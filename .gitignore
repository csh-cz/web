# Node / pnpm
node_modules
*.log
.pnpm-debug.log

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode
.idea
*.swp
*.swo

# Build artifacts
dist
.astro
.cache
apps/*/dist
apps/*/.astro

# Cloudflare / Vercel / Netlify dev
.wrangler
.vercel
.netlify

# Env files
.env
.env.local
.env.*.local
# Cloudflare Pages local dev secrets (wrangler pages dev)
.dev.vars

# Scraped raw HTML — celý adresář je pracovní, regenerable přes pnpm scrape:hodinarium
raw/

# Stažené obrázky (62 MB) — regenerable přes pnpm download:hodinarium
# pokud chceš, odkomentuj řádky níže pro úspornější repo
# apps/*/public/img/

# OG images jsou commitnuté — generují se přes pnpm og:build
# (pokud bys chtěl negenerovat ručně, odkomentuj řádek níže)
# apps/*/public/og/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Lighthouse CI lokální reporty — obsahují timestamped JSON+HTML.
# CI je nahrává do temporary-public-storage (lhci.app), lokální výstup
# je gitignored.
.lighthouseci/

# Tmp soubory
/tmp_*

# Pracovní výstupy v tmp/ — scratch (Zotero crossref, geocode cache, OSM
# dumps, výzkumné JSONy, reporty). Celá složka je scratch, nepatří do gitu.
tmp/

# macOS Finder copy artefakty (s mezerou v názvu — „file 2.json")
**/* 2.[a-z]*

# zdroje/ — pracovní materiály mimo git (PDF originály, fotky pro zpracování,
# ZIP archivy z Google Photos atd.). Příliš velké, ne všechny patří publikovat.
# Výjimka: zdroje/README.md = guide pro budoucí session, smí být committed.
# Pozn.: `zdroje/**` (ne `zdroje/`) je nutné, aby `!` výjimka mohla fungovat —
# directory-level rule (`zdroje/`) git neumí selektivně přebít.
zdroje/**
!zdroje/README.md

# macOS Finder aliases / drag-drop omylem
fo:Users:*
*Downloads:*
# Claude Code local config — personal/devbox-only, not shared
.claude/*
# Skills jsou sdílená pravidla pro celý tým, tracked v repu
!.claude/skills/

# Lokální (gitignored) soukromá data — vlastníci sbírkových karet apod.
local/

# Semantic search korpus — meziprodukt z `pnpm search:corpus`,
# rebuilduje se z content/. Final index `public/search/semantic-index.json`
# je commitnutý (deployment artifact pro Pages Function).
apps/*/.semantic-corpus.json

# AVIF/WebP varianty — generují se v prebuild kroku přes
# `pnpm imgvariants:build` (sharp); idempotentní (skip pokud existuje).
# Nedrží se v repu, protože by repo přibrzdily o ~400 MB.
apps/*/public/img/**/*.avif
apps/*/public/img/**/*.webp
