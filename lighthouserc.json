{
  "ci": {
    "collect": {
      "url": [
        "https://hodinarium-eu.pages.dev/",
        "https://hodinarium-eu.pages.dev/sbirka/",
        "https://hodinarium-eu.pages.dev/sbirka/karta/inv-1-vezni-hiemann-1884/",
        "https://hodinarium-eu.pages.dev/hodinari/",
        "https://hodinarium-eu.pages.dev/hodinari/jan-janata/",
        "https://hodinarium-eu.pages.dev/soupis-veznich-hodin/",
        "https://hodinarium-eu.pages.dev/slovnik/",
        "https://hodinarium-eu.pages.dev/slovnik/setrvacka/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "skipAudits": [
          "uses-http2",
          "redirects-http",
          "uses-responsive-images",
          "is-crawlable"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.7 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
