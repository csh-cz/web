{
  "name": "csh-web",
  "version": "0.1.0",
  "private": true,
  "description": "Webové projekty Českého spolku horologického — orloj.eu, hodinarium.eu",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "scrape:hodinarium": "tsx scripts/scrape-hodinarium.ts",
    "convert:hodinarium": "tsx scripts/convert-hodinarium.ts",
    "catalog:hodinarium": "tsx scripts/build-catalog.ts",
    "download:hodinarium": "tsx scripts/download-assets.ts",
    "redirects:hodinarium": "tsx scripts/build-redirects.ts",
    "og:build": "tsx scripts/build-og-images.ts",
    "og:check": "node scripts/check-og-coverage.mjs",
    "og:check:ci": "node scripts/check-og-coverage.mjs --ci",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "imgindex:build": "tsx scripts/build-image-index.ts",
    "spelldict:build": "node scripts/build-cs-spell-dictionary.mjs",
    "deadlinks:audit": "node scripts/audit-dead-links.mjs",
    "imgvariants:build": "tsx scripts/generate-image-formats.ts",
    "imgvariants:upload": "node scripts/upload-imgvariants-to-r2.mjs",
    "imgvariants:sync": "pnpm imgvariants:build && pnpm imgvariants:upload",
    "cf:cleanup": "node scripts/cleanup-cf-pages-deployments.mjs",
    "refs:cross": "node scripts/build-cross-refs.mjs",
    "content:audit": "node scripts/audit-content-evergreen.mjs",
    "favicon:build": "tsx scripts/build-favicon.ts",
    "hodinari:detect": "tsx scripts/detect-hodinari-mentions.ts",
    "refs:sync": "node scripts/sync-zotero-refs.mjs",
    "refs:check": "node scripts/sync-zotero-refs.mjs --check",
    "refs:snapshot": "node scripts/test-iso690-snapshots.mjs",
    "refs:snapshot:update": "node scripts/test-iso690-snapshots.mjs --update",
    "gmaps:parse": "tsx scripts/parse-gmaps-kml.ts",
    "soupis:parse": "tsx scripts/parse-soupis.ts",
    "soupis:stuby": "tsx scripts/generate-soupis-stubs.ts",
    "sbirka:relate": "tsx scripts/backfill-related-karty.ts",
    "popisy:parse": "tsx scripts/parse-popisy-stroju.ts",
    "popisy:apply": "tsx scripts/apply-popisy-to-karty.ts",
    "renumber": "tsx scripts/migrate-renumbering.ts",
    "clanky:extract": "tsx scripts/extract-from-articles.ts",
    "search:corpus": "node scripts/extract-search-corpus.mjs",
    "search:embed": "node scripts/build-semantic-index.mjs",
    "search:rebuild": "pnpm search:corpus && pnpm search:embed",
    "slovnik:build": "node scripts/build-slovnik.mjs",
    "slovnik:auto-link": "node scripts/auto-link-slovnik.mjs",
    "dict:build": "tsx scripts/build-dictionary-index.ts",
    "validate:content": "node scripts/validate-content.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "pipeline:hodinarium": "pnpm scrape:hodinarium && pnpm convert:hodinarium && pnpm catalog:hodinarium && pnpm download:hodinarium && pnpm redirects:hodinarium",
    "dev:hodinarium": "pnpm --filter hodinarium-eu dev",
    "build:hodinarium": "pnpm --filter hodinarium-eu build",
    "preview:hodinarium": "pnpm --filter hodinarium-eu preview"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/turndown": "^5.0.6",
    "katex": "^0.16.45",
    "pathe": "^2.0.3",
    "playwright": "^1.59.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "typescript": "^5.7.2",
    "unist-util-visit": "^5.0.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.4"
  },
  "dependencies": {
    "remark-directive": "^4.0.0"
  }
}
