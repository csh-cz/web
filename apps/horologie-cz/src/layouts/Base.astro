---
import "../styles/global.css";
import { SISTER_HODINARIUM } from "../data/sites";
import BrandLogo from "../components/BrandLogo.astro";
import { cdnUrl } from "../utils/cdnImage";

interface Props {
  title: string;
  description?: string;
  ogSlug?: string;
}
const { title, description, ogSlug } = Astro.props;
const fullTitle = title === "Český spolek horologický" ? title : `${title} — Český spolek horologický`;
const desc = description ?? "Český spolek horologický z. s. — sdružení obdivovatelů hodin, restaurátorů a tvůrců.";
// Cloudflare Web Analytics token — set in CF Pages env as PUBLIC_CF_ANALYTICS_TOKEN.
// Bez tokenu beacon tag se nevyrenderuje (no-op v dev/preview).
// Setup viz docs/setup-cloudflare-web-analytics.md.
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;
// Dočasně canonical na pages.dev — ostrá doména horologie.cz zatím neběží
// (po DNS switch změnit zpět a aktualizovat astro.config).
const site = Astro.site ?? new URL("https://horologie-cz.pages.dev");
const canonical = new URL(Astro.url.pathname, site).toString();

function ogSlugFromPath(path: string): string {
  const p = path.replace(/\/$/, '').replace(/^\//, '');
  if (p === '' || p === 'index') return 'home';
  if (p.startsWith('clanky/')) return p.slice('clanky/'.length);
  return p.split('/')[0];
}
const slug = ogSlug ?? ogSlugFromPath(Astro.url.pathname);
const ogImage = new URL(`/og/${slug}.png`, site).toString();

// hreflang alternate — /en je samostatná anglická stránka, jiné cs↔en pairs
// nemáme. Ostatní stránky deklarují alternate jen tehdy když existuje en verze.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index';
const isEn = Astro.url.pathname === '/en' || Astro.url.pathname === '/en/';
const csUrl = new URL('/', site).toString();
const enUrl = new URL('/en', site).toString();

// Organization JSON-LD jen na home
const orgJsonLd = isHome ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': csUrl,
  name: 'Český spolek horologický',
  alternateName: 'CSH',
  url: csUrl,
  logo: cdnUrl('/img/logo-csh.png'),
  email: 'info@orloj.eu',
  telephone: '+420603502735',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'nábřeží Otakara Ostrčila 273/6',
    postalCode: '392 01',
    addressLocality: 'Soběslav',
    addressCountry: 'CZ',
  },
  taxID: '26573008',
  foundingDate: '2014',
  sameAs: [
    'https://hodinarium-eu.pages.dev/',
    'https://orloj.eu/',
  ],
} : null;
---
<!DOCTYPE html>
<html lang="cs" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14110c" />
    <meta name="description" content={desc} />
    <!-- DEV STATE: dokud běžíme na pages.dev, blokujeme indexaci. -->
    <!-- Po DNS switch na horologie.cz odstranit oba následující meta tagy. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />

    <!-- Favicon a homescreen ikony (vygenerované scripts/build-favicon.ts) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonical} />
    {(isHome || isEn) && (
      <>
        <link rel="alternate" hreflang="cs" href={csUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={csUrl} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Český spolek horologický" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />

    <!-- Licence: Creative Commons Attribution 4.0 International -->
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
    <meta name="dcterms.rights" content="© Český spolek horologický z. s. — CC BY 4.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" />

    {/* Font Awesome 6 Free — sjednoceno s Hodinarium (memory
        feedback_ikony_font_awesome). Použití: <i class="fa-solid fa-check">.
        Ikon set: solid (free) + brands. Regular vyžaduje Pro license. */}
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <title>{fullTitle}</title>
    {orgJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    )}
    {cfAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a href="#hlavni-obsah" class="skip-link">Přeskočit na obsah</a>

    <header class="site-header sticky top-0 z-20" role="banner">
      <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4" aria-label="Hlavní navigace">
        <a href="/" class="brand" style="border-bottom: none;" aria-label="Český spolek horologický — domů">
          <BrandLogo />
          <span class="hidden sm:inline">Český spolek horologický</span>
          <span class="sm:hidden">ČSH</span>
        </a>

        <ul class="hidden md:flex gap-5 text-sm items-center" style="letter-spacing: 0.04em;">
          <li><a href="/" style="border-bottom: none;">O spolku</a></li>
          <li><a href="/akce" style="border-bottom: none;">Akce</a></li>
          <li><a href="/schuze" style="border-bottom: none;">Schůze</a></li>
          <li><a href="/dokumenty" style="border-bottom: none;">Dokumenty</a></li>
          <li><a href="/spolky" style="border-bottom: none;">Spolky</a></li>
          <li><a href="/sponzoring" style="border-bottom: none;">Podpora</a></li>
          <li><a href="/kontakt" style="border-bottom: none;">Kontakt</a></li>
          <li>
            <a href={SISTER_HODINARIUM} target="_blank" rel="noopener" class="nav-sister" style="border-bottom: none;" aria-label="Hodinárium — webová expozice (otevře se v novém okně)">
              Hodinárium
            </a>
          </li>
          <li>
            <a href="https://orloj.eu" target="_blank" rel="noopener" class="nav-sister" style="border-bottom: none;" aria-label="Orloj.eu — Pražský orloj (otevře se v novém okně)">
              Orloj.eu
            </a>
          </li>
          <li>
            <a href="/en" class="nav-en" style="border-bottom: none;" aria-label="English summary" hreflang="en" lang="en">EN</a>
          </li>
        </ul>

        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer p-2 -m-2 select-none" aria-label="Otevřít menu">
            <svg class="h-6 w-6 text-[var(--color-brass-bright)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <ul class="mobile-menu absolute right-0 top-full mt-2 w-60 py-1">
            <li><a href="/" style="border-bottom: none;">O spolku</a></li>
            <li><a href="/akce" style="border-bottom: none;">Akce spolku</a></li>
            <li><a href="/schuze" style="border-bottom: none;">Členské schůze</a></li>
            <li><a href="/prispevky" style="border-bottom: none;">Příspěvky na schůzích</a></li>
            <li><a href="/dokumenty" style="border-bottom: none;">Dokumenty</a></li>
            <li><a href="/spolky" style="border-bottom: none;">Horologické spolky</a></li>
            <li><a href="/sponzoring" style="border-bottom: none;">Podpora</a></li>
            <li><a href="/kontakt" style="border-bottom: none;">Kontakt</a></li>
            <li><a href={SISTER_HODINARIUM} target="_blank" rel="noopener" style="border-bottom: none;">Hodinárium</a></li>
            <li><a href="https://orloj.eu" target="_blank" rel="noopener" style="border-bottom: none;">Orloj.eu</a></li>
            <li><a href="/en" style="border-bottom: none;" hreflang="en" lang="en">English summary</a></li>
          </ul>
        </details>
      </nav>
    </header>

    <main id="hlavni-obsah" class="flex-1 max-w-5xl mx-auto px-6 py-10 md:py-16 w-full" role="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer mt-20" role="contentinfo">
      <div class="max-w-5xl mx-auto px-6 py-10 text-sm text-[var(--color-text-muted)]">
        <div class="footer-grid">
          <div>
            <h3 class="footer-h">Spolek</h3>
            <ul>
              <li><a href="/">O spolku</a></li>
              <li><a href="/akce">Akce</a></li>
              <li><a href="/schuze">Schůze</a></li>
              <li><a href="/dokumenty">Dokumenty</a></li>
              <li><a href="/sponzoring">Podpora</a></li>
              <li><a href="/kontakt">Kontakt</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-h">Sesterské weby</h3>
            <ul>
              <li><a href={SISTER_HODINARIUM} target="_blank" rel="noopener">Hodinárium</a></li>
              <li><a href="https://orloj.eu" target="_blank" rel="noopener">Orloj.eu</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-h">Sociální sítě</h3>
            <ul>
              <li><a href="https://www.facebook.com/Hodin%C3%A1rium-%C4%8Cesk%C3%BD-spolek-horologick%C3%BD-169939123371944" target="_blank" rel="noopener">Facebook</a></li>
              <li><a href="https://www.youtube.com/@muzeum_veznich_hodin" target="_blank" rel="noopener">YouTube</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-h">Kontakt</h3>
            <ul>
              <li><a href="mailto:info@orloj.eu">info@orloj.eu</a></li>
              <li><a href="tel:+420603502735">+420 603 502 735</a></li>
              <li>nábřeží Otakara Ostrčila 273/6,<br/>392&nbsp;01 Soběslav&nbsp;III</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>Český spolek horologický&nbsp;z.&nbsp;s. · IČO 26573008</span>
          <span class="footer-licence">
            Obsah pod licencí
            <a href="/licence" rel="license" class="cc-mini">
              <span class="cc-mini-icon">CC</span><span class="cc-mini-icon">BY</span>
              <span>CC&nbsp;BY&nbsp;4.0</span>
            </a>
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    /* Logo + text spolku v zlaté brass barvě — vizuálně odlišené od těla
       textu, ale ne tak ostré jako --color-brass-bright. */
    color: var(--color-brass);
    font-size: 1rem;
    flex-shrink: 0;
  }
  .brand:hover {
    color: var(--color-brass-bright);
  }
  .nav-sister {
    color: var(--color-copper) !important;
  }
  .nav-sister:hover {
    color: var(--color-brass-bright) !important;
  }
  .nav-en {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    padding: 0.25rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent) !important;
    border-radius: 2px;
    color: var(--color-text-soft) !important;
  }
  .nav-en:hover {
    border-color: var(--color-brass) !important;
    color: var(--color-brass-bright) !important;
  }
  .mobile-menu {
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    border-radius: 2px;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--color-ink) 25%, transparent);
    /* Skrolovat když seznam přesahuje viewport (telefon na výšku).
       dvh = dynamic viewport, počítá s URL barem prohlížeče na mobilu.
       Fallback 100vh pro starší prohlížeče. + bottom safe-area pro iPhone notch.
       Bug 2026-05-31: bez dvh menu na mobilu přesahovalo pod URL bar. */
    max-height: calc(100vh - 100px - env(safe-area-inset-bottom, 0px));
    max-height: calc(100dvh - 100px - env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .mobile-menu a {
    display: block;
    padding: 0.85rem 1.1rem;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 8%, transparent);
  }
  .mobile-menu li:last-child a {
    border-bottom: none;
  }
  .mobile-menu a:hover {
    background: color-mix(in srgb, var(--color-brass) 8%, transparent);
  }
</style>
