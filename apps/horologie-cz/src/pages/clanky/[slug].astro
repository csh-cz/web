---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const all = await getCollection('clanky');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const lastModifiedReadable = (() => {
  if (!entry.data.lastModified) return undefined;
  const d = new Date(entry.data.lastModified);
  if (Number.isNaN(d.getTime())) return undefined;
  return d.toLocaleDateString('cs-CZ', { year: 'numeric', month: 'long', day: 'numeric' });
})();
---
<Base title={entry.data.title} description="">
  <Breadcrumbs trail={[
    { href: "/", label: "Spolek" },
    { href: "/dokumenty", label: "Dokumenty" },
    { label: entry.data.title },
  ]} />

  <article class="article-doc">
    <header class="article-header">
      <h1>{entry.data.title}</h1>
      {lastModifiedReadable && (
        <p class="last-mod">Aktualizováno {lastModifiedReadable}</p>
      )}
    </header>
    <div class="prose-content">
      <Content />
    </div>
  </article>
</Base>

<style>
  /* .breadcrumbs CSS přesunut do @csh/ui/styles/breadcrumbs.css (FU5 fáze 4). */

  .article-doc {
    max-width: 720px;
    margin: 0 auto;
  }
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .article-header h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-brass-bright);
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }
  .last-mod {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .prose-content {
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-content :global(p) {
    margin-block: 1.1em;
    color: var(--color-text);
  }
  .prose-content :global(h2),
  .prose-content :global(h3) {
    font-family: var(--font-serif);
    color: var(--color-brass-bright);
    border: none;
    margin-top: 2em;
  }
  .prose-content :global(blockquote) {
    border-left: 2px solid var(--color-copper);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-text-soft);
  }

  /* === Bullet a číslované listy ===
     Sjednoceno s hodinarium-eu (`apps/hodinarium-eu/src/styles/global.css`):
     `::before` namísto `::marker` pro přesný positioning, copper accents,
     serif + tabular-nums pro `<ol>` (vizuální parita s table headers). */
  .prose-content :global(ul),
  .prose-content :global(ol) {
    padding-left: 1.75rem;
    margin-block: 1em;
    list-style: none;
  }
  .prose-content :global(li) {
    position: relative;
    margin-block: 0.3rem;
  }
  .prose-content :global(ul > li::before) {
    content: '◆';
    position: absolute;
    left: -1.25rem;
    top: 0.05em;
    color: var(--color-copper);
    font-size: 0.85em;
  }
  .prose-content :global(ul ul > li::before) {
    content: '◇';
    opacity: 0.8;
  }
  .prose-content :global(ol) {
    counter-reset: ol-counter;
  }
  .prose-content :global(ol > li) {
    counter-increment: ol-counter;
  }
  .prose-content :global(ol > li::before) {
    content: counter(ol-counter) '.';
    position: absolute;
    left: -1.75rem;
    top: 0;
    color: var(--color-copper);
    font-family: var(--font-serif);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    min-width: 1.5rem;
    text-align: right;
    padding-right: 0.25rem;
  }
  .prose-content :global(ol ol) {
    counter-reset: ol-counter-nested;
  }
  .prose-content :global(ol ol > li) {
    counter-increment: ol-counter-nested;
  }
  .prose-content :global(ol ol > li::before) {
    content: counter(ol-counter-nested, lower-alpha) ')';
  }
</style>
