---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('clanky');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const lastModifiedReadable = (() => {
  if (!entry.data.lastModified) return undefined;
  const d = new Date(entry.data.lastModified);
  if (Number.isNaN(d.getTime())) return undefined;
  return d.toLocaleDateString('cs-CZ', { year: 'numeric', month: 'long', day: 'numeric' });
})();
---
<Base title={entry.data.title} description="">
  <nav class="breadcrumbs" aria-label="Drobečková navigace">
    <a href="/">Spolek</a>
    <span aria-hidden="true">›</span>
    <a href="/dokumenty">Dokumenty</a>
    <span aria-hidden="true">›</span>
    <span class="current" aria-current="page">{entry.data.title}</span>
  </nav>

  <article class="article-doc">
    <header class="article-header">
      <h1>{entry.data.title}</h1>
      {lastModifiedReadable && (
        <p class="last-mod">Aktualizováno {lastModifiedReadable}</p>
      )}
    </header>
    <div class="prose-content">
      <Content />
    </div>
  </article>
</Base>

<style>
  .breadcrumbs {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .breadcrumbs a {
    color: var(--color-text-soft);
    border-bottom: none;
  }
  .breadcrumbs a:hover {
    color: var(--color-brass-bright);
  }
  .breadcrumbs .current {
    color: var(--color-text-soft);
    font-style: italic;
  }
  .breadcrumbs span[aria-hidden] {
    color: var(--color-brass);
    opacity: 0.5;
  }

  .article-doc {
    max-width: 720px;
    margin: 0 auto;
  }
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .article-header h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-brass-bright);
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }
  .last-mod {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .prose-content {
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose-content :global(p) {
    margin-block: 1.1em;
    color: var(--color-text);
  }
  .prose-content :global(h2),
  .prose-content :global(h3) {
    font-family: var(--font-serif);
    color: var(--color-brass-bright);
    border: none;
    margin-top: 2em;
  }
  .prose-content :global(blockquote) {
    border-left: 2px solid var(--color-copper);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--color-text-soft);
  }
</style>
