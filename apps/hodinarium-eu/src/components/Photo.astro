---
/**
 * Obrázek s volitelným credit captionem (autor, licence, zdroj).
 *
 * Caption se renderuje jako overlay v pravém dolním rohu obrázku.
 * Barva textu je vybrána podle tone pravého dolního rohu (z image-sizes.json
 * pole `tone`, vyrobeno scripts/build-image-index.ts):
 *   - 'dark'  pozadí světlé → tmavý text + jemné světlé halo
 *   - 'light' pozadí tmavé  → světlý text + jemné tmavé halo
 *
 * Caption se vůbec nerenderuje, pokud není uveden žádný atribut credit
 * (author / license / sourceUrl) — komponenta pak chová jako obyčejný <img>.
 *
 * Mobile (≤600 px): overlay se vrátí pod obrázek (overlay nad ~320 px wide
 * fotkou je nečitelný).
 *
 * Použití:
 *   <Photo src="/img/foo.jpg" alt="…"
 *          author="Øyvind Holmstad" authorUrl="https://commons.wikimedia.org/wiki/User:Øyvind_Holmstad"
 *          license="CC BY-SA 3.0" licenseUrl="https://creativecommons.org/licenses/by-sa/3.0/"
 *          sourceUrl="https://commons.wikimedia.org/wiki/File:..."
 *          year={2014} />
 *
 *   <Photo src="/img/own.jpg" alt="…" /> — stejné jako obyčejný obr.
 *
 * Třída `class` propaguje na <img> (např. img-hero, img-standalone),
 * aby šly výchozí styly článku použít. Pokud není class, [slug].astro
 * skript přidá auto-classifikaci.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import exifr from 'exifr';
import imageSizes from '../data/image-sizes.json';

interface ImageSizeEntry {
  w: number;
  h: number;
  size: string;
  tone?: 'light' | 'dark';
}

interface Props {
  src: string;
  alt: string;
  class?: string;
  author?: string;
  authorUrl?: string;
  license?: string;
  licenseUrl?: string;
  sourceUrl?: string;
  year?: number;
}
const {
  src,
  alt,
  class: imgClass,
  author: propAuthor,
  authorUrl: propAuthorUrl,
  license: propLicense,
  licenseUrl: propLicenseUrl,
  sourceUrl: propSourceUrl,
  year: propYear,
} = Astro.props;

/**
 * Build-time auto-read XMP/IPTC metadata z `public/img/...` souboru.
 *
 * Fallback chain: MDX prop > XMP field > undefined.
 *
 * Pokud soubor nemá XMP (žádné exifr metadata), fallback pouze na MDX props.
 * Pokud exifr selže (neformální PDF/image), tichý fallback.
 *
 * XMP fields čteme:
 *   - XMP-dc:Creator           → author
 *   - XMP-dc:Rights / xmpRights:UsageTerms → license
 *   - XMP-cc:license / xmpRights:WebStatement → licenseUrl
 *   - XMP-dc:Source            → sourceUrl
 *   - XMP-dc:CreateDate (year extraction)
 */
/**
 * exifr s `true` filter parse-uje všechny XMP/IPTC/EXIF do flat objektu.
 * Pole jsou camelCase / lowercase dle XMP property names:
 *   - dc:creator → `creator` (string nebo array)
 *   - dc:rights → `rights` ({ lang, value } language alternative)
 *   - dc:source → `source` (string)
 *   - dc:description → `description` ({ lang, value })
 *   - cc:license → `license` ({ resource: URL }) — RDF resource
 *   - cc:attributionName → `attributionName`
 *   - cc:attributionURL → `attributionURL`
 *   - xmpRights:UsageTerms → `UsageTerms` ({ lang, value })
 *   - xmpRights:WebStatement → `WebStatement` (string)
 *   - xmp:CreateDate → `CreateDate` (Date)
 */
type XmpMeta = {
  creator?: string | string[];
  rights?: string | { lang?: string; value: string };
  source?: string;
  description?: string | { lang?: string; value: string };
  license?: string | { resource: string };
  attributionName?: string;
  attributionURL?: string;
  UsageTerms?: string | { lang?: string; value: string };
  WebStatement?: string;
  CreateDate?: Date | string;
};

function pickFirst<T>(v: T | T[] | undefined): T | undefined {
  if (Array.isArray(v)) return v[0];
  return v;
}

function extractLang(v: unknown): string | undefined {
  if (v == null) return undefined;
  if (typeof v === 'string') return v;
  if (typeof v === 'object') {
    const obj = v as { lang?: string; value?: string } & Record<string, string>;
    if (typeof obj.value === 'string') return obj.value;
    // Plain mapping like { 'x-default': '...', 'en': '...' }
    return obj['x-default'] ?? obj['en'] ?? obj['cs'] ?? Object.values(obj).find((x) => typeof x === 'string');
  }
  return undefined;
}

function extractResource(v: unknown): string | undefined {
  if (v == null) return undefined;
  if (typeof v === 'string') return v;
  if (typeof v === 'object') {
    const obj = v as { resource?: string };
    return obj.resource;
  }
  return undefined;
}

async function readXmp(srcPath: string): Promise<XmpMeta | null> {
  // Mapping URL path /img/foo.jpg → filesystem absolute path.
  // Astro build běží typicky z apps/<app>/, hledáme public/ relativně + apex pro safety.
  const candidates = [
    resolve(process.cwd(), 'public' + srcPath),
    resolve(process.cwd(), 'apps/hodinarium-eu/public' + srcPath),
    resolve(process.cwd(), 'apps/horologie-cz/public' + srcPath),
  ];
  const filePath = candidates.find((p) => existsSync(p));
  if (!filePath) return null;
  try {
    // Filter `true` = parse all segments; vrací flat object s parsed hodnotami.
    const meta = await exifr.parse(filePath, true);
    return (meta as XmpMeta) ?? null;
  } catch {
    return null;
  }
}

const xmp = await readXmp(src);

// Resolve hodnoty: MDX prop > XMP field
const author = propAuthor ?? (xmp ? pickFirst(xmp.creator) : undefined);
const authorUrl = propAuthorUrl ?? xmp?.attributionURL;

let license = propLicense;
if (!license && xmp) {
  license = extractLang(xmp.UsageTerms) ?? extractLang(xmp.rights);
}

let licenseUrl = propLicenseUrl;
if (!licenseUrl && xmp) {
  licenseUrl = extractResource(xmp.license) ?? xmp.WebStatement;
}

const sourceUrl = propSourceUrl ?? xmp?.source;

let year = propYear;
if (year === undefined && xmp?.CreateDate) {
  const d = xmp.CreateDate instanceof Date ? xmp.CreateDate : new Date(String(xmp.CreateDate));
  if (!Number.isNaN(d.getTime())) year = d.getFullYear();
}

const showCredit = Boolean(author || license || sourceUrl);
const sizeInfo = (imageSizes as Record<string, ImageSizeEntry>)[src];
// Default 'light' (světlý text + tmavé halo) — bezpečnější pro neznámé pozadí,
// většina foto-pozadí má střední/tmavé tóny.
const tone: 'light' | 'dark' = sizeInfo?.tone ?? 'light';

// R2 CDN rewrite — symetrie s rehype-picture (packages/rehype-picture/index.mjs).
// Markdown `![alt](/img/x.jpg)` prochází rehype-picture, kde se src přepíše na
// cdnBase + src. `::photo{src=...}` direktiva ale vede přímo do <Photo>
// komponenty, mimo rehype pipeline — proto stejný rewrite musíme udělat ručně,
// jinak by po `git rm public/img/` (TODO A.26 validation week) nebyl <img>
// odkud načíst (R2 by měl originály, ale komponenta by mířila na /img/).
//
// TODO refactor: extrahovat cdnBase do shared const a importovat oboustranně
// (astro.config.mjs i Photo.astro). Dnes hardcoded, sjednoceno s rehype config.
const CDN_BASE = 'https://pub-e96bd8c658664b38af73a48cb8872b60.r2.dev';
const cdnSrc = src.startsWith('/img/') ? `${CDN_BASE}${src}` : src;

// AVIF/WebP varianty (symetrie s rehype-picture wrapInPicture).
// `scripts/generate-image-formats.ts` produkuje per soubor `.avif` + `.webp`
// vedle originálu. R2 obsahuje všechny tři formáty.
const RASTER_RE = /\.(jpe?g|png)(\?.*)?$/i;
const isRaster = src.startsWith('/img/') && RASTER_RE.test(src);
const variantBase = isRaster ? `${CDN_BASE}${src.replace(RASTER_RE, '')}` : '';
---
<figure class="photo">
  {isRaster ? (
    <picture>
      <source type="image/avif" srcset={`${variantBase}.avif`} />
      <source type="image/webp" srcset={`${variantBase}.webp`} />
      <img src={cdnSrc} alt={alt} class={imgClass} loading="lazy" decoding="async" />
    </picture>
  ) : (
    <img src={cdnSrc} alt={alt} class={imgClass} loading="lazy" decoding="async" />
  )}
  {showCredit && (
    <figcaption class={`img-credit-overlay credit-tone-${tone}`}>
      {author && (
        <>
          Foto:&nbsp;
          {authorUrl ? <a href={authorUrl} rel="noopener" target="_blank">{author}</a> : author}
          {year && <> ({year})</>}
        </>
      )}
      {(author && license) && ' · '}
      {license && (
        licenseUrl
          ? <a href={licenseUrl} rel="noopener nofollow" target="_blank">{license}</a>
          : <span>{license}</span>
      )}
      {((author || license) && sourceUrl) && ' · '}
      {sourceUrl && <a href={sourceUrl} rel="noopener" target="_blank">zdroj</a>}
    </figcaption>
  )}
</figure>

<style is:global>
  .photo {
    position: relative;
    margin: 0 0 1.5rem;
    /* obrázek dědí třídy img-hero / img-large / atd. — žádný layout zde */
  }

  /* Overlay caption — pravý dolní roh nad obrázkem */
  .img-credit-overlay {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    margin: 0;
    padding: 0.15rem 0.5rem;
    max-width: 65%;
    font-size: 0.7rem;
    font-style: italic;
    letter-spacing: 0.01em;
    line-height: 1.4;
    text-align: right;
    pointer-events: none;
    border-radius: 2px;
  }
  .img-credit-overlay a,
  .img-credit-overlay span {
    pointer-events: auto;
  }
  .img-credit-overlay a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, currentColor 50%, transparent);
  }

  /* Audit M5 (a11y): tone-detection z BR rohu obrázku není spolehlivá
     u nehomogenních pozadí (krajka, gradient). Caption v některých
     fotkách failuje 4.5:1 i když token tvrdí jinak. Vrátit semi-průhledné
     pozadí + textový stín pro guaranteed contrast bez ohledu na obraz.
     Předtím byl jen barevný text bez halo. */
  /* Tmavý text na světlém pozadí — čistá černá + světlý stín */
  .img-credit-overlay.credit-tone-dark {
    color: #000;
    background: rgba(255, 255, 255, 0.55);
    text-shadow: 0 1px 1px rgba(255, 255, 255, 0.6);
  }
  /* Světlý text na tmavém pozadí — čistá bílá + tmavý stín */
  .img-credit-overlay.credit-tone-light {
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.6);
  }

  .img-credit-overlay.credit-tone-dark a:hover {
    color: #5a3818;
    border-bottom-color: #5a3818;
  }
  .img-credit-overlay.credit-tone-light a:hover {
    color: var(--color-brass-bright, #d4a85a);
    border-bottom-color: var(--color-brass, #b8923e);
  }

  /* === Photo komponenta umí floatovat (jako markdown ![]() obrázky) ===
     Figure.photo s image size class (img-small/medium/tall) → float v textu.
     Img uvnitř fills figure (width 100%). Caption overlay zůstává absolute. */
  .prose-content figure.photo.img-small,
  .prose-content figure.photo.img-medium,
  .prose-content figure.photo.img-tall {
    margin: 0.4rem 0 0.75rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
  }
  .prose-content figure.photo.img-small { float: right; max-width: 220px; }
  .prose-content figure.photo.img-medium { float: right; max-width: 320px; }
  .prose-content figure.photo.img-tall { float: right; max-width: 240px; max-height: 480px; }

  /* JS counter rotuje pravo/levo, propaguje na figure.photo */
  .prose-content figure.photo.img-float-right {
    float: right !important;
    margin: 0.4rem 0 0.75rem 1.5rem !important;
  }
  .prose-content figure.photo.img-float-left {
    float: left !important;
    margin: 0.4rem 1.5rem 0.75rem 0 !important;
  }

  /* Img uvnitř floatovaného figure.photo se sníží na 100% figure */
  .prose-content figure.photo.img-small img,
  .prose-content figure.photo.img-medium img,
  .prose-content figure.photo.img-tall img {
    width: 100%;
    height: auto;
    display: block;
    border: none;
    margin: 0;
  }

  /* Mobile fallback — overlay zpět pod obrázek + figure float vypnout */
  @media (max-width: 600px) {
    .img-credit-overlay {
      position: static;
      max-width: none;
      margin-top: 0.35rem;
      padding: 0;
      color: var(--color-text-muted) !important;
    }
    .img-credit-overlay a {
      color: var(--color-text-soft);
    }
    .prose-content figure.photo.img-small,
    .prose-content figure.photo.img-medium,
    .prose-content figure.photo.img-tall,
    .prose-content figure.photo.img-float-left,
    .prose-content figure.photo.img-float-right {
      float: none !important;
      max-width: 100%;
      margin: 1.25rem auto !important;
    }
  }
</style>
