---
/**
 * Obrázek s volitelným credit captionem (autor, licence, zdroj).
 *
 * Credit se renderuje VŽDY MIMO obrázek (ne overlay) — rozložení se volí
 * build-time z rozměrů v image-sizes.json (návrh + demo:
 * docs/photo-credit-layout-2026-05-20/):
 *   - landscape / krátký credit → caption pod obrázkem (default)
 *   - portrait + delší credit    → caption svisle vpravo (writing-mode)
 *   - velký portrait             → figure centrovaný na šířku textu
 * CC atribuce (TASL): author(+authorUrl) · license(+licenseUrl) · zdroj
 * (→ sourceUrl); rok se připojí za autora. Jméno se NIKDY nezdvojuje —
 * „© Jméno" se neuvádí zvlášť, pokud je autor zároveň držitelem práv.
 *
 * Caption se vůbec nerenderuje, pokud není uveden žádný atribut credit
 * (author / license / sourceUrl) — komponenta pak chová jako obyčejný <img>.
 *
 * Mobile (≤600 px): svislý side caption degraduje zpět pod obrázek.
 *
 * Použití:
 *   <Photo src="/img/foo.jpg" alt="…"
 *          author="Øyvind Holmstad" authorUrl="https://commons.wikimedia.org/wiki/User:Øyvind_Holmstad"
 *          license="CC BY-SA 3.0" licenseUrl="https://creativecommons.org/licenses/by-sa/3.0/"
 *          sourceUrl="https://commons.wikimedia.org/wiki/File:..."
 *          year={2014} />
 *
 *   <Photo src="/img/own.jpg" alt="…" /> — stejné jako obyčejný obr.
 *
 * Třída `class` propaguje na <img> (např. img-hero, img-standalone),
 * aby šly výchozí styly článku použít. Pokud není class, [slug].astro
 * skript přidá auto-classifikaci.
 */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import exifr from 'exifr';
import imageSizes from '../data/image-sizes.json';

interface ImageSizeEntry {
  w: number;
  h: number;
  size: string;
  tone?: 'light' | 'dark';
}

interface Props {
  src: string;
  alt: string;
  class?: string;
  author?: string;
  authorUrl?: string;
  license?: string;
  licenseUrl?: string;
  sourceUrl?: string;
  year?: number;
  /** Single-string credit fallback pro kompaktní YAML pole jako
   *  `foto[].credit: "© David Knespl, 2023"`. Pokud je vyplněn,
   *  zobrazí se pod obrázkem jako `<figcaption>` (na rozdíl od
   *  overlay credit composed z author/license/sourceUrl).
   *  Pokud je zároveň vyplněn `caption`, credit jde za caption. */
  credit?: string;
  /** Volitelný popis pod obrázkem (alt text se opakuje pro screen
   *  reader, caption je vizuální popis pro vidoucí uživatele). */
  caption?: string;
}
const {
  src,
  alt,
  class: imgClass,
  author: propAuthor,
  authorUrl: propAuthorUrl,
  license: propLicense,
  licenseUrl: propLicenseUrl,
  sourceUrl: propSourceUrl,
  year: propYear,
  credit: propCredit,
  caption: propCaption,
} = Astro.props;

/**
 * Build-time auto-read XMP/IPTC metadata z `public/img/...` souboru.
 *
 * Fallback chain: MDX prop > XMP field > undefined.
 *
 * Pokud soubor nemá XMP (žádné exifr metadata), fallback pouze na MDX props.
 * Pokud exifr selže (neformální PDF/image), tichý fallback.
 *
 * XMP fields čteme:
 *   - XMP-dc:Creator           → author
 *   - XMP-dc:Rights / xmpRights:UsageTerms → license
 *   - XMP-cc:license / xmpRights:WebStatement → licenseUrl
 *   - XMP-dc:Source            → sourceUrl
 *   - XMP-dc:CreateDate (year extraction)
 */
/**
 * exifr s `true` filter parse-uje všechny XMP/IPTC/EXIF do flat objektu.
 * Pole jsou camelCase / lowercase dle XMP property names:
 *   - dc:creator → `creator` (string nebo array)
 *   - dc:rights → `rights` ({ lang, value } language alternative)
 *   - dc:source → `source` (string)
 *   - dc:description → `description` ({ lang, value })
 *   - cc:license → `license` ({ resource: URL }) — RDF resource
 *   - cc:attributionName → `attributionName`
 *   - cc:attributionURL → `attributionURL`
 *   - xmpRights:UsageTerms → `UsageTerms` ({ lang, value })
 *   - xmpRights:WebStatement → `WebStatement` (string)
 *   - xmp:CreateDate → `CreateDate` (Date)
 */
type XmpMeta = {
  creator?: string | string[];
  rights?: string | { lang?: string; value: string };
  source?: string;
  description?: string | { lang?: string; value: string };
  license?: string | { resource: string };
  attributionName?: string;
  attributionURL?: string;
  UsageTerms?: string | { lang?: string; value: string };
  WebStatement?: string;
  CreateDate?: Date | string;
};

function pickFirst<T>(v: T | T[] | undefined): T | undefined {
  if (Array.isArray(v)) return v[0];
  return v;
}

function extractLang(v: unknown): string | undefined {
  if (v == null) return undefined;
  if (typeof v === 'string') return v;
  if (typeof v === 'object') {
    const obj = v as { lang?: string; value?: string } & Record<string, string>;
    if (typeof obj.value === 'string') return obj.value;
    // Plain mapping like { 'x-default': '...', 'en': '...' }
    return obj['x-default'] ?? obj['en'] ?? obj['cs'] ?? Object.values(obj).find((x) => typeof x === 'string');
  }
  return undefined;
}

function extractResource(v: unknown): string | undefined {
  if (v == null) return undefined;
  if (typeof v === 'string') return v;
  if (typeof v === 'object') {
    const obj = v as { resource?: string };
    return obj.resource;
  }
  return undefined;
}

async function readXmp(srcPath: string): Promise<XmpMeta | null> {
  // Mapping URL path /img/foo.jpg → filesystem absolute path.
  // Astro build běží typicky z apps/<app>/, hledáme public/ relativně + apex pro safety.
  const candidates = [
    resolve(process.cwd(), 'public' + srcPath),
    resolve(process.cwd(), 'apps/hodinarium-eu/public' + srcPath),
    resolve(process.cwd(), 'apps/horologie-cz/public' + srcPath),
  ];
  const filePath = candidates.find((p) => existsSync(p));
  if (!filePath) return null;
  try {
    // Filter `true` = parse all segments; vrací flat object s parsed hodnotami.
    const meta = await exifr.parse(filePath, true);
    return (meta as XmpMeta) ?? null;
  } catch {
    return null;
  }
}

const xmp = await readXmp(src);

// Resolve hodnoty: MDX prop > XMP field
const author = propAuthor ?? (xmp ? pickFirst(xmp.creator) : undefined);
const authorUrl = propAuthorUrl ?? xmp?.attributionURL;

let license = propLicense;
if (!license && xmp) {
  license = extractLang(xmp.UsageTerms) ?? extractLang(xmp.rights);
}

let licenseUrl = propLicenseUrl;
if (!licenseUrl && xmp) {
  licenseUrl = extractResource(xmp.license) ?? xmp.WebStatement;
}

const sourceUrl = propSourceUrl ?? xmp?.source;

let year = propYear;
if (year === undefined && xmp?.CreateDate) {
  const d = xmp.CreateDate instanceof Date ? xmp.CreateDate : new Date(String(xmp.CreateDate));
  if (!Number.isNaN(d.getTime())) year = d.getFullYear();
}

const showCredit = Boolean(author || license || sourceUrl);
const sizeInfo = (imageSizes as Record<string, ImageSizeEntry>)[src];

// ── Layout rozhodnutí (build-time z image-sizes.json) ─────────────────
// Návrh + demo: docs/photo-credit-layout-2026-05-20/{demo,demo-cc}.html
// Credit je VŽDY mimo obrázek (pod / svisle vpravo), ne overlay.
//   • landscape / krátký credit → caption pod obrázkem (default)
//   • portrait + delší credit    → caption svisle vpravo (writing-mode)
//   • velký portrait             → figure centrovaný na šířku textu
// Plně-šířkové třídy (img-hero/full/standalone) řeší šířku samy → nový
// shrink/centering layout na ně NEAPLIKOVAT (jinak by se rozbila šířka).
const w = sizeInfo?.w ?? 0;
const h = sizeInfo?.h ?? 0;
const isPortrait = w > 0 && h > w * 1.15;
const isLarge = w >= 900 || h >= 1200;
const FULLWIDTH_RE = /\b(?:img-hero|img-full|img-standalone|img-skip-hero)\b/;
const inFlow = !FULLWIDTH_RE.test(imgClass ?? '');
// Délka složeného creditu rozhoduje side vs below (většina CC creditů
// „Foto: Autor · CC BY-SA 3.0 · zdroj" je dlouhá → side u portrétů).
const creditText = [author, license, sourceUrl ? 'zdroj' : ''].filter(Boolean).join(' · ');
const creditLong = creditText.length > 24;
const layoutSide = showCredit && inFlow && isPortrait && !isLarge && creditLong;
const figureClass = [
  'photo',
  showCredit && inFlow && isPortrait && 'is-portrait',
  showCredit && inFlow && isPortrait && isLarge && 'is-large',
  layoutSide && 'layout-side',
].filter(Boolean).join(' ');

// R2 CDN rewrite — symetrie s rehype-picture (packages/rehype-picture/index.mjs).
// Markdown `![alt](/img/x.jpg)` prochází rehype-picture, kde se src přepíše na
// cdnBase + src. `::photo{src=...}` direktiva ale vede přímo do <Photo>
// komponenty, mimo rehype pipeline — proto stejný rewrite musíme udělat ručně,
// jinak by po `git rm public/img/` (TODO A.26 validation week) nebyl <img>
// odkud načíst (R2 by měl originály, ale komponenta by mířila na /img/).
//
// TODO refactor: extrahovat cdnBase do shared const a importovat oboustranně
// (astro.config.mjs i Photo.astro). Dnes hardcoded, sjednoceno s rehype config.
const CDN_BASE = 'https://pub-e96bd8c658664b38af73a48cb8872b60.r2.dev';
const cdnSrc = src.startsWith('/img/') ? `${CDN_BASE}${src}` : src;

// AVIF/WebP varianty (symetrie s rehype-picture wrapInPicture).
// `scripts/generate-image-formats.ts` produkuje per soubor `.avif` + `.webp`
// vedle originálu. R2 obsahuje všechny tři formáty.
const RASTER_RE = /\.(jpe?g|png)(\?.*)?$/i;
const isRaster = src.startsWith('/img/') && RASTER_RE.test(src);
const variantBase = isRaster ? `${CDN_BASE}${src.replace(RASTER_RE, '')}` : '';
---
<figure class={figureClass}>
  {isRaster ? (
    <picture>
      <source type="image/avif" srcset={`${variantBase}.avif`} />
      <source type="image/webp" srcset={`${variantBase}.webp`} />
      <img src={cdnSrc} alt={alt} class={imgClass} loading="lazy" decoding="async" />
    </picture>
  ) : (
    <img src={cdnSrc} alt={alt} class={imgClass} loading="lazy" decoding="async" />
  )}
  {showCredit && (
    <figcaption class="img-credit">
      {author && (
        <>
          Foto:&nbsp;
          {authorUrl ? <a href={authorUrl} rel="noopener" target="_blank">{author}</a> : author}
          {year && <> ({year})</>}
        </>
      )}
      {(author && license) && ' · '}
      {license && (
        licenseUrl
          ? <a href={licenseUrl} rel="noopener nofollow" target="_blank">{license}</a>
          : <span>{license}</span>
      )}
      {((author || license) && sourceUrl) && ' · '}
      {sourceUrl && <a href={sourceUrl} rel="noopener" target="_blank">zdroj</a>}
    </figcaption>
  )}
  {/* `credit` + `caption` props — single-string fallback pro YAML pole
      jako `foto[].credit: "© David Knespl, 2023"`. Renderují se pod obrázkem
      jako klasický figcaption (na rozdíl od overlay credit composed
      z author/license). Pre-A.26 byl tu v soupis kartách plain <img>
      a inline figcaption — refactor sjednotil přes Photo komponentu. */}
  {(propCaption || propCredit) && !showCredit && (
    <figcaption class="img-caption-below">
      {propCaption}
      {propCredit && <small class="credit"> — {propCredit}</small>}
    </figcaption>
  )}
</figure>

<style is:global>
  /* Photo komponenta — credit caption MIMO obrázek (pod / svisle vpravo),
     ne overlay. Návrh + demo: docs/photo-credit-layout-2026-05-20/.
     Plně-šířkové třídy (img-hero/full/standalone) na <img> řeší šířku samy;
     nový shrink/centering layout se na ně neaplikuje (viz Photo.astro). */
  .photo { margin: 0 0 1.5rem; }
  .photo > picture { display: block; }
  .photo > picture > img { display: block; width: 100%; height: auto; }

  /* ── Credit / caption POD obrázkem (default — landscape i krátké credity) ── */
  .photo > figcaption {
    margin: 0.4rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .photo > figcaption a {
    color: var(--color-text-soft);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-brass) 50%, transparent);
    text-underline-offset: 2px;
  }
  .photo > figcaption a:hover {
    color: var(--color-brass-bright, #d4a85a);
    text-decoration-color: var(--color-brass, #b8923e);
  }
  .photo > figcaption .credit { font-size: 0.92em; opacity: 0.85; }

  /* ── Velký portrait — zúžit na obrázek a vycentrovat na šířku textu ── */
  .photo.is-large.is-portrait { width: fit-content; max-width: 100%; margin-inline: auto; }
  .photo.is-large.is-portrait > figcaption { text-align: center; }
  .photo.is-large.is-portrait img { width: auto; max-width: 100%; max-height: 80vh; }

  /* ── Portrait + delší credit — caption svisle vpravo (writing-mode) ── */
  .photo.layout-side {
    display: grid;
    grid-template-columns: auto min-content;
    align-items: stretch;
    gap: 0 0.6rem;
    width: fit-content;
    max-width: 100%;
  }
  .photo.layout-side > :is(picture, img) { grid-column: 1; grid-row: 1; min-width: 0; }
  .photo.layout-side img { display: block; width: auto; max-width: min(100%, 22rem); height: auto; }
  .photo.layout-side > figcaption {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    align-self: start;
    max-height: 100%;
    padding-inline-start: 0.5rem;
    border-inline-start: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }

  /* === Float thumbnaily (small/medium/tall) — figure floatuje jako ![]() === */
  .prose-content figure.photo.img-small  { float: right; max-width: 220px; margin: 0.4rem 0 0.75rem 1.5rem; }
  .prose-content figure.photo.img-medium { float: right; max-width: 320px; margin: 0.4rem 0 0.75rem 1.5rem; }
  .prose-content figure.photo.img-tall   { float: right; max-width: 240px; margin: 0.4rem 0 0.75rem 1.5rem; }
  .prose-content figure.photo.img-float-right { float: right !important; margin: 0.4rem 0 0.75rem 1.5rem !important; }
  .prose-content figure.photo.img-float-left  { float: left  !important; margin: 0.4rem 1.5rem 0.75rem 0 !important; }
  .prose-content figure.photo:is(.img-small, .img-medium, .img-tall) :is(picture, img) {
    width: 100%;
    height: auto;
    display: block;
    margin: 0;
  }
  .prose-content figure.photo:is(.img-small, .img-medium, .img-tall) img {
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
  }

  /* === Mobile — side caption zpět pod obrázek; floaty vypnout === */
  @media (max-width: 600px) {
    .photo.layout-side { display: block; width: auto; }
    .photo.layout-side > figcaption {
      writing-mode: horizontal-tb;
      white-space: normal;
      max-height: none;
      margin-top: 0.4rem;
      border-inline-start: none;
      padding-inline-start: 0;
      border-block-start: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
      padding-block-start: 0.3rem;
    }
    .prose-content figure.photo:is(.img-small, .img-medium, .img-tall, .img-float-left, .img-float-right) {
      float: none !important;
      max-width: 100%;
      margin: 1.25rem auto !important;
    }
  }
</style>
