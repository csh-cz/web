---
/**
 * EditorNote — redakční / správní poznámka viditelná POUZE přihlášenému editorovi.
 *
 * Použití v MDX:
 *   import EditorNote from '~/components/EditorNote.astro';
 *
 *   <EditorNote>
 *     Tato karta je stub. Doplnit: životopis, references, portrét.
 *   </EditorNote>
 *
 *   <EditorNote level="warn">
 *     Lokalita "Karlsthal" zatím nepotvrzena primárním pramenem.
 *   </EditorNote>
 *
 *   <EditorNote level="todo">
 *     TODO: dohledat rok výroby v kronice obce.
 *   </EditorNote>
 *
 * Mechanismus:
 *   - Server: render do <aside class="editor-note">.
 *   - CSS (`global.css`): default `display: none` → anonymní návštěvník nic
 *     nevidí.
 *   - JS hydrace v Base.astro při autentizaci přes Cloudflare Access:
 *     `document.body.setAttribute('data-editor-mode', 'true')`. CSS pak
 *     `body[data-editor-mode] .editor-note { display: block }`.
 *   - Žádný server-side conditional rendering (Pages je static SSG) —
 *     visibility řeší pouze CSS + JS.
 *
 * Bezpečnost: poznámka je v HTML i pro anonymního uživatele (jen schovaná
 * CSS-em). NEVKLÁDEJ sem citlivá data (osobní údaje, neveřejné URL,
 * tokeny). Je to UI affordance pro pohodlí editora, ne security boundary.
 *
 * Levels:
 *   - 'info'  (default): mosazný okraj, neutrální tón
 *   - 'warn'  : copper okraj, varuje na nejistotu / chybu
 *   - 'todo'  : warm red, vyžaduje akci
 */

interface Props {
  /** Vizuální tón poznámky. */
  level?: 'info' | 'warn' | 'todo';
  /** Volitelný titulek (jinak se použije label podle level). */
  title?: string;
  /** Klíč pro JS resolve mechanismus — identifikuje typ note v rámci souboru
      (např. 'hodinar-stub', 'hellich-stub'). Default odvozeno z titulku. */
  noteKey?: string;
  /** Cesta k MDX souboru (pro JS resolve commit). Pokud není, button se neukáže. */
  sourceFile?: string;
}

const { level = 'info', title, noteKey, sourceFile } = Astro.props;
const defaultTitle: Record<string, string> = {
  info: 'Editorská poznámka',
  warn: 'Pozor — nejistota',
  todo: 'TODO',
};
const heading = title ?? defaultTitle[level];

// Default noteKey: slugify s transliterací diakritiky.
// Bez transliterace by „Pozor — nejistota" → „pozor--nejistota" a každý
// dvě default-info notes na téže stránce by sdílely stejný klíč
// (kolize v JS resolve regex). Lepší volat noteKey explicitně, ale
// fallback musí být injektivní v běžných případech.
function slugifyHeading(s: string): string {
  return s
    .normalize('NFD')                         // diakritika → kombinační znaky
    .replace(/[̀-ͯ]/g, '')           // odstranit kombinační znaky
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')               // ne-alfanumerické → '-'
    .replace(/^-+|-+$/g, '')                   // trim pomlček
    .replace(/-+/g, '-');                      // collapse multi -
}
const key = noteKey ?? (slugifyHeading(heading) || 'editor-note');
---
<aside class={`editor-note editor-note-${level}`}
       data-source-file={sourceFile}
       data-note-key={key}
       data-editor-only
       role="note"
       aria-label={heading}>
  <header class="editor-note-head">
    <span class="editor-note-icon" aria-hidden="true">
      {level === 'info' && <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>}
      {level === 'warn' && <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>}
      {level === 'todo' && <i class="fa-solid fa-square" aria-hidden="true"></i>}
    </span>
    <span class="editor-note-title">{heading}</span>
    <span class="editor-note-meta" aria-hidden="true">viditelné jen přihlášenému editorovi</span>
  </header>
  <div class="editor-note-body">
    <slot />
    {sourceFile && (
      <button type="button" class="editor-note-resolve" data-action="resolve-editor-note">
        <i class="fa-solid fa-check" aria-hidden="true"></i> Vyřízeno (smazat tuto poznámku z MDX)
      </button>
    )}
  </div>
</aside>
