---
import catalog from "../data/catalog.json";

import type { CatalogEntry as Entry } from '../data/catalog-types';

const entries: Entry[] = catalog as Entry[];

// Lehčí JSON pro client (jen co potřebujeme pro search).
// `g` (tagy) a `k` (searchKeywords) se v UI nezobrazují, jen Fuse je
// indexuje — najde tak článek i podle synonyma / cizího termínu.
const searchData = entries.map((e) => ({
  s: e.slug,
  t: e.title,
  c: e.category,
  e: e.excerpt.slice(0, 160),
  y: e.year,
  th: e.thumbnail,
  g: e.tags ?? [],
  k: e.searchKeywords ?? [],
}));

// Krátké labely kategorií — jediný zdroj pravdy (data/labels.ts).
// Předává se browser-side scriptu přes define:vars (řádek dole).
import { categoryLabel } from '../data/labels';
const CATEGORIES_USED = ['sbirka','konstrukce','projekty','virtualni-muzeum','muzea','zajimavosti','decin','vezni-hodiny','spolek','ostatni'] as const;
const categoryLabelsForClient = Object.fromEntries(
  CATEGORIES_USED.map((c) => [c, categoryLabel(c, 'short')])
);
---
<dialog id="search-modal" aria-label="Vyhledávání">
  <div class="search-modal-inner">
    <div class="search-input-wrap">
      <i class="fa-solid fa-magnifying-glass search-icon" aria-hidden="true"></i>
      <input
        id="search-input"
        type="search"
        placeholder="Hledej hodiny, projekty, osobnosti…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Vyhledávání"
      />
      <kbd class="search-kbd">esc</kbd>
    </div>
    <div class="search-mode-tabs" role="tablist" aria-label="Režim vyhledávání">
      <button data-mode="keyword" class="search-mode-tab is-active" role="tab" aria-selected="true">
        <i class="fa-solid fa-bullseye mode-icon" aria-hidden="true"></i>
        <span class="mode-label">Klíčová slova</span>
        <span class="mode-hint">přesná shoda</span>
      </button>
      <button data-mode="semantic" class="search-mode-tab" role="tab" aria-selected="false">
        <i class="fa-solid fa-wand-magic-sparkles mode-icon" aria-hidden="true"></i>
        <span class="mode-label">Sémanticky</span>
        <span class="mode-hint">významem</span>
      </button>
    </div>
    <div id="search-results" class="search-results" aria-live="polite">
      <p class="search-hint">
        Začni psát. <strong>Klíčová slova</strong> hledá fuzzy shodu v názvech a perexech 218 článků.
        <strong>Sémanticky</strong> najde věcně související obsah napříč 1008 stránkami webu — i když nemáš přesné slovo.
        <kbd>↵</kbd> otevře první výsledek, <kbd>esc</kbd> zavře.
      </p>
    </div>
  </div>
</dialog>

<style>
  dialog#search-modal {
    margin: auto;
    margin-top: 8vh;
    padding: 0;
    border: none;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 35%, transparent);
    border-radius: 2px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
    width: min(640px, 92vw);
    max-height: 80vh;
    color: var(--color-text);
    overflow: hidden;
  }
  dialog#search-modal::backdrop {
    background: rgba(10, 8, 7, 0.7);
    backdrop-filter: blur(4px);
  }
  .search-modal-inner {
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    background: var(--color-bg-deep);
  }
  .search-icon {
    font-size: 1.2rem;
    color: var(--color-brass);
    flex-shrink: 0;
  }
  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-text);
    padding: 0.25rem 0;
  }
  #search-input::placeholder {
    color: var(--color-text-muted);
    font-style: italic;
  }
  .search-kbd, kbd {
    font-family: ui-monospace, "SF Mono", monospace;
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    border-radius: 2px;
    color: var(--color-text-soft);
  }
  .search-results {
    overflow-y: auto;
    flex: 1;
  }
  .search-hint {
    padding: 1.5rem 1.5rem 2rem;
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }
  .search-result {
    display: flex;
    gap: 0.85rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 12%, transparent);
    text-decoration: none;
    color: var(--color-text);
    transition: background 100ms ease;
    border-bottom-color: color-mix(in srgb, var(--color-brass) 12%, transparent);
  }
  .search-result:hover, .search-result.is-active {
    background: var(--color-bg-deep);
  }
  .search-result-thumb {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }
  .search-result-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.15) saturate(0.85);
  }
  .search-result-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-brass);
    opacity: 0.4;
  }
  .search-result-body { flex: 1; min-width: 0; }
  .search-result-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-brass-bright);
    margin: 0 0 0.15rem;
    line-height: 1.25;
  }
  .search-result-meta {
    font-size: 0.75rem;
    color: var(--color-copper);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 0.25rem;
  }
  .search-result-excerpt {
    font-size: 0.85rem;
    color: var(--color-text-soft);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .search-result mark {
    background: color-mix(in srgb, var(--color-brass) 35%, transparent);
    color: var(--color-brass-bright);
    padding: 0 1px;
    border-radius: 1px;
  }
  .search-empty {
    padding: 2rem 1.5rem;
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
  }

  /* Tab switcher mezi Keyword (Fuse, instant) a Semantic (server, latency).
     Tab je sticky pod input boxem, takže scroll výsledků nezakryje volbu. */
  .search-mode-tabs {
    display: flex;
    gap: 0;
    background: var(--color-bg-deep);
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 20%, transparent);
    padding: 0 0.5rem;
  }
  .search-mode-tab {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.55rem 0.75rem;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05rem;
    border-bottom: 2px solid transparent;
    transition: color 120ms ease, border-color 120ms ease;
  }
  .search-mode-tab:hover {
    color: var(--color-text);
  }
  .search-mode-tab.is-active {
    color: var(--color-brass-bright);
    border-bottom-color: var(--color-brass);
  }
  .search-mode-tab .mode-icon {
    font-size: 1rem;
    line-height: 1;
  }
  .search-mode-tab .mode-label {
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .search-mode-tab .mode-hint {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
  .search-mode-tab.is-active .mode-hint {
    color: var(--color-copper);
  }

  /* Sémantické skóre badge — informuje uživatele jak silné je sémantické
     spojení mezi query a výsledkem (cosine similarity). */
  .search-result-score {
    margin-left: auto;
    flex-shrink: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--color-copper);
    padding: 0.1rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--color-copper) 25%, transparent);
    border-radius: 2px;
    align-self: center;
  }
  .search-result-loading {
    padding: 2rem 1.5rem;
    color: var(--color-text-muted);
    text-align: center;
    font-style: italic;
  }

  /* AI quota fallback banner — když Workers AI vrátil 429/kvótu,
     server spadl na fulltext. Subtle warning aby uživatel věděl,
     že tohle není sémantické vyhledávání (= horší recall na meaning). */
  .search-fallback-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.6rem 1.25rem;
    background: color-mix(in srgb, var(--color-bg-deep) 80%, var(--color-copper));
    border-bottom: 1px solid color-mix(in srgb, var(--color-copper) 35%, transparent);
    font-size: 0.82rem;
    color: var(--color-text-soft);
    line-height: 1.4;
  }
  .fallback-icon {
    color: var(--color-copper);
    font-size: 0.95rem;
    line-height: 1.4;
    flex-shrink: 0;
  }
  .fallback-text {
    flex: 1;
  }
  .search-result-loading::before {
    content: '';
    display: inline-block;
    width: 12px;
    height: 12px;
    border: 2px solid color-mix(in srgb, var(--color-brass) 40%, transparent);
    border-top-color: var(--color-brass);
    border-radius: 50%;
    margin-right: 0.5rem;
    vertical-align: middle;
    animation: spin 700ms linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script is:inline define:vars={{ searchData, categoryLabels: categoryLabelsForClient }}>
  let fuse = null;
  let activeIdx = -1;
  let lastResults = [];
  let mode = 'keyword';   // 'keyword' (Fuse, instant) | 'semantic' (server)
  let semanticAbort = null; // AbortController pro in-flight requesty

  const dialog = document.getElementById('search-modal');
  const input = document.getElementById('search-input');
  const resultsEl = document.getElementById('search-results');
  const tabs = document.querySelectorAll('.search-mode-tab');

  // categoryLabels předány z frontmatter přes define:vars — jediný zdroj pravdy.

  async function ensureFuse() {
    if (fuse) return fuse;
    const Fuse = (await import('fuse.js')).default;
    fuse = new Fuse(searchData, {
      keys: [
        { name: 't', weight: 2 },     // title (nejvyšší priorita)
        { name: 'e', weight: 1 },     // excerpt
        { name: 's', weight: 1.5 },   // slug
        { name: 'g', weight: 1.8 },   // tags (waist whitelist)
        { name: 'k', weight: 1.5 },   // searchKeywords (synonyma, cizí termíny)
      ],
      threshold: 0.35,
      includeMatches: true,
      minMatchCharLength: 2,
    });
    return fuse;
  }

  function highlight(text, matches) {
    if (!matches || !text) return text;
    const indices = matches.flatMap((m) => m.indices ?? []).filter((r) => r[1] - r[0] >= 1);
    if (!indices.length) return text;
    let out = '';
    let last = 0;
    indices.sort((a, b) => a[0] - b[0]);
    for (const [s, e] of indices) {
      if (s < last) continue;
      out += text.slice(last, s);
      out += '<mark>' + text.slice(s, e + 1) + '</mark>';
      last = e + 1;
    }
    out += text.slice(last);
    return out;
  }

  // Sjednocený render — bere normalizovaná data (`title`, `excerpt`,
  // `href`, `meta`, `score`, `thumb`, `matches`). Fuse i semantic
  // results se napřed normalizují do tohoto tvaru a teprve pak render.
  // `meta.mode` je server-reported režim (semantic|fulltext) — pokud
  // mode='fulltext', ukáže se info banner o AI fallbacku.
  function render(query, items, meta = {}) {
    if (!query) {
      const hint = mode === 'semantic'
        ? 'Sémantické vyhledávání hledá <em>významem</em> napříč 1008 stránkami webu — i bez přesného slova. Začni psát celou frázi nebo otázku.'
        : 'Začni psát. Klíčová slova hledá fuzzy shodu v názvech a perexech 218 článků. Pro hledání napříč všemi 1008 stránkami přepni na <strong>Sémanticky</strong>.';
      resultsEl.innerHTML = '<p class="search-hint">' + hint + ' <kbd>↵</kbd> otevře první výsledek.</p>';
      return;
    }
    if (items.length === 0) {
      resultsEl.innerHTML = '<p class="search-empty">Žádný výsledek pro <em>' + query.replace(/[<>&]/g, '') + '</em></p>';
      return;
    }
    const top = items.slice(0, 12);
    lastResults = top;
    // Banner pro AI fallback — server odhalil 429/quota a spadl na fulltext.
    // Uživatel by měl vědět, že výsledky nejsou sémantické (jiné skóre, jiný recall).
    const fallbackBanner = (meta.mode === 'fulltext')
      ? `<div class="search-fallback-banner" role="status">
           <span class="fallback-icon" aria-hidden="true">⚠</span>
           <span class="fallback-text">${meta.fallbackReason ?? 'AI kvóta vyčerpaná — fallback na fulltext.'}</span>
         </div>`
      : '';
    resultsEl.innerHTML = fallbackBanner + top.map((it, idx) => {
      const titleHtml = it.titleHtml ?? it.title;
      const excerptHtml = it.excerptHtml ?? it.excerpt;
      const meta = it.meta ?? '';
      const thumb = it.thumb
        ? `<div class="search-result-thumb"><img src="${it.thumb}" alt="" loading="lazy" /></div>`
        : `<div class="search-result-thumb"><div class="search-result-thumb-placeholder"><i class="fa-solid fa-clock" aria-hidden="true" style="font-size: 1.5rem;"></i></div></div>`;
      const scoreBadge = typeof it.score === 'number'
        ? `<span class="search-result-score" title="Sémantická podobnost (0–1)">${it.score.toFixed(2)}</span>`
        : '';
      return `<a class="search-result${idx === activeIdx ? ' is-active' : ''}" href="${it.href}" data-idx="${idx}">${thumb}<div class="search-result-body"><div class="search-result-meta">${meta}</div><div class="search-result-title">${titleHtml}</div><div class="search-result-excerpt">${excerptHtml}</div></div>${scoreBadge}</a>`;
    }).join('');
  }

  // Mapovač Fuse výsledku → unified shape.
  function mapFuseResult(r) {
    const item = r.item;
    const titleMatch = r.matches?.find((m) => m.key === 't');
    const excerptMatch = r.matches?.find((m) => m.key === 'e');
    const titleHtml = highlight(item.t, titleMatch ? [titleMatch] : []);
    const excerptHtml = highlight(item.e, excerptMatch ? [excerptMatch] : []);
    const cat = categoryLabels[item.c] ?? '';
    const year = item.y ? ' · ' + item.y : '';
    const newCats = ['sbirka','konstrukce','projekty','virtualni-muzeum','muzea','zajimavosti'];
    const href = newCats.includes(item.c) ? `/${item.c}/${item.s}` : `/clanky/${item.s}`;
    return {
      title: item.t,
      titleHtml,
      excerpt: item.e,
      excerptHtml,
      meta: cat + year,
      href,
      thumb: item.th,
    };
  }

  // Mapovač Semantic API odpovědi → unified shape.
  // Backend vrací { url, title, summary, collection, category, year, thumbnail, score, tags }.
  function mapSemanticResult(r) {
    const collLabels = {
      clanek: 'Článek',
      karta: 'Sbírková karta',
      hodinar: 'Medailon',
      soupis: 'Soupis věží',
      kronika: 'Kronika',
    };
    const collLabel = collLabels[r.collection] ?? r.collection;
    const catLabel = r.category ? (categoryLabels[r.category] ?? '') : '';
    const metaParts = [collLabel, catLabel, r.year].filter(Boolean);
    return {
      title: r.title,
      excerpt: r.summary || (r.tags?.length ? r.tags.slice(0, 5).join(' · ') : ''),
      meta: metaParts.join(' · '),
      href: r.url,
      thumb: r.thumbnail,
      score: r.score,
    };
  }

  // Aktivuje keyword (Fuse) tab + spustí Fuse search nad query.
  // Vrací Promise která resolve-ne až se výsledky vyrenderují, takže
  // se to dá použít jako fallback chain.
  async function switchToKeywordMode(q, banner) {
    mode = 'keyword';
    tabs.forEach((t) => {
      const active = t.getAttribute('data-mode') === 'keyword';
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    const f = await ensureFuse();
    const items = f.search(q).map(mapFuseResult);
    activeIdx = items.length > 0 ? 0 : -1;
    render(q, items, banner ? { mode: 'fulltext', fallbackReason: banner } : {});
  }

  async function runSemantic(q) {
    if (semanticAbort) semanticAbort.abort();
    semanticAbort = new AbortController();
    resultsEl.innerHTML = '<p class="search-result-loading">Sémanticky prohledávám 1008 stránek…</p>';
    let r, data;
    try {
      r = await fetch(`/api/search/semantic?q=${encodeURIComponent(q)}&limit=15`, {
        signal: semanticAbort.signal,
      });
      data = await r.json().catch(() => ({}));
    } catch (err) {
      if (err.name === 'AbortError') return; // Newer query si přepíše
      console.warn('Semantic search network error, falling back to keyword:', err);
      await switchToKeywordMode(q,
        'Sémantické vyhledávání nedostupné — používám klíčová slova.');
      return;
    }

    // 503 = index ještě nebyl vygenerovaný (admin nezbuildoval). Auto-fallback
    // na keyword bez user-action — uživatel vidí výsledky + decentní banner.
    if (r.status === 503) {
      console.warn('Semantic index not yet built:', data.error);
      await switchToKeywordMode(q,
        'Sémantický index zatím není připravený — používám klíčová slova.');
      return;
    }

    if (!r.ok) {
      // Ostatní chyby (5xx, 401, 429) — zkus parse server-side message.
      const msg = data.error || 'Server odpověděl ' + r.status + '.';
      resultsEl.innerHTML =
        '<p class="search-empty">Sémantické vyhledávání selhalo: ' + msg +
        ' Zkus přepnout na <strong>Klíčová slova</strong>.</p>';
      return;
    }

    const items = (data.results ?? []).map(mapSemanticResult);
    activeIdx = items.length > 0 ? 0 : -1;
    render(q, items, { mode: data.mode, fallbackReason: data.fallback_reason });
  }

  let timer;
  input.addEventListener('input', async () => {
    clearTimeout(timer);
    const q = input.value.trim();
    if (q.length < 2) {
      activeIdx = -1;
      lastResults = [];
      render('', []);
      return;
    }
    if (mode === 'keyword') {
      timer = setTimeout(async () => {
        const f = await ensureFuse();
        const items = f.search(q).map(mapFuseResult);
        activeIdx = items.length > 0 ? 0 : -1;
        render(q, items);
      }, 80);
    } else {
      // Semantic: delší debounce (500ms) — server roundtrip + AI inference
      // má smysl jen pro stable query, ne každý keystroke.
      timer = setTimeout(() => runSemantic(q), 500);
    }
  });

  // Tab switching
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const newMode = tab.getAttribute('data-mode');
      if (newMode === mode) return;
      mode = newMode;
      tabs.forEach((t) => {
        const active = t.getAttribute('data-mode') === mode;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      // Refresh: pokud má input query, znovu spusť v novém režimu.
      const q = input.value.trim();
      activeIdx = -1;
      lastResults = [];
      if (q.length >= 2) {
        if (mode === 'semantic') {
          runSemantic(q);
        } else {
          ensureFuse().then((f) => {
            const items = f.search(q).map(mapFuseResult);
            activeIdx = items.length > 0 ? 0 : -1;
            render(q, items);
          });
        }
      } else {
        render('', []);
      }
      input.focus();
    });
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && lastResults[activeIdx]) {
      e.preventDefault();
      // Unified shape — vždy `.href` na položce.
      window.location.href = lastResults[activeIdx].href;
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, lastResults.length - 1);
      render(input.value.trim(), lastResults);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, 0);
      render(input.value.trim(), lastResults);
    }
  });

  // Otevřít modal: Cmd/Ctrl+K, /, klik na trigger
  function openModal() {
    if (!dialog.open) dialog.showModal();
    setTimeout(() => input.focus(), 30);
  }
  function closeModal() {
    if (dialog.open) dialog.close();
    input.value = '';
    activeIdx = -1;
    lastResults = [];
    render('', []);
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    } else if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      openModal();
    } else if (e.key === 'Escape' && dialog.open) {
      closeModal();
    }
  });

  // Triggery (data-search-trigger v navu)
  document.querySelectorAll('[data-search-trigger]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });

  // Zavři modal po kliknutí na výsledek
  resultsEl.addEventListener('click', (e) => {
    const link = e.target.closest('.search-result');
    if (link) closeModal();
  });

  // Klik mimo content = zavři
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) closeModal();
  });
</script>
