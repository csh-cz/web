---
/**
 * Schema.org JSON-LD strukturovaná data.
 *
 * Injectne <script type="application/ld+json"> s předaným payloadem.
 * Pole `data` může být jeden objekt nebo pole objektů (více schémat na stránku).
 *
 * Validace: https://search.google.com/test/rich-results
 */
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---
{items.map((item) => (
  <script type="application/ld+json" set:html={JSON.stringify(item)} />
))}
