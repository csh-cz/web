---
/**
 * RedakceReportsPanel — panel s editor reports na /redakce/ dashboardu.
 *
 * SSG renderuje placeholder (loading state). Klient po načtení stránky
 * fetchne `/api/admin/reports` (CF Access protected) a vyrenderuje skutečný
 * seznam open reportů.
 *
 * Pro non-editor visitors panel zůstane skrytý (component se renderuje
 * jen v sekci ${redakce}, kterou hydration JS odhalí jen pro editor mode).
 *
 * UI:
 *   - Header: počet open reportů, tlačítko "Obnovit"
 *   - Empty state: "Žádné nové reporty 🎉"
 *   - List: každý report jako card s
 *     - Title + GitHub issue číslo (link)
 *     - Typ problému + datum + reporter email
 *     - URL stránky (link, otevře v novém tabu)
 *     - Description excerpt + expand toggle
 *     - Action buttons: "Otevřít stránku", "Otevřít na GitHubu"
 */
---

<section class="redakce-section redakce-priority-high" id="section-reports">
  <header class="redakce-section-header">
    <span class="redakce-section-icon" aria-hidden="true">
      <i class="fa-solid fa-bug" aria-hidden="true"></i>
    </span>
    <h2 class="redakce-section-title">Hlášení od editorů</h2>
    <span class="redakce-section-count" id="reports-count">…</span>
    <button class="reports-refresh" id="reports-refresh" type="button" title="Obnovit seznam">
      <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
    </button>
  </header>
  <p class="redakce-section-desc">
    Open reporty z formuláře „Nahlásit problém" (FAB tlačítko vpravo dole na všech
    stránkách). Vytváří se jako GitHub Issue s labelem <code>web-bug</code>.
    Po opravě commit s textem <code>Closes #N</code> uzavře issue automaticky.
  </p>

  <div id="reports-content" class="reports-content">
    <p class="reports-loading">
      <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
      Načítám reporty…
    </p>
  </div>
</section>

<style>
  .reports-refresh {
    margin-left: auto;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    border-radius: 2px;
    padding: 0.3rem 0.55rem;
    cursor: pointer;
    color: var(--color-brass);
    font-size: 0.85rem;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .reports-refresh:hover {
    border-color: var(--color-brass);
    color: var(--color-brass-bright);
  }
  .reports-refresh.is-loading i {
    animation: spin-refresh 700ms linear infinite;
  }
  @keyframes spin-refresh { to { transform: rotate(360deg); } }

  .reports-content {
    margin-top: 0.5rem;
  }

  .reports-loading,
  .reports-empty,
  .reports-error {
    padding: 1rem 0;
    color: var(--color-text-muted);
    font-style: italic;
  }
  .reports-empty {
    color: var(--color-brass-bright);
    font-weight: 500;
  }
  .reports-error {
    color: var(--color-copper);
  }

  .reports-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
  }
  .report-card {
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-left: 3px solid var(--color-copper);
    border-radius: 2px;
    padding: 0.85rem 1rem;
  }
  .report-card-header {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .report-issue-num {
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .report-issue-num a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-brass) 35%, transparent);
  }
  .report-issue-num a:hover { color: var(--color-brass-bright); }
  .report-title {
    font-family: var(--font-serif);
    font-weight: 500;
    color: var(--color-brass-bright);
    font-size: 1rem;
    margin: 0;
    flex: 1;
    min-width: 0;
  }
  .report-type-badge {
    display: inline-block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-copper);
    padding: 0.1rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-copper) 30%, transparent);
    border-radius: 2px;
  }
  .report-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.78rem;
    color: var(--color-text-soft);
    margin-bottom: 0.5rem;
  }
  .report-meta i {
    margin-right: 0.3rem;
    opacity: 0.6;
  }
  .report-url-link {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--color-brass);
    margin-bottom: 0.5rem;
    word-break: break-all;
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-brass) 35%, transparent);
  }
  .report-url-link:hover { color: var(--color-brass-bright); }

  .report-description {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0.5rem 0;
    white-space: pre-wrap;
    background: var(--color-bg-deep);
    padding: 0.5rem 0.75rem;
    border-left: 2px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
  }

  .report-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .report-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    padding: 0.35rem 0.7rem;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
    color: var(--color-brass);
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .report-action-btn:hover {
    border-color: var(--color-brass);
    color: var(--color-brass-bright);
  }

  .report-extra-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }
  .report-label-pill {
    font-size: 0.68rem;
    padding: 0.05rem 0.4rem;
    border-radius: 8px;
    font-weight: 500;
    color: white;
  }
</style>

<script is:inline>
  (function () {
    const countEl = document.getElementById('reports-count');
    const contentEl = document.getElementById('reports-content');
    const refreshBtn = document.getElementById('reports-refresh');
    if (!countEl || !contentEl || !refreshBtn) return;

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      });
    }

    function fmtDate(iso) {
      if (!iso) return '';
      try {
        const d = new Date(iso);
        return d.toLocaleString('cs-CZ', { dateStyle: 'short', timeStyle: 'short' });
      } catch { return iso; }
    }

    function renderReport(r) {
      const p = r.parsed || {};
      const desc = p.description || (r.bodyRaw && r.bodyRaw.length < 600 ? r.bodyRaw : '');
      const labelPills = (r.extraLabels || []).map(function (l) {
        return '<span class="report-label-pill" style="background: #' + escapeHtml(l.color) +
               '">' + escapeHtml(l.name) + '</span>';
      }).join('');

      return '<li class="report-card">' +
        '<header class="report-card-header">' +
          '<span class="report-issue-num"><a href="' + escapeHtml(r.htmlUrl) +
            '" target="_blank" rel="noopener">#' + r.number + '</a></span>' +
          '<h3 class="report-title">' + escapeHtml(r.title) + '</h3>' +
          (p.problemType
            ? '<span class="report-type-badge">' + escapeHtml(p.problemType.replace(/\s*\(`[^`]+`\)\s*$/, '')) + '</span>'
            : '') +
        '</header>' +
        '<div class="report-meta">' +
          (p.reporter
            ? '<span><i class="fa-solid fa-user" aria-hidden="true"></i>' + escapeHtml(p.reporter) + '</span>'
            : '') +
          '<span><i class="fa-solid fa-calendar" aria-hidden="true"></i>' + fmtDate(r.createdAt) + '</span>' +
          (r.comments > 0
            ? '<span><i class="fa-solid fa-comment" aria-hidden="true"></i>' + r.comments + '</span>'
            : '') +
        '</div>' +
        (p.url
          ? '<a class="report-url-link" href="' + escapeHtml(p.url) + '" target="_blank" rel="noopener">' +
            '<i class="fa-solid fa-link" aria-hidden="true"></i> ' + escapeHtml(p.url) + '</a>'
          : '') +
        (desc ? '<div class="report-description">' + escapeHtml(desc) + '</div>' : '') +
        (labelPills ? '<div class="report-extra-labels">' + labelPills + '</div>' : '') +
        '<div class="report-actions">' +
          (p.url
            ? '<a class="report-action-btn" href="' + escapeHtml(p.url) + '" target="_blank" rel="noopener">' +
              '<i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> Otevřít stránku</a>'
            : '') +
          '<a class="report-action-btn" href="' + escapeHtml(r.htmlUrl) + '" target="_blank" rel="noopener">' +
            '<i class="fa-brands fa-github" aria-hidden="true"></i> Otevřít na GitHubu</a>' +
        '</div>' +
      '</li>';
    }

    async function loadReports() {
      refreshBtn.classList.add('is-loading');
      countEl.textContent = '…';
      contentEl.innerHTML = '<p class="reports-loading">' +
        '<i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Načítám reporty…</p>';

      try {
        const r = await fetch('/api/admin/reports', { credentials: 'include' });
        if (r.status === 401) {
          countEl.textContent = '?';
          contentEl.innerHTML = '<p class="reports-error">' +
            'Vyžaduje přihlášení editora. Zkus se přihlásit (kliknout na avatar v navu).</p>';
          return;
        }
        if (!r.ok) {
          const data = await r.json().catch(function () { return {}; });
          throw new Error(data.error || ('HTTP ' + r.status));
        }
        const data = await r.json();
        const reports = data.reports || [];
        countEl.textContent = reports.length;
        if (reports.length === 0) {
          contentEl.innerHTML = '<p class="reports-empty">' +
            '<i class="fa-solid fa-circle-check" aria-hidden="true"></i> Žádné otevřené reporty.</p>';
          return;
        }
        contentEl.innerHTML = '<ul class="reports-list">' + reports.map(renderReport).join('') + '</ul>';
      } catch (err) {
        countEl.textContent = '!';
        contentEl.innerHTML = '<p class="reports-error">' +
          'Načtení selhalo: ' + escapeHtml(err.message || 'neznámá chyba') + '</p>';
      } finally {
        refreshBtn.classList.remove('is-loading');
      }
    }

    refreshBtn.addEventListener('click', loadReports);

    // První načtení — počkej na editor mode hydration (může chvíli trvat).
    // Použijeme polling — pokud body[data-editor-mode] není set do 5 s,
    // ukážeme login prompt.
    function tryLoad() {
      if (document.body.hasAttribute('data-editor-mode')) {
        loadReports();
      }
    }

    // Initial check + retry after hydration
    if (document.body.hasAttribute('data-editor-mode')) {
      loadReports();
    } else {
      // Polling — Base.astro hydrate může trvat ~200-500ms
      let tries = 0;
      const interval = setInterval(function () {
        tries++;
        if (document.body.hasAttribute('data-editor-mode')) {
          clearInterval(interval);
          loadReports();
        } else if (tries > 25) {  // 5 s
          clearInterval(interval);
          countEl.textContent = '?';
          contentEl.innerHTML = '<p class="reports-error">' +
            'Tento panel je viditelný jen pro přihlášené editory. Přihlas se přes avatar v navu.</p>';
        }
      }, 200);
    }
  })();
</script>
