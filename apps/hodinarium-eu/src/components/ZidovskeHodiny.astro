---
/**
 * Živý ciferník Židovské radnice — hebrejské hodiny jdoucí "proti
 * směru hodinových ručiček", větší ručička = minuty, menší = hodiny.
 *
 * Nahrazuje původní iframe na hodinarium.eu/zidovske/zid.php.
 * Logika rotace mirrorovaná z Petrova zid.php (server-side PHP
 * generoval inline rotate() v CSS):
 *   - transform-origin = default (50% 50%, střed image)
 *   - hodinova.gif (33×103) je nakreslena symetricky kolem pivotu,
 *     position absolute top:167 left:212 v původním 500×362 canvasu →
 *     pin v (228.5, 218.5) px = (45.7%, 60.36%) canvasu
 *   - minutova.gif (33×67) stejný pivot, top:185 left:212
 *   - žádný 180° offset, žádný translateX — Petrovy úhly:
 *       hodinova = -((h%12)*30 + m*0.5)
 *       minutova = -(m*6)
 *
 * Procentuální pozice + width:6.6% + aspect-ratio dělá ručičky
 * responzivními bez ztráty správného umístění pinu.
 *
 * Obrázky jsou v /public/img/zidovske/clock/ (původní podklad +
 * dvě GIF ručičky) — servírují se z R2 přes cdnUrl (A.26).
 */
import { cdnUrl } from '../utils/cdnImage';
---
<figure class="zidovske-hodiny" aria-label="Živý ciferník Židovské radnice">
  <div class="zidovske-hodiny-canvas">
    <img class="zidovske-podklad" src={cdnUrl("/img/zidovske/clock/podklad.jpg")} alt="Hebrejský ciferník Židovské radnice" width="500" height="362" loading="lazy" decoding="async" />
    <span class="zidovske-attribution"><strong>www.muzeumhodin.info</strong></span>
    <time class="zidovske-cas" data-clock-time>00:00</time>
    <img class="zidovske-rucka zidovske-hodinova" data-clock-hour src={cdnUrl("/img/zidovske/clock/hodinova.gif")} alt="" width="33" height="103" />
    <img class="zidovske-rucka zidovske-minutova" data-clock-minute src={cdnUrl("/img/zidovske/clock/minutova.gif")} alt="" width="33" height="67" />
  </div>
  <figcaption><strong>Ručičky hodin ukazují stále správný čas.</strong> Vytvořeno pro tento server.</figcaption>
</figure>

<style>
  .zidovske-hodiny {
    margin: 1.5rem auto;
    max-width: 500px;
  }

  .zidovske-hodiny-canvas {
    position: relative;
    width: 500px;
    max-width: 100%;
    aspect-ratio: 500 / 362;
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
    overflow: hidden;
    background: var(--color-bg-deep);
  }

  .zidovske-podklad {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .zidovske-attribution {
    position: absolute;
    top: 79%;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 600;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }

  .zidovske-cas {
    position: absolute;
    top: 5%;
    left: 8%;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text);
    background: rgba(0, 0, 0, 0.55);
    padding: 0.1em 0.4em;
    border-radius: 2px;
    pointer-events: none;
  }

  /* Ručičky — pozice mirrorovaná z Petrova zid.php (top/left v px
     na 500×362 canvasu, převedené na %). Width v % aby ručička
     scalovala s podkladem. transform-origin DEFAULT (50% 50%) =
     střed image, jako v Petrově PHP — image je nakreslená symetricky
     kolem pinu. */
  .zidovske-rucka {
    position: absolute;
    width: 6.6%; /* 33 / 500 */
    height: auto;
    transition: transform 200ms ease-out;
    pointer-events: none;
  }

  /* Hodinová ručička — kratší (33×103), menší ze dvou (rarita: hod = malá). */
  .zidovske-hodinova {
    aspect-ratio: 33 / 103;
    top: 46.13%;  /* 167 / 362 */
    left: 42.4%;  /* 212 / 500 */
  }

  /* Minutová ručička — větší (33×67), umístění mírně níž. */
  .zidovske-minutova {
    aspect-ratio: 33 / 67;
    top: 51.10%;  /* 185 / 362 */
    left: 42.4%;  /* 212 / 500 */
  }

  @media (max-width: 540px) {
    .zidovske-attribution { font-size: 0.7rem; }
    .zidovske-cas { font-size: 1.1rem; }
  }
</style>

<script>
  /**
   * Hebrejské hodiny: ručičky se otáčejí PROTI směru hodinových
   * ručiček, hodinová ručička je MENŠÍ než minutová (zaměnené proti
   * konvenci, viz raritu radničního ciferníku).
   *
   * Úhly mirrorované z Petrova zid.php — transform-origin defaultně
   * uprostřed image, takže žádný offset, jen čistý rotate(deg).
   */
  function tick() {
    const els = {
      time: document.querySelector('[data-clock-time]'),
      hour: document.querySelector('[data-clock-hour]'),
      min: document.querySelector('[data-clock-minute]'),
    };
    if (!els.time || !els.hour || !els.min) return;

    const now = new Date();
    const h = now.getHours();
    const m = now.getMinutes();

    els.time.textContent =
      String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0');

    const hourDeg = -((h % 12) * 30 + m * 0.5);
    const minDeg = -(m * 6);

    (els.hour as HTMLElement).style.transform = `rotate(${hourDeg}deg)`;
    (els.min as HTMLElement).style.transform = `rotate(${minDeg}deg)`;
  }

  tick();
  setInterval(tick, 30_000);
</script>
