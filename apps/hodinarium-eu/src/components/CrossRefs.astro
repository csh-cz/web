---
/**
 * <CrossRefs> — render forward + reverse křížových odkazů na detail page.
 *
 * Forward refs: z frontmatter `entry.data.crossRefs` (deklarováno autorem).
 * Reverse refs: z build-time generovaného `data/cross-ref-reverse.json`
 * (PBI X.2, generated by `pnpm refs:cross`).
 *
 * Komponenta zobrazí dvě sekce:
 *   1. SOUVISÍ S       — forward refs grouped by target type
 *   2. POUŽITO V       — reverse refs grouped by source type
 *
 * Reverse sekce se neukáže pro „leaf" typy (clanky, karty, soupis,
 * kronika) — ty bývají typicky source, ne target. Zobrazí se hlavně u
 * `kroky`, `hodinari`, `slovnik` (= věci, na které se odkazuje z jiných).
 * Toggle přes prop `showReverse` (default true).
 *
 * Použití (v každém detail layoutu):
 *   <CrossRefs
 *     refs={entry.data.crossRefs}
 *     selfType="karty"
 *     selfSlug={entry.data.slug}
 *   />
 *
 * Resolve href: pro každý target type víme URL prefix
 * (např. 'kroky' → /kroky/<slug>, 'karty' → /sbirka/karta/<slug>).
 * Pokud cílový entry nemá title v catalog/data, fallback je sám slug.
 */
import reverseMap from '../data/cross-ref-reverse.json';
import catalog from '../data/catalog.json';
import { getCollection } from 'astro:content';
import Card from './Card.astro';
import { clanekHref } from '../data/url-helpers';
import type { CatalogEntry } from '../data/catalog-types';

const catalogEntries = catalog as CatalogEntry[];
const catalogBySlug = new Map(catalogEntries.map((e) => [e.slug, e]));

interface CrossRefsObj {
  kroky?: string[];
  hodinari?: string[];
  karty?: string[];
  clanky?: string[];
  soupis?: string[];
  slovnik?: string[];
  kronika?: string[];
}

interface Props {
  refs?: CrossRefsObj | null;
  selfType: 'kroky' | 'hodinari' | 'karty' | 'clanky' | 'soupis' | 'slovnik' | 'kronika';
  selfSlug: string;
  showReverse?: boolean;
}

const { refs, selfType, selfSlug, showReverse = true } = Astro.props as Props;

// Reverse refs pro tento entry (pokud existují)
const reverseForThis = (reverseMap as Record<string, Record<string, Record<string, string[]>>>)[selfType]?.[selfSlug] ?? {};

// Resolve target → { title, href } pro každý typ. Načteme pouze relevantní
// collections (jen ty, kde refs/reverse ukazuje), abychom neotvírali zbytečně.
const TYPE_META: Record<string, { label: string; icon: string; href: (slug: string) => string }> = {
  kroky:    { label: 'Krok',     icon: '⚙', href: (s) => `/kroky/${s}` },
  hodinari: { label: 'Hodinář',  icon: '👤', href: (s) => `/hodinari/${s}` },
  karty:    { label: 'Sbírka',   icon: '🏛', href: (s) => `/sbirka/karta/${s}` },
  clanky:   { label: 'Článek',   icon: '📄', href: (s) => `/clanky/${s}` },
  soupis:   { label: 'Soupis',   icon: '🗼', href: (s) => `/soupis-veznich-hodin/${s}` },
  slovnik:  { label: 'Slovník',  icon: '📕', href: (s) => `/slovnik/${s}` },
  kronika:  { label: 'Kronika',  icon: '🗓', href: (s) => `/kronika/${s}` },
};

// Načteme názvy entries pro pretty display. Lookup map: type → slug → title.
// Optimalizace: nahraj jen typy, které opravdu potřebujeme renderovat.
const neededTypes = new Set<string>();
if (refs) {
  for (const t of Object.keys(refs)) {
    if ((refs as Record<string, string[] | undefined>)[t]?.length) neededTypes.add(t);
  }
}
for (const t of Object.keys(reverseForThis)) {
  if (reverseForThis[t]?.length) neededTypes.add(t);
}

const titleMap: Record<string, Record<string, string>> = {};

async function loadTitles(type: string) {
  if (titleMap[type]) return;
  titleMap[type] = {};
  // Karty + clanky obojí z 'clanky' Astro collection (podsekce filter na použití)
  if (type === 'karty' || type === 'clanky') {
    if (titleMap.__hodinariumEu) {
      // hodinarium-eu collection již načtena pro druhý typ, reuse
    } else {
      const all = await getCollection('clanky');
      titleMap.__hodinariumEu = {};
      for (const e of all) {
        titleMap.__hodinariumEu[e.data.slug] = e.data.title;
      }
    }
    titleMap[type] = titleMap.__hodinariumEu;
    return;
  }
  // 1-to-1 mapping na Astro collection
  const collMap: Record<string, string> = {
    kroky: 'kroky',
    hodinari: 'hodinari',
    soupis: 'soupis-veznich-hodin',
    slovnik: 'slovnik',
    kronika: 'kronika',
  };
  const coll = collMap[type];
  if (!coll) return;
  const all = await getCollection(coll as never);
  for (const e of all) {
    // @ts-expect-error - heterogeneous collection types
    titleMap[type][e.data.slug] = e.data.title;
  }
}

await Promise.all([...neededTypes].map(loadTitles));

function resolveTitle(type: string, slug: string): string {
  return titleMap[type]?.[slug] ?? slug;
}

// Build groups for rendering
type Group = { type: string; meta: typeof TYPE_META[string]; items: { slug: string; title: string }[] };

const forwardGroups: Group[] = [];
if (refs) {
  for (const type of Object.keys(TYPE_META)) {
    const slugs = (refs as Record<string, string[] | undefined>)[type];
    if (!slugs?.length) continue;
    forwardGroups.push({
      type,
      meta: TYPE_META[type],
      items: slugs.map((s) => ({ slug: s, title: resolveTitle(type, s) })),
    });
  }
}

const reverseGroups: Group[] = [];
if (showReverse) {
  for (const type of Object.keys(TYPE_META)) {
    const slugs = reverseForThis[type];
    if (!slugs?.length) continue;
    reverseGroups.push({
      type,
      meta: TYPE_META[type],
      items: slugs.map((s) => ({ slug: s, title: resolveTitle(type, s) })),
    });
  }
}

const hasForward = forwardGroups.length > 0;
const hasReverse = reverseGroups.length > 0;
---
{(hasForward || hasReverse) && (
  <aside class="cross-refs" aria-labelledby="cross-refs-heading">
    <h2 id="cross-refs-heading" class="visually-hidden">Křížové odkazy</h2>

    {hasForward && (
      <section class="cross-refs-section" aria-labelledby="cross-refs-forward">
        <h3 id="cross-refs-forward" class="cross-refs-section-heading">Souvisí s</h3>

        {/* Content groups (clanky + karty) renderujeme jako card grid —
            tyto jsou plnohodnotný obsahový kontext, prominent UI.
            Ostatní groups (kroky, hodinari, slovnik, soupis, kronika) =
            metadata-like text list s typed ikonami. */}
        {(() => {
          const cardGroups = forwardGroups.filter((g) => g.type === 'clanky' || g.type === 'karty');
          const listGroups = forwardGroups.filter((g) => g.type !== 'clanky' && g.type !== 'karty');
          return (
            <>
              {cardGroups.map((g) => (
                <div class="cross-refs-cards-wrap">
                  <p class="cross-refs-cards-eyebrow">
                    <span class="cross-refs-icon" aria-hidden="true">{g.meta.icon}</span>
                    {g.type === 'karty' ? 'Sbírkové předměty' : 'Související články'}
                    {g.items.length > 1 ? ` (${g.items.length})` : ''}
                  </p>
                  <div class="cross-refs-cards-grid">
                    {g.items.map((it) => {
                      const e = catalogBySlug.get(it.slug);
                      if (!e) {
                        return (
                          <a class="cross-refs-card-fallback" href={g.meta.href(it.slug)}>
                            <span class="cross-refs-card-fallback-title">{it.title}</span>
                          </a>
                        );
                      }
                      return (
                        <Card
                          href={clanekHref(e)}
                          title={e.title}
                          excerpt={e.excerpt}
                          thumbnail={e.thumbnail}
                          category={e.category}
                          lastModified={e.lastModified}
                          imageCount={e.imageCount}
                          vyrobce={e.vyrobce}
                        />
                      );
                    })}
                  </div>
                </div>
              ))}

              {listGroups.length > 0 && (
                <dl class="cross-refs-groups">
                  {listGroups.map((g) => (
                    <div class="cross-refs-group">
                      <dt class="cross-refs-group-label">
                        <span class="cross-refs-icon" aria-hidden="true">{g.meta.icon}</span>
                        {g.meta.label}{g.items.length > 1 ? ` (${g.items.length})` : ''}
                      </dt>
                      <dd>
                        <ul class="cross-refs-list">
                          {g.items.map((it) => (
                            <li>
                              <a href={g.meta.href(it.slug)}>{it.title}</a>
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
            </>
          );
        })()}
      </section>
    )}

    {hasReverse && (
      <section class="cross-refs-section" aria-labelledby="cross-refs-reverse">
        <h3 id="cross-refs-reverse" class="cross-refs-section-heading">Použito v</h3>
        <dl class="cross-refs-groups">
          {reverseGroups.map((g) => (
            <div class="cross-refs-group">
              <dt class="cross-refs-group-label">
                <span class="cross-refs-icon" aria-hidden="true">{g.meta.icon}</span>
                {g.meta.label} ({g.items.length})
              </dt>
              <dd>
                <ul class="cross-refs-list">
                  {g.items.slice(0, 10).map((it) => (
                    <li>
                      <a href={g.meta.href(it.slug)}>{it.title}</a>
                    </li>
                  ))}
                  {g.items.length > 10 && (
                    <li class="cross-refs-overflow">
                      + {g.items.length - 10} dalších
                    </li>
                  )}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </aside>
)}

<style>
  .cross-refs {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }
  .cross-refs-section + .cross-refs-section {
    margin-top: 2rem;
  }
  .cross-refs-section-heading {
    font-family: var(--font-serif);
    font-size: 0.78rem !important;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0 0 1.25rem !important;
  }
  .cross-refs-groups {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }
  .cross-refs-group {
    display: grid;
    grid-template-columns: minmax(7rem, 9rem) 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  .cross-refs-group-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .cross-refs-icon {
    font-size: 0.95rem;
    line-height: 1;
  }
  .cross-refs-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
  }
  .cross-refs-list li {
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .cross-refs-list li + li::before {
    content: '· ';
    color: var(--color-brass);
    opacity: 0.5;
    margin-right: 0.15rem;
  }
  .cross-refs-list a {
    color: var(--color-brass-bright);
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-brass) 40%, transparent);
  }
  .cross-refs-list a:hover {
    border-bottom-style: solid;
  }
  .cross-refs-overflow {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Card grid pro clanky/karty groups — visually prominent než text list. */
  .cross-refs-cards-wrap {
    margin: 0 0 1.5rem;
  }
  .cross-refs-cards-eyebrow {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0 0 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .cross-refs-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1rem;
  }
  .cross-refs-card-fallback {
    display: block;
    padding: 0.85rem 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-brass-bright);
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
  }
  .cross-refs-card-fallback:hover {
    border-color: var(--color-brass);
  }
  .cross-refs-card-fallback-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
  }

  @media (max-width: 600px) {
    .cross-refs-group {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
