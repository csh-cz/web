---
/**
 * Živý monitor rubidiového oscilátoru PRS10 vystaveného v Hodináriu.
 *
 * Nahrazuje původní iframe (PRS2.php). Fetchuje plain-text endpoint
 * https://www.orloj.eu/PRS10_text.php (CORS *), parsuje semicolon-separated
 * řádek z RS-232 monitoru a renderuje nativně.
 *
 * Server čte /linka/PRS10.dat, do kterého WEMOS jednotka přes RS-232
 * zapisuje statistiku z PRS10. Klient pollne každých 5 s; pokud se
 * hodnota nezmění víc než 30 s, upozorní (zdroj možná tichý).
 */
const ENDPOINT = 'https://www.orloj.eu/PRS10_text.php';
---
<figure class="prs10-live" aria-label="Živý monitor rubidiového oscilátoru PRS10">
  <header class="prs10-live-header">
    <h3 class="prs10-live-title">PRS10 — živý monitor</h3>
    <p class="prs10-live-status" data-prs10-status data-state="loading">Načítám…</p>
  </header>
  <div class="prs10-live-body" data-prs10-body hidden>
    <dl class="prs10-live-id">
      <div><dt>Model</dt><dd data-prs10-model>—</dd></div>
      <div><dt>S/N</dt><dd data-prs10-sn>—</dd></div>
    </dl>
    <details class="prs10-live-details">
      <summary>Surová data (<span data-prs10-count>0</span> hodnot)</summary>
      <table class="prs10-live-table">
        <thead><tr><th>#</th><th>Hodnota</th></tr></thead>
        <tbody data-prs10-table></tbody>
      </table>
    </details>
  </div>
  <p class="prs10-live-source">
    Zdroj: <a href={ENDPOINT} rel="noopener" target="_blank">www.orloj.eu/PRS10_text.php</a>
    · polling 5 s · program: Petr Král.
  </p>
</figure>

<style>
  .prs10-live {
    margin: 1.5rem auto;
    max-width: 640px;
    padding: 1rem 1.25rem;
    background: var(--color-bg-deep);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
  }
  .prs10-live-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .prs10-live-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-brass-bright);
    margin: 0;
    font-weight: 500;
  }
  .prs10-live-status {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .prs10-live-status[data-state="ok"] { color: var(--color-verdigris, #6aa78a); }
  .prs10-live-status[data-state="stale"] { color: var(--color-copper); }
  .prs10-live-status[data-state="error"] { color: #c97373; }

  .prs10-live-id {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.3rem 1.25rem;
    margin: 0 0 1rem;
  }
  .prs10-live-id div { display: contents; }
  .prs10-live-id dt {
    color: var(--color-copper);
    margin: 0;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    align-self: center;
  }
  .prs10-live-id dd {
    color: var(--color-brass-bright);
    margin: 0;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.95rem;
  }

  .prs10-live-details summary {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.25rem 0;
  }
  .prs10-live-details summary:hover { color: var(--color-brass-bright); }
  .prs10-live-table {
    margin-top: 0.5rem;
    width: 100%;
    border-collapse: collapse;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.82rem;
  }
  .prs10-live-table th,
  .prs10-live-table td {
    padding: 0.22rem 0.6rem;
    text-align: left;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 12%, transparent);
  }
  .prs10-live-table th {
    color: var(--color-copper);
    font-weight: 500;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .prs10-live-table td:first-child {
    color: var(--color-text-muted);
    width: 3em;
    text-align: right;
  }
  .prs10-live-table td:last-child { color: var(--color-text); }

  .prs10-live-source {
    margin: 1rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  .prs10-live-source a { color: var(--color-brass-bright); }
</style>

<script is:inline define:vars={{ ENDPOINT }}>
  (function () {
    const root = document.querySelector('.prs10-live');
    if (!root) return;
    const el = {
      status: root.querySelector('[data-prs10-status]'),
      body: root.querySelector('[data-prs10-body]'),
      model: root.querySelector('[data-prs10-model]'),
      sn: root.querySelector('[data-prs10-sn]'),
      table: root.querySelector('[data-prs10-table]'),
      count: root.querySelector('[data-prs10-count]'),
    };

    let lastPayload = '';
    let lastChange = Date.now();

    async function poll() {
      try {
        const r = await fetch(ENDPOINT, { cache: 'no-store' });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        const text = (await r.text()).trim();
        if (text.startsWith('ERROR;')) throw new Error(text);

        if (text !== lastPayload) {
          lastPayload = text;
          lastChange = Date.now();
        }
        render(text);

        const stableSec = Math.round((Date.now() - lastChange) / 1000);
        if (stableSec > 30) {
          el.status.dataset.state = 'stale';
          el.status.textContent = 'beze změn ' + stableSec + ' s';
        } else {
          el.status.dataset.state = 'ok';
          el.status.textContent = 'online · čerstvé';
        }
      } catch (err) {
        el.status.dataset.state = 'error';
        el.status.textContent = 'chyba: ' + (err && err.message ? err.message : err);
      }
    }

    function render(text) {
      const parts = text.split(';');
      el.body.hidden = false;

      const idMatch = parts[0].match(/^(PRS10[_\d.]*)_SN_(\d+)$/);
      if (idMatch) {
        el.model.textContent = idMatch[1].replace(/_/g, ' ');
        el.sn.textContent = idMatch[2];
      } else {
        el.model.textContent = parts[0] || '—';
        el.sn.textContent = '—';
      }

      const values = parts.slice(1).filter((v) => v !== '');
      el.count.textContent = String(values.length);

      el.table.replaceChildren();
      for (let i = 0; i < values.length; i++) {
        const tr = document.createElement('tr');
        const num = document.createElement('td');
        num.textContent = String(i + 1);
        const val = document.createElement('td');
        val.textContent = values[i];
        tr.append(num, val);
        el.table.append(tr);
      }
    }

    poll();
    setInterval(poll, 5000);
  })();
</script>
