---
/**
 * Editor-only „Nahlásit problém" + „Upravit" — floating buttons + modal form.
 *
 * Visible only when editor is authenticated (CF Access session). Hydrate
 * logic v Base.astro fetcheuje `/api/cms/auth/user` a pokud authenticated,
 * nastaví `body[data-editor-mode="true"]`. Tahle komponenta se na to
 * pověsí přes CSS (`body:not([data-editor-mode]) .fab-stack { display:none }`).
 *
 * **„Upravit" FAB renderuje SERVER-SIDE** (issue #36), nikoli přes JS inject.
 * Předtím Base.astro JS injektoval FAB až po fetch `/api/admin-session-status`
 * — pokud check selhal (cookie expired, race condition), FAB chyběl i pro
 * přihlášené editory. Statické renderování s data-cms-edit-url z Base props
 * je deterministické. JS pak jen `sessionStorage.setItem('cms-return-url')`
 * při kliknutí (return-from-CMS UX).
 *
 * Form posílá JSON na `POST /api/report-issue`. CF Access cookie se posílá
 * automaticky (same-origin), endpoint čte editora z
 * `Cf-Access-Authenticated-User-Email` header.
 *
 * Po success: zelený toast + URL odkaz na vytvořený issue.
 * Po fail: červená inline hláška ve formuláři.
 */
interface Props {
  /** CMS edit URL z Base.astro (Sveltia route). Když undefined → jen Nahlásit problém. */
  cmsEditUrl?: string;
}
const { cmsEditUrl } = Astro.props as Props;
---

{/* FAB stack — společný container pro všechna floating editor tlačítka.
    Stack je vizuálně column-reverse → primary (Upravit) dole, secondary
    (Nahlásit) nad ním. CSS skrývá stack pro anon (body bez data-editor-mode). */}
<div class="fab-stack" aria-label="Editorské nástroje">
  <button
    id="report-issue-trigger"
    class="fab fab--secondary"
    type="button"
    aria-label="Nahlásit problém na této stránce"
    title="Nahlásit problém na této stránce (jen pro editory)"
  >
    <i class="fa-solid fa-bug" aria-hidden="true"></i>
    <span>Nahlásit problém</span>
  </button>
  {cmsEditUrl && (
    <a
      href={cmsEditUrl}
      id="cms-edit-fab"
      class="fab fab--primary cms-edit-fab"
      aria-label="Upravit tuto stránku v CMS"
      title="Upravit tuto stránku v CMS"
    >
      <i class="fa-solid fa-pen" aria-hidden="true"></i>
      <span>Upravit</span>
    </a>
  )}
</div>

<dialog id="report-issue-modal" aria-label="Nahlásit problém" aria-modal="true">
  <form id="report-issue-form" class="report-form" novalidate>
    <header class="report-form-header">
      <h2>Nahlásit problém</h2>
      <button type="button" class="report-form-close" aria-label="Zavřít">×</button>
    </header>

    <p class="report-form-hint">
      Hlášení uloží do interní fronty pro maintainery webu. Tvůj e-mail,
      adresa stránky a krátká informace o prohlížeči se přidají automaticky.
    </p>

    <div class="report-field">
      <span class="report-label">Stránka</span>
      <output id="report-page-info" class="report-page-info" aria-label="Aktuální stránka"></output>
    </div>

    <label class="report-field">
      <span class="report-label">Typ problému</span>
      <select id="report-type" required>
        <option value="">— vyber —</option>
        <option value="preklep">Překlep / typografická chyba</option>
        <option value="chybejici-info">Chybějící nebo neúplná informace</option>
        <option value="spatny-obrazek">Špatný / chybějící obrázek</option>
        <option value="technicka-chyba">Technická chyba (rozbité odkazy, layout)</option>
        <option value="metadata">Chybná metadata (datum, autor, kategorie)</option>
        <option value="duplicita">Duplicita / sloučit s jiným záznamem</option>
        <option value="jine">Jiné</option>
      </select>
    </label>

    <label class="report-field">
      <span class="report-label">Popis problému <span class="required">*</span></span>
      <textarea
        id="report-description"
        rows="5"
        required
        minlength="5"
        maxlength="2000"
        placeholder="Co je špatně? Pokud možno cituj nebo popiš lokaci v textu."
      ></textarea>
      <span class="report-counter" id="report-counter" aria-live="polite" aria-atomic="true">0 / 2000</span>
    </label>

    {/* Honeypot — skrytý anti-bot field. CSS skryje, browser autofill ho
        normálně nevyplní. Bot scraper, který slepě vyplňuje všechny inputy,
        sem dá hodnotu → server detekuje a tichý 200 (bez signálu, že
        zafungovalo). Naming `_url` je úmyslně lákavý pro spambot heuristiky. */}
    <div class="report-honeypot" aria-hidden="true">
      <label>Webová adresa (nevyplňuj)
        <input type="text" id="report-honeypot" name="_url" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div id="report-status" class="report-status" role="status" aria-live="polite"></div>

    <footer class="report-form-footer">
      <button type="button" class="report-form-cancel">Zrušit</button>
      <button type="submit" class="report-form-submit">
        <span class="submit-label">Odeslat hlášení</span>
        <span class="submit-spinner" aria-hidden="true"></span>
      </button>
    </footer>
  </form>
</dialog>

<style>
  /* FAB styly žijí v global.css (.fab, .fab--primary, .fab--secondary,
     .fab-stack) — tahle komponenta jen používá utility classes. */

  dialog#report-issue-modal {
    margin: auto;
    margin-top: 8vh;
    padding: 0;
    border: none;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 35%, transparent);
    border-radius: 2px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.7);
    width: min(560px, 92vw);
    max-height: 90vh;
    color: var(--color-text);
    overflow: hidden;
  }
  dialog#report-issue-modal::backdrop {
    background: rgba(10, 8, 7, 0.7);
    backdrop-filter: blur(4px);
  }

  .report-form {
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    overflow-y: auto;
  }
  .report-form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: var(--color-bg-deep);
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .report-form-header h2 {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-brass-bright);
    margin: 0;
  }
  .report-form-close {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    /* Audit M4: WCAG 2.5.5 vyžaduje min 44×44 px touch target.
       Dříve padding 0 0.5rem dával ~24×24. */
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .report-form-close:hover { color: var(--color-text); }

  .report-form-hint {
    margin: 1rem 1.25rem 0;
    padding: 0.6rem 0.85rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-bg-deep) 90%, var(--color-brass));
    border-left: 2px solid color-mix(in srgb, var(--color-brass) 40%, transparent);
    line-height: 1.5;
  }

  .report-field {
    display: flex;
    flex-direction: column;
    margin: 1rem 1.25rem 0;
    position: relative;
  }
  .report-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-copper);
    font-weight: 500;
    margin-bottom: 0.4rem;
  }
  .report-label .required { color: var(--color-brass); }

  .report-field input[type="text"],
  .report-field select,
  .report-field textarea {
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    padding: 0.55rem 0.7rem;
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  .report-field input[type="text"]:focus,
  .report-field select:focus,
  .report-field textarea:focus {
    outline: none;
    border-color: var(--color-brass);
  }
  .report-page-info {
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    padding: 0.55rem 0.7rem;
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: 0.85rem;
    line-height: 1.4;
    display: block;
    overflow-wrap: anywhere;
  }
  .report-field textarea {
    resize: vertical;
    min-height: 100px;
    font-family: var(--font-serif);
  }
  .report-counter {
    align-self: flex-end;
    margin-top: 0.25rem;
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-family: ui-monospace, monospace;
  }

  /* Honeypot — vizuálně + screen-reader skrytý.
     Speciální technika: position+overflow+aria-hidden, ne `display:none`,
     aby Chrome autofill ho nepřeskočil pokud bot prochází formuláře. */
  .report-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .report-status {
    margin: 1rem 1.25rem 0;
    min-height: 0;
  }
  .report-status:empty { display: none; }
  .report-status.is-success {
    padding: 0.7rem 0.9rem;
    background: color-mix(in srgb, var(--color-bg-deep) 80%, var(--color-brass));
    border-left: 3px solid var(--color-brass);
    color: var(--color-brass-bright);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .report-status.is-error {
    padding: 0.7rem 0.9rem;
    background: color-mix(in srgb, var(--color-bg-deep) 80%, var(--color-copper));
    border-left: 3px solid var(--color-copper);
    color: var(--color-copper);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .report-status a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .report-form-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 1.25rem;
    margin-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }
  .report-form-cancel,
  .report-form-submit {
    padding: 0.5rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    border-radius: 2px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 120ms ease, background 120ms ease;
  }
  .report-form-cancel:hover {
    border-color: var(--color-brass);
  }
  .report-form-submit {
    background: color-mix(in srgb, var(--color-bg-elevated) 70%, var(--color-brass));
    border-color: var(--color-brass);
    color: var(--color-brass-bright);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .report-form-submit:hover {
    background: color-mix(in srgb, var(--color-bg-elevated) 50%, var(--color-brass));
  }
  .report-form-submit[disabled] {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .submit-spinner {
    display: none;
    width: 12px;
    height: 12px;
    border: 2px solid color-mix(in srgb, var(--color-brass) 35%, transparent);
    border-top-color: var(--color-brass);
    border-radius: 50%;
    animation: spin-report 700ms linear infinite;
  }
  .report-form-submit.is-loading .submit-spinner { display: inline-block; }
  .report-form-submit.is-loading .submit-label { opacity: 0.6; }
  @keyframes spin-report { to { transform: rotate(360deg); } }
</style>

<script>
  // Bundled ES module — má ESM import (na rozdíl od `is:inline` v SearchModal,
  // které blokuje import kvůli `define:vars` data injection).
  import { attachDialogControls } from '../utils/dialog-controls';

  (function () {
    const trigger = document.getElementById('report-issue-trigger');
    const dialog = document.getElementById('report-issue-modal') as HTMLDialogElement | null;
    const form = document.getElementById('report-issue-form') as HTMLFormElement | null;
    if (!trigger || !dialog || !form) return;

    const pageInfoEl = document.getElementById('report-page-info') as HTMLOutputElement;
    const typeEl = document.getElementById('report-type') as HTMLSelectElement;
    const descEl = document.getElementById('report-description') as HTMLTextAreaElement;
    const counterEl = document.getElementById('report-counter') as HTMLElement;
    const honeypotEl = document.getElementById('report-honeypot') as HTMLInputElement;
    const statusEl = document.getElementById('report-status') as HTMLElement;
    const submitBtn = form.querySelector('.report-form-submit') as HTMLButtonElement;
    const cancelBtn = form.querySelector('.report-form-cancel') as HTMLButtonElement;
    const closeBtn = form.querySelector('.report-form-close') as HTMLButtonElement;

    function updateCounter() {
      const len = descEl.value.length;
      counterEl.textContent = len + ' / 2000';
    }
    descEl.addEventListener('input', updateCounter);

    /** Nastav text + class statusu a přepne role mezi "alert" (errors,
     *  okamžité ohlášení screen readerem) a "status" (success / neutrální
     *  info, polite ohlášení). */
    function setStatus(text: string, kind: 'success' | 'error' | 'reset', html = false) {
      if (html) {
        statusEl.innerHTML = text;
      } else {
        statusEl.textContent = text;
      }
      if (kind === 'error') {
        statusEl.className = 'report-status is-error';
        statusEl.setAttribute('role', 'alert');
      } else if (kind === 'success') {
        statusEl.className = 'report-status is-success';
        statusEl.setAttribute('role', 'status');
      } else {
        statusEl.className = 'report-status';
        statusEl.setAttribute('role', 'status');
      }
    }

    function fillCurrentPage() {
      const url = window.location.href;
      const title = document.title.replace(/\s—\sHodinárium$/, '');
      pageInfoEl.textContent = title + '  ·  ' + url;
      pageInfoEl.dataset.url = url;
      pageInfoEl.dataset.title = title;
    }

    // Sjednocený dialog handler (open/close/Esc/click-outside).
    // Tech-debt TD2 — předtím duplicitní s SearchModal.
    const { close: closeModal } = attachDialogControls(dialog, {
      trigger,
      closeBtns: [cancelBtn, closeBtn],
      onOpen: () => {
        fillCurrentPage();
        setStatus('', 'reset');
        // Reset only popis + type, zachovej page info (aktuální stránka).
        descEl.value = '';
        typeEl.value = '';
        honeypotEl.value = '';
        updateCounter();
        submitBtn.classList.remove('is-loading');
        submitBtn.disabled = false;
        setTimeout(() => typeEl.focus(), 30);
      },
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      setStatus('', 'reset');

      const description = descEl.value.trim();
      const problemType = typeEl.value;
      if (description.length < 5) {
        setStatus('Popis problému musí mít alespoň 5 znaků.', 'error');
        descEl.focus();
        return;
      }
      if (!problemType) {
        setStatus('Vyber typ problému.', 'error');
        typeEl.focus();
        return;
      }

      submitBtn.classList.add('is-loading');
      submitBtn.disabled = true;

      try {
        const r = await fetch('/api/report-issue', {
          method: 'POST',
          credentials: 'include', // CF Access cookie
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            url: pageInfoEl.dataset.url || window.location.href,
            pageTitle: pageInfoEl.dataset.title || document.title,
            problemType: problemType,
            description: description,
            _url: honeypotEl.value, // Honeypot — měl by být prázdný
          }),
        });
        const data = await r.json().catch(function () { return {}; });

        if (r.ok && data.ok) {
          // Schováváme termín "Issue" + GitHub URL pro netechnické editory.
          // Číslo úkolu zobrazíme jako interní reference (#N), ale bez
          // odkazu na GitHub — udržení dojmu interního systému.
          if (data.issue && data.issue.number) {
            setStatus(
              'Hlášení přijato (úkol č. ' + data.issue.number + '). Děkujeme!',
              'success',
            );
          } else {
            setStatus('Hlášení přijato. Děkujeme!', 'success');
          }
          // Zavři po 4 s.
          setTimeout(function () {
            closeModal();
          }, 4000);
        } else {
          setStatus(data.error || 'Odeslání selhalo. Zkus to znovu později.', 'error');
          submitBtn.classList.remove('is-loading');
          submitBtn.disabled = false;
        }
      } catch (err) {
        setStatus('Síťová chyba — zkontroluj připojení a zkus znovu.', 'error');
        submitBtn.classList.remove('is-loading');
        submitBtn.disabled = false;
      }
    });

    // Escape + click-outside = řeší attachDialogControls výše.
  })();
</script>
