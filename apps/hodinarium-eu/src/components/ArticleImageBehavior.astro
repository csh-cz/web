---
/**
 * Sdílené chování pro obrázky v dlouhých textových šablonách
 * (`.prose-content` wrapper). Renderuje:
 *   - lightbox dialog (jeden pro celou stránku)
 *   - <style is:global> pro img-* klasifikace, gallery grid, lightbox UI
 *   - <script> pro klasifikaci + lightbox logiku + galerie grouping
 *
 * Použito v:
 *   - apps/hodinarium-eu/src/pages/[kategorie]/[slug].astro (články)
 *   - apps/hodinarium-eu/src/pages/kronika/[slug].astro (kronika)
 *
 * Předpoklad: stránka obsahuje element `.prose-content` (typicky
 * vyprodukovaný `<Article>` layoutem nebo přímo v kronika [slug].astro).
 *
 * Behavior:
 *   1. První obrázek → auto `img-hero` (full-width, no float)
 *   2. Ostatní obrázky klasifikovány podle image-sizes.json (small/medium/large/tall)
 *   3. Small/medium/tall → float v textu, JS counter rotuje pravo/levo
 *   4. Large → standalone, klik = lightbox
 *   5. ≥2 konsekutivní large obrázky → seskupí do `.article-gallery` (grid)
 *   6. Lightbox: dialog s next/prev, ESC/← →, klik mimo zavře
 *   7. Line-height snap pro floatable images (lícuje s textovým gridem)
 *   8. Post-hero guard přesune samotný obrázek za první paragraf s textem
 */
import imageSizes from '../data/image-sizes.json';
---
<!-- Lightbox dialog (jeden pro celou stránku) -->
<dialog id="lightbox" aria-label="Lightbox obrázku">
  <button class="lightbox-close" aria-label="Zavřít" type="button">×</button>
  <button class="lightbox-prev" aria-label="Předchozí obrázek" type="button">‹</button>
  <button class="lightbox-next" aria-label="Další obrázek" type="button">›</button>
  <img src="" alt="" />
  <div class="lightbox-caption" id="lightbox-caption"></div>
</dialog>

<style is:global>
  /* === Inline image layout v článcích — časopisecký float === */

  /* Hero — první obrázek v článku, aplikuje se automaticky (viz JS).
     Plná šířka článku, výrazný spodní margin, žádný float. Lightbox
     funguje (cursor zoom-in), klik otevře dialog s vyšším rozlišením. */
  .prose-content img.img-hero {
    display: block;
    float: none !important;
    width: 100%;
    max-width: 100%;
    margin: 0 auto 2.25rem;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    cursor: zoom-in;
  }

  /* Manuální override: <img class="img-full"> v markdownu vynutí
     full-width zobrazení (ignoruje JS klasifikaci). */
  .prose-content img.img-full {
    display: block;
    float: none !important;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    cursor: zoom-in;
  }

  /* Standalone na střed — pro screenshoty a obrázky kde float nedává smysl. */
  .prose-content img.img-standalone {
    display: block;
    float: none !important;
    max-width: min(100%, 480px);
    margin: 1.5rem auto;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    cursor: zoom-in;
  }

  /* Small + Medium + Tall: float v textu, časopisecký dojem.
     Small ~220 px, Medium ~320 px, Tall (úzký vysoký) ~240 px se zoomem.
     Default float right; JS counter rotuje na .img-float-left pro lichá
     pořadí (rytmus pravo-levo). nth-of-type fallback pro případ vypnutého JS. */
  .prose-content img.img-small,
  .prose-content img.img-medium,
  .prose-content img.img-tall {
    float: right;
    width: auto;
    margin: 0.4rem 0 0.75rem 1.5rem;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    cursor: default;
  }
  .prose-content img.img-small { max-width: 220px; }
  .prose-content img.img-medium { max-width: 320px; }
  .prose-content img.img-tall {
    max-width: 240px;
    max-height: 480px;
    cursor: zoom-in;
  }
  .prose-content img.img-tall:hover { filter: brightness(1.05); }

  /* JS counter — deterministic střídání pravo-levo. Přebíjí default float
     a nth-of-type fallback. */
  .prose-content img.img-float-right {
    float: right !important;
    margin: 0.4rem 0 0.75rem 1.5rem !important;
  }
  .prose-content img.img-float-left {
    float: left !important;
    margin: 0.4rem 1.5rem 0.75rem 0 !important;
  }

  /* Fallback bez JS — sekvenční nth-of-type rotace. */
  .prose-content img.img-small:nth-of-type(even),
  .prose-content img.img-medium:nth-of-type(even),
  .prose-content img.img-tall:nth-of-type(even) {
    float: left;
    margin: 0.4rem 1.5rem 0.75rem 0;
  }

  /* Na úzkých displejích (~mobile) se medium/tall chová jako standalone. */
  @media (max-width: 600px) {
    .prose-content img.img-medium,
    .prose-content img.img-tall,
    .prose-content img.img-float-left,
    .prose-content img.img-float-right {
      float: none !important;
      display: block;
      max-width: 100%;
      margin: 1.25rem auto !important;
    }
    .prose-content img.img-tall { max-height: 70vh; }
  }

  /* Large: standalone, klik = lightbox (větší rozlišení k dispozici) */
  .prose-content img.img-large {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0;
    cursor: zoom-in;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    transition: filter 200ms ease, transform 200ms ease;
  }
  .prose-content img.img-large:hover {
    filter: brightness(1.05);
  }

  /* Vysoké obrázky obtékat přes víc odstavců — žádný overflow: hidden
     na <p>, float pokračuje až do nejbližšího clear (h2/h3/hr/.fleuron).
     To zajistí, že tall image se nesvazuje s krátkým paragrafem. */
  .prose-content h2,
  .prose-content h3,
  .prose-content .fleuron,
  .prose-content hr {
    clear: both;
  }

  /* Manuální clearfix — pokud autor chce explicitně ukončit float-block,
     může vložit <div class="clearfix"></div> nebo <hr>. */
  .prose-content .clearfix { clear: both; }


  /* Konsekutivní obrázky v článku — propojit do galerie (jen pro velké) */
  .prose-content p:has(> img:only-child) {
    display: contents;
  }

  .prose-content {
    --gallery-gap: 0.75rem;
  }

  /* Inline lightbox styling */
  dialog#lightbox {
    margin: auto;
    padding: 0;
    border: none;
    background: rgba(20, 16, 12, 0.95);
    backdrop-filter: blur(8px);
    max-width: 96vw;
    max-height: 96vh;
    width: 96vw;
    height: 96vh;
    color: var(--color-text);
  }
  dialog#lightbox::backdrop {
    background: rgba(10, 8, 7, 0.85);
    backdrop-filter: blur(6px);
  }
  dialog#lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .lightbox-close, .lightbox-prev, .lightbox-next {
    position: absolute;
    background: rgba(20, 16, 12, 0.7);
    border: 1px solid color-mix(in srgb, var(--color-brass) 35%, transparent);
    color: var(--color-brass-bright);
    font-family: var(--font-serif);
    font-size: 1.6rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 150ms ease;
    z-index: 2;
    line-height: 1;
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
  }
  .lightbox-prev, .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 64px;
    font-size: 2rem;
  }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }
  .lightbox-close:hover, .lightbox-prev:hover, .lightbox-next:hover {
    background: var(--color-brass);
    color: var(--color-ink);
  }
  .lightbox-caption {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1rem;
    background: rgba(20, 16, 12, 0.85);
    color: var(--color-text);
    font-size: 0.9rem;
    font-style: italic;
    border-radius: 2px;
    max-width: 80%;
    text-align: center;
  }
  .lightbox-caption:empty { display: none; }

  /* Vizuální galerie — pokud script seskupí <p><img></p> za sebou */
  .article-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  @media (min-width: 640px) {
    .article-gallery {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }
  }
  .article-gallery img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    cursor: zoom-in;
    transition: transform 200ms ease, filter 200ms ease;
    filter: sepia(0.1) saturate(0.9);
    margin: 0 !important;
  }
  .article-gallery img:hover {
    transform: scale(1.02);
    filter: sepia(0) saturate(1);
    border-color: var(--color-brass);
  }

  /* Gallery item s caption — figure wrapper okolo img + figcaption */
  .article-gallery .gallery-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .article-gallery .gallery-caption {
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-text-muted);
    text-align: center;
    padding: 0 0.25rem;
  }
  .article-gallery .gallery-caption a {
    color: var(--color-brass);
  }

  /* Modifikátor: zachovat plný poměr stran (žádný crop), pevný počet
     sloupců na řádek. Použij pro skeny dobových inzerátů, dokumenty apod.,
     kde má smysl vidět celou stránku. */
  .article-gallery.gallery-portrait {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .article-gallery.gallery-portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    background: var(--color-bg-deep);
  }
  @media (max-width: 540px) {
    .article-gallery.gallery-portrait {
      grid-template-columns: 1fr;
    }
  }
  .article-gallery a {
    display: block;
    border-bottom: none !important;
  }

  /* Galerie obrázků — pouze pro skupinu obrázků, neskupinujeme small/medium */
  .article-gallery img {
    cursor: default;
  }
  .article-gallery img.img-large {
    cursor: zoom-in;
  }
</style>

<script is:inline define:vars={{ imageSizes }}>
  /**
   * Po načtení článku:
   * 1. Pro každý <img> přidá class podle skutečné velikosti (small/medium/large).
   * 2. Small obrázky → float, text obtéká.
   * 3. Medium → standalone, žádný lightbox.
   * 4. Large → standalone, lightbox při kliknutí.
   * 5. ≥2 large obrázky vedle sebe = galerie.
   */

  function setup() {
    const article = document.querySelector('.prose-content');
    if (!article) return;

    const sizes = imageSizes;

    // 0. První obrázek v článku → automaticky `img-hero` (jednotný styl
    //    napříč články). Manuální override (img-hero/img-full/
    //    img-standalone/img-skip-hero) vyhrává.
    const allImgs = Array.from(article.querySelectorAll('img'));
    if (allImgs.length > 0) {
      const first = allImgs[0];
      const hasManual = ['img-hero', 'img-full', 'img-standalone', 'img-skip-hero']
        .some((c) => first.classList.contains(c));
      if (!hasManual) {
        first.classList.add('img-hero');
      }
    }

    // 1. Klasifikuj zbývající obrázky podle dat z JSON indexu.
    //    Manuální override class (img-hero/img-full/img-standalone) má přednost.
    //    Pokud je img uvnitř figure.photo (Photo komponenta), propaguj size
    //    class i na figure — figure pak nese layout (float/max-width), img
    //    fills figure (100%). Caption overlay zůstává absolutně na figure.
    for (const img of allImgs) {
      if (
        img.classList.contains('img-hero') ||
        img.classList.contains('img-full') ||
        img.classList.contains('img-standalone')
      ) continue;
      const src = img.getAttribute('src') || '';
      const dim = sizes[src];
      const klass = dim ? dim.size : 'medium'; // fallback medium pro externí URL
      img.classList.add(`img-${klass}`);
      const photoFig = img.closest('figure.photo');
      if (photoFig) photoFig.classList.add(`img-${klass}`);
      // Lightbox pro large i tall; medium/small disable
      if (klass !== 'large' && klass !== 'tall') {
        img.dataset.noLightbox = '1';
      }
    }

    // 1.4. Karta sbírky — pokud je první v prose-content, přesunout hned za hero
    //      (vizuálně: nadpis → hero → karta → text). Bez JS zůstává jako první
    //      před hero, což je taky čitelné.
    {
      const karta = article.querySelector(':scope > .karta-sbirky');
      const hero = article.querySelector('img.img-hero');
      if (karta && hero) {
        const heroBlock = hero.closest('figure, p') || hero;
        if (heroBlock.parentElement === article) {
          heroBlock.insertAdjacentElement('afterend', karta);
        }
      }
    }

    // 1.5. Post-hero guard — za hero MUSÍ následovat text (paragraf), ne další
    //      velký obrázek. Pokud je hned po hero blok obsahující jen img
    //      (img-large / img-full / img-standalone / img-hero), přesun ho
    //      za první následující paragraf s textem (>50 znaků).
    const heroEl = article.querySelector('img.img-hero');
    if (heroEl) {
      const heroBlock = heroEl.closest('figure, p') || heroEl;
      let blocking = heroBlock.nextElementSibling;
      while (blocking && blocking.tagName === 'BR') blocking = blocking.nextElementSibling;
      const isImgOnly = (el) => {
        if (!el) return false;
        const bigImg = el.querySelector(
          'img.img-large, img.img-full, img.img-standalone, img.img-hero'
        );
        if (!bigImg) return false;
        // p / figure obsahující jen img + a + br + text-only-uvnitř-figcaption
        if (el.tagName === 'FIGURE') return true;
        if (el.tagName === 'P') {
          return Array.from(el.childNodes).every((n) =>
            n.nodeType !== 1 ||
            n.tagName === 'IMG' ||
            n.tagName === 'A' ||
            n.tagName === 'BR'
          );
        }
        return false;
      };
      if (isImgOnly(blocking)) {
        let cursor = blocking.nextElementSibling;
        while (cursor) {
          if (cursor.tagName === 'P' && cursor.textContent.trim().length > 50) {
            cursor.after(blocking);
            break;
          }
          cursor = cursor.nextElementSibling;
        }
        // Pokud nenajdu paragraf, nech to být — krátký článek bez textu.
      }
    }

    // 1.6. Line-height snap pro floatable images — mírné resize tak, aby
    //      výška obrázku byla celočíselný násobek line-height paragrafu.
    //      Tím obrázek "lícuje" s textovým gridem v default rozlišení;
    //      zabrání se polovičním řádkům přebývajícím nad/pod obrázkem.
    //      Šířka se sníží proporcionálně, max-width z CSS class zůstává limit.
    const proseStyle = window.getComputedStyle(article);
    const baseFontSize = parseFloat(proseStyle.fontSize) || 17;
    const lineHeight = parseFloat(proseStyle.lineHeight) || baseFontSize * 1.65;

    // Photo komponenta (figure.photo) je teď taky floatable — caption overlay
    // se s float dobře snáší (žádný flow under-image text). Layout se aplikuje
    // na figure.photo (ne na img uvnitř).
    const floatable = Array.from(
      article.querySelectorAll('img.img-small, img.img-medium, img.img-tall')
    );

    function snapToLineHeight(img) {
      const natW = img.naturalWidth;
      const natH = img.naturalHeight;
      if (!natW || !natH) return;
      const renderedW = img.offsetWidth;
      if (!renderedW) return;
      const aspect = natH / natW;
      const renderedH = renderedW * aspect;
      // Cílová výška: nejbližší celočíselný násobek line-height (min 2 řádky).
      const lines = Math.max(2, Math.round(renderedH / lineHeight));
      const targetH = lines * lineHeight;
      const targetW = targetH / aspect;
      // Nezvětšuj — jen sniž k cíli, pokud je to v rozumném rozsahu (>20% rozdíl je moc).
      if (Math.abs(targetH - renderedH) / renderedH > 0.2) return;
      img.style.width = Math.round(Math.min(targetW, renderedW)) + 'px';
      img.style.height = Math.round(targetH) + 'px';
    }

    function processFloatable(img) {
      if (img.complete && img.naturalWidth > 0) {
        snapToLineHeight(img);
      } else {
        img.addEventListener('load', () => snapToLineHeight(img), { once: true });
      }
    }
    floatable.forEach(processFloatable);

    // 1.7. Rytmický float — sekvenční counter střídá pravo/levo.
    //      Pro img v markdown ![]() se class přidá na img.
    //      Pro img uvnitř Photo (figure.photo) se class přidá na figure
    //      — figure je layout container, img fills 100%.
    floatable.forEach((img, idx) => {
      const klass = idx % 2 === 0 ? 'img-float-right' : 'img-float-left';
      const photoFig = img.closest('figure.photo');
      if (photoFig) {
        photoFig.classList.add(klass);
      } else {
        img.classList.add(klass);
      }
    });

    // 2. Skupinování konsekutivních LARGE obrázků do galerie
    //    (small/medium float v textu, ne sloučit)
    //
    //    Pravidlo: ≥2 konsekutivní img-large paragrafy → .article-gallery
    //    grid s thumbnaily + lightbox. Krátké caption paragrafy (text < 120
    //    znaků, žádný img) sekvenci NEPŘERUŠUJÍ — naopak se připojí jako
    //    <figcaption> k předchozímu thumbnailu v galerii. Delší text =
    //    obsahový paragraf, sekvenci ukončí.
    const isImgOnlyP = (el) => {
      if (!el || el.tagName !== 'P') return false;
      if (el.querySelectorAll('img.img-large').length === 0) return false;
      return Array.from(el.childNodes).every((n) =>
        n.nodeType !== 1 ||
        n.tagName === 'IMG' || n.tagName === 'A' || n.tagName === 'BR'
      );
    };
    const isShortCaptionP = (el) => {
      if (!el || el.tagName !== 'P') return false;
      if (el.querySelector('img')) return false;
      const text = (el.textContent || '').trim();
      return text.length > 0 && text.length < 120;
    };

    // Posbírej sekvence: img-only p (s případnými short-caption mezi nimi)
    const sequences = [];
    let cursor = article.firstElementChild;
    while (cursor) {
      if (isImgOnlyP(cursor)) {
        const seq = [cursor];
        let next = cursor.nextElementSibling;
        while (next && (isImgOnlyP(next) || isShortCaptionP(next))) {
          seq.push(next);
          next = next.nextElementSibling;
        }
        // Trim trailing captions (caption MUSÍ být MEZI img, ne na konci)
        while (seq.length > 0 && !isImgOnlyP(seq[seq.length - 1])) seq.pop();
        sequences.push(seq);
        cursor = next;
      } else {
        cursor = cursor.nextElementSibling;
      }
    }

    for (const seq of sequences) {
      const imgCount = seq.reduce(
        (s, p) => s + (isImgOnlyP(p) ? p.querySelectorAll('img').length : 0),
        0
      );
      if (imgCount < 2) continue;

      const gallery = document.createElement('div');
      gallery.className = 'article-gallery';
      let pendingFigure = null;

      for (const p of seq) {
        if (isImgOnlyP(p)) {
          for (const img of Array.from(p.querySelectorAll('img'))) {
            const fig = document.createElement('figure');
            fig.className = 'gallery-item';
            fig.appendChild(img);
            gallery.appendChild(fig);
            pendingFigure = fig; // captions se připojí k posledně vloženému
          }
        } else if (isShortCaptionP(p) && pendingFigure) {
          const cap = document.createElement('figcaption');
          cap.className = 'gallery-caption';
          // Přesun všech child node z p do figcaption (zachová <a>, <em>, …)
          while (p.firstChild) cap.appendChild(p.firstChild);
          pendingFigure.appendChild(cap);
        }
      }

      seq[0].parentElement?.insertBefore(gallery, seq[0]);
      for (const p of seq) p.remove();
    }

    // 3. Lightbox — pro large i tall
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const lbImg = lb.querySelector('img');
    const lbCaption = lb.querySelector('#lightbox-caption');
    const lbImgs = Array.from(article.querySelectorAll(
      'img.img-large, img.img-tall, img.img-full, img.img-standalone, img.img-hero, .article-gallery img'
    ));

    function open(idx) {
      const img = lbImgs[idx];
      if (!img) return;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lbCaption.textContent = img.alt && img.alt !== 'menu' && img.alt !== 'grafika' ? img.alt : '';
      lb.dataset.idx = String(idx);
      lb.showModal();
    }

    function closeLb() { lb.close(); }
    function step(delta) {
      const idx = parseInt(lb.dataset.idx ?? '0', 10);
      const next = (idx + delta + lbImgs.length) % lbImgs.length;
      open(next);
    }

    lbImgs.forEach((img, idx) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        open(idx);
      });
    });

    lb.querySelector('.lightbox-close')?.addEventListener('click', closeLb);
    lb.querySelector('.lightbox-prev')?.addEventListener('click', () => step(-1));
    lb.querySelector('.lightbox-next')?.addEventListener('click', () => step(1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLb();
    });
    document.addEventListener('keydown', (e) => {
      if (!lb.open) return;
      if (e.key === 'Escape') closeLb();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
