---
/**
 * Sdílené chování pro obrázky v dlouhých textových šablonách
 * (`.prose-content` wrapper). Renderuje:
 *   - lightbox dialog se třemi režimy (single / grid / compare)
 *   - <style is:global> pro img-* klasifikace, gallery grid, lightbox UI
 *   - <script> pro klasifikaci + lightbox logiku + galerie grouping
 *
 * Použito v:
 *   - apps/hodinarium-eu/src/pages/[kategorie]/[slug].astro (články)
 *   - apps/hodinarium-eu/src/pages/kronika/[slug].astro (kronika)
 *
 * Předpoklad: stránka obsahuje element `.prose-content` (typicky
 * vyprodukovaný `<Article>` layoutem nebo přímo v kronika [slug].astro).
 *
 * Behavior — klasifikace + layout:
 *   1. První obrázek → auto `img-hero` (full-width, no float)
 *   2. Ostatní obrázky klasifikovány podle image-sizes.json (small/medium/large/tall)
 *   3. Small/medium/tall → float v textu, JS counter rotuje pravo/levo
 *   4. Large → standalone, klik = lightbox
 *   5. ≥2 konsekutivní large obrázky → seskupí do `.article-gallery` (grid)
 *   6. Line-height snap pro floatable images (lícuje s textovým gridem)
 *   7. Post-hero guard přesune samotný obrázek za první paragraf s textem
 *
 * Behavior — lightbox (přepracováno 2026-05-18, A.33/A.34/A.35):
 *   L1 — single mode (default):
 *     - Klik na fotku, backdrop, ESC, ×-tlačítko, swipe-down → close
 *     - Šipky next/prev v horních rozích, semi-transparent (0.4 → 1 hover)
 *     - Mobile: swipe ← → nav, ↓ close
 *     - Mac trackpad: 2-finger horizontal scroll → nav (debounce 300ms)
 *     - Klávesnice: ← → Esc; 1 single, g grid toggle, c compare toggle
 *     - Caption auto-hide po 2 s nepohybu kurzoru
 *   L2 — grid mode (auto pro portréty na širokém displeji):
 *     - Detekce viewport ≥1200px + aspect ≥3:2 + portrait foto
 *     - 3-up grid: prev / active / next, active s focus ringem
 *     - Sousedy 60% opacity, klik přepne aktivní
 *     - Šipky posunou celé okno o 1 krok
 *   L3 — compare mode (manuál):
 *     - Klávesa `c` nebo tlačítko otevře split-screen 2-up
 *     - Drag divider resize (CSS variable --lb-split)
 *     - Klávesa `x` swap A↔B, `Esc` zpět do single
 */
import imageSizes from '../data/image-sizes.json';
---
<!-- Lightbox dialog (jeden pro celou stránku) -->
<dialog id="lightbox" class="lb" aria-label="Lightbox obrázku">
  <div class="lb-stage" data-tiles="1">
    <!-- Sloty se vkládají dynamicky — 1-9 tiles -->
  </div>

  <button class="lb-close" aria-label="Zavřít (Esc)" type="button">
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
  <button class="lb-prev" aria-label="Předchozí (←)" type="button">
    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
  </button>
  <button class="lb-next" aria-label="Další (→)" type="button">
    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
  </button>

  <div class="lb-counter" aria-live="polite"></div>
  <div class="lb-caption" id="lightbox-caption"></div>
  <div class="lb-hint" aria-hidden="true">klik = zavřít · ← → další · klik v pruhu = přidat fotku · r = odebrat</div>

  <!-- Thumbstrip — vždy viditelný, klik na thumbnail přidá fotku do gridu -->
  <div class="lb-thumbstrip" role="listbox" aria-label="Klikněte na fotku pro přidání do gridu">
    <!-- thumbnaily se vkládají dynamicky -->
  </div>
</dialog>

<style is:global>
  /* === Inline image layout v článcích — časopisecký float === */

  /* Hero — první obrázek v článku, aplikuje se automaticky (viz JS).
     Plná šířka článku, výrazný spodní margin, žádný float. Lightbox
     funguje (cursor zoom-in), klik otevře dialog s vyšším rozlišením. */
  .prose-content img.img-hero {
    display: block;
    float: none !important;
    width: 100%;
    max-width: 100%;
    margin: 0 auto 2.25rem;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    cursor: zoom-in;
  }

  /* Manuální override: <img class="img-full"> v markdownu vynutí
     full-width zobrazení (ignoruje JS klasifikaci). */
  .prose-content img.img-full {
    display: block;
    float: none !important;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    cursor: zoom-in;
  }

  /* Standalone na střed — pro screenshoty a obrázky kde float nedává smysl. */
  .prose-content img.img-standalone {
    display: block;
    float: none !important;
    max-width: min(100%, 480px);
    margin: 1.5rem auto;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    cursor: zoom-in;
  }

  /* Small + Medium + Tall: float v textu, časopisecký dojem. */
  .prose-content img.img-small,
  .prose-content img.img-medium,
  .prose-content img.img-tall {
    float: right;
    width: auto;
    margin: 0.4rem 0 0.75rem 1.5rem;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    cursor: default;
  }
  .prose-content img.img-small { max-width: 220px; }
  .prose-content img.img-medium { max-width: 320px; }
  .prose-content img.img-tall {
    max-width: 240px;
    max-height: 480px;
    cursor: zoom-in;
  }
  .prose-content img.img-tall:hover { filter: brightness(1.05); }

  /* JS counter — deterministic střídání pravo-levo. */
  .prose-content img.img-float-right {
    float: right !important;
    margin: 0.4rem 0 0.75rem 1.5rem !important;
  }
  .prose-content img.img-float-left {
    float: left !important;
    margin: 0.4rem 1.5rem 0.75rem 0 !important;
  }

  /* Fallback bez JS — sekvenční nth-of-type rotace. */
  .prose-content img.img-small:nth-of-type(even),
  .prose-content img.img-medium:nth-of-type(even),
  .prose-content img.img-tall:nth-of-type(even) {
    float: left;
    margin: 0.4rem 1.5rem 0.75rem 0;
  }

  @media (max-width: 600px) {
    .prose-content img.img-medium,
    .prose-content img.img-tall,
    .prose-content img.img-float-left,
    .prose-content img.img-float-right {
      float: none !important;
      display: block;
      max-width: 100%;
      margin: 1.25rem auto !important;
    }
    .prose-content img.img-tall { max-height: 70vh; }
  }

  /* Large: standalone, klik = lightbox */
  .prose-content img.img-large {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0;
    cursor: zoom-in;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    transition: filter 200ms ease, transform 200ms ease;
  }
  .prose-content img.img-large:hover {
    filter: brightness(1.05);
  }

  .prose-content h2,
  .prose-content h3,
  .prose-content .fleuron,
  .prose-content hr {
    clear: both;
  }
  .prose-content .clearfix { clear: both; }

  .prose-content p:has(> img:only-child) {
    display: contents;
  }
  .prose-content {
    --gallery-gap: 0.75rem;
  }

  /* ============================================================ */
  /* === LIGHTBOX — single / grid / compare režimy === */
  /* ============================================================ */

  dialog.lb {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    color: var(--color-text);
    overflow: hidden;
  }
  dialog.lb::backdrop {
    background: rgba(10, 8, 7, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  /* Stage — N tiles (1-9), auto-grid podle data-tiles. Thumbstrip vždy
     viditelný dole → padding-bottom alokuje místo. */
  .lb-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    gap: 0.5rem;
    padding: 4rem 1rem 9rem;
  }
  .lb-stage[data-tiles="1"] {
    grid-template-columns: 1fr;
  }
  .lb-stage[data-tiles="2"] {
    grid-template-columns: 1fr 1fr;
  }
  .lb-stage[data-tiles="3"] {
    grid-template-columns: repeat(3, 1fr);
  }
  .lb-stage[data-tiles="4"] {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .lb-stage[data-tiles="5"],
  .lb-stage[data-tiles="6"] {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: 1fr 1fr;
  }
  .lb-stage[data-tiles="7"],
  .lb-stage[data-tiles="8"],
  .lb-stage[data-tiles="9"] {
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
  }
  /* Mobile — squish 3+ tiles do 2 sloupců */
  @media (max-width: 800px) {
    .lb-stage[data-tiles="3"],
    .lb-stage[data-tiles="5"],
    .lb-stage[data-tiles="6"],
    .lb-stage[data-tiles="7"],
    .lb-stage[data-tiles="8"],
    .lb-stage[data-tiles="9"] {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }
  }

  /* Slot — wrapper jedné fotky */
  .lb-slot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transition: opacity 200ms ease, outline-color 200ms ease;
  }
  .lb-slot img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 2px;
    cursor: zoom-out;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* Focused tile — outline border (klávesnice nav v jeho gallery) */
  .lb-slot.is-focused {
    outline: 2px solid var(--color-brass-bright);
    outline-offset: -2px;
  }

  /* Pan/zoom — transform driven JS, vždy pro všechny tiles */
  .lb-slot {
    cursor: grab;
  }
  .lb-slot.is-dragging {
    cursor: grabbing;
  }
  .lb-slot img {
    cursor: inherit;
    transform: translate(var(--pan-x, 0px), var(--pan-y, 0px)) scale(var(--zoom, 1));
    transform-origin: center;
    transition: transform 50ms linear;
  }
  .lb-slot.is-dragging img {
    transition: none;
  }

  /* Per-tile remove button (hover/focus, jen pokud N≥2) */
  .lb-slot-remove {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 28px;
    height: 28px;
    background: rgba(20, 16, 12, 0.85);
    border: 1px solid color-mix(in srgb, var(--color-brass) 35%, transparent);
    color: var(--color-text);
    border-radius: 50%;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2;
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 150ms ease, background 150ms ease, color 150ms ease;
  }
  .lb-slot:hover .lb-slot-remove,
  .lb-slot.is-focused .lb-slot-remove {
    display: flex;
    opacity: 0.85;
  }
  .lb-slot-remove:hover {
    background: var(--color-copper);
    color: var(--color-ink);
    opacity: 1 !important;
  }
  /* Pokud je jen 1 tile — × skryto (nelze odebrat poslední) */
  .lb-stage[data-tiles="1"] .lb-slot-remove {
    display: none !important;
  }

  /* Ovládací prvky — close, prev, next, mode toolbar, counter, caption */
  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    background: rgba(20, 16, 12, 0.65);
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    color: var(--color-brass-bright);
    cursor: pointer;
    border-radius: 50%;
    transition: opacity 150ms ease, background 150ms ease, color 150ms ease, transform 150ms ease;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    font-size: 0.95rem;
    opacity: 0.5;
  }
  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover {
    opacity: 1;
    background: var(--color-brass);
    color: var(--color-ink);
  }
  .lb-close:focus-visible,
  .lb-prev:focus-visible,
  .lb-next:focus-visible {
    opacity: 1;
    outline: 2px solid var(--color-brass-bright);
    outline-offset: 2px;
  }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { top: 1rem; left: 1rem; }
  .lb-next { top: 1rem; left: 4rem; }

  /* Thumbstrip — vždy viditelný (přidání fotky do gridu) */
  .lb-thumbstrip {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(20, 16, 12, 0.95);
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    padding: 0.5rem;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    z-index: 6;
    max-height: 120px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-brass) transparent;
  }
  .lb-thumbstrip::-webkit-scrollbar { height: 6px; }
  .lb-thumbstrip::-webkit-scrollbar-thumb { background: var(--color-brass); border-radius: 3px; }
  .lb-thumbstrip img {
    height: 80px;
    width: auto;
    max-width: 120px;
    object-fit: cover;
    cursor: pointer;
    border: 2px solid transparent;
    border-radius: 2px;
    opacity: 0.7;
    transition: opacity 150ms ease, border-color 150ms ease, transform 150ms ease;
    flex-shrink: 0;
  }
  .lb-thumbstrip img:hover {
    opacity: 1;
    border-color: var(--color-brass-bright);
    transform: scale(1.05);
  }
  .lb-thumbstrip img.is-in-workspace {
    border-color: var(--color-brass);
    opacity: 0.4;
    cursor: not-allowed;
  }
  .lb-thumbstrip img.is-in-workspace:hover {
    transform: none;
  }
  /* Caption a counter posunuté nad thumbstrip */
  .lb-caption,
  .lb-counter {
    bottom: 8rem !important;
  }
  /* Hint posunutý ještě výš aby ho thumbstrip nepřekrýval */
  .lb-hint {
    bottom: 8.5rem;
  }
  dialog.lb[data-hint-seen] .lb-hint {
    opacity: 0;
  }

  /* Mobile — thumbstrip menší, ale stále viditelný */
  @media (max-width: 600px) {
    .lb-thumbstrip {
      max-height: 70px;
      padding: 0.3rem;
    }
    .lb-thumbstrip img {
      height: 56px;
    }
    .lb-caption, .lb-counter {
      bottom: 5rem !important;
    }
    .lb-hint {
      bottom: 5.5rem;
    }
    .lb-stage {
      padding-bottom: 6.5rem;
    }
  }

  /* Counter (X / N) */
  .lb-counter {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(20, 16, 12, 0.65);
    color: var(--color-text-soft);
    padding: 0.35rem 0.7rem;
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
    border-radius: 2px;
    z-index: 5;
    opacity: 0.5;
    pointer-events: none;
  }

  /* Caption — auto-hide po 2s nepohybu kurzoru */
  .lb-caption {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1rem;
    background: rgba(20, 16, 12, 0.85);
    color: var(--color-text);
    font-size: 0.9rem;
    font-style: italic;
    border-radius: 2px;
    max-width: min(80%, 60ch);
    text-align: center;
    z-index: 4;
    opacity: 1;
    transition: opacity 400ms ease;
    pointer-events: none;
  }
  .lb-caption:empty { display: none; }
  dialog.lb[data-caption-hidden] .lb-caption {
    opacity: 0;
  }

  /* Hint pruh dole — zobrazí se jen při prvním otevření, pak se skryje */
  .lb-hint {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    opacity: 0.5;
    pointer-events: none;
    z-index: 4;
    white-space: nowrap;
    transition: opacity 400ms ease 1s;
  }
  dialog.lb[data-hint-seen] .lb-hint {
    opacity: 0;
  }

  /* Mobile — menší tlačítka, schovat hint (caption a counter řeší předchozí media block) */
  @media (max-width: 600px) {
    .lb-prev { left: 1rem; }
    .lb-next { left: 3.5rem; }
    .lb-caption { font-size: 0.82rem; }
    .lb-hint { display: none; }
  }

  /* === Galerie (article-gallery) === */
  .article-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  @media (min-width: 640px) {
    .article-gallery {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }
  }
  .article-gallery img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    cursor: zoom-in;
    transition: transform 200ms ease, filter 200ms ease;
    filter: sepia(0.1) saturate(0.9);
    margin: 0 !important;
  }
  .article-gallery img:hover {
    transform: scale(1.02);
    filter: sepia(0) saturate(1);
    border-color: var(--color-brass);
  }

  .article-gallery .gallery-item {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .article-gallery .gallery-caption {
    font-size: 0.78rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-text-muted);
    text-align: center;
    padding: 0 0.25rem;
  }
  .article-gallery .gallery-caption a {
    color: var(--color-brass);
  }

  .article-gallery.gallery-portrait {
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  .article-gallery.gallery-portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    background: var(--color-bg-deep);
  }
  @media (max-width: 540px) {
    .article-gallery.gallery-portrait {
      grid-template-columns: 1fr;
    }
  }
  .article-gallery a {
    display: block;
    border-bottom: none !important;
  }
  .article-gallery img {
    cursor: default;
  }
  .article-gallery img.img-large {
    cursor: zoom-in;
  }
</style>

<script is:inline define:vars={{ imageSizes }}>
  /**
   * Po načtení článku:
   * 1. Klasifikuj obrázky (img-small/medium/large/tall/hero) podle image-sizes.json
   * 2. Float-rytmus, line-height snap
   * 3. Skupinování konsekutivních large do galerie
   * 4. Lightbox state machine (single / grid / compare)
   */

  function setup() {
    const article = document.querySelector('.prose-content');
    if (!article) return;

    const sizes = imageSizes;

    // 0. První obrázek → automaticky img-hero (pokud nemá manuální override)
    const allImgs = Array.from(article.querySelectorAll('img'));
    if (allImgs.length > 0) {
      const first = allImgs[0];
      const hasManual = ['img-hero', 'img-full', 'img-standalone', 'img-skip-hero']
        .some((c) => first.classList.contains(c));
      if (!hasManual) {
        first.classList.add('img-hero');
      }
    }

    // 1. Klasifikuj zbývající obrázky podle dat z JSON indexu
    for (const img of allImgs) {
      if (
        img.classList.contains('img-hero') ||
        img.classList.contains('img-full') ||
        img.classList.contains('img-standalone')
      ) continue;
      const src = img.getAttribute('src') || '';
      const dim = sizes[src];
      const klass = dim ? dim.size : 'medium';
      img.classList.add(`img-${klass}`);
      const photoFig = img.closest('figure.photo');
      if (photoFig) photoFig.classList.add(`img-${klass}`);
      if (klass !== 'large' && klass !== 'tall') {
        img.dataset.noLightbox = '1';
      }
    }

    // 1.4. Karta sbírky — pokud je první v prose-content, přesunout hned za hero
    {
      const karta = article.querySelector(':scope > .karta-sbirky');
      const hero = article.querySelector('img.img-hero');
      if (karta && hero) {
        const heroBlock = hero.closest('figure, p') || hero;
        if (heroBlock.parentElement === article) {
          heroBlock.insertAdjacentElement('afterend', karta);
        }
      }
    }

    // 1.5. Post-hero guard — za hero MUSÍ následovat text, ne další obrázek
    const heroEl = article.querySelector('img.img-hero');
    if (heroEl) {
      const heroBlock = heroEl.closest('figure, p') || heroEl;
      let blocking = heroBlock.nextElementSibling;
      while (blocking && blocking.tagName === 'BR') blocking = blocking.nextElementSibling;
      const isImgOnly = (el) => {
        if (!el) return false;
        const bigImg = el.querySelector(
          'img.img-large, img.img-full, img.img-standalone, img.img-hero'
        );
        if (!bigImg) return false;
        if (el.tagName === 'FIGURE') return true;
        if (el.tagName === 'P') {
          return Array.from(el.childNodes).every((n) =>
            n.nodeType !== 1 ||
            n.tagName === 'IMG' ||
            n.tagName === 'A' ||
            n.tagName === 'BR'
          );
        }
        return false;
      };
      if (isImgOnly(blocking)) {
        let cursor = blocking.nextElementSibling;
        while (cursor) {
          if (cursor.tagName === 'P' && cursor.textContent.trim().length > 50) {
            cursor.after(blocking);
            break;
          }
          cursor = cursor.nextElementSibling;
        }
      }
    }

    // 1.6. Line-height snap pro floatable images
    const proseStyle = window.getComputedStyle(article);
    const baseFontSize = parseFloat(proseStyle.fontSize) || 17;
    const lineHeight = parseFloat(proseStyle.lineHeight) || baseFontSize * 1.65;

    const floatable = Array.from(
      article.querySelectorAll('img.img-small, img.img-medium, img.img-tall')
    );

    function snapToLineHeight(img) {
      const natW = img.naturalWidth;
      const natH = img.naturalHeight;
      if (!natW || !natH) return;
      const renderedW = img.offsetWidth;
      if (!renderedW) return;
      const aspect = natH / natW;
      const renderedH = renderedW * aspect;
      const lines = Math.max(2, Math.round(renderedH / lineHeight));
      const targetH = lines * lineHeight;
      const targetW = targetH / aspect;
      if (Math.abs(targetH - renderedH) / renderedH > 0.2) return;
      img.style.width = Math.round(Math.min(targetW, renderedW)) + 'px';
      img.style.height = Math.round(targetH) + 'px';
    }

    function processFloatable(img) {
      if (img.complete && img.naturalWidth > 0) {
        snapToLineHeight(img);
      } else {
        img.addEventListener('load', () => snapToLineHeight(img), { once: true });
      }
    }
    floatable.forEach(processFloatable);

    // 1.7. Rytmický float — sekvenční counter střídá pravo/levo
    floatable.forEach((img, idx) => {
      const klass = idx % 2 === 0 ? 'img-float-right' : 'img-float-left';
      const photoFig = img.closest('figure.photo');
      if (photoFig) {
        photoFig.classList.add(klass);
      } else {
        img.classList.add(klass);
      }
    });

    // 2. Skupinování konsekutivních LARGE obrázků do galerie
    const isImgOnlyP = (el) => {
      if (!el || el.tagName !== 'P') return false;
      if (el.querySelectorAll('img.img-large').length === 0) return false;
      return Array.from(el.childNodes).every((n) =>
        n.nodeType !== 1 ||
        n.tagName === 'IMG' || n.tagName === 'A' || n.tagName === 'BR'
      );
    };
    const isShortCaptionP = (el) => {
      if (!el || el.tagName !== 'P') return false;
      if (el.querySelector('img')) return false;
      const text = (el.textContent || '').trim();
      return text.length > 0 && text.length < 120;
    };

    const sequences = [];
    let cursor = article.firstElementChild;
    while (cursor) {
      if (isImgOnlyP(cursor)) {
        const seq = [cursor];
        let next = cursor.nextElementSibling;
        while (next && (isImgOnlyP(next) || isShortCaptionP(next))) {
          seq.push(next);
          next = next.nextElementSibling;
        }
        while (seq.length > 0 && !isImgOnlyP(seq[seq.length - 1])) seq.pop();
        sequences.push(seq);
        cursor = next;
      } else {
        cursor = cursor.nextElementSibling;
      }
    }

    for (const seq of sequences) {
      const imgCount = seq.reduce(
        (s, p) => s + (isImgOnlyP(p) ? p.querySelectorAll('img').length : 0),
        0
      );
      if (imgCount < 2) continue;

      const gallery = document.createElement('div');
      gallery.className = 'article-gallery';
      let pendingFigure = null;

      for (const p of seq) {
        if (isImgOnlyP(p)) {
          for (const img of Array.from(p.querySelectorAll('img'))) {
            const fig = document.createElement('figure');
            fig.className = 'gallery-item';
            fig.appendChild(img);
            gallery.appendChild(fig);
            pendingFigure = fig;
          }
        } else if (isShortCaptionP(p) && pendingFigure) {
          const cap = document.createElement('figcaption');
          cap.className = 'gallery-caption';
          while (p.firstChild) cap.appendChild(p.firstChild);
          pendingFigure.appendChild(cap);
        }
      }

      seq[0].parentElement?.insertBefore(gallery, seq[0]);
      for (const p of seq) p.remove();
    }

    // ==========================================================
    // 3. Lightbox — N-tile workspace state machine
    // ==========================================================
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const stage = lb.querySelector('.lb-stage');
    const captionEl = lb.querySelector('.lb-caption');
    const counterEl = lb.querySelector('.lb-counter');
    const closeBtn = lb.querySelector('.lb-close');
    const prevBtn = lb.querySelector('.lb-prev');
    const nextBtn = lb.querySelector('.lb-next');
    const thumbstrip = lb.querySelector('.lb-thumbstrip');

    // Sbírka všech lightbox-eligible obrázků v článku
    const lbImgs = Array.from(article.querySelectorAll(
      'img.img-large, img.img-tall, img.img-full, img.img-standalone, img.img-hero, .article-gallery img'
    ));
    if (lbImgs.length === 0) return;

    /** Lightbox state — jediný "N-tile workspace" režim.
     *  tiles.length === 1 vypadá jako single-photo, ≥2 jako grid. */
    const MAX_TILES = 9;
    const state = {
      tiles: [],          // pole indexů fotek (1-9)
      focusedTile: -1,    // který tile má focus pro klávesovou nav
      captionTimeout: null,
      lastWheel: 0,
      panZoom: {},        // keyed by slot index
    };

    /** Render všech tiles do stage podle state.tiles */
    function renderSlots() {
      stage.innerHTML = '';
      const indices = state.tiles;
      stage.dataset.tiles = String(indices.length);

      indices.forEach((idx, slotIdx) => {
        const slot = document.createElement('div');
        slot.className = 'lb-slot';
        slot.dataset.slotIdx = String(slotIdx);
        slot.dataset.imgIdx = String(idx);

        if (slotIdx === state.focusedTile) {
          slot.classList.add('is-focused');
        }

        const img = document.createElement('img');
        const src = lbImgs[idx];
        img.src = src.src;
        img.alt = src.alt || '';
        // Pan/zoom CSS variables
        const pz = state.panZoom[slotIdx] || { x: 0, y: 0, zoom: 1 };
        img.style.setProperty('--pan-x', pz.x + 'px');
        img.style.setProperty('--pan-y', pz.y + 'px');
        img.style.setProperty('--zoom', String(pz.zoom));
        slot.appendChild(img);

        // Remove × tlačítko (CSS ho skryje pokud N=1)
        const remove = document.createElement('button');
        remove.className = 'lb-slot-remove';
        remove.type = 'button';
        remove.setAttribute('aria-label', `Odebrat fotku ${slotIdx + 1} z gridu`);
        remove.innerHTML = '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';
        slot.appendChild(remove);

        stage.appendChild(slot);
      });
    }

    /** Render thumbstrip — všechny lbImgs jako thumbnaily.
     *  Klik → addTile(idx). Fotky, které už jsou v gridu, mají
     *  zatlumený border + cursor: not-allowed (nelze duplikát). */
    function renderThumbstrip() {
      thumbstrip.innerHTML = '';
      lbImgs.forEach((img, idx) => {
        const thumb = document.createElement('img');
        thumb.src = img.src;
        thumb.alt = img.alt || `Foto ${idx + 1}`;
        thumb.dataset.idx = String(idx);
        thumb.setAttribute('role', 'option');
        if (state.tiles.includes(idx)) {
          thumb.classList.add('is-in-workspace');
        }
        thumbstrip.appendChild(thumb);
      });
    }

    /** Přidá fotku idx do gridu (max MAX_TILES, žádné duplikáty). */
    function addTile(idx) {
      if (state.tiles.length >= MAX_TILES) return;
      if (state.tiles.includes(idx)) return;
      state.tiles.push(idx);
      state.panZoom[state.tiles.length - 1] = { x: 0, y: 0, zoom: 1 };
      refresh();
      renderThumbstrip();
    }

    /** Odebere tile na pozici slotIdx (kromě posledního). */
    function removeTile(slotIdx) {
      if (state.tiles.length <= 1) return;
      state.tiles.splice(slotIdx, 1);
      // Re-key panZoom (shift indices down)
      const newPz = {};
      Object.entries(state.panZoom).forEach(([k, v]) => {
        const i = parseInt(k, 10);
        if (i < slotIdx) newPz[i] = v;
        else if (i > slotIdx) newPz[i - 1] = v;
      });
      state.panZoom = newPz;
      if (state.focusedTile === slotIdx) state.focusedTile = -1;
      else if (state.focusedTile > slotIdx) state.focusedTile--;
      refresh();
      renderThumbstrip();
    }

    function updateCaption() {
      let txt = '';
      // V N-tile workspaceu zobrazím caption focused tile (nebo prvního)
      const slotIdx = state.focusedTile >= 0 ? state.focusedTile : 0;
      const imgIdx = state.tiles[slotIdx];
      if (typeof imgIdx === 'number') {
        const img = lbImgs[imgIdx];
        const baseAlt = (img.alt && img.alt !== 'menu' && img.alt !== 'grafika') ? img.alt : '';
        if (state.tiles.length === 1) {
          txt = baseAlt;
        } else {
          txt = baseAlt ? `${slotIdx + 1}/${state.tiles.length}: ${baseAlt}` : `${slotIdx + 1}/${state.tiles.length}`;
        }
      }
      captionEl.textContent = txt;
      lb.removeAttribute('data-caption-hidden');
      clearTimeout(state.captionTimeout);
      state.captionTimeout = setTimeout(() => {
        lb.setAttribute('data-caption-hidden', '');
      }, 2000);
    }

    function updateCounter() {
      if (state.tiles.length === 1) {
        counterEl.textContent = `${state.tiles[0] + 1} / ${lbImgs.length}`;
      } else {
        counterEl.textContent = `${state.tiles.length} v gridu · z ${lbImgs.length}`;
      }
    }

    function refresh() {
      renderSlots();
      updateCaption();
      updateCounter();
    }

    function open(idx) {
      state.tiles = [idx];
      state.focusedTile = 0;
      state.panZoom = { 0: { x: 0, y: 0, zoom: 1 } };
      refresh();
      renderThumbstrip();
      lb.showModal();
    }

    function closeLb() {
      lb.close();
      clearTimeout(state.captionTimeout);
    }

    function step(delta) {
      const n = lbImgs.length;
      // Šipky cyklují fotku v focused tile (nebo prvním pokud focus = -1)
      const slotIdx = state.focusedTile >= 0 ? state.focusedTile : 0;
      if (state.tiles[slotIdx] === undefined) return;
      state.tiles[slotIdx] = (state.tiles[slotIdx] + delta + n) % n;
      // Reset pan/zoom pro tento slot (nová fotka)
      state.panZoom[slotIdx] = { x: 0, y: 0, zoom: 1 };
      refresh();
      renderThumbstrip(); // is-in-workspace flags se mění
    }

    // === Event listeners ===

    // Otevírání lightboxu z článku
    lbImgs.forEach((img, idx) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        open(idx);
      });
    });

    closeBtn.addEventListener('click', closeLb);
    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));

    // Klik handler — N-tile workspace
    lb.addEventListener('click', (e) => {
      const target = e.target;
      // Ignoruj kliky na ovládací prvky
      if (target.closest('.lb-close, .lb-prev, .lb-next, .lb-counter, .lb-thumbstrip')) return;

      // Remove × tlačítko na tile
      const removeBtn = target.closest('.lb-slot-remove');
      if (removeBtn) {
        const slot = removeBtn.closest('.lb-slot');
        if (slot) {
          const slotIdx = parseInt(slot.dataset.slotIdx, 10);
          removeTile(slotIdx);
        }
        return;
      }

      // Klik na tile = focus (klávesnice ← → pak cykluje fotku v tom tile)
      const slot = target.closest('.lb-slot');
      if (slot) {
        if (state.tiles.length === 1) {
          // Při N=1 klik na tile = close (klasický single lightbox UX)
          closeLb();
          return;
        }
        const slotIdx = parseInt(slot.dataset.slotIdx, 10);
        state.focusedTile = slotIdx;
        stage.querySelectorAll('.lb-slot').forEach((s, i) => {
          s.classList.toggle('is-focused', i === state.focusedTile);
        });
        updateCaption();
        return;
      }

      // Klik mimo sloty (backdrop pruh) = close
      closeLb();
    });

    // Thumbstrip — klik na thumbnail přidá fotku do gridu
    thumbstrip?.addEventListener('click', (e) => {
      // STOP PROPAGATION: addTile() rebuilduje thumbstrip → kliknutý target
      // se odpojí z DOM. Když by pak event bublal do lb handleru,
      // `target.closest('.lb-thumbstrip')` by vrátilo null a klik by se
      // chybně interpretoval jako klik mimo sloty → closeLb().
      e.stopPropagation();
      const target = e.target;
      if (!(target instanceof HTMLImageElement)) return;
      if (target.classList.contains('is-in-workspace')) return;
      const idx = parseInt(target.dataset.idx, 10);
      if (Number.isNaN(idx)) return;
      addTile(idx);
    });

    // Klávesnice
    document.addEventListener('keydown', (e) => {
      if (!lb.open) return;
      if (e.key === 'Escape') {
        closeLb();
      }
      else if (e.key === 'ArrowLeft') { step(-1); }
      else if (e.key === 'ArrowRight') { step(1); }
      else if (e.key === 'r' || e.key === 'R') {
        // R → odebrat focused tile (pokud N≥2)
        if (state.focusedTile >= 0 && state.tiles.length >= 2) {
          removeTile(state.focusedTile);
        }
      }
    });

    // === Touch gestures ===
    // Single tile (N=1) → swipe ← → cykluje fotku, ↓ zavře.
    // Multi tile (N≥2) → touch ovládá pan slotů (níže v pointerdown), bez swipe-nav.
    let touchStart = null;
    stage.addEventListener('touchstart', (e) => {
      if (e.touches.length !== 1) return;
      if (state.tiles.length !== 1) return;
      const t = e.touches[0];
      touchStart = { x: t.clientX, y: t.clientY, t: Date.now() };
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      if (!touchStart) return;
      if (state.tiles.length !== 1) { touchStart = null; return; }
      const t = e.changedTouches[0];
      const dx = t.clientX - touchStart.x;
      const dy = t.clientY - touchStart.y;
      const dt = Date.now() - touchStart.t;
      touchStart = null;
      if (dt > 600) return;
      const absX = Math.abs(dx);
      const absY = Math.abs(dy);
      if (absX > 50 && absX > absY * 1.5) {
        step(dx < 0 ? 1 : -1);
      } else if (dy > 80 && absY > absX * 1.5) {
        closeLb();
      }
    }, { passive: true });

    // === Trackpad horizontal wheel (Mac 2-finger scroll) ===
    // Funguje jen při N=1, jinak má prioritu pan/zoom (níže).
    stage.addEventListener('wheel', (e) => {
      if (state.tiles.length !== 1) return;
      const absX = Math.abs(e.deltaX);
      const absY = Math.abs(e.deltaY);
      if (absX < absY || absX < 8) return;
      const now = Date.now();
      if (now - state.lastWheel < 300) return;
      state.lastWheel = now;
      step(e.deltaX > 0 ? 1 : -1);
      e.preventDefault();
    }, { passive: false });

    // === Caption auto-hide on mouse move ===
    lb.addEventListener('mousemove', () => {
      lb.removeAttribute('data-caption-hidden');
      clearTimeout(state.captionTimeout);
      state.captionTimeout = setTimeout(() => {
        lb.setAttribute('data-caption-hidden', '');
      }, 2000);
    });

    // === Hint dismiss on first interaction ===
    lb.addEventListener('keydown', () => lb.setAttribute('data-hint-seen', ''), { once: true });
    lb.addEventListener('click', () => lb.setAttribute('data-hint-seen', ''), { once: true });

    // === Per-tile pan / zoom (jen při N≥2 — single tile používá swipe/wheel nav) ===
    let panStart = null;
    stage.addEventListener('pointerdown', (e) => {
      if (state.tiles.length < 2) return;
      const slot = e.target.closest('.lb-slot');
      if (!slot) return;
      // Klik na × tlačítko nezačíná pan
      if (e.target.closest('.lb-slot-remove')) return;
      const slotIdx = parseInt(slot.dataset.slotIdx, 10);
      const pz = state.panZoom[slotIdx];
      if (!pz) return;
      slot.classList.add('is-dragging');
      slot.setPointerCapture(e.pointerId);
      panStart = { x: e.clientX, y: e.clientY, slotIdx, startPanX: pz.x, startPanY: pz.y };
    });
    stage.addEventListener('pointermove', (e) => {
      if (!panStart) return;
      const dx = e.clientX - panStart.x;
      const dy = e.clientY - panStart.y;
      const pz = state.panZoom[panStart.slotIdx];
      pz.x = panStart.startPanX + dx;
      pz.y = panStart.startPanY + dy;
      const slot = stage.querySelector(`.lb-slot[data-slot-idx="${panStart.slotIdx}"]`);
      const img = slot?.querySelector('img');
      if (img) {
        img.style.setProperty('--pan-x', pz.x + 'px');
        img.style.setProperty('--pan-y', pz.y + 'px');
      }
    });
    stage.addEventListener('pointerup', () => {
      if (!panStart) return;
      const slot = stage.querySelector(`.lb-slot[data-slot-idx="${panStart.slotIdx}"]`);
      slot?.classList.remove('is-dragging');
      panStart = null;
    });
    stage.addEventListener('pointercancel', () => {
      const dragging = stage.querySelector('.lb-slot.is-dragging');
      dragging?.classList.remove('is-dragging');
      panStart = null;
    });

    // Wheel zoom per tile (jen N≥2, jinak wheel = horizontal nav viz výše)
    stage.addEventListener('wheel', (e) => {
      if (state.tiles.length < 2) return;
      const slot = e.target.closest('.lb-slot');
      if (!slot) return;
      const slotIdx = parseInt(slot.dataset.slotIdx, 10);
      const pz = state.panZoom[slotIdx];
      if (!pz) return;
      e.preventDefault();
      const delta = e.deltaY > 0 ? -0.1 : 0.1;
      pz.zoom = Math.max(0.5, Math.min(5, pz.zoom + delta));
      const img = slot.querySelector('img');
      if (img) img.style.setProperty('--zoom', String(pz.zoom));
    }, { passive: false });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
