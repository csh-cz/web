---
/**
 * Kompozitní ikona „věžní hodiny": civilní/sakrální budova (fa-landmark)
 * s hodinovým ciferníkem (fa-clock) ve štítu. Neutrální pro kostelní
 * i radniční věže (bez kříže). Měřítko se řídí `font-size` containeru.
 *
 * Ciferník je obarven na barvu pozadí (`--color-bg-elevated`), takže
 * „prosvítá" štítem budovy jako zapuštěný ciferník — vyříznuté ručičky
 * fa-solid ukazují barvu budovy. Funguje v light i dark motivu.
 *
 * Určeno pro VĚTŠÍ ikony (≥ ~1,4 rem). V malých kontextech (chip,
 * cross-ref) použij prosté `fa-solid fa-landmark` — ciferník by se slil.
 */
interface Props {
  /** Doplňková třída na wrapper (propaguje velikost / barvu). */
  class?: string;
}
const { class: cls } = Astro.props;
---
<span class:list={['tower-clock', cls]} aria-hidden="true">
  <i class="fa-solid fa-landmark tower-clock-base"></i>
  <i class="fa-solid fa-clock tower-clock-dial"></i>
</span>
<style>
  .tower-clock {
    position: relative;
    display: inline-block;
    line-height: 1;
  }
  .tower-clock-base {
    display: block;
  }
  .tower-clock-dial {
    position: absolute;
    font-size: 0.26em;
    top: 0.16em;
    left: 50%;
    transform: translateX(-50%);
    /* Ciferník v barvě pozadí → zapuštěný do štítu budovy,
       ručičky (negativní prostor fa-solid) ukazují barvu budovy. */
    color: var(--color-bg-elevated);
  }
</style>
