  .ru-half {
    white-space: nowrap;
    font-weight: 600;
    color: var(--color-text);
  }
  .ru-half::before {
    content: '';
    display: inline-block;
    width: 0.85em;
    height: 0.85em;
    margin-right: 0.35em;
    border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, 0.35);
    vertical-align: -0.08em;
  }
  .ru-predlit::before { background: #c9a227; }
  .ru-zalit::before   { background: #b5654a; }
  .ru-kondo::before   { background: #7c8a6a; }

  .hainz-filtry {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.6rem;
    align-items: center;
  }
  .hainz-filtr {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--color-text-soft);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.6rem 0.15rem 0.4rem;
    cursor: pointer;
    user-select: none;
    background: color-mix(in srgb, var(--color-bg-elevated) 60%, transparent);
  }
  .hainz-filtr:has(input:not(:checked)) {
    opacity: 0.45;
  }
  .hainz-filtr input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .hainz-filtr-tecka {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--pin-barva, var(--color-brass));
    display: inline-block;
    flex: none;
  }
  .hainz-filtr-n {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
  .hainz-filtr-btn {
    font-size: 0.75rem;
    color: var(--color-brass-bright);
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    cursor: pointer;
  }
  .hainz-filtr-hranice {
    margin-left: auto;
    border-style: dashed;
  }
  :global(.ru-tooltip) {
    font-family: var(--font-serif);
    font-size: 0.78rem;
    background: var(--color-bg-elevated);
    color: var(--color-text-soft);
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
  }
  /* stálé popisky korunních zemí na mapě */
  :global(.ru-popisek) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    color: #7a4a2b;
    opacity: 0.85;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    text-shadow:
      0 0 3px #f6f1e5, 0 0 3px #f6f1e5, 0 0 3px #f6f1e5;
    pointer-events: none;
    background: none;
    border: none;
  }
  /* názvy evropských států — velké „atlasové" kapitálky (odliší od korunních zemí) */
  :global(.evropa-popisek) {
    font-style: normal;
    font-variant: small-caps;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    opacity: 0.72;
  }

  .hainz-stat-grid {
    display: grid;
