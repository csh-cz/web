  }
  .ring-zeleny { box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px #4a9e5c; }
  .ring-zlaty  { box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px #d9a521; }
  .ring-modry  { box-shadow: 0 0 0 2.5px #7ec8e3; }
  .ring-prerus { border-style: dashed; opacity: 0.6; }
