---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';
import { hainz1904, hainzNeurceno } from '../data/hainz1904';

// Kategorie: pořadí, popisky, barvy pinů
const KATEGORIE: Record<string, { label: string; barva: string }> = {
  sakralni:   { label: 'Kostely a sakrální stavby', barva: '#d4b13d' },
  radnice:    { label: 'Radnice',                   barva: '#c0563f' },
  zamek:      { label: 'Zámky',                     barva: '#a678b8' },
  skola:      { label: 'Školy',                     barva: '#5b9bd5' },
  nadrazi:    { label: 'Nádraží',                   barva: '#4fae8f' },
  prumysl:    { label: 'Továrny a průmysl',         barva: '#97a05a' },
  kandelabr:  { label: 'Kandelábry a pouliční hodiny', barva: '#e6d47a' },
  zdymadlo:   { label: 'Vltavská kanalizace',       barva: '#58b8cc' },
  instituce:  { label: 'Instituce a úřady',         barva: '#cf8fb0' },
  zastoupeni: { label: 'Obchodní zastoupení',       barva: '#8d8d8d' },
  ostatni:    { label: 'Ostatní',                   barva: '#b5a58f' },
};

const ZEME_NAZVY: Record<string, string> = {
  CZ: 'Česko', PL: 'Polsko', UA: 'Ukrajina', SK: 'Slovensko', HU: 'Maďarsko',
  AT: 'Rakousko', HR: 'Chorvatsko', RS: 'Srbsko', BA: 'Bosna a Hercegovina',
  SI: 'Slovinsko', IT: 'Itálie', RO: 'Rumunsko', BG: 'Bulharsko', RU: 'Rusko',
};

const pocetHodin = hainz1904.reduce((s, z) => s + z.pocet, 0);
const pocetElektro = hainz1904.filter((z) => z.elektro).length;
const pocetBudova = hainz1904.filter((z) => z.presnost === 'budova').length;
const pocetZaniklo = hainz1904.filter((z) => z.zaniklo).length;

const katStat = Object.keys(KATEGORIE)
  .map((k) => ({ k, ...KATEGORIE[k], n: hainz1904.filter((z) => z.kategorie === k).length }))
  .filter((x) => x.n > 0);

const zemeStat = Object.entries(
  hainz1904.reduce((acc: Record<string, number>, z) => {
    acc[z.zeme] = (acc[z.zeme] || 0) + z.pocet;
    return acc;
  }, {})
).sort((a, b) => b[1] - a[1]);

// Rozdělení podle korunních zemí monarchie / zahraničních entit (stav 1904)
const zeme1904Stat = Object.entries(
  hainz1904.reduce((acc: Record<string, number>, z) => {
    acc[z.zeme1904] = (acc[z.zeme1904] || 0) + z.pocet;
    return acc;
  }, {})
).sort((a, b) => b[1] - a[1]);

// seznam pod mapou: CZ podle okresu, zahraničí podle země
const zahranici = [...new Set(hainz1904.filter((z) => z.zeme !== 'CZ').map((z) => z.zeme))]
  .sort((a, b) => (ZEME_NAZVY[a] || a).localeCompare(ZEME_NAZVY[b] || b, 'cs'));
const mistaCZ = [...new Set(hainz1904.filter((z) => z.zeme === 'CZ').map((z) => z.misto))]
  .sort((a, b) => a.localeCompare(b, 'cs'));
---
<Base
  title="Hodiny firmy Hainz do roku 1904 — mapa"
  description={`Interaktivní mapa ${hainz1904.length} instalací věžních a veřejných hodin pražské firmy Ludwig Hainz podle firemního seznamu z roku 1904 — od Prahy přes Halič po Split a Sant’Elpidio a Mare.`}
>
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/virtualni-muzeum', label: 'Virtuální muzeum' },
    { label: 'Hainz 1904 — mapa' },
  ]} />

  <header class="max-w-3xl mb-10">
    <p class="eyebrow mb-4">Firemní seznam z roku 1904</p>
    <h1 class="hero-title mb-5 hero-title-sm">Kam všude dodala firma Hainz hodiny</h1>
    <p class="text-[var(--color-text)] leading-relaxed">
      Pražská továrna <a href="/hodinari/l-hainz"><strong>Ludwig Hainz</strong></a> vydala
      počátkem roku 1905 leták se seznamem všech míst, kam do konce roku 1904 dodala
      věžní nebo jiné veřejné hodiny — <strong
      class="text-[var(--color-brass-bright)]">{pocetHodin} hodin</strong> na
      <strong class="text-[var(--color-brass-bright)]">{hainz1904.length} místech</strong> od
      Petrohradu… vlastně od ruských Klinců přes Halič, Vídeň a Budapešť po Split
      a italské Sant’Elpidio a Mare. Každou položku jsme identifikovali a zanesli
      do mapy. Souvislosti popisuje <a href="/virtualni-muzeum/hainz-seznam-1904">doprovodný
      článek</a>.
    </p>
    <p class="text-[var(--color-text-soft)] leading-relaxed mt-3 intro-text">
      {pocetBudova} pinů míří na konkrétní budovu (kostel, radnici, zámek, nádraží,
      továrnu či zdymadlo), ostatní na střed obce. Položky s otazníkem v popisku mají nejistou identifikaci.
      Zvlášť jsou vyznačeny elektrické hodinové systémy ({pocetElektro} instalací) —
      na svou dobu žhavá novinka.
    </p>
  </header>

  <!-- ═══ FILTRY ═══ -->
  <section class="mb-4" aria-label="Filtry mapy">
    <div class="hainz-filtry" id="hainz-filtry">
      {katStat.map((k) => (
        <label class="hainz-filtr" style={`--pin-barva: ${k.barva}`}>
          <input type="checkbox" checked data-kat={k.k} />
          <span class="hainz-filtr-tecka" aria-hidden="true"></span>
          {k.label} <span class="hainz-filtr-n">{k.n}</span>
        </label>
      ))}
      <button type="button" id="hainz-filtr-vse" class="hainz-filtr-btn">vše</button>
      <button type="button" id="hainz-filtr-nic" class="hainz-filtr-btn">nic</button>
      <label class="hainz-filtr hainz-filtr-hranice" title="Historické hranice monarchie a korunních zemí (HistoGIS, stav 1910)">
        <input type="checkbox" id="hainz-vrstva-ru" />
        <span class="hainz-filtr-tecka" style="--pin-barva: #7a4a2b" aria-hidden="true"></span>
        hranice Rakouska-Uherska (1910)
      </label>
      <label class="hainz-filtr hainz-filtr-hranice" title="Hranice evropských států kolem roku 1910 (stav před balkánskými válkami 1912–13)">
        <input type="checkbox" id="hainz-vrstva-evropa" />
        <span class="hainz-filtr-tecka" style="--pin-barva: #6a6f8a" aria-hidden="true"></span>
        hranice evropských států (kolem 1910)
      </label>
    </div>
  </section>

  <div id="hainz-vyber" class="hainz-vyber" hidden>
    Zvýrazněno: <strong id="hainz-vyber-text"></strong>
    <button type="button" id="hainz-vyber-zrus" aria-label="Zrušit zvýraznění">zrušit ✕</button>
  </div>

  <div id="hainz-mapa" class="mapa-canvas" role="region" aria-label="Mapa instalací hodin firmy Hainz do roku 1904"></div>

  <ul class="hainz-ring-legenda" aria-label="Vysvětlivky značení pinů">
    <li><span class="ring-swatch ring-zeleny"></span> <strong>zelený prsten</strong> — stroj dochován dle <a href="/soupis-veznich-hodin">našeho soupisu</a></li>
    <li><span class="ring-swatch ring-zlaty"></span> <strong>zlatý prsten</strong> — jinde doložený Hainzův stroj</li>
    <li><span class="ring-swatch ring-modry"></span> <strong>modrý prsten</strong> — elektrická instalace (1904)</li>
    <li><span class="ring-swatch ring-prerus"></span> <strong>přerušovaný okraj</strong> — nejistá identifikace</li>
    <li><span class="ring-swatch ring-zaniklo"></span> <strong>tmavá výplň</strong> — zaniklá stavba (pin na bývalém místě)</li>
    <li><span class="ring-swatch"></span> barva výplně = typ objektu (viz filtry výše)</li>
  </ul>

  <p id="hainz-ru-legenda" class="hainz-ru-legenda" hidden>
    Barva výplně rozlišuje dvě poloviny monarchie:
    <span class="ru-half ru-predlit">Předlitavsko</span> (rakouská část),
    <span class="ru-half ru-zalit">Zalitavsko</span> (země uherské koruny) a
    <span class="ru-half ru-kondo">Bosna a Hercegovina</span> (společné kondominium).
  </p>

  <p id="hainz-evropa-legenda" class="hainz-ru-legenda" hidden>
    Politická mapa Evropy kolem roku 1910 (stav před balkánskými válkami 1912–13) — Německé
    císařství, Ruské impérium, Osmanská říše a další. Najetím na stát se zobrazí jeho tehdejší název.
  </p>

  <p class="text-sm text-[var(--color-text-muted)] mt-2 mb-12">
    Podklad: © přispěvatelé OpenStreetMap (ODbL), dlaždice OpenFreeMap.
    Historické hranice (stav 1910): HistoGIS, ACDH-ÖAW, CC BY 4.0.
    Poloha pinů: {pocetBudova}× budova, zbytek střed obce; {pocetZaniklo}× stavba už nestojí (tmavý pin na bývalém místě).
  </p>

  <!-- ═══ STATISTIKY ═══ -->
  <section class="mb-14">
    <h2 class="text-3xl mb-5 h2-flush">Čísla ze seznamu</h2>
    <p class="text-sm text-[var(--color-text-muted)] mb-4">
      Klepnutím na řádek zvýrazníte odpovídající místa na mapě.
    </p>
    <div class="hainz-stat-grid">
      <div>
        <h3 class="lokace-list-h">Podle typu objektu</h3>
        <ul class="hainz-stat-list">
          {katStat.map((k) => (
            <li class="hainz-stat-row" role="button" tabindex="0" data-dim="typ" data-val={k.k}>
              <span class="hainz-filtr-tecka" style={`--pin-barva: ${k.barva}`} aria-hidden="true"></span>
              {k.label}
              <strong>{k.n}</strong>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="lokace-list-h">Podle dnešních zemí (počet hodin)</h3>
        <ul class="hainz-stat-list">
          {zemeStat.map(([cc, n]) => (
            <li class="hainz-stat-row" role="button" tabindex="0" data-dim="zeme" data-val={cc}>
              {ZEME_NAZVY[cc] || cc} <strong>{n}</strong>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="lokace-list-h">Podle korunních zemí (stav 1904)</h3>
        <ul class="hainz-stat-list">
          {zeme1904Stat.map(([zeme, n]) => (
            <li class="hainz-stat-row" role="button" tabindex="0" data-dim="zeme1904" data-val={zeme}>
              {zeme} <strong>{n}</strong>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ SEZNAM LOKALIT ═══ -->
  <section class="mb-14">
    <h2 class="text-3xl mb-5 h2-flush">Rejstřík lokalit</h2>
    <p class="text-sm text-[var(--color-text-muted)] mb-4">
      Klepnutím na místo přeletíte na jeho značku na mapě.
    </p>
    <h3 class="lokace-list-h">Česko — {mistaCZ.length} míst</h3>
    <ul class="lokace-list mb-8">
      {mistaCZ.map((m) => {
        const zaznamy = hainz1904.filter((z) => z.zeme === 'CZ' && z.misto === m);
        const nejiste = zaznamy.some((z) => z.nejiste);
        return (
          <li class="text-[var(--color-text-soft)]">
            <button type="button" class="lokace-odkaz" data-misto={m}>{m}</button>{nejiste && ' (?)'} —
            {' '}{zaznamy.map((z) => z.objekt).join(', ')}
          </li>
        );
      })}
    </ul>
    <h3 class="lokace-list-h">Za dnešními hranicemi</h3>
    <ul class="lokace-list">
      {zahranici.map((cc) => {
        const mista = [...new Set(hainz1904.filter((z) => z.zeme === cc).map((z) => z.misto))]
          .sort((a, b) => a.localeCompare(b, 'cs'));
        return (
          <li class="text-[var(--color-text-soft)]">
            <strong class="text-[var(--color-text)]">{ZEME_NAZVY[cc] || cc}:</strong>{' '}
            {mista.map((m, i) => (
              <>{i > 0 && ', '}<button type="button" class="lokace-odkaz" data-misto={m}>{m}</button></>
            ))}
          </li>
        );
      })}
    </ul>
  </section>

  <!-- ═══ SHODA SE SOUPISEM ═══ -->
  <section class="mb-14 max-w-3xl">
    <h2 class="text-3xl mb-5 h2-flush">Shoda s naším soupisem věžních hodin</h2>
    <p class="text-[var(--color-text-soft)] leading-relaxed mb-3">
      Sedm míst z letáku 1904 najdete i v našem <a href="/soupis-veznich-hodin">soupisu
      věžních hodin</a> — tam je Hainzův stroj doložen konkrétní kartou, většinou
      dodnes <em>in situ</em>. Nezávisle to potvrzuje dodávky ze seznamu:
    </p>
    <ul class="lokace-list">
      <li class="text-[var(--color-text-soft)]"><a class="lokace-odkaz" href="/soupis-veznich-hodin/1893-domazlice-hainz">Domažlice — radnice</a> (L. Hainz 1891–1893)</li>
      <li class="text-[var(--color-text-soft)]"><a class="lokace-odkaz" href="/soupis-veznich-hodin/1880-hlubos-skala-2004">Hluboš — zámek</a> (L. Hainz 1880)</li>
      <li class="text-[var(--color-text-soft)]"><a class="lokace-odkaz" href="/soupis-veznich-hodin/nedatovano-tvorsovice-skala-2004">Tvoršovice — zámek</a></li>
      <li class="text-[var(--color-text-soft)]"><a class="lokace-odkaz" href="/soupis-veznich-hodin/nedatovano-chocerady-skala-2004">Chocerady — kostel</a></li>
      <li class="text-[var(--color-text-soft)]"><a class="lokace-odkaz" href="/soupis-veznich-hodin/nedatovano-zlonice-skala-2004">Zlonice — kostel</a></li>
      <li class="text-[var(--color-text-soft)]"><a class="lokace-odkaz" href="/soupis-veznich-hodin/1896-strenice-skala-2004">Strenice — kostel</a> (L. Hainz 1896)</li>
      <li class="text-[var(--color-text-soft)]"><a class="lokace-odkaz" href="/soupis-veznich-hodin/1902-olomouc-hainz-jankowsky-vmo">Olomouc</a> (L. Hainz 1902, dnes v muzeu)</li>
    </ul>
    <p class="text-sm text-[var(--color-text-muted)] mt-3">
      Na mapě jsou tato místa (kde je stroj dle soupisu dochován <em>in situ</em>)
      vyznačena <strong style="color:#4a9e5c">zeleným prstenem</strong>; odkaz na
      kartu soupisu vede i přímo z bubliny.
    </p>
  </section>

  <!-- ═══ DOLOŽENÉ STROJE V CIZINĚ ═══ -->
  <section class="mb-14 max-w-3xl">
    <h2 class="text-3xl mb-5 h2-flush">Doložené Hainzovy stroje v cizině</h2>
    <p class="text-[var(--color-text-soft)] leading-relaxed mb-3">
      U několika zahraničních položek se podařilo najít nezávislý pramen, který
      Hainzův (resp. „Heinzův") stroj jmenovitě potvrzuje. Několik z nich <strong>jde
      dodnes</strong>:
    </p>
    <ul class="lokace-list">
      <li class="text-[var(--color-text-soft)]"><button type="button" class="lokace-odkaz" data-misto="Krakov — Wawel">Krakov — Wawel</button> — čtvrťový stroj „firmy L. Heinza z Prahy", spuštěný v říjnu 1899, dodnes funkční (kyvadlo 196 cm)</li>
      <li class="text-[var(--color-text-soft)]"><button type="button" class="lokace-odkaz" data-misto="Nowy Sącz (Neu-Sandec)">Nowy Sącz — radnice</button> — „zegar firmy Heinz" z Prahy, osazený 1901, dodnes funkční, o stroj pečují hodináři Dobrzańští</li>
      <li class="text-[var(--color-text-soft)]"><button type="button" class="lokace-odkaz" data-misto="Rzeszów">Rzeszów — radnice</button> — dochovaný stroj „Ludwik Hainz, Praha" (památkový úřad WUOZ Przemyśl)</li>
      <li class="text-[var(--color-text-soft)]"><button type="button" class="lokace-odkaz" data-misto="Sanok">Sanok — radnice</button> — pražský stroj spuštěný 1906, po výměně 2007 zachován jako muzejní exponát</li>
      <li class="text-[var(--color-text-soft)]"><button type="button" class="lokace-odkaz" data-misto="Silistra">Silistra (Bulharsko) — galerie</button> — bývalá pedagogická škola z roku 1892; na střešní věži dodnes čtyřciferníkový stroj, který bulharské prameny připisují „firmě Heinz-Prague"</li>
    </ul>
    <p class="text-sm text-[var(--color-text-muted)] mt-3">
      Tato místa jsou na mapě vyznačena <strong style="color:#d9a521">zlatým prstenem</strong>.
      Další zahraniční položky (Skawina — secesní radnice z 1904, Zakopane, Chyrów,
      Stryj a další) mají věž s hodinami chronologicky odpovídající dodávce, konkrétní
      doklad výrobce se ale zatím nenašel — viz poznámky v bublinách.
    </p>
  </section>

  <!-- ═══ NEURČENO ═══ -->
  <section class="mb-14 max-w-3xl">
    <h2 class="text-3xl mb-5 h2-flush">Co se nepodařilo určit</h2>
    <p class="text-[var(--color-text-soft)] leading-relaxed mb-4">
      Dvě položky seznamu se zatím nepodařilo jednoznačně lokalizovat — jde
      o jména, která v Čechách nese příliš mnoho obcí. Pokud poznáte, o kterou
      jde, <a href="mailto:info@orloj.eu">napište nám</a>.
    </p>
    <ul class="lokace-list">
      {hainzNeurceno.map((n) => (
        <li class="text-[var(--color-text-soft)]">
          <strong class="text-[var(--color-text)]"><em>{n.original}</em></strong> — {n.pozn}
        </li>
      ))}
    </ul>
  </section>

  <!-- ═══ ZDROJ ═══ -->
  <section class="max-w-3xl mb-8">
    <h2 class="text-3xl mb-5 h2-flush">Pramen</h2>
    <p class="text-[var(--color-text-soft)] leading-relaxed">
      <em>Ortsverzeichnis der bis Ende 1904 zur Aufstellung gebrachten Turm- oder
      sonstigen öffentlichen Uhren.</em> Praha: Ludwig Hainz, Uhrenfabrik in Prag,
      Altstädter Ring No. 483, [1905]. Tisk Alois Wiesner, Praha. Sken poskytnut
      z archivu firmy L. Hainz. Přepis, identifikace lokalit a mapové zpracování:
      Český spolek horologický, 2026. Podrobnosti o letáku i firmě najdete
      v <a href="/virtualni-muzeum/hainz-seznam-1904">doprovodném článku</a>
      a v <a href="/hodinari/l-hainz">medailonu firmy</a>.
    </p>
  </section>
</Base>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<!-- maplibre-gl připnuto na 3.6.2 = konzervativní párování se starým pluginem
     maplibre-gl-leaflet@0.0.22 (vlastní příčinu mizejícího podkladu ale řeší
     glResize() při zoomu, ne verze — viz init mapy níže). -->
<script is:inline src="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js"></script>
<script is:inline src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.0.22/leaflet-maplibre-gl.js"></script>

<script is:inline define:vars={{ zaznamy: hainz1904, kategorie: KATEGORIE, zemeNazvy: ZEME_NAZVY }}>
  function popupHtml(z) {
    const nejiste = z.nejiste ? ' <span title="nejistá identifikace">(?)</span>' : '';
    const okres = z.okres && z.okres !== 'Praha' ? `, okres ${z.okres}` : '';
    const zeme = z.zeme !== 'CZ' ? ` (${zemeNazvy[z.zeme] || z.zeme})` : '';
    const elektro = z.elektro ? '<p><strong>⚡ elektrická hodinová instalace</strong></p>' : '';
    const presnost = z.zaniklo
      ? '<p class="popup-meta">pin: bývalé místo stavby (nedochovala se)</p>'
      : z.presnost === 'budova'
      ? '<p class="popup-meta">pin: konkrétní budova</p>'
      : '<p class="popup-meta">pin: střed obce</p>';
    const pozn = z.pozn ? `<p class="popup-meta">${z.pozn}</p>` : '';
    const badge = z.dochovano === 'in_situ'
      ? '<p class="popup-dochovano">✓ stroj dochován in situ (náš soupis)</p>'
      : z.dochovano === 'muzeum'
      ? '<p class="popup-dochovano popup-dochovano-muzeum">◆ stroj dochován v muzeu (náš soupis)</p>'
      : z.dolozenyStroj === 'zachovan'
      ? '<p class="popup-dochovano popup-dolozeny">★ doložený Hainzův stroj, zachován</p>'
      : z.dolozenyStroj === 'exponat'
      ? '<p class="popup-dochovano popup-dolozeny">★ doložený Hainzův stroj, dnes muzejní exponát</p>'
      : '';
    const soupis = z.soupisSlug
      ? `<p class="popup-soupis"><a href="/soupis-veznich-hodin/${z.soupisSlug}">→ karta v soupisu věžních hodin</a></p>`
      : '';
    return `<p class="popup-title"><strong>${z.misto}</strong>${nejiste}${zeme}</p>` +
      `<p>${z.objekt}${z.pocet > 1 ? ` — ${z.pocet} ks` : ''}${okres}</p>` +
      elektro +
      `<p class="popup-original">„${z.original}"</p>` +
      pozn + badge + soupis + presnost;
  }

  // Init až po DOMContentLoaded — v dev módu se scoped styly načítají jako
  // module (deferred); okamžitý běh by inicializoval Leaflet nad kontejnerem
  // s nulovou výškou a markercluster by nevykreslil nic.
  function initHainzMapa() {

  // @ts-expect-error Leaflet z CDN
  const mapa = L.map('hainz-mapa', { zoomControl: true, scrollWheelZoom: false, maxZoom: 18 })
    .setView([49.7, 15.5], 7);
  // Vektorový podklad: vlastní minimální „soudobý" styl (jen dnešní státy
  // a významná města; detail ulic až od velkého přiblížení) nad dlaždicemi
  // OpenFreeMap. Bez API klíče, bez limitů, self-hostovatelné; NEpoužíváme
  // produkčně tile.openstreetmap.org.
  // @ts-expect-error maplibre-gl-leaflet z CDN
  const glVrstva = L.maplibreGL({
    style: '/data/hainz/podklad-soudoby.json',
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> přispěvatelé | <a href="https://openfreemap.org">OpenFreeMap</a>',
  }).addTo(mapa);
  // FIX mizejícího podkladu (watchdog): maplibre-gl-leaflet nechává GL plátno
  // rozjeté ve velikosti i pozici vůči Leaflet kontejneru — po zoomu / při
  // studeném načtení se podklad vykreslí jen ve výřezu nebo zmizí (piny kreslí
  // Leaflet, ty jsou OK). resync() srovná GL: glMap.resize() VELIKOST a
  // mapa.fire('move') přinutí plugin (_update) srovnat POZICI/transform plátna —
  // bez resetu pohledu. Spouštíme z více NEZÁVISLÝCH zdrojů, protože Leaflet
  // 'zoomend' se v téhle kombinaci ne vždy propíše: ResizeObserver, Leaflet i
  // maplibre vlastní eventy, přímé DOM interakce a krátký watchdog na start.
  let resyncBezi = false;
  function resync() {
    if (resyncBezi) return;
    resyncBezi = true;
    try {
      const m = glVrstva.getMaplibreMap ? glVrstva.getMaplibreMap() : glVrstva._glMap;
      if (m && m.resize) m.resize();   // velikost GL plátna
      mapa.fire('move');               // → plugin _update = pozice/transform GL
    } catch (e) { /* no-op */ }
    finally { resyncBezi = false; }
  }
  const mapaEl = document.getElementById('hainz-mapa');
  try { new ResizeObserver(resync).observe(mapaEl); } catch (e) { /* starší prohlížeč */ }
  mapa.on('zoomend moveend', resync);
  try {
    const gm = glVrstva.getMaplibreMap && glVrstva.getMaplibreMap();
    if (gm && gm.on) { gm.on('moveend', resync); gm.on('idle', resync); }
  } catch (e) { /* no-op */ }
  ['dblclick', 'wheel'].forEach((ev) =>
    mapaEl.addEventListener(ev, () => setTimeout(resync, 300), { passive: true }));
  window.addEventListener('load', () => { mapa.invalidateSize(); resync(); });
  mapa.whenReady(resync);
  let wdN = 0;
  const wd = setInterval(() => { resync(); if (++wdN >= 20) clearInterval(wd); }, 500);

  // @ts-expect-error markercluster z CDN
  const cluster = L.markerClusterGroup({
    maxClusterRadius: 42,
    showCoverageOnHover: false,
    spiderfyOnMaxZoom: true,
  });
  mapa.addLayer(cluster);

  const markeryByMisto = new Map();
  const vsechnyMarkery = zaznamy.map((z) => {
    const classes = ['hainz-pin', `kat-${z.kategorie}`];
    if (z.zaniklo) classes.push('zaniklo');
    if (z.elektro) classes.push('elektro');
    if (z.nejiste) classes.push('nejiste');
    if (z.dochovano) classes.push('dochovano');
    if (z.dolozenyStroj) classes.push('dolozeny');
    // @ts-expect-error
    const icon = L.divIcon({ className: classes.join(' '), html: '', iconSize: [12, 12] });
    // @ts-expect-error
    const m = L.marker([z.lat, z.lon], { icon, title: `${z.misto} — ${z.objekt}` });
    m.bindPopup(popupHtml(z));
    if (!markeryByMisto.has(z.misto)) markeryByMisto.set(z.misto, []);
    markeryByMisto.get(z.misto).push(m);
    return { z, kat: z.kategorie, marker: m };
  });

  // ── zvýraznění (výběr přes statistiky) ──
  let vyber = null; // { dim, val }
  function odpovida(z) {
    if (!vyber) return true;
    if (vyber.dim === 'typ') return z.kategorie === vyber.val;
    if (vyber.dim === 'zeme') return z.zeme === vyber.val;
    if (vyber.dim === 'zeme1904') return z.zeme1904 === vyber.val;
    return true;
  }

  function prekresli() {
    const zapnute = new Set(
      [...document.querySelectorAll('#hainz-filtry input[data-kat]:checked')]
        .map((el) => el.dataset.kat)
    );
    cluster.clearLayers();
    for (const { z, kat, marker } of vsechnyMarkery) {
      if (zapnute.has(kat) && odpovida(z)) cluster.addLayer(marker);
    }
  }
  document.querySelectorAll('#hainz-filtry input[data-kat]').forEach((el) =>
    el.addEventListener('change', prekresli)
  );
  document.getElementById('hainz-filtr-vse').addEventListener('click', () => {
    document.querySelectorAll('#hainz-filtry input[data-kat]').forEach((el) => { el.checked = true; });
    prekresli();
  });
  document.getElementById('hainz-filtr-nic').addEventListener('click', () => {
    document.querySelectorAll('#hainz-filtry input[data-kat]').forEach((el) => { el.checked = false; });
    prekresli();
  });
  prekresli();

  function scrollMapuDoZobrazeni() {
    const box = document.getElementById('hainz-mapa').getBoundingClientRect();
    if (box.top < 0 || box.bottom > window.innerHeight) {
      document.getElementById('hainz-mapa').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  const chip = document.getElementById('hainz-vyber');
  const chipText = document.getElementById('hainz-vyber-text');
  function popisVyberu(v) {
    if (v.dim === 'typ') return (kategorie[v.val] && kategorie[v.val].label) || v.val;
    if (v.dim === 'zeme') return zemeNazvy[v.val] || v.val;
    return v.val;
  }
  function nastavVyber(dim, val) {
    if (vyber && vyber.dim === dim && vyber.val === val) { zrusVyber(); return; }
    vyber = { dim, val };
    // při zvýraznění zapnout všechny typy, aby výběr nebyl skrytý filtrem
    document.querySelectorAll('#hainz-filtry input[data-kat]').forEach((el) => { el.checked = true; });
    prekresli();
    chipText.textContent = popisVyberu(vyber);
    chip.hidden = false;
    document.querySelectorAll('.hainz-stat-row').forEach((el) => {
      el.classList.toggle('aktivni', el.dataset.dim === dim && el.dataset.val === val);
    });
    const matched = vsechnyMarkery.filter((x) => odpovida(x.z)).map((x) => x.marker);
    if (matched.length) {
      // @ts-expect-error
      const b = L.featureGroup(matched).getBounds();
      mapa.fitBounds(b, { padding: [40, 40], maxZoom: 12 });
    }
    scrollMapuDoZobrazeni();
  }
  function zrusVyber() {
    vyber = null;
    chip.hidden = true;
    document.querySelectorAll('.hainz-stat-row.aktivni').forEach((el) => el.classList.remove('aktivni'));
    prekresli();
  }
  document.getElementById('hainz-vyber-zrus').addEventListener('click', zrusVyber);

  document.querySelector('.hainz-stat-grid').addEventListener('click', (ev) => {
    const row = ev.target.closest('.hainz-stat-row');
    if (row) nastavVyber(row.dataset.dim, row.dataset.val);
  });
  document.querySelector('.hainz-stat-grid').addEventListener('keydown', (ev) => {
    if (ev.key !== 'Enter' && ev.key !== ' ') return;
    const row = ev.target.closest('.hainz-stat-row');
    if (row) { ev.preventDefault(); nastavVyber(row.dataset.dim, row.dataset.val); }
  });

  // ── proklik z rejstříku lokalit na značku ──
  function letNaMisto(misto) {
    const markery = markeryByMisto.get(misto);
    if (!markery || !markery.length) return;
    if (vyber) zrusVyber();
    document.querySelectorAll('#hainz-filtry input[data-kat]').forEach((el) => { el.checked = true; });
    prekresli();
    scrollMapuDoZobrazeni();
    const m = markery[0];
    // rozbalit případný cluster a otevřít popup
    cluster.zoomToShowLayer(m, () => m.openPopup());
    setTimeout(() => mapa.setView(m.getLatLng(), Math.max(mapa.getZoom(), 12), { animate: true }), 50);
  }
  document.body.addEventListener('click', (ev) => {
    const btn = ev.target.closest('.lokace-odkaz');
    if (btn) letNaMisto(btn.dataset.misto);
  });

  // ── Historická vrstva Rakouska-Uherska 1910 (HistoGIS, CC BY 4.0) ──
  // Lazy fetch při prvním zapnutí; vlastní pane pod markery.
  mapa.createPane('hranice-ru');
  mapa.getPane('hranice-ru').style.zIndex = '350';
  let vrstvaRU = null;
  const ATTR_RU = 'Hranice 1910: <a href="https://histogis.acdh.oeaw.ac.at/">HistoGIS</a> (ACDH-ÖAW), CC BY 4.0';

  async function nactiVrstvuRU() {
    const [zeme, hranice, popisky] = await Promise.all([
      fetch('/data/hainz/rakousko-uhersko-1910-zeme.geojson').then((r) => r.json()),
      fetch('/data/hainz/rakousko-uhersko-1910-hranice.geojson').then((r) => r.json()),
      fetch('/data/hainz/rakousko-uhersko-1910-popisky.geojson').then((r) => r.json()),
    ]);
    // @ts-expect-error Leaflet z CDN
    const g = L.layerGroup();
    // korunní země obarvené podle poloviny monarchie: Předlitavsko (rakouská
    // část) zlatě, Zalitavsko (uherská koruna sv. Štěpána) červeně, Bosna a
    // Hercegovina (společné kondominium) olivově.
    const ZALITAVSKO = new Set([
      'Königreich Ungarn',
      'Königreich Kroatien und Slawonien',
      'Freie Stadt Fiume mit Gebiet',
    ]);
    const KONDOMINIUM = new Set(['Bosnien und Herzegowina']);
    const RU_STYL = {
      predlitavsko: { fillColor: '#c9a227', color: '#9c7a4f' },
      zalitavsko:   { fillColor: '#b5654a', color: '#8a4a30' },
      kondominium:  { fillColor: '#7c8a6a', color: '#5f6b4f' },
    };
    const polovinaRU = (name) =>
      KONDOMINIUM.has(name) ? 'kondominium' : ZALITAVSKO.has(name) ? 'zalitavsko' : 'predlitavsko';
    // @ts-expect-error
    L.geoJSON(zeme, {
      pane: 'hranice-ru',
      style: (f) => {
        const s = RU_STYL[polovinaRU(f.properties && f.properties.name)];
        return { color: s.color, weight: 1, opacity: 0.7, dashArray: '4,3',
                 fillColor: s.fillColor, fillOpacity: 0.13 };
      },
      onEachFeature: (f, layer) => {
        if (f.properties && f.properties.name) {
          layer.bindTooltip(f.properties.name, { sticky: true, direction: 'top', className: 'ru-tooltip' });
        }
      },
    }).addTo(g);
    // vnější hranice monarchie — výraznější plná linka
    // @ts-expect-error
    L.geoJSON(hranice, {
      pane: 'hranice-ru',
      style: { color: '#7a4a2b', weight: 2.2, opacity: 0.85, fill: false },
      interactive: false,
    }).addTo(g);
    // názvy korunních zemí — stálé textové popisky (česky)
    // @ts-expect-error
    L.geoJSON(popisky, {
      pane: 'hranice-ru',
      pointToLayer: (f, latlng) =>
        // @ts-expect-error
        L.marker(latlng, {
          // @ts-expect-error
          icon: L.divIcon({ className: 'ru-popisek', html: f.properties.nazev, iconSize: null }),
          interactive: false,
          keyboard: false,
        }),
    }).addTo(g);
    return g;
  }

  document.getElementById('hainz-vrstva-ru').addEventListener('change', async (ev) => {
    const legenda = document.getElementById('hainz-ru-legenda');
    if (ev.target.checked) {
      if (!vrstvaRU) vrstvaRU = await nactiVrstvuRU();
      vrstvaRU.addTo(mapa);
      mapa.attributionControl.addAttribution(ATTR_RU);
      if (legenda) legenda.hidden = false;
    } else if (vrstvaRU) {
      mapa.removeLayer(vrstvaRU);
      mapa.attributionControl.removeAttribution(ATTR_RU);
      if (legenda) legenda.hidden = true;
    }
  });

  // ── Historická vrstva evropských států kolem 1910 ──
  // Data: historical-basemaps (A. Ourednik, GPL-3.0); snímek 1900 = konfigurace
  // Evropy platná do balkánských válek 1912–13. Ořez na Evropu + zjednodušeno.
  // Vlastní pane pod R-U detailem i pod markery.
  mapa.createPane('hranice-evropa');
  mapa.getPane('hranice-evropa').style.zIndex = '345';
  let vrstvaEvropa = null;
  const ATTR_EVROPA = 'Hranice ~1910: <a href="https://github.com/aourednik/historical-basemaps">historical-basemaps</a> (GPL-3.0)';

  async function nactiVrstvuEvropa() {
    const [staty, popisky] = await Promise.all([
      fetch('/data/hainz/evropa-staty-1910.geojson').then((r) => r.json()),
      fetch('/data/hainz/evropa-staty-1910-popisky.geojson').then((r) => r.json()),
    ]);
    // @ts-expect-error Leaflet z CDN
    const g = L.layerGroup();
    // teplá „atlasová" paleta — každý stát jiný odstín (jako R-U, jen víc barev)
    const PALETA = ['#c9a227', '#b5654a', '#7c8a6a', '#a8825b', '#8a8fae', '#b58aa0', '#6f9a8a'];
    const barvaStatu = (nazev) => {
      let h = 0;
      for (let i = 0; i < nazev.length; i++) h = (h * 31 + nazev.charCodeAt(i)) >>> 0;
      return PALETA[h % PALETA.length];
    };
    // @ts-expect-error
    L.geoJSON(staty, {
      pane: 'hranice-evropa',
      style: (f) => ({
        color: '#7a5a3a', weight: 1.2, opacity: 0.75, dashArray: '4,3',
        fillColor: barvaStatu((f.properties && f.properties.nazev) || ''), fillOpacity: 0.16,
      }),
      onEachFeature: (f, layer) => {
        if (f.properties && f.properties.nazev) {
          layer.bindTooltip(f.properties.nazev, { sticky: true, direction: 'top', className: 'ru-tooltip' });
        }
      },
    }).addTo(g);
    // stálé názvy států (mimo husté jádro R-U, které popisuje vrstva R-U)
    // @ts-expect-error
    L.geoJSON(popisky, {
      pane: 'hranice-evropa',
      pointToLayer: (f, latlng) =>
        // @ts-expect-error
        L.marker(latlng, {
          // @ts-expect-error
          icon: L.divIcon({ className: 'ru-popisek evropa-popisek', html: f.properties.nazev, iconSize: null }),
          interactive: false,
          keyboard: false,
        }),
    }).addTo(g);
    return g;
  }

  document.getElementById('hainz-vrstva-evropa').addEventListener('change', async (ev) => {
    const legenda = document.getElementById('hainz-evropa-legenda');
    if (ev.target.checked) {
      if (!vrstvaEvropa) vrstvaEvropa = await nactiVrstvuEvropa();
      vrstvaEvropa.addTo(mapa);
      mapa.attributionControl.addAttribution(ATTR_EVROPA);
      if (legenda) legenda.hidden = false;
    } else if (vrstvaEvropa) {
      mapa.removeLayer(vrstvaEvropa);
      mapa.attributionControl.removeAttribution(ATTR_EVROPA);
      if (legenda) legenda.hidden = true;
    }
  });

  } // initHainzMapa

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHainzMapa);
  } else {
    initHainzMapa();
  }
</script>

<style define:vars={{}}>
