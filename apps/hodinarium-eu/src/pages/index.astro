---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import catalog from '../data/catalog.json';
import { lokace } from '../data/lokace';
import { clanekHref } from '../data/url-helpers';

import type { CatalogEntry as Entry } from '../data/catalog-types';
const entries: Entry[] = catalog as Entry[];

// Featured: ručně vybrané 4 nejcennější/nejvizuálnější
const featuredSlugs = ['astro2_NTP', 'sobeslav3', 'svarcvaldky', 'decin_koncepce'];
const featured = featuredSlugs
  .map((s) => entries.find((e) => e.slug === s))
  .filter((e): e is Entry => Boolean(e));

// Náhodné z atlasu (4) — pro inspiraci
const browsable = entries
  .filter((e) => e.thumbnail && !featuredSlugs.includes(e.slug) && e.wordCount > 100)
  .sort(() => Math.random() - 0.5)
  .slice(0, 4);

// Statistiky
const total = entries.length;
const withImages = entries.filter((e) => e.thumbnail).length;
const totalImages = entries.reduce((s, e) => s + e.imageCount, 0);
const lokaceCount = lokace.length;
const oldestYear = Math.min(...entries.filter((e) => e.year && e.year > 1300).map((e) => e.year as number));
const newestYear = Math.max(...entries.filter((e) => e.year && e.year < 2030).map((e) => e.year as number));
---
<Base title="Hodinárium" description="Webová expozice Českého spolku horologického — sbírka hodin, projekty, expozice v Děčíně.">
  <!-- HERO -->
  <section class="hero-section mb-20">
    <div class="hero-grid">
      <div>
        <p class="eyebrow mb-5">Český spolek horologický</p>
        <h1 class="hero-title mb-6">
          Hodinárium
        </h1>
        <p class="hero-lede mb-8">
          {oldestYear ?? 1410} → {newestYear ?? 2025}.
          Sbírka, expozice a projekty obdivovatelů hodinařiny —
          od&nbsp;věžních strojů 15.&nbsp;století přes&nbsp;švarcvaldky
          až po&nbsp;astroláby řízené&nbsp;mikroprocesorem.
        </p>
        <div class="hero-cta">
          <a href="/sbirka" class="btn-primary">Procházet sbírku</a>
          <a href="/mapa-horologie" class="btn-secondary">Mapa horologie →</a>
        </div>
      </div>
      <div class="hero-stats" aria-label="Souhrn obsahu">
        <div class="stat">
          <span class="stat-num">{total}</span>
          <span class="stat-label">článků</span>
        </div>
        <div class="stat">
          <span class="stat-num">{totalImages}</span>
          <span class="stat-label">fotografií</span>
        </div>
        <div class="stat">
          <span class="stat-num">{lokaceCount}</span>
          <span class="stat-label">lokací</span>
        </div>
      </div>
    </div>
  </section>

  <div class="fleuron"></div>

  <!-- FEATURED -->
  <section class="mb-20" aria-labelledby="featured-heading">
    <header class="mb-8 flex items-end justify-between gap-4 flex-wrap">
      <div>
        <p class="eyebrow mb-3">Vybrané exponáty</p>
        <h2 id="featured-heading" class="text-3xl md:text-4xl" style="margin-top: 0;">Stojí za prohlídku</h2>
      </div>
      <a href="/tagy" class="text-sm">Procházet podle tagu →</a>
    </header>
    <div class="featured-grid">
      {featured.map((e) => (
        <Card
          href={clanekHref(e)}
          title={e.title}
          excerpt={e.excerpt}
          thumbnail={e.thumbnail}
          category={e.category}
          lastModified={e.lastModified}
          imageCount={e.imageCount}
        />
      ))}
    </div>
  </section>

  <!-- DVOJICE: ATLAS / MAPA -->
  <section class="mb-20" aria-labelledby="explore-heading">
    <header class="mb-8">
      <p class="eyebrow mb-3">Dva způsoby procházení</p>
      <h2 id="explore-heading" class="text-3xl md:text-4xl" style="margin-top: 0;">Najdi si svoji cestu</h2>
    </header>
    <div class="explore-grid">
      <a href="/tagy" class="explore-card">
        <div class="explore-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M6 14h36M6 24h36M6 34h36"/>
            <circle cx="14" cy="14" r="2"/>
            <circle cx="24" cy="24" r="2"/>
            <circle cx="34" cy="34" r="2"/>
          </svg>
        </div>
        <h3>Tagy</h3>
        <p>Filtr {withImages}+ článků podle vlastností — typ hodin, pohon, regulátor, období, lokace, výrobce.</p>
      </a>
      <a href="/mapa-horologie" class="explore-card">
        <div class="explore-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M24 4c-7 0-13 6-13 13 0 9 13 27 13 27s13-18 13-27c0-7-6-13-13-13z"/>
            <circle cx="24" cy="17" r="5"/>
          </svg>
        </div>
        <h3>Mapa horologie</h3>
        <p>Orloje, hodinářská muzea, věžní stroje a další zajímavosti na mapě Česka, Evropy i světa.</p>
      </a>
    </div>
  </section>

  <!-- NÁHODNÝ VÝBĚR -->
  <section class="mb-20" aria-labelledby="random-heading">
    <header class="mb-8 flex items-end justify-between gap-4 flex-wrap">
      <div>
        <p class="eyebrow mb-3">Pro inspiraci</p>
        <h2 id="random-heading" class="text-3xl md:text-4xl" style="margin-top: 0;">Náhodný výběr</h2>
      </div>
      <a href="/sbirka" class="text-sm">Procházet vše →</a>
    </header>
    <div class="featured-grid">
      {browsable.map((e) => (
        <Card
          href={clanekHref(e)}
          title={e.title}
          excerpt={e.excerpt}
          thumbnail={e.thumbnail}
          category={e.category}
          lastModified={e.lastModified}
          imageCount={e.imageCount}
        />
      ))}
    </div>
  </section>

  <div class="fleuron"></div>

  <!-- O WEBU + ORLOJ.EU -->
  <section class="grid md:grid-cols-2 gap-12 mt-16">
    <div>
      <h2 class="text-2xl mb-4" style="margin-top: 0;">O webu</h2>
      <p class="text-[var(--color-text)] mb-3 leading-relaxed">
        Webová expozice vychází z dlouholetého pozorování, restaurování a sbírání hodin
        v rámci spolku.
      </p>
      <p class="text-[var(--color-text)] leading-relaxed">
        Pokrývá od&nbsp;věžních strojů 15.&nbsp;století přes lidové švarcvaldky
        až po experimentální konstrukce s mikroprocesorem.
      </p>
    </div>
    <div>
      <h2 class="text-2xl mb-4" style="margin-top: 0;">Sesterský web — Orloj.eu</h2>
      <p class="text-[var(--color-text)] mb-3 leading-relaxed">
        <a href="https://orloj.eu">orloj.eu</a> se věnuje výhradně Pražskému orloji.
        Encyklopedický rozsah, simulátory, historie osobností.
      </p>
      <p class="text-[var(--color-text)] leading-relaxed">
        Z titulky vede odkaz, ze stránky každé osobnosti či detailu konstrukce
        rovnou na příslušnou kapitolu orloj.eu.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero-section {
    margin-top: 1rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }
  }

  .hero-lede {
    font-size: 1.25rem;
    line-height: 1.55;
    color: var(--color-text);
    max-width: 36ch;
    font-feature-settings: "lnum";
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary, .btn-secondary {
    font-family: var(--font-serif);
    padding: 0.7rem 1.4rem;
    font-size: 1rem;
    border-radius: 2px;
    text-decoration: none;
    border-bottom: none !important;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: all 150ms ease;
  }

  .btn-primary {
    background: var(--color-brass);
    color: var(--color-ink);
    border: 1px solid var(--color-brass-bright);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
    font-weight: 500;
  }

  .btn-primary:hover {
    background: var(--color-brass-bright);
    color: var(--color-ink);
  }

  .btn-secondary {
    background: var(--color-bg-elevated);
    color: var(--color-brass-bright);
    border: 1px solid color-mix(in srgb, var(--color-brass) 50%, transparent);
  }

  .btn-secondary:hover {
    border-color: var(--color-brass);
    background: var(--color-bg-deep);
  }

  /* Stats */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 1.5rem 2.5rem;
    padding: 1.75rem 2rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
  }

  @media (min-width: 900px) {
    .hero-stats {
      grid-template-columns: repeat(2, auto);
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-num {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 500;
    color: var(--color-brass-bright);
    line-height: 1;
    font-feature-settings: "lnum";
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-soft);
    text-transform: lowercase;
    letter-spacing: 0.04em;
    font-style: italic;
  }

  /* Featured grid */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  /* Explore cards */
  .explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .explore-card {
    display: block;
    padding: 2rem 1.75rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
    text-decoration: none;
    transition: all 200ms ease;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    color: var(--color-text);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .explore-card:hover {
    border-color: var(--color-brass);
    transform: translateY(-2px);
    border-bottom-color: var(--color-brass);
  }

  .explore-icon {
    width: 48px;
    height: 48px;
    color: var(--color-brass);
    margin-bottom: 1rem;
  }

  .explore-icon svg {
    width: 100%;
    height: 100%;
  }

  .explore-card h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-brass-bright);
    margin: 0 0 0.5rem;
    font-style: normal;
  }

  .explore-card h3::before { content: none; }

  .explore-card p {
    margin: 0;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.55;
  }
</style>
