---
import Base from '../../layouts/Base.astro';
import RedakceReportsPanel from '../../components/RedakceReportsPanel.astro';
import review from '../../data/_review.json';

/**
 * /redakce/ — Redakční přehled.
 *
 * Stránka pro přihlášené editory s přehledem dokumentů co potřebují
 * pozornost: chybí typ-tag, fotka, výrobce, umístění; krátké medailony
 * hodinářů; články bez perex; legacy /clanky/ odkazy; návrhy na smazání.
 *
 * Stránka je technicky public (= staticky vyrenderovaná v dist/), ale
 * data nejsou citlivá — jen seznam slugů a poznámek "k doplnění". Pro
 * běžného návštěvníka se nezobrazí, protože:
 *   1. JS hydration kontroluje /api/cms/auth/user — pokud není
 *      authenticated:true, ukáže "musíš se přihlásit jako editor"
 *      message a nezobrazí seznamy.
 *   2. Stránka není v top nav ani v /vice — dosažitelná jen ze /redakce
 *      přímou URL.
 *   3. (Volitelně) CF Access policy lze rozšířit aby pokrývala
 *      i /redakce/* — explicit guard. Zatím přes JS gating.
 *
 * Data se generují build-time skriptem /tmp/generate_review.py
 * (zachycen jako součást commitu C3) z aktuálního stavu content/.
 * Tj. po každém Pages CI buildu je report aktuální.
 *
 * Editor klikne na kartu/článek → odkaz vede do Sveltia CMS na editaci.
 */

// `unknown` cast preventuje strict type-narrowing — _review.json je
// generován build-time skriptem (build-review-report.ts) a tvar polí se
// vyvíjí (kniha → kniha+article+...). Runtime guards níž ošetřují missing
// fields; TS by tu jinak nutil přesně-shaped typ, který by se po každém
// rozšíření build skriptu rozbil.
const r = review as unknown as {
  generatedAt: string;
  summary: Record<string, number | number[]>;
  sections: {
    [key: string]: Array<{
      slug: string;
      title: string;
      category?: string;
      editUrl: string;
      wordCount?: number;
      legacyCount?: number;
      path?: string;
      note?: string;
    }>;
  };
};

interface SectionDef {
  key: keyof typeof r.sections;
  title: string;
  icon: string;
  description: string;
  priority: 'high' | 'medium' | 'low';
}

const sections: SectionDef[] = [
  {
    key: 'kartyPlaceholderTitle',
    title: 'Karty s placeholder titulkem',
    icon: '⚠',
    description: 'Karty s "[K doplnění]" nebo "K doplnění" v nadpisu — auto-generované stuby co potřebují skutečný titulek.',
    priority: 'high',
  },
  {
    key: 'kartyNoTyp',
    title: 'Karty bez typového tagu',
    icon: '🏷',
    description: 'Karty co nemají žádný typový tag (vezni/budik/sitovky/jednotny-cas/...). Bez něj se nezobrazí v dlaždicích na /sbirka/.',
    priority: 'high',
  },
  {
    key: 'hodinariShort',
    title: 'Krátké medailony hodinářů',
    icon: '👤',
    description: 'Hodináři/firmy s méně než 200 slovy v těle medailonu. Pro českou hodinářskou tradici (Janata, Krečmer, Prokeš…) doplňovat. Pro historicky / mezinárodně významné hodináře (Breguet, Huygens, Harrison…), které vedeme jen referenčně, **stub se shrnutím stačí** — primárním obsahem jsou tam zařazení do era + cross-link do článků, ne biografie.',
    priority: 'medium',
  },
  {
    key: 'kartyNoThumb',
    title: 'Karty bez náhledové fotky',
    icon: '🖼',
    description: 'Karty bez `thumbnail` field. Atlas / katalog je zobrazí bez ilustrace. Foto pipeline auto-detekce vyčerpána, zbytek vyžaduje fotodokumentaci ručně.',
    priority: 'medium',
  },
  {
    key: 'kartyNoVyrobce',
    title: 'Karty bez výrobce',
    icon: '🏭',
    description: 'Karty kde `karta.vyrobce` field chybí. Detekce z titulu je vyčerpána. Často jde o exponáty bez identifikované značky.',
    priority: 'medium',
  },
  {
    key: 'clankyShort',
    title: 'Krátké články',
    icon: '📄',
    description: 'Články pod 200 slov. Mohou být legitimně krátké (medailon muzea), nebo to jsou stuby co potřebují obsah.',
    priority: 'medium',
  },
  {
    key: 'clankyLegacyLinks',
    title: 'Články s legacy /clanky/ odkazy',
    icon: '🔗',
    description: 'Inline odkazy `/clanky/<slug>` v textu. CF Pages 301 redirect je v pořádku, ale vnitřní linky procházejí přes redirect — UX/SEO mírně horší. Postupně přepsat na čisté cesty.',
    priority: 'low',
  },
  {
    key: 'hodinariNoPortret',
    title: 'Hodináři bez portrétu',
    icon: '🖼',
    description: 'Medailony bez `portret` field. Pro známé osobnosti často existuje volný portrét na Wikipedii (CC BY-SA), pro firmy logo z webu výrobce.',
    priority: 'low',
  },
  {
    key: 'clankyNoTldr',
    title: 'Články bez perex (tldr)',
    icon: '📝',
    description: 'Články bez `tldr` field. Většinu auto-generoval skript v C2, zbylé vyžadují manuální napsání.',
    priority: 'low',
  },
  {
    key: 'kartyNoUmisteni',
    title: 'Karty bez umístění',
    icon: '📍',
    description: 'Karty kde `karta.umisteni` field chybí. Návštěvník nepozná, kde exponát fyzicky stojí.',
    priority: 'low',
  },
  {
    key: 'duplicates',
    title: 'Duplicitní soubory (Finder pattern)',
    icon: '🗑',
    description: 'macOS Finder/iCloud duplicates (`* 2.mdx`, `* 3.md`). Návrh na smazání — zachovat originál.',
    priority: 'high',
  },
  {
    key: 'stubsKarty',
    title: 'Karty označené jako stub',
    icon: '☐',
    description: 'Karty s frontmatter `isStub: true` — minimální data, čekají na manuální doplnění (typicky bulk import). Po revizi smaž flag.',
    priority: 'medium',
  },
  {
    key: 'stubsClanky',
    title: 'Články označené jako stub',
    icon: '☐',
    description: 'Články s `isStub: true` v jiných kategoriích než sbírka. Stejný princip — flag se smaže po revizi.',
    priority: 'medium',
  },
  {
    key: 'stubsHodinari',
    title: 'Medailony hodinářů — stub',
    icon: '☐',
    description: 'Hodinaři/firmy s `isStub: true`. Pro mezinárodně významné hodináře (Breguet, Huygens, …) je to OK referenční záznam — stub se shrnutím stačí. Pro české hodináře doplnit.',
    priority: 'low',
  },
  {
    key: 'stubsSoupis',
    title: 'Soupis věžních hodin — stub',
    icon: '☐',
    description: 'Záznamy soupisu s `isStub: true` — typicky bulk-import z Hellicha (1917) bez identifikace budovy / roku / stavu. Vyžadují dohledání v místních pramenech.',
    priority: 'medium',
  },
];

// const PRIORITY_COLORS = { high: 'red', medium: 'amber', low: 'gray' };  // (unused)

// Sumary stats
const totalIssues = Object.entries(r.sections)
  .reduce((sum, [, arr]) => sum + (Array.isArray(arr) ? arr.length : 0), 0);
const generatedDate = new Date(r.generatedAt).toLocaleString('cs-CZ');

// Karta total — z summary
const kartyTotal = (r.summary.kartyTotal as number) ?? 290;
const hodinariTotal = (r.summary.hodinariTotal as number) ?? 40;
---
<Base
  title="Redakční přehled"
  description="Stránka pro přihlášené editory — přehled dokumentů co potřebují pozornost."
>
  <header class="redakce-header">
    <p class="eyebrow mb-3">Pro editory</p>
    <h1 class="redakce-title">Redakční přehled</h1>
    <p class="redakce-lede">
      Seznam karet, článků a medailonů co potřebují <strong>review</strong>,
      <strong>doplnění</strong> nebo <strong>opravu</strong>.
    </p>
    <p class="redakce-meta">
      Vygenerováno: <time datetime={r.generatedAt}>{generatedDate}</time>
      &nbsp;·&nbsp; Karet: {kartyTotal} &nbsp;·&nbsp; Hodinářů: {hodinariTotal}
      &nbsp;·&nbsp; Issues: {totalIssues}
    </p>
  </header>

  <!-- Nápověda — jak stránku používat. Pro non-IT editory. -->
  <aside class="redakce-help" id="redakce-help-aside">
    <details>
      <summary>
        <strong>📖 Jak tuto stránku používat</strong>
        <span class="redakce-help-toggle-hint">(klikni pro otevření)</span>
      </summary>
      <div class="redakce-help-body">
        <h3>Co tady najdeš</h3>
        <p>
          Stránka ti ukazuje <strong>seznam položek na webu, které ještě nejsou
          úplné</strong> — chybí jim foto, popis výrobce, kategorie, nebo jiné
          detaily. Tobě jako redaktorovi pomáhá vědět, kde je co potřeba doplnit.
        </p>

        <h3>Jak je seznam organizovaný</h3>
        <ul>
          <li>
            <strong>Sekce</strong> jsou rozděleny podle typu chybějící informace
            (např. „Karty bez náhledové fotky").
          </li>
          <li>
            Každá sekce má barevný proužek vlevo:
            <span class="redakce-help-pill redakce-help-pill-high">červený = vysoká priorita</span>
            <span class="redakce-help-pill redakce-help-pill-medium">žlutý = střední</span>
            <span class="redakce-help-pill redakce-help-pill-low">šedý = nízká</span>
          </li>
          <li>
            U každé sekce vidíš <strong>počet</strong> (např. „93") — kolik
            položek je k doplnění.
          </li>
          <li>
            Klikni na <em>„Zobrazit seznam"</em> a rozbalí se ti seznam
            konkrétních karet/článků.
          </li>
        </ul>

        <h3>Jak něco opravit</h3>
        <ol>
          <li>
            Najdi v seznamu kartu nebo článek, který chceš opravit.
          </li>
          <li>
            <strong>Klikni na jeho jméno</strong> — automaticky se otevře
            redakční systém (CMS) přímo na editaci té položky.
          </li>
          <li>
            Doplň, co potřebuje — chybějící foto, výrobce, kategorii…
          </li>
          <li>
            Klikni v CMS dole vlevo <strong>„Save"</strong> (uložit).
            Změna se uloží a po několika minutách zmizí z tohoto seznamu.
          </li>
          <li>
            Po uložení tě CMS automaticky vrátí zpět na stránku co jsi
            upravoval — můžeš zkontrolovat, jak vypadá.
          </li>
        </ol>

        <h3>Co znamenají odborné termíny</h3>
        <dl class="redakce-help-glossary">
          <dt>Karta exponátu</dt>
          <dd>
            Strukturovaný popis jednoho předmětu ve sbírce (= „evidenční karta").
            Obsahuje inv. číslo, výrobce, datum, umístění v expozici atd.
          </dd>
          <dt>Článek</dt>
          <dd>
            Volný text — esej, návod, popis projektu, popis cizího muzea…
            Není to evidenční karta, ale narrativní obsah.
          </dd>
          <dt>Typ-tag</dt>
          <dd>
            Klíčové slovo, které říká „toto jsou věžní hodiny" /
            „toto je budík" / „toto jsou síťovky". Bez něj se karta
            nezobrazí v dlaždicích na stránce <em>Sbírka</em>.
          </dd>
          <dt>Thumbnail</dt>
          <dd>
            Náhledová fotka — to malé obrázkové dlaždice co návštěvník vidí
            v atlasu/katalogu. Bez něj je tam jen prázdný rámeček.
          </dd>
          <dt>Slug</dt>
          <dd>
            Krátký „technický" název v adrese stránky (např.
            <code>inv-100-strojek-hainz</code>). Vidíš ho jen jako
            poznámku — neměň ho, je to identifikátor.
          </dd>
          <dt>Tldr / perex</dt>
          <dd>
            Krátký souhrn článku (1–2 věty). Zobrazí se jako „upoutávka"
            v seznamech a na sociálních sítích.
          </dd>
        </dl>

        <h3>Co když si nevím rady?</h3>
        <p>
          Napiš na <a href="mailto:info@orloj.eu">info@orloj.eu</a> nebo zavolej
          Davidovi (+420&nbsp;603&nbsp;502&nbsp;735). Některé položky vyžadují
          fotky které nemáme nebo informace co není veřejně dostupná —
          v takovém případě je v pořádku je <strong>nechat na seznamu</strong>,
          nemusíš všechno vyřešit hned.
        </p>

        <h3>Tip pro starší editory</h3>
        <p>
          Stránka je <strong>jen pro tebe</strong> — když jsi přihlášen jako
          editor, vidíš ji. Běžný návštěvník Hodinária ji neuvidí, takže nemusíš
          mít obavu, že někdo uvidí „nedodělaný" stav. Je to pracovní seznam.
        </p>
      </div>
    </details>
  </aside>

  <!-- Auth gate — zobrazí se anonymous návštěvníkům -->
  <div id="redakce-auth-gate" class="redakce-auth-gate hidden">
    <h2>Přístup omezen</h2>
    <p>
      Tato stránka je dostupná jen pro přihlášené editory CSH. Přihlas se
      přes <a href="/admin/">CMS administraci</a> a vrať se na tuto stránku
      (cookies se sdílí mezi /admin/ a /redakce/, takže tě to po přihlášení
      pustí dál).
    </p>
  </div>

  <!-- Hlavní obsah — zobrazí se po JS auth check -->
  <div id="redakce-content" class="hidden">
    {/* Panel s open editor reports (z /api/admin/reports → GitHub Issues
        labelu web-bug). Hydratuje se klient-side po editor mode check. */}
    <RedakceReportsPanel />

    {sections.map((s) => {
      const items = r.sections[s.key];
      if (!items || items.length === 0) return null;
      return (
        <section class={`redakce-section redakce-priority-${s.priority}`} id={`section-${s.key}`}>
          <header class="redakce-section-header">
            <span class="redakce-section-icon" aria-hidden="true">{s.icon}</span>
            <h2 class="redakce-section-title">{s.title}</h2>
            <span class={`redakce-priority-badge redakce-priority-${s.priority}`}>{
              s.priority === 'high' ? 'Vysoká' : s.priority === 'medium' ? 'Střední' : 'Nízká'
            }</span>
            <span class="redakce-section-count">{items.length}</span>
          </header>
          <p class="redakce-section-desc">{s.description}</p>
          <details class="redakce-list-wrapper">
            <summary class="redakce-list-summary">Zobrazit seznam ({items.length})</summary>
            <ul class="redakce-list">
              {items.slice(0, 100).map((item) => (
                <li class="redakce-item">
                  {item.editUrl ? (
                    <a href={item.editUrl} class="redakce-item-link">
                      <strong>{item.title || item.slug}</strong>
                      {item.category && <span class="redakce-item-cat">[{item.category}]</span>}
                      {item.wordCount !== undefined && <span class="redakce-item-meta">{item.wordCount} slov</span>}
                      {item.legacyCount !== undefined && <span class="redakce-item-meta">{item.legacyCount}× legacy odkaz</span>}
                      <code class="redakce-item-slug">{item.slug}</code>
                    </a>
                  ) : (
                    <span class="redakce-item-static">
                      <strong>{item.path}</strong>
                      {item.note && <span class="redakce-item-meta">{item.note}</span>}
                    </span>
                  )}
                </li>
              ))}
              {items.length > 100 && (
                <li class="redakce-item-more">
                  … a dalších <strong>{items.length - 100}</strong>. Pro plný seznam dotaž se Davida (data jsou v <code>src/data/_review.json</code>).
                </li>
              )}
            </ul>
          </details>
        </section>
      );
    })}

    <!-- Kronika gap notice -->
    {(r.summary.kronikaGapYears as number[]).length > 0 && (
      <section class="redakce-section redakce-priority-medium">
        <header class="redakce-section-header">
          <span class="redakce-section-icon" aria-hidden="true">📅</span>
          <h2 class="redakce-section-title">Kronika — chybějící roky</h2>
          <span class="redakce-priority-badge redakce-priority-medium">Střední</span>
          <span class="redakce-section-count">{(r.summary.kronikaGapYears as number[]).length} let</span>
        </header>
        <p class="redakce-section-desc">
          Kronika nemá záznamy pro tyto roky. Lze je vytvořit z článku
          <a href="/admin/#/collections/clanky/entries/akvizice-2015-2025">akvizice-2015-2025</a>
          (split na sezónní záznamy) nebo z fotodokumentace expozice.
        </p>
        <p class="redakce-kronika-years">
          {(r.summary.kronikaGapYears as number[]).map((y) => (
            <a href={`/admin/#/collections/kronika/new?rok=${y}`} class="redakce-year-tag">{y}</a>
          ))}
        </p>
      </section>
    )}
  </div>

  <script is:inline>
    (async function () {
      // Auth gate — zkontroluj jestli editor má platnou CF Access session.
      let authenticated = false;
      try {
        const r = await fetch('/api/cms/auth/user', { credentials: 'include' });
        if (r.ok) {
          const ct = r.headers.get('content-type') || '';
          if (ct.includes('json')) {
            const u = await r.json();
            authenticated = !!u.authenticated;
          }
        }
      } catch (e) { /* anonymous */ }

      const gate = document.getElementById('redakce-auth-gate');
      const content = document.getElementById('redakce-content');
      if (authenticated) {
        content?.classList.remove('hidden');
        gate?.classList.add('hidden');
      } else {
        content?.classList.add('hidden');
        gate?.classList.remove('hidden');
      }
    })();
  </script>
</Base>

<style>
  .redakce-header {
    margin-bottom: 3rem;
    max-width: 800px;
  }
  .redakce-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-brass-bright);
    margin: 0 0 1rem;
    line-height: 1.05;
  }
  .redakce-lede {
    font-size: 1.05rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .redakce-meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-feature-settings: "lnum";
  }

  .redakce-auth-gate {
    background: var(--color-bg-elevated);
    border-left: 3px solid var(--color-copper);
    padding: 1.75rem 2rem;
    border-radius: 2px;
    max-width: 600px;
  }
  .redakce-auth-gate h2 {
    color: var(--color-brass-bright);
    margin: 0 0 0.75rem;
    border: none; padding: 0;
  }
  .redakce-auth-gate h2::before { content: none; }

  .redakce-section {
    margin-bottom: 2.5rem;
    background: var(--color-bg-elevated);
    border-left: 3px solid var(--color-text-muted);
    border-radius: 2px;
    padding: 1.5rem 1.75rem;
  }
  .redakce-priority-high {
    border-left-color: #c44;
  }
  .redakce-priority-medium {
    border-left-color: var(--color-copper);
  }
  .redakce-priority-low {
    border-left-color: var(--color-text-muted);
  }

  .redakce-section-header {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .redakce-section-icon {
    font-size: 1.4rem;
    line-height: 1;
  }
  .redakce-section-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.3rem;
    color: var(--color-brass-bright);
    margin: 0;
    border: none; padding: 0;
    flex: 1;
  }
  .redakce-section-title::before { content: none; }

  .redakce-priority-badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 0.15rem 0.55rem;
    border-radius: 2px;
    border: 1px solid currentColor;
  }
  .redakce-priority-badge.redakce-priority-high {
    color: #c44;
    background: color-mix(in srgb, #c44 10%, transparent);
  }
  .redakce-priority-badge.redakce-priority-medium {
    color: var(--color-copper);
    background: color-mix(in srgb, var(--color-copper) 10%, transparent);
  }
  .redakce-priority-badge.redakce-priority-low {
    color: var(--color-text-muted);
  }

  .redakce-section-count {
    font-feature-settings: "lnum";
    font-size: 1.1rem;
    color: var(--color-brass);
    font-weight: 500;
    background: var(--color-bg);
    padding: 0.15rem 0.6rem;
    border-radius: 4px;
  }

  .redakce-section-desc {
    color: var(--color-text-soft);
    line-height: 1.55;
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }

  .redakce-list-wrapper {
    margin-top: 0.5rem;
  }
  .redakce-list-summary {
    cursor: pointer;
    color: var(--color-brass-bright);
    font-size: 0.9rem;
    padding: 0.4rem 0;
    list-style: none;
    user-select: none;
  }
  .redakce-list-summary::before {
    content: '▶';
    display: inline-block;
    margin-right: 0.4rem;
    transition: transform 150ms ease;
    font-size: 0.7rem;
  }
  details[open] .redakce-list-summary::before {
