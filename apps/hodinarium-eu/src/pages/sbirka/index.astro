---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import catalog from '../../data/catalog.json';
import { kategorie as catMeta } from '../../data/kategorie';
import { clanekHref } from '../../data/url-helpers';

interface Entry {
  slug: string;
  title: string;
  category: string;
  thumbnail: string | null;
  excerpt: string;
  year: number | null;
  lastModified: string | null;
  imageCount: number;
  wordCount: number;
}

const meta = catMeta.sbirka;

// Načti collection pro discriminator podsekce (catalog.json ho zatím nemá)
const all = await getCollection('clanky');
const sbirkaEntries = all.filter((e) => e.data.category === 'sbirka');
const kartySlugs = new Set(
  sbirkaEntries.filter((e) => e.data.podsekce === 'karta').map((e) => e.id)
);

// Catalog.json poskytuje thumbnail/excerpt/imageCount; rozdělíme podle slugů
const catalogAll = (catalog as Entry[]).filter((e) => e.category === 'sbirka');
const karty = catalogAll.filter((e) => kartySlugs.has(e.slug));
const clanky = catalogAll.filter((e) => !kartySlugs.has(e.slug));
clanky.sort((a, b) => a.title.localeCompare(b.title, 'cs'));

// Featured karty — preferuj ty s thumbnailem (auto-detected fotka),
// pak řadit podle inv. č. ascending
const kartyWithPhoto = karty.filter((k) => k.thumbnail);
kartyWithPhoto.sort((a, b) => {
  const matchA = a.slug.match(/inv-(\d+)/);
  const matchB = b.slug.match(/inv-(\d+)/);
  const numA = matchA ? parseInt(matchA[1], 10) : 9999;
  const numB = matchB ? parseInt(matchB[1], 10) : 9999;
  return numA - numB;
});
const featuredKarty = kartyWithPhoto.slice(0, 6);

// Featured články — z meta.featuredSlugs (jako u jiných kategorií)
const featuredArticleSlugs = (meta.featuredSlugs ?? []).filter((s) => !kartySlugs.has(s));
const featuredArticles = featuredArticleSlugs
  .map((s) => clanky.find((c) => c.slug === s))
  .filter((c): c is Entry => Boolean(c));
const ostatniArticles = featuredArticles.length
  ? clanky.filter((c) => !featuredArticleSlugs.includes(c.slug))
  : clanky;

const totalImages = catalogAll.reduce((s, e) => s + e.imageCount, 0);
---
<Base title={meta.jmeno} description={meta.intro}>
  <section class="kategorie-hero mb-16">
    <p class="eyebrow mb-5">Sekce</p>
    <h1 class="hero-title mb-3" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">{meta.jmeno}</h1>
    <p class="kategorie-podnadpis">{meta.podnadpis}</p>
    <p class="kategorie-intro mt-6">{meta.intro}</p>

    <div class="kategorie-stats mt-8">
      <div class="stat-inline">
        <strong>{karty.length}</strong>
        <span>evidenčních karet</span>
      </div>
      <div class="stat-inline">
        <strong>{clanky.length}</strong>
        <span>vázaných článků</span>
      </div>
      {totalImages > 0 && (
        <div class="stat-inline">
          <strong>{totalImages}</strong>
          <span>fotografií</span>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ SEKCE 1: EVIDENČNÍ KARTY ═══ -->
  <section class="mb-16" aria-labelledby="karty-heading">
    <header class="section-divider mb-6">
      <p class="eyebrow mb-2">1. Evidenční karty</p>
      <h2 id="karty-heading" class="section-h">
        Sbírkové předměty
        <span class="section-h-count">{karty.length}</span>
      </h2>
      <p class="section-intro mt-3">
        Základní popis každého sbírkového předmětu (1:1 ze Soupisu exponátů Hodinária).
        Každá karta obsahuje technické parametry, lokaci v expozici a vztah ke sbírce.
      </p>
    </header>

    <div class="featured-grid-cat">
      {featuredKarty.map((e) => (
        <Card
          href={`/sbirka/karta/${e.slug}/`}
          title={e.title}
          excerpt={e.excerpt || 'Stub karty — k doplnění z Popisů strojů.'}
          thumbnail={e.thumbnail}
          category="sbirka"
          lastModified={e.lastModified}
          imageCount={e.imageCount}
        />
      ))}
    </div>

    <div class="katalog-link mt-6">
      <a href="/sbirka/katalog/" class="btn-primary">Otevřít celý katalog ({karty.length}) →</a>
    </div>
  </section>

  <!-- ═══ SEKCE 2: VÁZANÉ ČLÁNKY ═══ -->
  <section aria-labelledby="clanky-heading">
    <header class="section-divider mb-6">
      <p class="eyebrow mb-2">2. Vázané články</p>
      <h2 id="clanky-heading" class="section-h">
        Příběhy ke sbírkovým předmětům
        <span class="section-h-count">{clanky.length}</span>
      </h2>
      <p class="section-intro mt-3">
        Delší články popisující jednotlivé exponáty hlouběji — způsob nabytí, restaurování,
        historie předmětu nebo jeho výroby. Vážou se na jednu nebo více evidenčních karet.
      </p>
    </header>

    {featuredArticles.length > 0 && (
      <>
        <header class="mb-6">
          <p class="eyebrow mb-2">Vybrané</p>
          <h3 class="text-xl">Stojí za prohlídku</h3>
        </header>
        <div class="featured-grid-cat mb-12">
          {featuredArticles.map((e) => (
            <Card
              href={clanekHref(e)}
              title={e.title}
              excerpt={e.excerpt}
              thumbnail={e.thumbnail}
              category={e.category}
              lastModified={e.lastModified}
              imageCount={e.imageCount}
            />
          ))}
        </div>
      </>
    )}

    <header class="mb-6">
      <p class="eyebrow mb-2">Kompletní seznam</p>
      <h3 class="text-xl">
        {featuredArticles.length > 0 ? 'Další články' : 'Všechny články'}
      </h3>
    </header>
    <div class="featured-grid-cat">
      {ostatniArticles.map((e) => (
        <Card
          href={clanekHref(e)}
          title={e.title}
          excerpt={e.excerpt}
          thumbnail={e.thumbnail}
          category={e.category}
          lastModified={e.lastModified}
          imageCount={e.imageCount}
        />
      ))}
    </div>
  </section>
</Base>

<style>
  .kategorie-hero { max-width: 880px; }
  .kategorie-podnadpis {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--color-copper);
    margin: 0;
  }
  .kategorie-intro {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 64ch;
  }
  .kategorie-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }
  .stat-inline {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .stat-inline strong {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--color-brass-bright);
    font-feature-settings: "lnum";
  }
  .stat-inline span {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .section-divider {
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .section-h {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    color: var(--color-brass-bright);
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border: none;
    padding: 0;
  }
  .section-h::before { content: none; }
  .section-h-count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-feature-settings: "lnum";
    font-weight: 400;
  }
  .section-intro {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-text-soft);
    max-width: 72ch;
    margin: 0;
  }

  .katalog-link {
    text-align: center;
  }

  .featured-grid-cat {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
</style>
