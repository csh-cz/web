---
import Base from '../../layouts/Base.astro';
import soupis from '../../data/soupis-exponatu.json';
import { readdirSync, readFileSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
import { hodinari } from '../../data/hodinari';
import { skupinaTyp, skupinaHref } from '../../data/skupiny';

interface Exponat {
  invCislo: string;
  invCisloNumeric: number | null;
  popis: string;
  typ: string;
  rok: string;
  majitel: string;
  stav: string;
  vztah: string;
  poznamka: string;
  lokace: string;
  lokaceHuman: string;
  sekceCislo: number | null;
  mistnost: string;
}

const items = soupis as unknown as Exponat[];

// Slugify shodný s scripts/generate-soupis-stubs.ts
function slugify(s: string): string {
  return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
    .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);
}
function kartaSlug(e: Exponat): string {
  return `inv-${e.invCislo}-${slugify(e.popis)}`;
}

// Detekce existujících inv-* karet ve content/hodinarium-eu/
// + extract karta.vyrobce z frontmatteru pro Hodinář/Výrobce sloupec
const __filename = fileURLToPath(import.meta.url);
const CONTENT_DIR = join(dirname(__filename), '..', '..', '..', '..', '..', 'content', 'hodinarium-eu');
let existingKarty: Set<string>;
const vyrobceMap = new Map<string, string>();
try {
  const files = readdirSync(CONTENT_DIR)
    .filter((f) => f.startsWith('inv-') && (f.endsWith('.md') || f.endsWith('.mdx')));
  existingKarty = new Set(files.map((f) => f.replace(/\.(md|mdx)$/, '')));
  // Naïve YAML extract: hledáme řádek `  vyrobce: ...` v karta: bloku.
  // Pro 290 souborů to je rychlé i bez full YAML parseru.
  for (const f of files) {
    try {
      const txt = readFileSync(join(CONTENT_DIR, f), 'utf8');
      const fmM = txt.match(/^---\n([\s\S]*?)\n---\n/);
      if (!fmM) continue;
      // Najdi karta: blok a v něm vyrobce: line
      const kartaM = fmM[1].match(/^karta:\s*\n((?:  \w+:[^\n]*\n)+)/m);
      if (!kartaM) continue;
      const vM = kartaM[1].match(/^  vyrobce:\s*["']?([^"'\n]+)["']?\s*$/m);
      if (vM) {
        const slug = f.replace(/\.(md|mdx)$/, '');
        vyrobceMap.set(slug, vM[1].trim());
      }
    } catch { /* skip */ }
  }
} catch {
  existingKarty = new Set();
}

// Mapa inv. č. → reálný slug karty. Robustní dohledání i když se popis
// v soupisu liší od slugu karty (např. terminologická oprava ručka↔rafije
// zmrazila slug, ale popis se aktualizoval → kartaSlug() by netrefil).
const kartaByInv = new Map<string, string[]>();
for (const slug of existingKarty) {
  const m = slug.match(/^inv-([A-Za-z0-9]+)-/);
  if (m) {
    const arr = kartaByInv.get(m[1]) ?? [];
    arr.push(slug);
    kartaByInv.set(m[1], arr);
  }
}
/** Reálný slug existující karty pro exponát, nebo null. Nejdřív přesná
 *  shoda (popis→slug), pak fallback podle inv. č. — ale jen když má dané
 *  číslo právě jednu kartu (u kolizních čísel raději bez linku než špatný). */
function cardSlugFor(e: Exponat): string | null {
  const exact = kartaSlug(e);
  if (existingKarty.has(exact)) return exact;
  const byInv = kartaByInv.get(String(e.invCislo));
  if (byInv && byInv.length === 1) return byInv[0];
  return null;
}

// Map vyrobce → hodinář slug pro link na medailon (pokud match je)
const hodinariCandidates: Array<{ needle: string; slug: string; jmeno: string }> = [];
for (const h of hodinari) {
  // jmeno + aliasy, deduplikované
  const variants = new Set<string>([h.jmeno, ...(h.aliasy ?? [])]);
  for (const v of variants) {
    hodinariCandidates.push({ needle: v.toLowerCase().normalize('NFC'), slug: h.slug, jmeno: h.jmeno });
  }
}
hodinariCandidates.sort((a, b) => b.needle.length - a.needle.length);

function findHodinarSlug(vyrobce: string): { slug: string; jmeno: string } | null {
  if (!vyrobce) return null;
  const hay = vyrobce.toLowerCase().normalize('NFC');
  for (const c of hodinariCandidates) {
    if (c.needle.length >= 3 && hay.includes(c.needle)) {
      return { slug: c.slug, jmeno: c.jmeno };
    }
  }
  return null;
}

// Group by lokace, preserve order
const lokaceOrder = [
  'hlavni-sal',
  'panel-1', 'panel-2', 'panel-3', 'panel-4', 'panel-5',
  'vitrina-1-hlavni', 'vitrina-2-hlavni', 'vitrina-3-hlavni',
  'vitrina-1-vedlejsi', 'vitrina-2-vedlejsi', 'vitrina-3-vedlejsi',
  'vitrina-4-vedlejsi', 'vitrina-5-vedlejsi',
  'rohova-vitrina-vedlejsi',
  'volne-vedlejsi',
];
const byLokace = new Map<string, Exponat[]>();
for (const code of lokaceOrder) byLokace.set(code, []);
for (const it of items) {
  if (!byLokace.has(it.lokace)) byLokace.set(it.lokace, []);
  byLokace.get(it.lokace)!.push(it);
}
for (const list of byLokace.values()) {
  list.sort((a, b) => {
    if (a.invCisloNumeric !== null && b.invCisloNumeric !== null) return a.invCisloNumeric - b.invCisloNumeric;
    if (a.invCisloNumeric !== null) return -1;
    if (b.invCisloNumeric !== null) return 1;
    return a.invCislo.localeCompare(b.invCislo);
  });
}

const lokaceLabels: Record<string, string> = {
  'hlavni-sal': 'Hlavní sál',
  'panel-1': 'Panel 1',
  'panel-2': 'Panel 2',
  'panel-3': 'Panel 3',
  'panel-4': 'Panel 4',
  'panel-5': 'Panel 5',
  'vitrina-1-hlavni': 'Vitrína 1 — Sál věžních hodin',
  'vitrina-2-hlavni': 'Vitrína 2 — Sál věžních hodin',
  'vitrina-3-hlavni': 'Vitrína 3 — Sál věžních hodin',
  'vitrina-1-vedlejsi': 'Vitrína 1 — Sál elektro',
  'vitrina-2-vedlejsi': 'Vitrína 2 — Sál elektro',
  'vitrina-3-vedlejsi': 'Vitrína 3 — Sál elektro',
  'vitrina-4-vedlejsi': 'Vitrína 4 — Sál elektro',
  'vitrina-5-vedlejsi': 'Vitrína 5 — Sál elektro',
  'rohova-vitrina-vedlejsi': 'Rohová vitrína — Sál elektro',
  'volne-vedlejsi': 'Volně — Sál elektro',
};

const total = items.length;
// const maxInv = Math.max(...items.map((i) => i.invCisloNumeric ?? 0));  // (unused)
const withKarta = items.filter((i) => cardSlugFor(i) !== null).length;

// Counter per stav
const stavCounts: Record<string, number> = {};
for (const i of items) {
  const k = i.stav || '—';
  stavCounts[k] = (stavCounts[k] ?? 0) + 1;
}
const stavOrder = ['funkční', 'polofunkční', 'nefunkční', 'torzo', '—'];

// Counter per typ + per vyrobce — jen ty, které mají alespoň 2 výskyty,
// ostatní spadnou pod "ostatní" pro filter chip ekonomii.
const typCounts: Record<string, number> = {};
const vyrobceCounts: Record<string, number> = {};
for (const i of items) {
  if (i.typ) typCounts[i.typ] = (typCounts[i.typ] ?? 0) + 1;
  const cs = cardSlugFor(i);
  const v = cs ? vyrobceMap.get(cs) : undefined;
  if (v) vyrobceCounts[v] = (vyrobceCounts[v] ?? 0) + 1;
}
const typOpts = Object.entries(typCounts)
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'cs'))
  .slice(0, 12);
const vyrobceOpts = Object.entries(vyrobceCounts)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'cs'));
---
<Base
  title="Katalog sbírkových předmětů"
  description={`Soupis ${total} exponátů Hodinária Děčín — věžní hodiny, kapesní hodinky, podružné systémy, sluneční a astronomické hodiny. Členěno podle umístění v expozici.`}
>
  <header class="katalog-header">
    <p class="eyebrow mb-3">Sbírka</p>
    <h1 class="katalog-title">Katalog sbírkových předmětů</h1>
    <p class="katalog-lede">
      Soupis <strong class="text-[var(--color-brass-bright)]">{total} exponátů</strong>
      Hodinária Děčín, členěno podle umístění v expozici.
      <strong>{withKarta}</strong> má vlastní evidenční kartu (klikni na řádku).
    </p>
    <div class="stav-counters" aria-label="Stav exponátů">
      {stavOrder.filter((s) => stavCounts[s]).map((s) => (
        <span class={`stav-pill stav-${s}`}>
          {s === '—' ? 'bez stavu' : s}
          <span class="stav-pill-count">{stavCounts[s]}</span>
        </span>
      ))}
    </div>

    <!-- Přepínač zobrazení -->
    <nav class="view-toggle mt-6" aria-label="Zobrazení sbírky">
      <span class="view-toggle-label">Zobrazit jako:</span>
      <a href="/sbirka" class="view-toggle-btn">Rozcestník</a>
      <a href="/sbirka/katalog" class="view-toggle-btn view-toggle-btn-active" aria-current="page">Katalog ({total})</a>
    </nav>
  </header>

  <div class="katalog-controls">
    <input
      type="search"
      class="katalog-search"
      placeholder="Hledat v popisu, výrobci…"
      aria-label="Hledat v katalogu"
      data-katalog-search
    />

    <details class="katalog-filter-group" open>
      <summary>Umístění <span class="muted">({[...byLokace.entries()].filter(([, l]) => l.length > 0).length})</span></summary>
      <div class="katalog-filter" role="group" aria-label="Filtr podle umístění">
        <label class="filter-chip filter-chip-all">
          <input type="checkbox" checked data-filter-all />
          <span class="chip-dot" aria-hidden="true"></span>
          <span class="chip-label">Vše</span>
          <span class="chip-count">{items.length}</span>
        </label>
        {[...byLokace.entries()].filter(([, list]) => list.length > 0).map(([code, list]) => (
          <label class="filter-chip">
            <input type="checkbox" checked data-filter-lokace={code} />
            <span class="chip-dot" aria-hidden="true"></span>
            <span class="chip-label">{lokaceLabels[code] ?? code}</span>
            <span class="chip-count">{list.length}</span>
          </label>
        ))}
      </div>
    </details>

    {vyrobceOpts.length > 0 && (
      <details class="katalog-filter-group">
        <summary>Hodinář / Výrobce <span class="muted">({vyrobceOpts.length})</span></summary>
        <div class="katalog-filter" role="group" aria-label="Filtr podle výrobce">
          {vyrobceOpts.map(([v, n]) => (
            <label class="filter-chip">
              <input type="checkbox" data-filter-vyrobce={v} />
              <span class="chip-dot" aria-hidden="true"></span>
              <span class="chip-label">{v}</span>
              <span class="chip-count">{n}</span>
            </label>
          ))}
        </div>
      </details>
    )}

    {typOpts.length > 0 && (
      <details class="katalog-filter-group">
        <summary>Typ <span class="muted">({typOpts.length})</span></summary>
        <div class="katalog-filter" role="group" aria-label="Filtr podle typu">
          {typOpts.map(([t, n]) => (
            <label class="filter-chip">
              <input type="checkbox" data-filter-typ={t} />
              <span class="chip-dot" aria-hidden="true"></span>
              <span class="chip-label">{t}</span>
              <span class="chip-count">{n}</span>
            </label>
          ))}
        </div>
      </details>
    )}

    <details class="katalog-filter-group">
      <summary>Stav <span class="muted">({stavOrder.filter((s) => stavCounts[s]).length})</span></summary>
      <div class="katalog-filter" role="group" aria-label="Filtr podle stavu">
        {stavOrder.filter((s) => stavCounts[s]).map((s) => (
          <label class="filter-chip">
            <input type="checkbox" data-filter-stav={s} />
            <span class="chip-dot" aria-hidden="true"></span>
            <span class="chip-label">{s === '—' ? 'bez stavu' : s}</span>
            <span class="chip-count">{stavCounts[s]}</span>
          </label>
        ))}
      </div>
    </details>

    <p class="filter-summary"><span data-filter-count>{items.length}</span> z {items.length} exponátů <button type="button" id="katalog-reset" class="filter-reset">↺ Reset filtrů</button></p>
  </div>

  {[...byLokace.entries()].filter(([, list]) => list.length > 0).map(([code, list]) => (
    <section class="katalog-section" id={`l-${code}`} data-lokace-section={code}>
      <h2 class="katalog-section-h">
        {skupinaTyp(code)
          ? <a class="katalog-section-link" href={skupinaHref(code)}>{lokaceLabels[code] ?? code}</a>
          : (lokaceLabels[code] ?? code)}
        <span class="katalog-section-count">{list.length}</span>
      </h2>
      <div class="katalog-table" role="table">
        <div class="katalog-row katalog-head" role="row">
          <span role="columnheader">Inv. č.</span>
          <span role="columnheader">Popis</span>
          <span role="columnheader">Hodinář / výrobce</span>
          <span role="columnheader">Rok</span>
          <span role="columnheader">Typ</span>
          <span role="columnheader">Stav</span>
        </div>
        {list.map((e) => {
          const slug = cardSlugFor(e);
          const hasKarta = slug !== null;
          const vyrobce = slug ? (vyrobceMap.get(slug) || '') : '';
          const hodinarLink = vyrobce ? findHodinarSlug(vyrobce) : null;
          const dataSearch = `${e.popis} ${e.typ} ${e.invCislo} ${vyrobce} ${e.rok ?? ''}`.toLowerCase();
          const inner = (
            <>
              <span class="katalog-inv" role="cell">{e.invCislo}</span>
              <span class="katalog-popis" role="cell">
                <strong>{e.popis}</strong>
                {e.poznamka && <span class="katalog-pozn"> — {e.poznamka}</span>}
              </span>
              <span class="katalog-vyrobce" role="cell">
                {vyrobce ? (
                  hodinarLink ? (
                    <a href={`/hodinari/${hodinarLink.slug}`} class="vyrobce-link" data-stop-row-link>{vyrobce}</a>
                  ) : (
                    <span>{vyrobce}</span>
                  )
                ) : <span class="muted">—</span>}
              </span>
              <span class="katalog-rok" role="cell">{e.rok || '—'}</span>
              <span class="katalog-typ" role="cell">{e.typ || '—'}</span>
              <span class="katalog-stav" role="cell">{e.stav || '—'}</span>
            </>
          );
          const dataAttrs = {
            'data-search': dataSearch,
            'data-vyrobce': vyrobce,
            'data-typ': e.typ || '',
            'data-stav': e.stav || '—',
          };
          return hasKarta ? (
            <div class="katalog-row katalog-row-link" role="row" data-href={`/sbirka/karta/${slug}/`} {...dataAttrs}>
              {inner}
            </div>
          ) : (
            <div class="katalog-row" role="row" {...dataAttrs}>
              {inner}
            </div>
          );
        })}
      </div>
    </section>
  ))}
</Base>

<style>
  .katalog-header {
    max-width: 72ch;
    margin-bottom: 2rem;
  }
  .katalog-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-brass-bright);
    margin: 0 0 1rem;
    line-height: 1.1;
  }
  .katalog-lede {
    font-size: 1.05rem;
    color: var(--color-text);
    line-height: 1.6;
  }

  .stav-counters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: 0.75rem;
  }
  .stav-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.55rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    font-size: 0.78rem;
    color: var(--color-text-soft);
  }
  .stav-pill-count {
    font-feature-settings: "lnum";
    color: var(--color-brass-bright);
    font-weight: 500;
  }
  .stav-pill.stav-funkční { border-left: 3px solid #6a8a4a; }
  .stav-pill.stav-nefunkční { border-left: 3px solid #8a4a4a; }
  .stav-pill.stav-torzo { border-left: 3px solid #6a4a8a; }
  .stav-pill.stav-polofunkční { border-left: 3px solid #b8923e; }

  .katalog-controls {
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .katalog-search {
    width: 100%;
    max-width: 32rem;
    padding: 0.55rem 0.85rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 0.95rem;
  }
  .katalog-search:focus {
    outline: none;
    border-color: var(--color-brass);
  }
  .katalog-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    padding: 0.85rem 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.6rem 0.25rem 0.45rem;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    cursor: pointer;
    font-size: 0.8rem;
    user-select: none;
    transition: border-color 150ms ease;
  }
  .filter-chip:hover { border-color: var(--color-brass); }
  .filter-chip input { margin: 0; }
  .filter-chip-all .chip-label { font-weight: 600; }
  .filter-chip-all { border-color: color-mix(in srgb, var(--color-brass) 50%, transparent); }
  .chip-dot {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--color-copper);
  }
  .chip-label { color: var(--color-text); }
  .chip-count {
    color: var(--color-text-muted);
    font-feature-settings: "lnum";
    font-size: 0.78rem;
  }

  .katalog-section {
    margin: 2.5rem 0;
  }
  .katalog-section-h {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-brass-bright);
    margin: 0 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    border-top: none;
    border-left: none;
    border-right: none;
  }
  .katalog-section-h::before { content: none; }
  .katalog-section-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-brass) 40%, transparent);
  }
  .katalog-section-link:hover {
    color: var(--color-brass-bright);
    border-bottom-color: var(--color-brass);
  }
  .katalog-section-count {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-feature-settings: "lnum";
    margin-left: auto;
  }

  .katalog-table {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    overflow: hidden;
  }
  .katalog-row {
    display: grid;
    grid-template-columns: 50px 2fr 1.4fr 0.7fr 1fr 0.9fr;
    gap: 0.75rem;
    padding: 0.5rem 0.85rem;
    align-items: baseline;
    font-size: 0.88rem;
    border-bottom: 1px dashed color-mix(in srgb, var(--color-brass) 12%, transparent);
    color: inherit;
    text-decoration: none;
  }
  .katalog-row:last-child { border-bottom: none; }
  .katalog-row:nth-child(odd) {
    background: color-mix(in srgb, var(--color-bg-elevated) 50%, transparent);
  }
  .katalog-row-link {
    cursor: pointer;
    transition: background 120ms ease;
  }
  .katalog-row-link:hover {
    background: color-mix(in srgb, var(--color-brass) 8%, var(--color-bg-elevated));
  }
  .katalog-row-link .katalog-popis strong {
    color: var(--color-brass-bright);
  }
  .katalog-row.katalog-hidden { display: none; }
  .katalog-head {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-copper);
    background: var(--color-bg-elevated) !important;
    padding-block: 0.7rem;
  }
  .katalog-inv {
    font-feature-settings: "lnum";
    color: var(--color-brass-bright);
    font-weight: 500;
    text-align: right;
  }
  .katalog-popis strong {
    color: var(--color-text);
    font-weight: 500;
  }
  .katalog-pozn {
    color: var(--color-text-muted);
    font-style: italic;
    font-size: 0.85em;
  }
  .katalog-typ, .katalog-stav, .katalog-vyrobce, .katalog-rok {
    color: var(--color-text-soft);
  }
  .katalog-rok {
    font-feature-settings: "lnum";
    white-space: nowrap;
  }
  .katalog-vyrobce {
    font-style: italic;
  }
  .vyrobce-link {
    color: var(--color-copper);
    text-decoration: none;
    border-bottom: 1px dotted color-mix(in srgb, var(--color-copper) 50%, transparent);
  }
  .vyrobce-link:hover {
    color: var(--color-brass-bright);
    border-bottom-color: var(--color-brass-bright);
  }

  /* Filter group (collapsible details) */
  .katalog-filter-group {
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
  }
  .katalog-filter-group summary {
    padding: 0.5rem 0.85rem;
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--color-brass-bright);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }
  .katalog-filter-group summary::-webkit-details-marker { display: none; }
  .katalog-filter-group summary::before {
    content: '▸';
    display: inline-block;
    margin-right: 0.4em;
    transition: transform 150ms ease;
    color: var(--color-copper);
  }
  .katalog-filter-group[open] summary::before { transform: rotate(90deg); }
  .katalog-filter-group .katalog-filter {
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 12%, transparent);
    border-radius: 0;
    padding: 0.7rem 0.85rem 0.85rem;
  }
  .filter-summary {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-soft);
    font-style: italic;
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }
  .filter-reset {
    padding: 0.25rem 0.6rem;
    background: transparent;
    color: var(--color-text-soft);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
    font: inherit;
    font-style: normal;
    cursor: pointer;
    font-size: 0.78rem;
  }
  .filter-reset:hover {
    color: var(--color-brass-bright);
    border-color: var(--color-brass-bright);
  }

  @media (max-width: 800px) {
    .katalog-row {
      grid-template-columns: 50px 1fr;
      gap: 0.4rem 0.85rem;
      padding: 0.65rem 0.75rem;
    }
    .katalog-head { display: none; }
    .katalog-typ, .katalog-stav, .katalog-vyrobce, .katalog-rok {
      grid-column: 2;
      font-size: 0.78rem;
    }
    .katalog-vyrobce::before { content: 'Hodinář: '; color: var(--color-text-muted); font-style: normal; }
    .katalog-rok::before { content: 'Rok: '; color: var(--color-text-muted); }
    .katalog-typ::before { content: 'Typ: '; color: var(--color-text-muted); }
    .katalog-stav::before { content: 'Stav: '; color: var(--color-text-muted); }
    .katalog-vztah::before { content: 'Vztah: '; color: var(--color-text-muted); }
  }
</style>

<script is:inline>
  // Filtry: search + lokace + vyrobce + typ + stav.
  // Logic: AND across kategorií, OR uvnitř kategorie.
  // Když ŽÁDNÝ chip není zaškrtnutý v dané kategorii (vyrobce/typ/stav),
  // kategorie se nepoužije (= všechno projde — equivalent "vše").
  // U lokace je default "vše checked"; AND nad ostatními zůstává.
  const search = document.querySelector('[data-katalog-search]');
  const chipsLokace = document.querySelectorAll('[data-filter-lokace]');
  const chipsVyrobce = document.querySelectorAll('[data-filter-vyrobce]');
  const chipsTyp = document.querySelectorAll('[data-filter-typ]');
  const chipsStav = document.querySelectorAll('[data-filter-stav]');
  const allChip = document.querySelector('[data-filter-all]');
  const sections = document.querySelectorAll('[data-lokace-section]');
  const $count = document.querySelector('[data-filter-count]');
  const $reset = document.getElementById('katalog-reset');

  function syncAllState() {
    if (!allChip) return;
    const total = chipsLokace.length;
    let on = 0;
    for (const cb of chipsLokace) if (cb.checked) on++;
    allChip.checked = on === total;
    allChip.indeterminate = on > 0 && on < total;
  }

  function activeSet(chips, attr) {
    const s = new Set();
    for (const cb of chips) if (cb.checked) s.add(cb.dataset[attr]);
    return s;
  }

  function refresh() {
    const q = (search?.value || '').toLowerCase().trim();
    const enabledLokace = activeSet(chipsLokace, 'filterLokace');
    const enabledVyrobce = activeSet(chipsVyrobce, 'filterVyrobce');
    const enabledTyp = activeSet(chipsTyp, 'filterTyp');
    const enabledStav = activeSet(chipsStav, 'filterStav');

    let total = 0;
    for (const sec of sections) {
      const lokace = sec.dataset.lokaceSection;
      const lokaceOk = enabledLokace.has(lokace);
      let anyMatch = false;
      const rows = sec.querySelectorAll('.katalog-row:not(.katalog-head)');
      for (const r of rows) {
        const txt = r.dataset.search || '';
        const matchSearch = !q || txt.includes(q);
        const matchVyrobce = enabledVyrobce.size === 0 || enabledVyrobce.has(r.dataset.vyrobce || '');
        const matchTyp = enabledTyp.size === 0 || enabledTyp.has(r.dataset.typ || '');
        const matchStav = enabledStav.size === 0 || enabledStav.has(r.dataset.stav || '—');
        const visible = lokaceOk && matchSearch && matchVyrobce && matchTyp && matchStav;
        r.classList.toggle('katalog-hidden', !visible);
        if (visible) { anyMatch = true; total++; }
      }
      sec.style.display = anyMatch ? '' : 'none';
    }
    if ($count) $count.textContent = String(total);
    syncAllState();
  }

  function resetAll() {
    if (search) search.value = '';
    for (const cb of chipsLokace) cb.checked = true;
    for (const cb of chipsVyrobce) cb.checked = false;
    for (const cb of chipsTyp) cb.checked = false;
    for (const cb of chipsStav) cb.checked = false;
    refresh();
  }

  search?.addEventListener('input', () => { refresh(); writeUrl(); });
  for (const cb of [...chipsLokace, ...chipsVyrobce, ...chipsTyp, ...chipsStav]) {
    cb.addEventListener('change', () => { refresh(); writeUrl(); });
  }
  allChip?.addEventListener('change', () => {
    const target = allChip.checked;
    for (const cb of chipsLokace) cb.checked = target;
    refresh();
    writeUrl();
  });
  $reset?.addEventListener('click', () => { resetAll(); writeUrl(); });

  // === URL ↔ filter state ===
  function readUrl() {
    const p = new URLSearchParams(window.location.search);
    if (p.has('q') && search) search.value = p.get('q') || '';
    function applyChipState(chips, attr, key) {
      if (!p.has(key)) return;
      const allowed = new Set((p.get(key) || '').split(',').filter(Boolean));
      // Default state pro lokace = checked, pro ostatní = unchecked
      const defaultChecked = (key === 'lokace');
      for (const cb of chips) {
        const v = cb.dataset[attr];
        cb.checked = allowed.size === 0 ? defaultChecked : allowed.has(v);
      }
    }
    applyChipState(chipsLokace, 'filterLokace', 'lokace');
    applyChipState(chipsVyrobce, 'filterVyrobce', 'vyrobce');
    applyChipState(chipsTyp, 'filterTyp', 'typ');
    applyChipState(chipsStav, 'filterStav', 'stav');
    if (p.toString()) refresh();
  }
  function writeUrl() {
    const p = new URLSearchParams();
    if (search?.value) p.set('q', search.value);
    function dump(chips, attr, key, defaultChecked) {
      const on = [...chips].filter((c) => c.checked).map((c) => c.dataset[attr]);
      const off = [...chips].filter((c) => !c.checked).map((c) => c.dataset[attr]);
      // Only dump if state is non-default
      if (defaultChecked && off.length === 0) return;
      if (!defaultChecked && on.length === 0) return;
      p.set(key, on.join(','));
    }
    dump(chipsLokace, 'filterLokace', 'lokace', true);
    dump(chipsVyrobce, 'filterVyrobce', 'vyrobce', false);
    dump(chipsTyp, 'filterTyp', 'typ', false);
    dump(chipsStav, 'filterStav', 'stav', false);
    const qs = p.toString();
    const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    window.history.replaceState(null, '', url);
  }

  syncAllState();
  readUrl();

  // Row click → navigate to karta. Skip pokud klik byl na <a> uvnitř (vyrobce link).
  document.querySelectorAll('.katalog-row-link').forEach((row) => {
    row.addEventListener('click', (e) => {
      if (e.target instanceof HTMLAnchorElement) return;  // klik na vyrobce <a> — projde sám
      const href = row.getAttribute('data-href');
      if (!href) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) {
        window.open(href, '_blank');
      } else {
        window.location.href = href;
      }
    });
    row.style.cursor = 'pointer';
  });
</script>
