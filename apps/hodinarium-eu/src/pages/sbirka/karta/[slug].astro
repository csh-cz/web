---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';
import EditorNotesBlock from '../../../components/EditorNotesBlock.astro';
import JsonLd from '@csh/ui/components/JsonLd.astro';
import KartaSbirky from '../../../components/KartaSbirky.astro';
import ArticleImageBehavior from '../../../components/ArticleImageBehavior.astro';
import WipBanner from '../../../components/WipBanner.astro';
import { clanekHref } from '../../../data/url-helpers';
import { isPubliclyBuildable, showsWipBanner } from '../../../utils/workflow-visibility';
import CrossRefs from '../../../components/CrossRefs.astro';
import { CSH_CONTENT_COMPONENTS } from '../../../utils/content-components';

export async function getStaticPaths() {
  const all = await getCollection('clanky');
  // Pouze evidenční karty (podsekce: 'karta')
  return all
    .filter((entry) => entry.data.category === 'sbirka' && entry.data.podsekce === 'karta')
    // Editorial workflow visibility — non-ready bez publicDuringEdit → 404.
    .filter((entry) => isPubliclyBuildable(entry.data.workflow))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry, all },
    }));
}

const { entry, all } = Astro.props;
const { Content } = await render(entry);
const wipStatus = showsWipBanner(entry.data.workflow) ? entry.data.workflow!.status : null;

// Reverse lookup — články, které referují tuto kartu přes relatedKarty
const vazaneClanky = all.filter((a) =>
  a.data.podsekce !== 'karta' &&
  (a.data.relatedKarty ?? []).includes(entry.data.slug)
);

// Komponenty kompletu — pokud karta má karta.komponenty: [...], lookup
// titles a kategorie pro link generování
const komponentySlugs = entry.data.karta?.komponenty ?? [];
const komponenty = komponentySlugs
  .map((slug) => all.find((a) => a.id === slug))
  .filter((a): a is NonNullable<typeof a> => Boolean(a))
  .map((a) => ({
    slug: a.data.slug,
    title: a.data.title,
    category: a.data.category,
    isKarta: a.data.podsekce === 'karta',
  }));

const site = Astro.site ?? new URL('https://hodinarium-eu.pages.dev');
const kartaUrl = new URL(`/sbirka/karta/${entry.data.slug}`, site).toString();
const k = entry.data.karta;

// Materials: normalize string|string[] na array stringů (pro JSON-LD).
const materialsArray: string[] = (() => {
  const m = k?.materialy;
  if (!m) return [];
  if (Array.isArray(m)) return m.filter(Boolean).map((s) => String(s).trim());
  return String(m)
    .split(/[,;]/)
    .map((s) => s.trim())
    .filter(Boolean);
})();

// Hlavní fotka pro JSON-LD `image` — preferuj thumbnail, jinak undefined.
// (Body článku má svoje vlastní obrázky, ale ty by vyžadovaly parse MDX.)
const mainImageUrl = entry.data.thumbnail
  ? new URL(entry.data.thumbnail, site).toString()
  : undefined;

// Citation export URLs (pro UI tlačítka i pro JSON-LD `encoding`).
const citeRisUrl = `/sbirka/karta/${entry.id}/citation.ris`;
const citeBibUrl = `/sbirka/karta/${entry.id}/citation.bib`;
const citeJsonUrl = `/sbirka/karta/${entry.id}/citation.json`;

const kartaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  '@id': kartaUrl,
  name: entry.data.title,
  url: kartaUrl,
  inLanguage: 'cs',
  description: `Evidenční karta sbírkového předmětu — inv. č. ${k?.inventarniCislo ?? '?'}`,
  ...(k?.inventarniCislo && { identifier: k.inventarniCislo }),
  ...(k?.datace && { dateCreated: k.datace }),
  ...(k?.vyrobce && {
    creator: { '@type': 'Person', name: k.vyrobce },
  }),
  ...(k?.puvodniUmisteni?.obec && {
    locationCreated: {
      '@type': 'Place',
      name: [k.puvodniUmisteni.objekt, k.puvodniUmisteni.obec].filter(Boolean).join(', '),
      address: { '@type': 'PostalAddress', addressLocality: k.puvodniUmisteni.obec, addressCountry: 'CZ' },
    },
  }),
  ...(k?.rozmery && { size: k.rozmery }),
  ...(materialsArray.length > 0 && { material: materialsArray }),
  ...(mainImageUrl && { image: mainImageUrl }),
  ...(k?.signatura && { alternateName: k.signatura }),
  // Strojově čitelné odkazy na citation export endpointy. Klienti
  // (Zotero translator, custom skripty) je mohou číst přes JSON-LD.
  encoding: [
    { '@type': 'MediaObject', encodingFormat: 'application/x-research-info-systems', contentUrl: new URL(citeRisUrl, site).toString() },
    { '@type': 'MediaObject', encodingFormat: 'application/x-bibtex', contentUrl: new URL(citeBibUrl, site).toString() },
    { '@type': 'MediaObject', encodingFormat: 'application/vnd.citationstyles.csl+json', contentUrl: new URL(citeJsonUrl, site).toString() },
    ...(k?.catalogPdfUrl ? [{ '@type': 'MediaObject', encodingFormat: 'application/pdf', contentUrl: new URL(k.catalogPdfUrl, site).toString() }] : []),
    ...(k?.iiifManifestUrl ? [{ '@type': 'MediaObject', encodingFormat: 'application/ld+json;profile="http://iiif.io/api/presentation/3/context.json"', contentUrl: k.iiifManifestUrl }] : []),
  ],
  isPartOf: {
    '@type': 'Museum',
    name: 'Hodinárium',
    url: site.origin + '/',
  },
};
---
<Base
  title={entry.data.title}
  description={`Evidenční karta sbírkového předmětu — inv. č. ${entry.data.karta?.inventarniCislo ?? '?'}`}
  cmsEditUrl={`/admin/#/collections/karty/entries/${entry.id}`}
  noindex={entry.data.draft}
  citation={{
    /* Sbírkový předmět NENÍ článek — Zotero connector to musí uložit
       jako Web Page (přes DC.* meta), ne jako Journal Article. Bez
       tohoto override Highwire `citation_journal_title` + `citation_volume`
       triggerují Zotero journalArticle detection. */
    itemType: 'webpage',
    title: entry.data.title,
    author: entry.data.karta?.vyrobce || entry.data.author || undefined,
    date: typeof entry.data.lastModified === 'string' ? entry.data.lastModified : undefined,
    journalTitle: 'Hodinárium — Sbírka',
    inventarniCislo: entry.data.karta?.inventarniCislo,
    pdfUrl: entry.data.karta?.catalogPdfUrl ? new URL(entry.data.karta.catalogPdfUrl, site).toString() : undefined,
    keywords: [
      ...(entry.data.tags ?? []),
      ...(entry.data.karta?.vyrobce ? [entry.data.karta.vyrobce] : []),
      ...(entry.data.karta?.umisteni ? [entry.data.karta.umisteni] : []),
      ...materialsArray,
    ].filter(Boolean),
    alternateLinks: [
      { href: citeRisUrl, type: 'application/x-research-info-systems', title: 'Citace RIS' },
      { href: citeBibUrl, type: 'application/x-bibtex', title: 'Citace BibTeX' },
      { href: citeJsonUrl, type: 'application/vnd.citationstyles.csl+json', title: 'Citace CSL JSON' },
      ...(k?.iiifManifestUrl ? [{ href: k.iiifManifestUrl, type: 'application/ld+json;profile="http://iiif.io/api/presentation/3/context.json"', title: 'IIIF manifest' }] : []),
    ],
  }}
>
  <JsonLd data={kartaJsonLd} />
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/sbirka', label: 'Sbírka' },
    { href: '/sbirka/katalog', label: 'Katalog', soft: true },
    { label: entry.data.title },
  ]} />

  <article class="karta-detail" itemscope itemtype="https://schema.org/CreativeWork" data-draft={entry.data.draft ? 'true' : undefined}>
    {entry.data.draft && (
      <div class="draft-banner" role="status" aria-label="Rozpracovaná karta">
        <strong>📝 Rozpracovaná karta</strong>
        <span>Tato evidenční karta je viditelná jen v editor mode. Po finalizaci nastav <code>draft: false</code> ve frontmatteru.</span>
      </div>
    )}
    {entry.data.draft && (
      <div class="draft-placeholder">
        <h1 class="article-title">{entry.data.title}</h1>
        <p>Tato evidenční karta je rozpracovaná a zatím nebyla zveřejněna.</p>
        <p><a href="/sbirka">← Zpět do sbírky</a></p>
      </div>
    )}
    <header class="karta-detail-header">
      <p class="eyebrow mb-3">
        Evidenční karta
        {entry.data.karta?.inventarniCislo && <> · inv. č. <strong>{entry.data.karta.inventarniCislo}</strong></>}
      </p>
      <h1 class="karta-detail-title" itemprop="name">{entry.data.title}</h1>
    </header>

    {wipStatus && (
      <WipBanner status={wipStatus as 'todo' | 'in-progress' | 'review'} notes={entry.data.workflow?.notes} />
    )}

    {entry.data.karta && <KartaSbirky karta={entry.data.karta} />}

    <EditorNotesBlock notes={entry.data.editorNotes} sourceFile={`content/hodinarium-eu/${entry.id}.md`} />

    {komponenty.length > 0 && (
      <aside class="komplet" aria-labelledby="komplet-h">
        <p class="eyebrow komplet-label" id="komplet-h">Komplet obsahuje</p>
        <ul class="komplet-list">
          {komponenty.map((k) => (
            <li>
              <a href={clanekHref({ slug: k.slug, category: k.category, podsekce: k.isKarta ? 'karta' : undefined })}>
                <strong>{k.title}</strong>
                {k.isKarta && <span class="komplet-badge">karta</span>}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div class="prose-content drop-cap" itemprop="description">
      <Content components={CSH_CONTENT_COMPONENTS} />
    </div>

    {vazaneClanky.length > 0 && (
      <aside class="vazane-clanky" aria-labelledby="vazane-h">
        <p class="eyebrow vazane-clanky-label" id="vazane-h">Vážící se články</p>
        <ul class="vazane-clanky-list">
          {vazaneClanky.map((a) => (
            <li>
              <a href={clanekHref({ slug: a.data.slug, category: a.data.category, podsekce: a.data.podsekce })}>
                <strong>{a.data.title}</strong>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <aside class="karta-cite" aria-labelledby="karta-cite-h">
      <p class="eyebrow karta-cite-label" id="karta-cite-h">Citovat tento předmět</p>
      <p class="karta-cite-hint">
        Stáhněte bibliografický záznam pro reference manager (Zotero, EndNote, BibTeX).
        Sbírkový předmět je exportován jako generický záznam s inventárním číslem
        a kanonickou URL.
      </p>
      <ul class="karta-cite-list">
        <li><a href={citeRisUrl} download type="application/x-research-info-systems">RIS&nbsp;<span class="cite-ext">.ris</span></a></li>
        <li><a href={citeBibUrl} download type="application/x-bibtex">BibTeX&nbsp;<span class="cite-ext">.bib</span></a></li>
        <li><a href={citeJsonUrl} download type="application/vnd.citationstyles.csl+json">CSL&nbsp;JSON&nbsp;<span class="cite-ext">.json</span></a></li>
        {k?.catalogPdfUrl && (
          <li><a href={k.catalogPdfUrl} target="_blank" rel="noopener" type="application/pdf">Katalogový list&nbsp;<span class="cite-ext">PDF</span></a></li>
        )}
        {k?.iiifManifestUrl && (
          <li><a href={k.iiifManifestUrl} target="_blank" rel="noopener">IIIF manifest</a></li>
        )}
      </ul>
    </aside>

    <CrossRefs refs={entry.data.crossRefs} selfType="karty" selfSlug={entry.data.slug} />

    <footer class="karta-byline">
      <span class="byline-publisher">{entry.data.author ?? 'Český spolek horologický'}</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <a href="/sbirka/katalog" class="byline-back">← Zpět do katalogu</a>
    </footer>
  </article>

  <ArticleImageBehavior />
</Base>

<style>
  /* .breadcrumbs CSS žije v global.css — sjednoceno přes <Breadcrumbs> component */

  .karta-detail {
    max-width: 72ch;
    margin: 0 auto;
  }
  .karta-detail-header {
    margin-bottom: 1.5rem;
  }
  .karta-detail-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0;
    color: var(--color-brass-bright);
  }

  .vazane-clanky {
    background: color-mix(in srgb, var(--color-bg-deep) 85%, var(--color-copper));
    border: 1px solid color-mix(in srgb, var(--color-copper) 25%, transparent);
    border-left: 3px solid var(--color-copper);
    border-radius: 2px;
    padding: 1rem 1.25rem;
    margin: 2.5rem 0 1rem;
  }

  /* Komplet — list komponent (sub-karty / vázané články), když karta
     reprezentuje soubor (např. Bychory komplet) */
  .komplet {
    background: color-mix(in srgb, var(--color-bg-deep) 85%, var(--color-brass));
    border: 1px solid color-mix(in srgb, var(--color-brass) 28%, transparent);
    border-left: 3px solid var(--color-brass);
    border-radius: 2px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
  }
  .komplet-label { margin: 0 0 0.6rem; }
  .komplet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.5rem;
  }
  .komplet-list a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-brass-bright);
    transition: border-color 150ms ease;
  }
  .komplet-list a:hover { border-color: var(--color-brass); }
  .komplet-list strong {
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .komplet-badge {
    margin-left: auto;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-copper);
    padding: 0.1rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--color-copper) 30%, transparent);
    border-radius: 2px;
  }
  .vazane-clanky-label { margin: 0 0 0.6rem; }
  .vazane-clanky-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .vazane-clanky-list a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-brass-bright);
    transition: border-color 150ms ease;
  }
  .vazane-clanky-list a:hover {
    border-color: var(--color-brass);
  }

  /* Citovat tento předmět — download box pro RIS/BibTeX/CSL JSON
     + odkaz na PDF katalogového listu / IIIF manifest. */
  .karta-cite {
    margin: 2.5rem 0 1.5rem;
    padding: 1rem 1.25rem;
    background: color-mix(in srgb, var(--color-bg-deep) 88%, var(--color-brass));
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-left: 3px solid color-mix(in srgb, var(--color-brass) 60%, transparent);
    border-radius: 2px;
  }
  .karta-cite-label { margin: 0 0 0.5rem; }
  .karta-cite-hint {
    margin: 0 0 0.85rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-soft);
  }
  .karta-cite-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .karta-cite-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 24%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-brass-bright);
    font-size: 0.9rem;
    transition: border-color 150ms ease, background 150ms ease;
  }
  .karta-cite-list a:hover {
    border-color: var(--color-brass);
    background: color-mix(in srgb, var(--color-bg-elevated) 80%, var(--color-brass));
  }
  .karta-cite-list .cite-ext {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    color: var(--color-copper);
    letter-spacing: 0.05em;
  }

  .karta-byline {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .byline-publisher { color: var(--color-text-soft); font-style: italic; }
  .byline-sep { color: var(--color-brass); opacity: 0.5; }
  .byline-back { color: var(--color-brass); border-bottom: 1px dotted color-mix(in srgb, var(--color-brass) 40%, transparent); text-decoration: none; }
  .byline-back:hover { color: var(--color-brass-bright); }
</style>
