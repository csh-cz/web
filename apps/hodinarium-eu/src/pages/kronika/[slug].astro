---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';
import JsonLd from '@csh/ui/components/JsonLd.astro';
import ArticleImageBehavior from '../../components/ArticleImageBehavior.astro';
import WipBanner from '../../components/WipBanner.astro';
import { isPubliclyBuildable, showsWipBanner } from '../../utils/workflow-visibility';
import CrossRefs from '../../components/CrossRefs.astro';
import { formatAuthor } from '../../utils/formatAuthor';
import { tinyMarkdown } from '../../utils/tinyMarkdown';
import { cdnUrl } from '../../utils/cdnImage';
import { CSH_CONTENT_COMPONENTS } from '../../utils/content-components';

export async function getStaticPaths() {
  const all = await getCollection('kronika');
  return all
    .filter((entry) => isPubliclyBuildable(entry.data.workflow))
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const wipStatus = showsWipBanner(entry.data.workflow) ? entry.data.workflow!.status : null;

const site = Astro.site ?? new URL('https://hodinarium-eu.pages.dev');
const kronikaUrl = new URL(`/kronika/${entry.id}`, site).toString();
const dateMatch = entry.data.date.match(/^\d{4}-\d{2}-\d{2}/);
const isoDate = dateMatch ? dateMatch[0] : `${entry.data.rok}-01-01`;
const kronikaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': kronikaUrl,
  headline: entry.data.title,
  url: kronikaUrl,
  datePublished: isoDate,
  inLanguage: 'cs',
  ...(entry.data.author && { author: { '@type': 'Person', name: entry.data.author } }),
  publisher: {
    '@type': 'Organization',
    name: 'Český spolek horologický',
    logo: { '@type': 'ImageObject', url: cdnUrl('/img/logo-csh.png') },
  },
  articleSection: 'Kronika',
};

const typLabels: Record<string, string> = {
  'vernisaz': 'Vernisáž',
  'fotoreport': 'Fotoreport',
  'sezona': 'Sezóna',
  'akvizice': 'Akvizice',
  'tisk': 'Tisk',
  'tv': 'TV',
  'restaurace': 'Restaurace',
  'historie-spolku': 'Historie spolku',
  'tematicka-vystava': 'Tematická výstava',
  'jine': 'Událost',
};
---
<Base
  title={entry.data.title}
  description={entry.data.title}
  cmsEditUrl={`/admin/#/collections/kronika/entries/${entry.id}`}
  citation={{
    /* Záznam v kronice = blog post / event report, ne journalArticle.
       Web Page je pro Zotero správný typ — bez nátlaku přes citation_volume. */
    itemType: 'webpage',
    title: entry.data.title,
    author: entry.data.author || undefined,
    date: entry.data.date || (entry.data.rok ? `${entry.data.rok}-01-01` : undefined),
    journalTitle: 'Hodinárium — Kronika',
    keywords: [
      ...(entry.data.misto ? [entry.data.misto] : []),
      ...(entry.data.typ ? [entry.data.typ] : []),
      `${entry.data.rok}`,
    ],
  }}
>
  <JsonLd data={kronikaJsonLd} />
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/kronika', label: 'Kronika' },
    { label: entry.data.title },
  ]} />

  <article class="kronika-detail">
    <header class="kronika-detail-header">
      <p class="eyebrow mb-3">Kronika · {entry.data.rok}</p>
      <h1>{entry.data.title}</h1>
      <dl class="kronika-detail-meta">
        <div>
          <dt>Datum</dt>
          <dd>{entry.data.date}</dd>
        </div>
        {entry.data.typ && (
          <div>
            <dt>Typ události</dt>
            <dd>{typLabels[entry.data.typ] ?? entry.data.typ}</dd>
          </div>
        )}
        {entry.data.misto && (
          <div>
            <dt>Místo</dt>
            <dd>{entry.data.misto}</dd>
          </div>
        )}
      </dl>
    </header>

    {wipStatus && (
      <WipBanner status={wipStatus as 'todo' | 'in-progress' | 'review'} notes={entry.data.workflow?.notes} />
    )}

    <div class="prose-content drop-cap">
      <Content components={CSH_CONTENT_COMPONENTS} />
    </div>

    <CrossRefs refs={entry.data.crossRefs} selfType="kronika" selfSlug={entry.id} />

    {entry.data.acknowledgments && (
      <section class="article-acknowledgments" aria-labelledby="acknowledgments-heading">
        <h2 id="acknowledgments-heading" class="references-title">Poděkování</h2>
        <div class="acknowledgments-body" set:html={tinyMarkdown(entry.data.acknowledgments)} />
      </section>
    )}

    {(entry.data.author || entry.data.photoAuthor) && (
      <section class="article-authors" aria-labelledby="authors-heading">
        <h2 id="authors-heading" class="references-title">Autoři</h2>
        <dl class="authors-list">
          {entry.data.author && (<>
            <dt>Text:</dt>
            <dd><span set:html={tinyMarkdown(formatAuthor(entry.data.author)).replace(/^<p>|<\/p>$/g, '')} /></dd>
          </>)}
          {entry.data.photoAuthor && (<>
            <dt>Foto:</dt>
            <dd><span set:html={tinyMarkdown(formatAuthor(entry.data.photoAuthor)).replace(/^<p>|<\/p>$/g, '')} /></dd>
          </>)}
        </dl>
      </section>
    )}

    <footer class="article-byline">
      <span class="byline-publisher">Český spolek horologický</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <span class="byline-date">{entry.data.date}</span>
    </footer>
  </article>

  <ArticleImageBehavior />
</Base>

<style>
  /* .breadcrumbs CSS žije v global.css — sjednoceno přes <Breadcrumbs> component */

  .kronika-detail {
    max-width: 72ch;
    margin: 0 auto;
  }
  .kronika-detail-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .kronika-detail-header h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-brass-bright);
    margin: 0 0 1.25rem;
    line-height: 1.1;
  }
  .kronika-detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin: 0;
  }
  .kronika-detail-meta div {
    border-left: 2px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    padding-left: 0.85rem;
  }
  .kronika-detail-meta dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0 0 0.2rem;
  }
  .kronika-detail-meta dd {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0;
    font-feature-settings: "lnum";
  }

  .article-byline {
    /* Issue #27: clear: both — pokud poslední blok v .prose-content je
       gallery / floated image, bez clear se byline napíše přes ně. */
    clear: both;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  /* Clearfix na celý prose-content aby float / grid blocky uvnitř nikdy
     nepřetékaly do siblings (CrossRefs, article-byline). Belt-and-suspenders. */
  .prose-content::after {
    content: "";
    display: block;
    clear: both;
  }
  .byline-author { color: var(--color-text-soft); font-style: italic; }
  .byline-sep { color: var(--color-brass); opacity: 0.5; }
</style>
