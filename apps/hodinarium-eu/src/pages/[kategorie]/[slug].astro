---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import ArticleImageBehavior from '../../components/ArticleImageBehavior.astro';
import { NEW_CATEGORIES } from '../../data/url-helpers';

export async function getStaticPaths() {
  const all = await getCollection('clanky');
  // Jen články v NOVÝCH kategoriích — deprecated (decin/vezni-hodiny/ostatni)
  // mají dál fallback na /clanky/<slug>, dokud se nepřesunou do Kroniky M4.
  return all
    .filter((entry) => NEW_CATEGORIES.has(entry.data.category))
    .map((entry) => ({
      params: { kategorie: entry.data.category, slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Article
  title={entry.data.title}
  originalUrl={entry.data.originalUrl}
  lastModified={entry.data.lastModified ?? undefined}
  tldr={entry.data.tldr}
  category={entry.data.category}
  slug={entry.data.slug}
  ogImageOverride={entry.data.ogImage}
  author={entry.data.author}
  references={entry.data.references}
>
  <Content />
</Article>

<ArticleImageBehavior />
