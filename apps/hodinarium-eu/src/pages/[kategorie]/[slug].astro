---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import ArticleImageBehavior from '../../components/ArticleImageBehavior.astro';
import WipBanner from '../../components/WipBanner.astro';
import { NEW_CATEGORIES } from '../../data/url-helpers';
import { isPubliclyBuildable, showsWipBanner } from '../../utils/workflow-visibility';
import { CSH_CONTENT_COMPONENTS } from '../../utils/content-components';

export async function getStaticPaths() {
  const all = await getCollection('clanky');
  // Jen články v NOVÝCH kategoriích.
  // Z `sbirka` vyloučit evidenční karty (`podsekce: 'karta'`) — ty mají
  // vlastní router /sbirka/karta/<slug>/ (viz pages/sbirka/karta/[slug].astro).
  return all
    .filter((entry) => NEW_CATEGORIES.has(entry.data.category))
    .filter((entry) => entry.data.podsekce !== 'karta')
    // Top-level about-pages mají vlastní router (/o-hodinariu, …) —
    // exclusion-list předchází duplicitní URL /sbirka/o-hodinariu.
    .filter((entry) => entry.id !== 'o-hodinariu')
    // Editorial workflow visibility — non-ready bez publicDuringEdit → 404.
    .filter((entry) => isPubliclyBuildable(entry.data.workflow))
    .map((entry) => ({
      params: { kategorie: entry.data.category, slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const wipStatus = showsWipBanner(entry.data.workflow) ? entry.data.workflow!.status : null;
---
<Article
  title={entry.data.title}
  originalUrl={entry.data.originalUrl}
  lastModified={entry.data.lastModified ?? undefined}
  tldr={entry.data.tldr}
  category={entry.data.category}
  slug={entry.id}
  ogImageOverride={entry.data.ogImage}
  author={entry.data.author}
  references={entry.data.references}
  editorNotes={entry.data.editorNotes}
  karta={entry.data.karta}
  draft={entry.data.draft}
  crossRefs={entry.data.crossRefs}
>
  {wipStatus && (
    <WipBanner status={wipStatus as 'todo' | 'in-progress' | 'review'} notes={entry.data.workflow?.notes} />
  )}
  <Content components={CSH_CONTENT_COMPONENTS} />
</Article>

<ArticleImageBehavior />
