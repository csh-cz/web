---
import Base from '../../layouts/Base.astro';
import catalog from '../../data/catalog.json';

interface Entry {
  slug: string;
  title: string;
  category: string;
  thumbnail: string | null;
  excerpt: string;
  year: number | null;
  imageCount: number;
  wordCount: number;
}

// Členové výboru — z veřejně dostupných údajů na hodinarium.eu/spolek.htm
const vybor = [
  { funkce: 'Předseda', jmeno: 'Ing. Petr Král' },
  { funkce: 'Pokladník', jmeno: 'Ing. Miroslav Baudisch' },
  { funkce: 'Člen výboru', jmeno: 'Ing. David Knespl' },
];

// Dokumenty ke stažení — hospodaření za jednotlivé roky (PDF na hodinarium.eu)
const dokumenty = [
  { rok: 2016, jmeno: 'Hospodaření 2016', href: 'https://hodinarium.eu/download/spolek/Hospodareni2016.pdf' },
  { rok: 2017, jmeno: 'Hospodaření 2017', href: 'https://hodinarium.eu/download/spolek/Hospodareni2017.pdf' },
  { rok: 2018, jmeno: 'Hospodaření 2018', href: 'https://hodinarium.eu/download/spolek/Hospodareni2018.pdf' },
  { rok: 2019, jmeno: 'Hospodaření 2019', href: 'https://hodinarium.eu/download/spolek/Hospodareni2019.pdf' },
];

// Spolek-related články z katalogu
const all = catalog as Entry[];
const spolekClanky = all.filter((e) => e.category === 'spolek');
const stanovyEntry = all.find((e) => e.slug === 'stanovy');
const sponzorEntry = all.find((e) => e.slug === 'sponsor');
const usneseniEntry = all.find((e) => e.slug === 'usneseni_o_zapisu_spolku');
const zapisy = all.filter((e) => e.slug.startsWith('zapis'));
---
<Base title="Spolek" description="Český spolek horologický z. s. — stanovy, hospodaření, zápisy ze schůzí, výbor.">
  <article class="spolek-doc">
    <header class="spolek-header">
      <p class="spolek-eyebrow">Český spolek horologický z. s.</p>
      <h1 class="spolek-title">Spolek</h1>
      <dl class="spolek-formality">
        <div>
          <dt>IČO</dt>
          <dd>26573008</dd>
        </div>
        <div>
          <dt>Sídlo</dt>
          <dd>nábřeží Otakara Ostrčila 273/6, 392 01 Soběslav III</dd>
        </div>
        <div>
          <dt>Spolkový rejstřík</dt>
          <dd>L 4908 / KS České Budějovice (Fj 4845/2016/KSCB), zapsán 5.&nbsp;3.&nbsp;2016</dd>
        </div>
        <div>
          <dt>Předchůdce</dt>
          <dd>Virtuální muzeum hodin o.&nbsp;s. (zapsáno 9.&nbsp;1.&nbsp;2009)</dd>
        </div>
      </dl>
    </header>

    <section class="spolek-section">
      <h2>Účel spolku</h2>
      <blockquote class="spolek-cite">
        Účelem spolku je prezentovat a popularizovat technickou i uměleckou stránku
        vývoje hodin od prvních konstrukcí po současnost. Pro propagaci zájmu o tuto
        oblast kulturního dědictví využít zejména možnosti Internetu. Propagovat
        a popularizovat tvůrčí činnost v této oblasti včetně malých či amatérských
        výrobců hodin.
      </blockquote>
      <p class="spolek-cite-source">— ze Stanov spolku</p>
    </section>

    <section class="spolek-section">
      <h2>Výbor spolku</h2>
      <ul class="spolek-vybor">
        {vybor.map((v) => (
          <li>
            <span class="vybor-funkce">{v.funkce}</span>
            <span class="vybor-jmeno">{v.jmeno}</span>
          </li>
        ))}
      </ul>
      <p class="spolek-poznamka">
        Spolek navenek zastupují členové výboru, každý samostatně, nebo další členové
        spolku pověření výborem pro konkrétní záležitost. Údaje od členské schůze 5.&nbsp;6.&nbsp;2016.
      </p>
    </section>

    <section class="spolek-section">
      <h2>Dokumenty</h2>
      <ul class="spolek-docs">
        {stanovyEntry && (
          <li>
            <a href={`/clanky/${stanovyEntry.slug}`} class="spolek-doc-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true">
                <rect x="6" y="3" width="12" height="18" rx="1"/>
                <line x1="9" y1="8" x2="15" y2="8" stroke-linecap="round"/>
                <line x1="9" y1="12" x2="15" y2="12" stroke-linecap="round"/>
                <line x1="9" y1="16" x2="13" y2="16" stroke-linecap="round"/>
              </svg>
              <span class="spolek-doc-title">Stanovy spolku</span>
              <span class="spolek-doc-meta">interní</span>
            </a>
          </li>
        )}
        {usneseniEntry && (
          <li>
            <a href={`/clanky/${usneseniEntry.slug}`} class="spolek-doc-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true">
                <rect x="6" y="3" width="12" height="18" rx="1"/>
                <line x1="9" y1="8" x2="15" y2="8" stroke-linecap="round"/>
                <line x1="9" y1="12" x2="15" y2="12" stroke-linecap="round"/>
                <line x1="9" y1="16" x2="13" y2="16" stroke-linecap="round"/>
              </svg>
              <span class="spolek-doc-title">Usnesení o zápisu spolku</span>
              <span class="spolek-doc-meta">2016</span>
            </a>
          </li>
        )}
        {dokumenty.map((d) => (
          <li>
            <a href={d.href} class="spolek-doc-link" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20" aria-hidden="true">
                <rect x="6" y="3" width="12" height="18" rx="1"/>
                <line x1="9" y1="8" x2="15" y2="8" stroke-linecap="round"/>
                <line x1="9" y1="12" x2="15" y2="12" stroke-linecap="round"/>
                <line x1="9" y1="16" x2="13" y2="16" stroke-linecap="round"/>
              </svg>
              <span class="spolek-doc-title">{d.jmeno}</span>
              <span class="spolek-doc-meta">PDF · {d.rok} ↗</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="spolek-poznamka">
        Hospodaření za roky 2020–2025 zatím není zveřejněno online; účetní výkazy
        jsou dostupné na vyžádání u pokladníka.
      </p>
    </section>

    {zapisy.length > 0 && (
      <section class="spolek-section">
        <h2>Zápisy ze schůzí</h2>
        <ul class="spolek-list">
          {zapisy.sort((a, b) => b.slug.localeCompare(a.slug)).map((z) => (
            <li>
              <a href={`/clanky/${z.slug}`}>{z.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {sponzorEntry && (
      <section class="spolek-section">
        <h2>Sponzoring</h2>
        <p>
          Spolek je nezisková organizace. Provoz expozice a webu je financován z členských
          příspěvků a darů. <a href={`/clanky/${sponzorEntry.slug}`}>Více v sekci o sponzoringu</a>.
        </p>
      </section>
    )}

    <section class="spolek-section">
      <h2>Kontakt</h2>
      <dl class="spolek-kontakt">
        <div>
          <dt>E-mail</dt>
          <dd><a href="mailto:info@orloj.eu">info@orloj.eu</a></dd>
        </div>
        <div>
          <dt>Telefon</dt>
          <dd><a href="tel:+420603502735">+420 603 502 735</a></dd>
        </div>
        <div>
          <dt>Sídlo</dt>
          <dd>nábřeží Otakara Ostrčila 273/6, 392 01 Soběslav III</dd>
        </div>
        <div>
          <dt>Expozice</dt>
          <dd><a href="/decin">Hodinárium Děčín</a> — zámek Děčín</dd>
        </div>
      </dl>
    </section>

    <section class="spolek-section">
      <h2>Související na webu</h2>
      <ul class="spolek-list">
        {spolekClanky
          .filter((c) => !['stanovy', 'sponsor', 'usneseni_o_zapisu_spolku'].includes(c.slug) && !c.slug.startsWith('zapis'))
          .map((c) => (
            <li>
              <a href={`/clanky/${c.slug}`}>{c.title}</a>
            </li>
          ))}
      </ul>
    </section>
  </article>
</Base>

<style>
  .spolek-doc {
    max-width: 720px;
    margin: 0 auto;
    /* Dokumentový feel — užší, klidnější, žádné fleurony */
  }

  .spolek-header {
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    padding-bottom: 2rem;
    margin-bottom: 3rem;
  }

  .spolek-eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-copper);
    margin: 0 0 1rem;
    font-weight: 500;
  }

  .spolek-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--color-brass-bright);
    margin: 0 0 2rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .spolek-formality {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .spolek-formality {
      grid-template-columns: 180px 1fr;
      gap: 0.5rem 1.5rem;
    }
    .spolek-formality div {
      display: contents;
    }
  }

  .spolek-formality dt {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0;
  }

  .spolek-formality dd {
    margin: 0 0 0.75rem;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .spolek-formality dd { margin-bottom: 0; }
  }

  .spolek-section {
    margin-bottom: 3rem;
  }

  .spolek-section h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-style: normal;
    font-size: 1.6rem;
    color: var(--color-brass-bright);
    margin: 0 0 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }

  .spolek-section h2::before { content: none; }

  .spolek-section p {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .spolek-cite {
    border-left: 2px solid var(--color-copper);
    padding: 0.5rem 0 0.5rem 1.25rem;
    font-size: 1.05rem;
    line-height: 1.65;
    font-style: italic;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .spolek-cite-source {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .spolek-vybor {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .spolek-vybor {
      grid-template-columns: 180px 1fr;
      gap: 0.5rem 1.5rem;
    }
    .spolek-vybor li {
      display: contents;
    }
  }

  .vybor-funkce {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-copper);
    font-weight: 500;
  }

  .vybor-jmeno {
    color: var(--color-text);
    font-size: 1.05rem;
  }

  .spolek-poznamka {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: 1rem;
  }

  .spolek-docs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .spolek-docs {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .spolek-doc-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    color: var(--color-text);
    text-decoration: none;
    transition: all 150ms ease;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }

  .spolek-doc-link:hover {
    border-color: var(--color-brass);
    background: var(--color-bg-deep);
  }

  .spolek-doc-link svg {
    color: var(--color-copper);
    flex-shrink: 0;
  }

  .spolek-doc-title {
    flex: 1;
    color: var(--color-brass-bright);
    font-size: 0.95rem;
  }

  .spolek-doc-meta {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .spolek-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  @media (min-width: 640px) {
    .spolek-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.4rem 1.5rem;
    }
  }

  .spolek-list li::before {
    content: '·';
    color: var(--color-copper);
    margin-right: 0.5rem;
  }

  .spolek-kontakt {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 640px) {
    .spolek-kontakt {
      grid-template-columns: 180px 1fr;
      gap: 0.5rem 1.5rem;
    }
    .spolek-kontakt div {
      display: contents;
    }
  }

  .spolek-kontakt dt {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0;
  }

  .spolek-kontakt dd {
    margin: 0;
    color: var(--color-text);
    font-size: 1rem;
  }
</style>
