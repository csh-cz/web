---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorNotesBlock from '../../components/EditorNotesBlock.astro';
import JsonLd from '../../components/JsonLd.astro';
import { hodinari } from '../../data/hodinari';
import catalog from '../../data/catalog.json';
import { clanekHref } from '../../data/url-helpers';
import { tinyMarkdown } from '../../utils/tinyMarkdown';
import { stavLabel } from '../../data/labels';
import { extractWikiTitle } from '../../utils/referenceTypes';
import { formatCite, getRef } from '../../utils/cite';

import type { CatalogEntry } from '../../data/catalog-types';

/**
 * Stránka hodináře kombinuje:
 *   1. data/hodinari.ts — whitelist s krátkým shrnutím (stub)
 *   2. content/hodinari/<slug>.mdx — plnohodnotný medailon (volitelný)
 *
 * Pokud existuje content collection entry, render dlouhý text.
 * Jinak fallback stub note.
 */
export async function getStaticPaths() {
  const medailony = await getCollection('hodinari');
  const medailonySlugs = new Set(medailony.map((m) => m.id));

  // Karta sbírky exponátů — filtrujeme jen evidenční karty (podsekce 'karta')
  const allClanky = await getCollection('clanky');
  const kartySbirky = allClanky.filter(
    (e) => e.data.category === 'sbirka' && e.data.podsekce === 'karta',
  );
  // Soupis věžních hodin — full collection
  const allSoupis = await getCollection('soupis-veznich-hodin');

  return hodinari.map((h) => {
    const medailon = medailony.find((m) => m.id === h.slug);

    // Match karta.vyrobce proti jmeno + aliasy (case-insensitive substring).
    // Aliases jako "Janata", "L. Hainz" pokryjí různé formy v karta.vyrobce.
    const candidates = [h.jmeno, ...(h.aliasy ?? [])]
      .map((s) => s.toLowerCase().normalize('NFC'))
      .filter(Boolean);
    const matchedKarty = kartySbirky.filter((k) => {
      const v = (k.data as { karta?: { vyrobce?: string } }).karta?.vyrobce;
      if (!v) return false;
      const hay = v.toLowerCase().normalize('NFC');
      return candidates.some((c) => c.length >= 3 && hay.includes(c));
    });

    // Soupis: hodinar field je přímo slug
    const matchedSoupis = allSoupis.filter((s) => s.data.hodinar === h.slug);

    return {
      params: { slug: h.slug },
      props: {
        hodinar: h,
        medailon: medailon ?? null,
        hasFull: medailonySlugs.has(h.slug),
        kartySbirky: matchedKarty.map((k) => {
          const slug = k.data.slug;
          // Thumbnail: explicitní z frontmatter > catalog.json (auto-detect z body).
          // Catalog.json import nahoře by byl cyclic; používáme `thumbnail` field
          // přímo z frontmatter (= explicitní override). Auto-detected fotky
          // z těla jdou přes catalog.json — ale zde fall-back nedělám pro
          // jednoduchost; pokud chybí, prázdný buňka.
          const thumb = k.data.thumbnail;
          return {
            slug,
            title: k.data.title,
            inv: (k.data as { karta?: { inventarniCislo?: string } }).karta?.inventarniCislo,
            umisteni: (k.data as { karta?: { umisteni?: string } }).karta?.umisteni,
            datace: (k.data as { karta?: { datace?: string } }).karta?.datace,
            thumb: thumb ?? null,
          };
        }),
        soupisRecords: matchedSoupis
          .map((s) => {
            // Hero photo priority: typ='stroj' > 'budova' > 'cifernik' > 'historicke' > first.
            // Důvod: stroj je primární obsah karty; budova zajímavá dotace, ciferník
            // estetický detail, historické skeny pomocné.
            const fotos = s.data.foto ?? [];
            const priority = ['stroj', 'budova', 'cifernik', 'historicke', 'detail'];
            let hero: { src: string; alt?: string } | null = null;
            for (const p of priority) {
              const found = fotos.find((f) => f.typ === p);
              if (found) { hero = { src: found.src, alt: found.alt }; break; }
            }
            if (!hero && fotos.length > 0) {
              hero = { src: fotos[0].src, alt: fotos[0].alt };
            }
            return {
              slug: s.data.slug,
              rok: s.data.rok,
              obec: s.data.puvodniMisto.obec,
              budova: s.data.puvodniMisto.budova,
              stav: s.data.stav,
              thumb: hero,
            };
          })
          .sort((a, b) => {
            const yA = typeof a.rok === 'number' ? a.rok : parseInt(String(a.rok), 10) || 9999;
            const yB = typeof b.rok === 'number' ? b.rok : parseInt(String(b.rok), 10) || 9999;
            return yA - yB;
          }),
      },
    };
  });
}

const { hodinar, medailon, hasFull, kartySbirky, soupisRecords } = Astro.props;
const all = catalog as CatalogEntry[];
const related = hodinar.relatedSlugs
  .map((s) => all.find((e) => e.slug === s))
  .filter((e): e is CatalogEntry => Boolean(e));

const Content = medailon ? (await render(medailon)).Content : null;

// Schema.org — Person nebo Organization podle typu
const site = Astro.site ?? new URL('https://hodinarium-eu.pages.dev');
const pageUrl = new URL(`/hodinari/${hodinar.slug}`, site).toString();
const periodMatch = hodinar.obdobi?.match(/(\d{4})\D+(\d{4})/);
const birthYear = periodMatch?.[1];
const deathYear = periodMatch?.[2];
const portretUrl = medailon?.data.portret
  ? new URL(medailon.data.portret, site).toString()
  : undefined;

const personJsonLd = hodinar.typ === 'osoba'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      '@id': pageUrl,
      name: hodinar.jmeno,
      alternateName: hodinar.aliasy,
      description: hodinar.shrnuti,
      url: pageUrl,
      ...(hodinar.mesto && {
        homeLocation: {
          '@type': 'Place',
          name: hodinar.mesto,
          ...(hodinar.zeme && { address: { '@type': 'PostalAddress', addressLocality: hodinar.mesto, addressCountry: hodinar.zeme } }),
        },
      }),
      ...(birthYear && { birthDate: birthYear }),
      ...(deathYear && { deathDate: deathYear }),
      ...(portretUrl && { image: portretUrl }),
      jobTitle: 'Hodinář',
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': pageUrl,
      name: hodinar.jmeno,
      alternateName: hodinar.aliasy,
      description: hodinar.shrnuti,
      url: pageUrl,
      ...(hodinar.mesto && {
        location: {
          '@type': 'Place',
          name: hodinar.mesto,
          address: { '@type': 'PostalAddress', addressLocality: hodinar.mesto, addressCountry: hodinar.zeme },
        },
      }),
      ...(birthYear && { foundingDate: birthYear }),
      ...(deathYear && { dissolutionDate: deathYear }),
      ...(portretUrl && { logo: portretUrl }),
    };
---
<Base
  title={`${hodinar.jmeno} — hodinář`}
  description={hodinar.shrnuti}
  cmsEditUrl={medailon ? `/admin/#/collections/hodinari/entries/${medailon.id}` : undefined}
  citation={{
    /* Medailon hodináře = encyklopedická stránka, ne journalArticle.
       Bez itemType=webpage by Zotero podle citation_journal_title
       force-mapoval na Journal Article. */
    itemType: 'webpage',
    title: `${hodinar.jmeno} — ${hodinar.typ === 'osoba' ? 'biografie hodináře' : 'medailon hodinářské firmy'}`,
    journalTitle: 'Hodinárium — Hodináři',
    keywords: [
      ...(hodinar.aliasy ?? []),
      ...(hodinar.mesto ? [hodinar.mesto] : []),
      ...(hodinar.obdobi ? [hodinar.obdobi] : []),
      hodinar.typ === 'osoba' ? 'hodinář' : 'hodinářská firma',
    ],
  }}
>
  <JsonLd data={personJsonLd} />
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/hodinari', label: 'Hodináři' },
    { label: hodinar.jmeno },
  ]} />

  <article class="hodinar-detail">
    <header class="hodinar-detail-header">
      <p class="eyebrow mb-3">{hodinar.typ === 'osoba' ? 'Hodinář' : 'Hodinářská firma'}</p>
      <h1 class="hodinar-detail-title">{hodinar.jmeno}</h1>

      <dl class="hodinar-detail-meta">
        {hodinar.obdobi && (
          <div>
            <dt>{hodinar.typ === 'osoba' ? 'Životní data / aktivita' : 'Působení'}</dt>
            <dd>{hodinar.obdobi}</dd>
          </div>
        )}
        {hodinar.mesto && (
          <div>
            <dt>Lokalita</dt>
            <dd>{hodinar.mesto}{hodinar.zeme && hodinar.zeme !== 'CZ' && <span class="hodinar-zeme">&nbsp;({hodinar.zeme})</span>}</dd>
          </div>
        )}
      </dl>
    </header>

    <div class="prose-content">
      <p class="lead" set:html={tinyMarkdown(hodinar.shrnuti)}></p>

      <EditorNotesBlock notes={medailon?.data.editorNotes} sourceFile={`content/hodinari/${hodinar.slug}.mdx`} />

      {hasFull && Content && (
        <Content />
      )}

      {/* Veřejná „profil je stub" hláška: pokud MDX neexistuje,
          NEBO pokud existuje jen kvůli CMS s frontmatter `isStub: true`. */}
      {(!hasFull || medailon?.data.isStub) && (
        <aside class="hodinar-stub-note">
          <p>
            <strong>Tento medailon zatím čeká na svůj příběh.</strong>
            Sbíráme archivní prameny, podrobnosti o dílně a typologii zachovaných
            strojů. Pokud máte dochované dokumenty, fotografie nebo rodinné svědectví,
            <a href="mailto:info@orloj.eu?subject=Doplnění medailonu hodináře">ozvěte&nbsp;se nám</a> — každý
            střípek se počítá.
          </p>
        </aside>
      )}

      {(kartySbirky.length > 0 || soupisRecords.length > 0) && (
        <section class="hodinar-stroje" aria-labelledby="stroje-heading">
          <h2 id="stroje-heading">Stroje od tohoto {hodinar.typ === 'osoba' ? 'hodináře' : 'výrobce'}</h2>

          {kartySbirky.length > 0 && (
            <>
              <h3>Ve sbírce Hodinária</h3>
              <table class="stroje-table">
                <thead>
                  <tr>
                    <th class="stroje-col-thumb" aria-label="Náhled" />
                    <th class="stroje-col-inv">Inv. č.</th>
                    <th class="stroje-col-datace">Datace</th>
                    <th class="stroje-col-title">Exponát</th>
                    <th class="stroje-col-meta">Umístění</th>
                  </tr>
                </thead>
                <tbody>
                  {kartySbirky.map((k) => (
                    <tr>
                      <td class="stroje-col-thumb">
                        {k.thumb && <a href={`/sbirka/karta/${k.slug}/`} class="stroje-thumb-link"><img src={k.thumb} alt="" loading="lazy" decoding="async" /></a>}
                      </td>
                      <td class="stroje-col-inv">{k.inv && <span class="stroje-inv">inv. {k.inv}</span>}</td>
                      <td class="stroje-col-datace">{k.datace}</td>
                      <td class="stroje-col-title">
                        <a href={`/sbirka/karta/${k.slug}/`}>{k.title}</a>
                      </td>
                      <td class="stroje-col-meta">{k.umisteni}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}

          {soupisRecords.length > 0 && (
            <>
              <h3>V soupisu věžních hodin</h3>
              <p class="stroje-counter">
                {soupisRecords.length} {soupisRecords.length === 1 ? 'záznam' : soupisRecords.length < 5 ? 'záznamy' : 'záznamů'}
                {' '}(řazeno chronologicky)
              </p>
              <table class="stroje-table">
                <thead>
                  <tr>
                    <th class="stroje-col-thumb" aria-label="Náhled" />
                    <th class="stroje-col-rok">Rok</th>
                    <th class="stroje-col-title">Lokalita</th>
                    <th class="stroje-col-budova">Budova</th>
                    <th class="stroje-col-meta">Stav</th>
                  </tr>
                </thead>
                <tbody>
                  {soupisRecords.map((s) => (
                    <tr>
                      <td class="stroje-col-thumb">
                        {s.thumb && <a href={`/soupis-veznich-hodin/${s.slug}/`} class="stroje-thumb-link"><img src={s.thumb.src} alt={s.thumb.alt ?? ''} loading="lazy" decoding="async" /></a>}
                      </td>
                      <td class="stroje-col-rok">{s.rok}</td>
                      <td class="stroje-col-title">
                        <a href={`/soupis-veznich-hodin/${s.slug}/`}>{s.obec}</a>
                      </td>
                      <td class="stroje-col-budova">{s.budova}</td>
                      <td class="stroje-col-meta">
                        <span class={`stav-mini stav-${s.stav}`}>{stavLabel(s.stav)}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )}
        </section>
      )}

      {medailon?.data.references && medailon.data.references.length > 0 && (
        <section class="references" aria-labelledby="references-heading">
          <h2 id="references-heading" class="references-title">Literatura a odkazy</h2>
          <ul class="references-list">
            {medailon.data.references.map((r) => {
              // bibKey path: render přes citeproc + ISO 690 CSL ze SSOT.
              const cslItem = r.bibKey ? getRef(r.bibKey) : null;
              const formatted = r.bibKey ? formatCite(r.bibKey) : null;
              if (formatted) {
                return (
                  <li class={`reference reference-${r.type ?? 'odkaz'}`}>
                    <span class="ref-cite" set:html={formatted} />
                    {r.note && <span class="ref-note"> — {r.note}</span>}
                  </li>
                );
              }
              // Title fallback: explicit r.title → cslItem.title → název
              // článku z wiki URL → bibKey → URL doména.
              const cslTitle = (cslItem?.title as string) || null;
              const cslUrl = (cslItem?.URL as string) || (cslItem?.url as string) || null;
              const url = r.url || cslUrl;
              const title = r.title
                || cslTitle
                || (r.type === 'wiki' ? extractWikiTitle(url) : null)
                || r.bibKey
                || (url ? url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/.*$/, '') : 'odkaz');
              return (
                <li class={`reference reference-${r.type ?? 'odkaz'}`}>
                  {r.author && <span class="ref-author">{r.author}:</span>}
                  {url
                    ? <a href={url} rel="noopener" target="_blank">{title}</a>
                    : <span class="ref-title">{title}</span>}
                  {r.year !== undefined && <span class="ref-year">({r.year})</span>}
                  {r.note && <span class="ref-note"> — {r.note}</span>}
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {related.length > 0 && (
        <section>
          <h2>Zmíněn v článcích</h2>
          <ul class="hodinar-related-list">
            {related.map((c) => (
              <li>
                <a href={clanekHref(c)}>
                  {c.thumbnail && (
                    <img src={c.thumbnail} alt="" loading="lazy" decoding="async" />
                  )}
                  <span class="related-text">
                    <strong>{c.title || c.slug}</strong>
                    {c.excerpt && <span class="related-excerpt">{c.excerpt.slice(0, 140)}{c.excerpt.length > 140 ? '…' : ''}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <footer class="article-byline">
      <span class="byline-author">Český spolek horologický</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <span class="byline-date">
        {hasFull ? 'Plnohodnotný profil' : 'Stub profil — připravujeme rozšířený životopis'}
      </span>
    </footer>
  </article>
</Base>

<style>
  /* .breadcrumbs CSS žije v global.css — sjednoceno přes <Breadcrumbs> component */

  .hodinar-detail {
    max-width: 72ch;
    margin: 0 auto;
  }
  .hodinar-detail-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .hodinar-detail-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    margin: 0 0 1.25rem;
    color: var(--color-brass-bright);
    letter-spacing: -0.01em;
  }
  .hodinar-detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 0;
  }
  .hodinar-detail-meta div {
    border-left: 2px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    padding-left: 0.85rem;
  }
  .hodinar-detail-meta dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0 0 0.2rem;
  }
  .hodinar-detail-meta dd {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0;
    font-feature-settings: "lnum";
  }
  .hodinar-zeme {
    color: var(--color-text-muted);
    font-size: 0.9em;
  }

  .lead {
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--color-text);
    margin-top: 0;
    font-style: italic;
  }

  .hodinar-stub-note {
    background: color-mix(in srgb, var(--color-bg-deep) 85%, var(--color-copper));
    border: 1px solid color-mix(in srgb, var(--color-copper) 40%, transparent);
    border-left: 3px solid var(--color-copper);
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    border-radius: 2px;
  }
  .hodinar-stub-note p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-soft);
  }

  .hodinar-related-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .hodinar-related-list a {
    display: flex;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-text);
    align-items: flex-start;
    transition: border-color 150ms ease;
  }
  .hodinar-related-list a:hover {
    border-color: var(--color-brass);
  }
  .hodinar-related-list img {
    width: 80px;
    height: 60px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
    filter: sepia(0.15) saturate(0.85);
  }
  .related-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }
  .related-text strong {
    color: var(--color-brass-bright);
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1rem;
  }
  .related-excerpt {
    font-size: 0.85rem;
    color: var(--color-text-soft);
    line-height: 1.4;
  }

  .hodinar-stroje {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 20%, transparent);
  }
  .hodinar-stroje h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-brass-bright);
    margin: 0 0 1rem;
  }
  .hodinar-stroje h3 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-copper);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 1.5rem 0 0.6rem;
    font-weight: 500;
  }
  .stroje-counter {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
    font-style: italic;
  }
  /* Tabulka strojů od daného hodináře — kompaktní table-style list
     se sloupcem hero foto vlevo. Nahrazuje původní card-list pattern. */
  .stroje-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.92rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 16%, transparent);
    border-radius: 2px;
  }
  .stroje-table thead th {
    text-align: left;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-copper);
    font-weight: 500;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 28%, transparent);
    background: color-mix(in srgb, var(--color-bg-elevated) 80%, var(--color-bg-deep));
  }
  .stroje-table tbody tr {
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 10%, transparent);
    transition: background 120ms ease;
  }
  .stroje-table tbody tr:last-child {
    border-bottom: none;
  }
  .stroje-table tbody tr:hover {
    background: color-mix(in srgb, var(--color-bg-elevated) 70%, var(--color-brass) 8%);
  }
  .stroje-table td {
    padding: 0.5rem 0.7rem;
    vertical-align: middle;
    color: var(--color-text);
  }
  .stroje-table a {
    color: var(--color-brass-bright);
    text-decoration: none;
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .stroje-table a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* Sloupec s thumbnail — fixed width, image fills cell */
  .stroje-col-thumb {
    width: 64px;
    padding: 0.3rem 0.5rem !important;
  }
  .stroje-thumb-link {
    display: block;
    line-height: 0;
  }
  .stroje-col-thumb img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
