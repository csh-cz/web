---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import imageSizes from '../../data/image-sizes.json';

export async function getStaticPaths() {
  const all = await getCollection('clanky');
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const lastModifiedReadable = entry.data.lastModified
  ? new Date(entry.data.lastModified).toLocaleDateString('cs-CZ', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---
<Article
  title={entry.data.title}
  originalUrl={entry.data.originalUrl}
  lastModified={lastModifiedReadable}
  tldr={entry.data.tldr}
  category={entry.data.category}
  slug={entry.data.slug}
>
  <Content />
</Article>

<!-- Lightbox dialog (jeden pro celou stránku) -->
<dialog id="lightbox" aria-label="Lightbox obrázku">
  <button class="lightbox-close" aria-label="Zavřít" type="button">×</button>
  <button class="lightbox-prev" aria-label="Předchozí obrázek" type="button">‹</button>
  <button class="lightbox-next" aria-label="Další obrázek" type="button">›</button>
  <img src="" alt="" />
  <div class="lightbox-caption" id="lightbox-caption"></div>
</dialog>

<style is:global>
  /* === Inline image layout v článcích — časopisecký float === */

  /* Small: float vpravo s textem obtékajícím (kolem 200 px) */
  .prose-content img.img-small {
    float: right;
    width: auto;
    max-width: 220px;
    margin: 0.4rem 0 0.75rem 1.5rem;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    cursor: default;
    /* Blend mode — pokus o "transparent" pozadí na tmavém webu.
       Funguje pro fotky s bílým pozadím; pro tmavé pozadí udělá nic. */
    mix-blend-mode: screen;
    background: transparent;
  }
  .prose-content img.img-small:nth-of-type(even) {
    float: left;
    margin: 0.4rem 1.5rem 0.75rem 0;
  }

  /* Medium: standalone, žádné zvětšení (větší verze neexistuje) */
  .prose-content img.img-medium {
    display: block;
    max-width: min(100%, 480px);
    margin: 1.25rem auto;
    cursor: default;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    mix-blend-mode: screen;
    background: transparent;
  }

  /* Large: standalone, klik = lightbox (větší rozlišení k dispozici) */
  .prose-content img.img-large {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0;
    cursor: zoom-in;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    transition: filter 200ms ease, transform 200ms ease;
  }
  .prose-content img.img-large:hover {
    filter: brightness(1.05);
  }

  /* Po obtékaných obrázcích — clearfix na hranici sekcí */
  .prose-content h2,
  .prose-content h3,
  .prose-content .fleuron,
  .prose-content hr {
    clear: both;
  }

  /* Když je odstavec moc krátký vedle obtékaného obrázku, zruš float pro další */
  .prose-content p {
    overflow: hidden; /* zabraň aby se float prolínal nesouvisejícími odstavci */
  }

  /* Light mode (pergamenové pozadí) — multiply místo screen pro stejný efekt */
  @media (prefers-color-scheme: light) {
    .prose-content img.img-small,
    .prose-content img.img-medium {
      mix-blend-mode: multiply;
    }
  }

  /* Tisk — bez blend (na bílém papíru s multiply ne každý fotka vypadá dobře) */
  @media print {
    .prose-content img.img-small,
    .prose-content img.img-medium {
      mix-blend-mode: normal;
    }
  }

  /* Lightbox / large — vždy plný obrázek, bez blendu */
  .prose-content img.img-large,
  dialog#lightbox img {
    mix-blend-mode: normal;
  }

  /* Opt-out per article — pokud má článek class .no-blend (např. dekor),
     vypne blend pro všechny obrázky uvnitř */
  .prose-content.no-blend img {
    mix-blend-mode: normal !important;
  }

  /* Konsekutivní obrázky v článku — propojit do galerie (jen pro velké) */
  .prose-content p:has(> img:only-child) {
    display: contents;
  }

  .prose-content {
    --gallery-gap: 0.75rem;
  }

  /* Inline lightbox styling */
  dialog#lightbox {
    margin: auto;
    padding: 0;
    border: none;
    background: rgba(20, 16, 12, 0.95);
    backdrop-filter: blur(8px);
    max-width: 96vw;
    max-height: 96vh;
    width: 96vw;
    height: 96vh;
    color: var(--color-text);
  }
  dialog#lightbox::backdrop {
    background: rgba(10, 8, 7, 0.85);
    backdrop-filter: blur(6px);
  }
  dialog#lightbox img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .lightbox-close, .lightbox-prev, .lightbox-next {
    position: absolute;
    background: rgba(20, 16, 12, 0.7);
    border: 1px solid color-mix(in srgb, var(--color-brass) 35%, transparent);
    color: var(--color-brass-bright);
    font-family: var(--font-serif);
    font-size: 1.6rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 150ms ease;
    z-index: 2;
    line-height: 1;
  }
  .lightbox-close {
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
  }
  .lightbox-prev, .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 64px;
    font-size: 2rem;
  }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }
  .lightbox-close:hover, .lightbox-prev:hover, .lightbox-next:hover {
    background: var(--color-brass);
    color: var(--color-ink);
  }
  .lightbox-caption {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.5rem 1rem;
    background: rgba(20, 16, 12, 0.85);
    color: var(--color-text);
    font-size: 0.9rem;
    font-style: italic;
    border-radius: 2px;
    max-width: 80%;
    text-align: center;
  }
  .lightbox-caption:empty { display: none; }

  /* Vizuální galerie — pokud script seskupí <p><img></p> za sebou */
  .article-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-block: 1.5rem;
  }
  @media (min-width: 640px) {
    .article-gallery {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1rem;
    }
  }
  .article-gallery img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
    cursor: zoom-in;
    transition: transform 200ms ease, filter 200ms ease;
    filter: sepia(0.1) saturate(0.9);
    margin: 0 !important;
  }
  .article-gallery img:hover {
    transform: scale(1.02);
    filter: sepia(0) saturate(1);
    border-color: var(--color-brass);
  }
  .article-gallery a {
    display: block;
    border-bottom: none !important;
  }

  /* Galerie obrázků — pouze pro skupinu obrázků, neskupinujeme small/medium */
  .article-gallery img {
    cursor: default;
  }
  .article-gallery img.img-large {
    cursor: zoom-in;
  }
</style>

<script define:vars={{ imageSizes }}>
  /**
   * Po načtení článku:
   * 1. Pro každý <img> přidá class podle skutečné velikosti (small/medium/large).
   * 2. Small obrázky → float, text obtéká.
   * 3. Medium → standalone, žádný lightbox.
   * 4. Large → standalone, lightbox při kliknutí.
   * 5. ≥2 large obrázky vedle sebe = galerie.
   */

  function setup() {
    const article = document.querySelector('.prose-content');
    if (!article) return;

    const sizes = imageSizes;

    // 1. Klasifikuj všechny obrázky podle dat ze JSON indexu
    const allImgs = Array.from(article.querySelectorAll('img'));
    for (const img of allImgs) {
      const src = img.getAttribute('src') || '';
      const dim = sizes[src];
      const klass = dim ? dim.size : 'medium'; // fallback medium pro externí URL
      img.classList.add(`img-${klass}`);
      // Lightbox pouze pro large; medium/small disable
      if (klass !== 'large') {
        img.dataset.noLightbox = '1';
      }
    }

    // 2. Skupinování konsekutivních LARGE obrázků do galerie
    //    (small/medium float v textu, ne sloučit)
    const largeParas = [];
    for (const p of article.querySelectorAll('p')) {
      const imgs = p.querySelectorAll('img.img-large');
      if (imgs.length === 0) continue;
      const onlyImages = Array.from(p.childNodes).every((n) =>
        n.nodeType !== 1 ||
        n.tagName === 'IMG' ||
        n.tagName === 'A' ||
        n.tagName === 'BR'
      );
      if (onlyImages) largeParas.push(p);
    }

    let i = 0;
    while (i < largeParas.length) {
      const start = largeParas[i];
      const seq = [start];
      while (i + 1 < largeParas.length && largeParas[i + 1] === seq[seq.length - 1].nextElementSibling) {
        seq.push(largeParas[++i]);
      }
      const totalImgs = seq.reduce((s, p) => s + p.querySelectorAll('img').length, 0);
      if (totalImgs >= 2) {
        const gallery = document.createElement('div');
        gallery.className = 'article-gallery';
        for (const p of seq) {
          for (const img of Array.from(p.querySelectorAll('img'))) {
            gallery.appendChild(img);
          }
        }
        seq[0].parentElement?.insertBefore(gallery, seq[0]);
        for (const p of seq) p.remove();
      }
      i++;
    }

    // 3. Lightbox — pouze pro large
    const lb = document.getElementById('lightbox');
    if (!lb) return;
    const lbImg = lb.querySelector('img');
    const lbCaption = lb.querySelector('#lightbox-caption');
    const lbImgs = Array.from(article.querySelectorAll('img.img-large'));

    function open(idx) {
      const img = lbImgs[idx];
      if (!img) return;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lbCaption.textContent = img.alt && img.alt !== 'menu' && img.alt !== 'grafika' ? img.alt : '';
      lb.dataset.idx = String(idx);
      lb.showModal();
    }

    function closeLb() { lb.close(); }
    function step(delta) {
      const idx = parseInt(lb.dataset.idx ?? '0', 10);
      const next = (idx + delta + lbImgs.length) % lbImgs.length;
      open(next);
    }

    lbImgs.forEach((img, idx) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        open(idx);
      });
    });

    lb.querySelector('.lightbox-close')?.addEventListener('click', closeLb);
    lb.querySelector('.lightbox-prev')?.addEventListener('click', () => step(-1));
    lb.querySelector('.lightbox-next')?.addEventListener('click', () => step(1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) closeLb();
    });
    document.addEventListener('keydown', (e) => {
      if (!lb.open) return;
      if (e.key === 'Escape') closeLb();
      else if (e.key === 'ArrowLeft') step(-1);
      else if (e.key === 'ArrowRight') step(1);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
</script>
