---
import Base from '../layouts/Base.astro';
import catalog from '../data/catalog.json';

interface Entry {
  slug: string;
  title: string;
  thumbnail: string | null;
  excerpt: string;
}

const ukazky = ['astro2_NTP', 'sobeslav3', 'svarcvaldky', 'decin_koncepce']
  .map((s) => (catalog as Entry[]).find((e) => e.slug === s))
  .filter((e): e is Entry => Boolean(e));
---
<Base title="Ukázka náhledových karet (Open Graph)" description="Jak by vypadaly odkazy na hodinarium.eu po sdílení na Facebook, Slack, Mastodon a v iMessage.">
  <header class="max-w-3xl mb-12">
    <p class="eyebrow mb-4">Ukázka</p>
    <h1 class="hero-title mb-5" style="font-size: clamp(2rem, 5vw, 3.5rem);">Náhledové karty</h1>
    <p class="text-[var(--color-text)] text-lg leading-relaxed">
      Když někdo sdílí odkaz na hodinarium.eu na Facebooku, Slacku, Mastodonu nebo
      v iMessage, ukáže se mu jeden z těchto náhledů. Tento stav je <strong>návrh</strong>,
      jak to bude vypadat — skutečnou OG image bude generovat samotný web při buildu.
    </p>
  </header>

  <section class="mb-16">
    <h2 class="text-2xl mb-6" style="margin-top: 0;">Bez Open Graph (jak vypadá staré <code>hodinarium.eu</code> dnes)</h2>
    <div class="og-mock og-mock-bare">
      <div class="og-mock-url">https://hodinarium.eu/clanky/astro2_NTP</div>
    </div>
    <p class="text-sm text-[var(--color-text-muted)] mt-3 italic">
      Holé URL. Nikdo neví, co tam je, klikne málokdo.
    </p>
  </section>

  {ukazky.map((entry, idx) => (
    <section class="mb-16">
      <h2 class="text-2xl mb-6" style="margin-top: 0;">Příklad {idx + 1}: <em>{entry.title}</em></h2>

      <div class="og-grid">
        <!-- Facebook / LinkedIn / Mastodon style -->
        <div class="og-platform">
          <p class="og-platform-label">Facebook · LinkedIn · Mastodon · Bluesky</p>
          <div class="og-mock og-mock-fb">
            <div class="og-mock-image">
              {entry.thumbnail ? (
                <img src={entry.thumbnail} alt="" />
              ) : (
                <div class="og-fallback">
                  <svg viewBox="0 0 200 200" width="80" height="80" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="100" cy="100" r="90"/>
                    <circle cx="100" cy="100" r="80"/>
                    <line x1="100" y1="100" x2="100" y2="40" stroke-width="3"/>
                    <line x1="100" y1="100" x2="140" y2="100" stroke-width="2"/>
                    <text x="100" y="35" text-anchor="middle" font-family="serif" font-size="14">XII</text>
                    <text x="165" y="105" text-anchor="middle" font-family="serif" font-size="14">III</text>
                  </svg>
                </div>
              )}
            </div>
            <div class="og-mock-body">
              <p class="og-mock-domain">HODINARIUM.EU</p>
              <h3 class="og-mock-title">{entry.title}</h3>
              <p class="og-mock-desc">{entry.excerpt.slice(0, 140)}{entry.excerpt.length > 140 ? '…' : ''}</p>
            </div>
          </div>
        </div>

        <!-- Slack / Discord style -->
        <div class="og-platform">
          <p class="og-platform-label">Slack · Discord · Telegram</p>
          <div class="og-mock og-mock-slack">
            <div class="og-slack-bar"></div>
            <div class="og-slack-content">
              <p class="og-slack-domain">hodinarium.eu</p>
              <h3 class="og-slack-title">{entry.title}</h3>
              <p class="og-slack-desc">{entry.excerpt.slice(0, 100)}{entry.excerpt.length > 100 ? '…' : ''}</p>
              {entry.thumbnail && (
                <div class="og-slack-image">
                  <img src={entry.thumbnail} alt="" />
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- Twitter / X style -->
        <div class="og-platform">
          <p class="og-platform-label">X · Threads · iMessage</p>
          <div class="og-mock og-mock-tw">
            <div class="og-tw-image">
              {entry.thumbnail ? (
                <img src={entry.thumbnail} alt="" />
              ) : (
                <div class="og-fallback">📷</div>
              )}
              <span class="og-tw-title-overlay">{entry.title}</span>
            </div>
            <p class="og-tw-domain">🔗 hodinarium.eu</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="mb-16 bg-section">
    <h2 class="text-2xl mb-4" style="margin-top: 0;">Jak to bude fungovat</h2>
    <ol class="list-decimal pl-6 space-y-2 text-[var(--color-text)]">
      <li>Při <strong>každém buildu</strong> webu se pro každý článek (218 + sekce) vygeneruje vlastní 1200×630 PNG s titulem v Spectral Italic, brass paletou a obrázkem z článku.</li>
      <li>PNG se uloží do <code>/og/&lt;slug&gt;.png</code> (např. <code>/og/astro2_NTP.png</code>).</li>
      <li>V <code>&lt;head&gt;</code> každé stránky je <code>&lt;meta property="og:image" content="…/og/astro2_NTP.png"/&gt;</code>.</li>
      <li>FB / Slack / Mastodon stáhnou ten obrázek a ukážou ho jako náhled.</li>
    </ol>
    <p class="mt-4 text-[var(--color-text-soft)] italic">
      Náklady: ~50 KB na článek × 218 článků = ~11 MB navíc v hosting (zanedbatelné).
      Build čas: +10 sekund (zanedbatelné).
    </p>
  </section>
</Base>

<style>
  /* Holá URL preview */
  .og-mock-bare {
    background: white;
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 16px;
    color: #1a73e8;
    font-family: ui-monospace, monospace;
    font-size: 14px;
    max-width: 500px;
  }

  .og-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 1100px) {
    .og-grid {
      grid-template-columns: 1fr 1fr;
    }
    .og-grid > .og-platform:first-child {
      grid-column: 1 / -1;
    }
  }

  .og-platform-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-copper);
    margin: 0 0 0.75rem;
    font-weight: 500;
  }

  /* Facebook / LinkedIn — large image card */
  .og-mock-fb {
    background: #f0f2f5;
    border-radius: 8px;
    overflow: hidden;
    max-width: 500px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }
  .og-mock-image {
    aspect-ratio: 1.91 / 1;
    background: #1c1812;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .og-mock-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .og-fallback {
    color: #c9a961;
    font-size: 4rem;
  }
  .og-mock-body {
    padding: 12px 16px;
    background: white;
    color: #1c1e21;
  }
  .og-mock-domain {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: #65676b;
    margin: 0 0 0.25em;
    letter-spacing: 0.05em;
  }
  .og-mock-title {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: #1c1e21;
    margin: 0 0 0.4em;
    line-height: 1.3;
  }
  .og-mock-desc {
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 0.85rem;
    color: #65676b;
    margin: 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Slack / Discord — narrow with left bar */
  .og-mock-slack {
    background: #1d1f23;
    border-left: 4px solid #1264a3;
    border-radius: 4px;
    overflow: hidden;
    max-width: 500px;
    color: #d1d2d3;
  }
  .og-slack-content {
    padding: 12px 16px;
  }
  .og-slack-domain {
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    color: #d1d2d3;
    opacity: 0.7;
    margin: 0 0 0.3em;
  }
  .og-slack-title {
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1d9bd1;
    margin: 0 0 0.4em;
    line-height: 1.3;
  }
  .og-slack-desc {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    color: #d1d2d3;
    margin: 0 0 0.6em;
    line-height: 1.4;
  }
  .og-slack-image {
    margin-top: 8px;
    max-width: 360px;
  }
  .og-slack-image img {
    width: 100%;
    border-radius: 4px;
  }

  /* Twitter / iMessage — image with overlay */
  .og-mock-tw {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    max-width: 500px;
    background: #15181c;
  }
  .og-tw-image {
    aspect-ratio: 1.91 / 1;
    position: relative;
    background: #1c1812;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .og-tw-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .og-tw-title-overlay {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.75);
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .og-tw-domain {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    color: #71767b;
    padding: 8px 16px 12px;
    margin: 0;
  }

  .bg-section {
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    border-radius: 2px;
    padding: 2rem;
  }

  code {
    font-family: ui-monospace, "SF Mono", monospace;
    background: var(--color-bg-deep);
    padding: 0.1em 0.4em;
    border-radius: 2px;
    font-size: 0.85em;
    color: var(--color-brass-bright);
    border: 1px solid color-mix(in srgb, var(--color-brass) 15%, transparent);
  }
</style>
