---
import { getEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';
import CrossRefs from '../../components/CrossRefs.astro';
import { kroky } from '../../data/kroky';
import catalog from '../../data/catalog.json';
import { clanekHref } from '../../data/url-helpers';
import { formatCite, getRef } from '../../utils/cite';
import { extractWikiTitle } from '../../utils/referenceTypes';
import WipBanner from '../../components/WipBanner.astro';
import { isPubliclyBuildable, showsWipBanner } from '../../utils/workflow-visibility';
import { cdnUrl } from '../../utils/cdnImage';
import { CSH_CONTENT_COMPONENTS } from '../../utils/content-components';

import type { CatalogEntry } from '../../data/catalog-types';

export async function getStaticPaths() {
  return kroky.map((k) => ({
    params: { slug: k.slug },
    props: { krok: k },
  }));
}

const { krok } = Astro.props;
const all = catalog as CatalogEntry[];
const related = krok.relatedSlugs
  .map((s) => all.find((e) => e.slug === s))
  .filter((e): e is CatalogEntry => Boolean(e));

// Cross-link na slovník — pro každou krok detail stránku zobrazujeme
// 4 obecná konstrukční hesla ze /slovnik/, která se týkají všech kroků
// (krok obecně, kotva, krokové kolo, paleta). Doplňuje kontext pro
// čtenáře, který přišel přes auto-link z článku a chce rozšířenou
// terminologii s primárními prameny.
const SLOVNIK_GENERIC_TERMS = ['krok', 'kotva', 'krokove-kolo', 'paleta'];
const slovnikAll = await getCollection('slovnik');
const slovnikGenericEntries = SLOVNIK_GENERIC_TERMS
  .map((s) => slovnikAll.find((e) => e.data.slug === s))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

// Pokud existuje MDX detail (content/kroky/<slug>.mdx), použij ho
// místo charakteristika+images z kroky.ts. To umožňuje plný technický
// článek s vlastním layoutem (sekce, tabulky, hero foto, inline figures).
//
// Editorial workflow: pokud je MDX non-ready bez publicDuringEdit,
// detail se nezobrazí (page sám zůstane — primární data jsou v data/kroky.ts,
// jen plný detail je rozpracován). publicDuringEdit:true → render + WIP banner.
const detail = await getEntry('kroky', krok.slug);
const detailVisible = detail && isPubliclyBuildable(detail.data.workflow);
const Detail = detailVisible ? (await render(detail)).Content : null;
const hero = detailVisible ? detail.data.hero : undefined;
const perex = detailVisible ? detail.data.perex : undefined;
const wipStatus = detailVisible && showsWipBanner(detail.data.workflow) ? detail.data.workflow!.status : null;
---
<Base
  title={`${krok.jmeno} — hodinový krok`}
  description={krok.shrnuti}
  citation={{
    /* Profil hodinového kroku = referenční stránka, ne journalArticle. */
    itemType: 'webpage',
    title: `${krok.jmeno} — hodinový krok`,
    journalTitle: 'Hodinárium — Hodinové kroky',
    keywords: [
      ...(krok.aliasy ?? []),
      ...(krok.vynalezce ? [krok.vynalezce] : []),
      ...(krok.rok ? [krok.rok] : []),
      'hodinový krok',
    ],
  }}
>
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/kroky', label: 'Hodinové kroky' },
    { label: krok.jmeno },
  ]} />

  <article class="krok-detail">
    <header class="krok-detail-header">
      <p class="eyebrow mb-3">Hodinový krok</p>
      <h1 class="krok-detail-title">{krok.jmeno}</h1>

      <dl class="krok-detail-meta">
        {krok.vynalezce && (
          <div>
            <dt>Vynálezce / původ</dt>
            <dd>{krok.vynalezce}</dd>
          </div>
        )}
        {krok.rok && (
          <div>
            <dt>Datace</dt>
            <dd>{krok.rok}</dd>
          </div>
        )}
      </dl>
    </header>

    {hero && (
      <figure class="krok-hero">
        <img src={cdnUrl(hero.src)} alt={hero.alt} loading="eager" decoding="async" />
        {hero.caption && <figcaption>{hero.caption}</figcaption>}
        <p class="krok-figure-credit"><em>{hero.credit}</em></p>
      </figure>
    )}

    <div class="prose-content">
      {perex
        ? <p class="lead">{perex}</p>
        : <p class="lead">{krok.shrnuti}</p>
      }

      {wipStatus && (
        <WipBanner status={wipStatus as 'todo' | 'in-progress' | 'review'} notes={detail?.data.workflow?.notes} />
      )}

      {Detail
        ? <Detail components={CSH_CONTENT_COMPONENTS} />
        : (
          <>
            <h2>Charakteristika</h2>
            <p>{krok.charakteristika}</p>

            {krok.images && krok.images.length > 0 && (
              <section class="krok-images" aria-labelledby="krok-images-heading">
                <h2 id="krok-images-heading">Obrazové prameny</h2>
                {krok.images.map((img) => (
                  <figure class="krok-figure">
                    <a href={cdnUrl(img.src)} target="_blank" rel="noopener" aria-label="Otevřít v plné velikosti">
                      <img src={cdnUrl(img.src)} alt={img.alt} loading="lazy" decoding="async" />
                    </a>
                    {img.caption && <figcaption>{img.caption}</figcaption>}
                    <p class="krok-figure-credit"><em>{img.credit}</em></p>
                  </figure>
                ))}
              </section>
            )}
          </>
        )
      }

      {(!krok.references || krok.references.length === 0) && (
        <aside class="krok-stub-note">
          <p>
            <strong>Podrobný technický článek je zatím stub.</strong>
            Připravujeme rozšířený text s nákresy mechanizmu, funkčním schématem
            a srovnáním přesnosti. Pokud disponujete technickou dokumentací,
            ozvěte&nbsp;se nám.
          </p>
        </aside>
      )}

      {krok.references && krok.references.length > 0 && (
        <section class="references krok-references" aria-labelledby="references-heading">
          <h2 id="references-heading" class="references-title">Literatura a odkazy</h2>
          <ol>
            {krok.references.map((r) => {
              // Branch 1: bibKey (primárně, ISO 690 přes citeproc-js)
              if (r.bibKey) {
                const cslItem = getRef(r.bibKey);
                if (!cslItem) {
                  return <li><code>{r.bibKey}</code> <em>(nenalezeno v references.json — spusť pnpm refs:sync)</em></li>;
                }
                const formatted = formatCite(r.bibKey) ?? r.bibKey;
                return (
                  <li>
                    <span set:html={formatted} />
                    {r.pages && <span class="krok-ref-pages">, s. {r.pages}</span>}
                    {r.note && <span class="krok-ref-note"> — {r.note}</span>}
                  </li>
                );
              }
              // Branch 2: title-only fallback (mimo Zotero — historické patenty,
              // aukční katalogy apod.). Pokud je URL na wiki/Wikidata bez
              // explicitního title, odvodíme název hesla z URL.
              const fallbackTitle = r.title || extractWikiTitle(r.url);
              if (fallbackTitle) {
                return (
                  <li>
                    <span class="krok-ref-title">{fallbackTitle}</span>
                    {r.url && (
                      <>
                        {' '}
                        Dostupné z:{' '}
                        <a href={r.url} target="_blank" rel="noopener">{r.url}</a>
                      </>
                    )}
                    {r.pages && <span class="krok-ref-pages">, s. {r.pages}</span>}
                    {r.note && <span class="krok-ref-note"> — {r.note}</span>}
                  </li>
                );
              }
              return null;
            })}
          </ol>
        </section>
      )}

      {slovnikGenericEntries.length > 0 && (
        <section class="krok-slovnik" aria-labelledby="krok-slovnik-heading">
          <h2 id="krok-slovnik-heading">Související slovníková hesla</h2>
          <p class="krok-slovnik-intro">
            Obecné konstrukční termíny související s každým hodinovým krokem.
            Detailní výklad s překlady do němčiny, angličtiny a francouzštiny
            a doslovnými citacemi z primárních pramenů.
          </p>
          <div class="krok-slovnik-grid">
            {slovnikGenericEntries.map((e) => (
              <a href={`/slovnik/${e.data.slug}`} class="krok-slovnik-card">
                <h3>{e.data.title}</h3>
                <p>{e.data.definice}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {related.length > 0 && (
        <section>
          <h2>Zmíněn v článcích</h2>
          <ul class="krok-related-list">
            {related.map((c) => (
              <li>
                <a href={clanekHref(c)}>
                  {c.thumbnail && (
                    <img src={cdnUrl(c.thumbnail)} alt="" loading="lazy" decoding="async" />
                  )}
                  <span class="related-text">
                    <strong>{c.title || c.slug}</strong>
                    {c.excerpt && <span class="related-excerpt">{c.excerpt.slice(0, 140)}{c.excerpt.length > 140 ? '…' : ''}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <CrossRefs refs={detail?.data.crossRefs} selfType="kroky" selfSlug={krok.slug} />

    <footer class="article-byline">
      <span class="byline-author">Český spolek horologický</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <span class="byline-date">Stub profil — připravujeme rozšířený technický popis</span>
    </footer>
  </article>
</Base>

<style>
  /* .breadcrumbs CSS žije v global.css — sjednoceno přes <Breadcrumbs> component */

  .krok-detail { max-width: 72ch; margin: 0 auto; }
  .krok-detail-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .krok-detail-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    margin: 0 0 1.25rem;
    color: var(--color-brass-bright);
    letter-spacing: -0.01em;
  }
  .krok-detail-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 0;
  }
  .krok-detail-meta div {
    border-left: 2px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    padding-left: 0.85rem;
  }
  .krok-detail-meta dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0 0 0.2rem;
  }
  .krok-detail-meta dd {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0;
    font-feature-settings: "lnum";
  }

  .lead {
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--color-text);
    margin-top: 0;
  }

  .krok-stub-note {
    background: color-mix(in srgb, var(--color-bg-deep) 85%, var(--color-copper));
    border: 1px solid color-mix(in srgb, var(--color-copper) 40%, transparent);
    border-left: 3px solid var(--color-copper);
    padding: 1rem 1.25rem;
    margin: 2rem 0;
    border-radius: 2px;
  }
  .krok-stub-note p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-soft);
  }

  .krok-hero {
    margin: 0 0 2rem;
    padding: 0;
  }
  .krok-hero img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 2px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }
  .krok-hero figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
    font-style: italic;
  }

  /* MDX body styling — figury inline v textu článku.
     Definováno na .prose-content scope, takže neovlivňuje sekci
     "Obrazové prameny" v fallback režimu (ta má vlastní .krok-figure
     s vlastním paddingem). */
  .prose-content :global(.krok-figure) {
    margin: 2rem 0;
    padding: 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
  }
  .prose-content :global(.krok-figure img) {
    width: 100%;
    max-width: 600px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .prose-content :global(.krok-figure figcaption) {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
  }
  .prose-content :global(.krok-figure-credit) {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .krok-images {
    margin: 2.5rem 0;
  }
  .krok-images h2 {
    font-family: var(--font-serif);
    color: var(--color-brass-bright);
    margin-bottom: 1.25rem;
  }
  .krok-figure {
    margin: 0 0 2rem;
    padding: 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
  }
  .krok-figure img {
    width: 100%;
    max-width: 600px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .krok-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text);
  }
  .krok-figure-credit {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .krok-related-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .krok-related-list a {
    display: flex;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-text);
    align-items: flex-start;
    transition: border-color 150ms ease;
  }
  .krok-related-list a:hover { border-color: var(--color-brass); }
  .krok-related-list img {
    width: 80px;
    height: 60px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
    filter: sepia(0.15) saturate(0.85);
  }
  .related-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }
  .related-text strong {
    color: var(--color-brass-bright);
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1rem;
  }
  .related-excerpt {
    font-size: 0.85rem;
    color: var(--color-text-soft);
    line-height: 1.4;
  }

  .article-byline {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .byline-author { color: var(--color-text-soft); font-style: italic; }
  .byline-sep { color: var(--color-brass); opacity: 0.5; }

  /* Slovníková cross-link sekce — 4 obecná hesla pro každou krok page. */
  .krok-slovnik {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }
  .krok-slovnik h2 {
    font-family: var(--font-serif);
    font-size: 0.78rem !important;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0 0 0.5rem !important;
  }
  .krok-slovnik-intro {
    font-size: 0.9rem;
    color: var(--color-text-soft);
    margin: 0 0 1.25rem;
    line-height: 1.5;
    max-width: 65ch;
  }
  .krok-slovnik-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
  }
  .krok-slovnik-card {
    display: block;
    padding: 0.85rem 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-text);
    border-left: 3px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    transition: border-color 150ms ease;
  }
  .krok-slovnik-card:hover {
    border-color: var(--color-brass);
    border-left-color: var(--color-brass-bright);
  }
  .krok-slovnik-card h3 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 0.95rem !important;
    color: var(--color-brass-bright) !important;
    margin: 0 0 0.3rem !important;
    line-height: 1.2 !important;
    text-transform: lowercase;
  }
  .krok-slovnik-card h3::first-letter {
    text-transform: uppercase;
  }
  .krok-slovnik-card p {
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--color-text-soft);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
