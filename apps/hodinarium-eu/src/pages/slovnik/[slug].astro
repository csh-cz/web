---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';
import WipBanner from '../../components/WipBanner.astro';
import { isPubliclyBuildable, showsWipBanner } from '../../utils/workflow-visibility';
import { formatCite, getRef } from '../../utils/cite';
import { tinyMarkdown, stripMarkdown } from '../../utils/tinyMarkdown';
import { cdnUrl } from '../../utils/cdnImage';
import CrossRefs from '../../components/CrossRefs.astro';
import { CSH_CONTENT_COMPONENTS } from '../../utils/content-components';

export async function getStaticPaths() {
  const all = await getCollection('slovnik');
  return all
    .filter((entry) => isPubliclyBuildable(entry.data.workflow))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const wipStatus = showsWipBanner(entry.data.workflow) ? entry.data.workflow!.status : null;

const data = entry.data;

// Resolve příbuzné slugs to actual entries (for cross-link cards)
const allSlovnik = await getCollection('slovnik');
const slovnikBySlug = new Map(allSlovnik.map((e) => [e.data.slug, e]));
const pribuzneEntries = (data.pribuzne ?? [])
  .map((s) => slovnikBySlug.get(s))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

// Resolve redirectTo target (alias/synonym entries)
const redirectTarget = data.redirectTo ? slovnikBySlug.get(data.redirectTo) : null;

const KATEGORIE_LABEL: Record<string, string> = {
  mechanika: 'Mechanika času',
  bici: 'Bicí mechanismy',
  astronomicke: 'Sluneční a astronomické hodiny',
  materialy: 'Materiály a vlastnosti',
  hodinky: 'Hodinky kapesní a náramkové',
  profese: 'Profese a hodinářské školy',
  jine: 'Slovník',
};
const kategorieLabel = KATEGORIE_LABEL[data.kategorie] ?? 'Slovník';
---
<Base
  title={`${data.title} — hodinářský slovník`}
  description={stripMarkdown(data.definice)}
  cmsEditUrl={`/admin/#/collections/slovnik/entries/${entry.id}`}
  citation={{
    itemType: 'webpage',
    title: `${data.title} — hodinářský slovník`,
    journalTitle: 'Hodinárium — Hodinářský slovník',
    keywords: [
      ...(data.varianty ?? []).map((v) => typeof v === 'string' ? v : v.term),
      ...(data.prekladyLa?.map((p) => p.term) ?? []),
      ...(data.prekladyDe?.map((p) => p.term) ?? []),
      ...(data.prekladyEn?.map((p) => p.term) ?? []),
      'hodinářský slovník',
      'horologická terminologie',
    ],
  }}
>
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/slovnik', label: 'Hodinářský slovník' },
    { label: data.title },
  ]} />

  <article class="slovnik-detail">
    <header class="slovnik-detail-header">
      <p class="eyebrow mb-3">{kategorieLabel}</p>
      <h1 class="slovnik-detail-title">{data.title}</h1>

      {data.varianty && data.varianty.length > 0 && (
        <p class="slovnik-varianty">
          <span class="varianty-label">též:</span>
          {data.varianty.map((v, i) => {
            // Legacy flat string nebo strukturovaný objekt se status (A.28)
            const isStruct = typeof v === 'object' && v !== null;
            const term = isStruct ? v.term : v;
            const status = isStruct ? v.status : null;
            const note = isStruct ? v.note : null;
            const dolozeno = isStruct ? (v as { doloženo?: string }).doloženo : null;
            const tooltip = [note, dolozeno && `Doloženo: ${dolozeno}`]
              .filter(Boolean).join(' — ');
            return (
              <span class="varianta" title={tooltip || undefined}>
                {term}
                {status && (
                  <span class={`varianta-badge varianta-status-${status}`}>{status}</span>
                )}
                {i < data.varianty!.length - 1 ? ',' : ''}
              </span>
            );
          })}
        </p>
      )}

      {data.definice && (
        <p class="slovnik-definice-lead" set:html={tinyMarkdown(data.definice).replace(/^<p>|<\/p>$/g, '')}></p>
      )}

      {redirectTarget && (
        <aside class="slovnik-redirect-banner" role="note" aria-label="Přesměrování">
          <span class="redirect-arrow" aria-hidden="true">→</span>
          <span class="redirect-label">Viz hlavní heslo:</span>
          <a href={`/slovnik/${redirectTarget.data.slug}`} class="redirect-target">
            <strong>{redirectTarget.data.title}</strong>
          </a>
        </aside>
      )}
    </header>

    {data.vyznamy && data.vyznamy.length > 0 && (
      <section class="slovnik-vyznamy" aria-labelledby="vyznamy-heading">
        <h2 id="vyznamy-heading">Významy</h2>
        <ol class="vyznamy-list">
          {data.vyznamy.map((v) => (
            <li class="vyznam-item">
              <span class="vyznam-kontext">{v.kontext}</span>
              <p class="vyznam-definice" set:html={tinyMarkdown(v.definice).replace(/^<p>|<\/p>$/g, '')}></p>
              {(v.kategorie && v.kategorie !== data.kategorie) || v.odkaz ? (
                <p class="vyznam-meta">
                  {v.kategorie && v.kategorie !== data.kategorie && (
                    <span class="vyznam-kategorie">kategorie: {v.kategorie}</span>
                  )}
                  {v.odkaz && (
                    <a href={v.odkaz} class="vyznam-odkaz" target="_blank" rel="noopener">externí zdroj</a>
                  )}
                </p>
              ) : null}
            </li>
          ))}
        </ol>
      </section>
    )}

    {data.atestace && data.atestace.length > 0 && (
      <section class="slovnik-atestace" aria-labelledby="atestace-heading">
        <h2 id="atestace-heading">Atestace v pramenech</h2>
        <table class="atestace-table">
          <thead>
            <tr>
              <th class="atest-rok">Rok</th>
              <th class="atest-pramen">Pramen</th>
              <th class="atest-forma">Forma</th>
              <th class="atest-note">Poznámka</th>
            </tr>
          </thead>
          <tbody>
            {data.atestace.map((a) => (
              <tr>
                <td class="atest-rok"><strong>{a.rok}</strong></td>
                <td class="atest-pramen">{a.pramen}</td>
                <td class="atest-forma"><em>{a.forma}</em></td>
                <td class="atest-note">
                  {a.citace && <blockquote class="atest-citace">{a.citace}</blockquote>}
                  {a.note && <span>{a.note}</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    {(data.prekladyLa || data.prekladyDe || data.prekladyEn || data.prekladyFr) && (
      <section class="slovnik-preklady" aria-labelledby="preklady-heading">
        <h2 id="preklady-heading" class="visually-hidden">Překlady</h2>
        <dl class="preklady-grid">
          {data.prekladyLa && data.prekladyLa.length > 0 && (
            <div class="preklad-row">
              <dt><span class="lang-flag">la</span> latina</dt>
              <dd>
                {data.prekladyLa.map((p, i) => (
                  <span class="preklad-item">
                    <strong>{p.term}</strong>
                    {p.genus && <span class="preklad-genus"> {p.genus}.</span>}
                    {p.deklinace && <span class="preklad-deklinace"> {p.deklinace}</span>}
                    {p.zdroj && <span class="preklad-zdroj"> [{p.zdroj}]</span>}
                    {i < data.prekladyLa!.length - 1 && <span class="preklad-sep"> · </span>}
                  </span>
                ))}
              </dd>
            </div>
          )}
          {data.prekladyDe && data.prekladyDe.length > 0 && (
            <div class="preklad-row">
              <dt><span class="lang-flag">de</span> němčina</dt>
              <dd>
                {data.prekladyDe.map((p, i) => (
                  <span class="preklad-item">
                    <strong>{p.term}</strong>
                    {p.genus && <span class="preklad-genus"> {p.genus}.</span>}
                    {p.deklinace && <span class="preklad-deklinace"> {p.deklinace}</span>}
                    {p.zdroj && <span class="preklad-zdroj"> [{p.zdroj}]</span>}
                    {i < data.prekladyDe!.length - 1 && <span class="preklad-sep"> · </span>}
                  </span>
                ))}
              </dd>
            </div>
          )}
          {data.prekladyEn && data.prekladyEn.length > 0 && (
            <div class="preklad-row">
              <dt><span class="lang-flag">en</span> angličtina</dt>
              <dd>
                {data.prekladyEn.map((p, i) => (
                  <span class="preklad-item">
                    <strong>{p.term}</strong>
                    {p.genus && <span class="preklad-genus"> {p.genus}.</span>}
                    {p.deklinace && <span class="preklad-deklinace"> {p.deklinace}</span>}
                    {p.zdroj && <span class="preklad-zdroj"> [{p.zdroj}]</span>}
                    {i < data.prekladyEn!.length - 1 && <span class="preklad-sep"> · </span>}
                  </span>
                ))}
              </dd>
            </div>
          )}
          {data.prekladyFr && data.prekladyFr.length > 0 && (
            <div class="preklad-row">
              <dt><span class="lang-flag">fr</span> francouzština</dt>
              <dd>
                {data.prekladyFr.map((p, i) => (
                  <span class="preklad-item">
                    <strong>{p.term}</strong>
                    {p.genus && <span class="preklad-genus"> {p.genus}.</span>}
                    {p.deklinace && <span class="preklad-deklinace"> {p.deklinace}</span>}
                    {p.zdroj && <span class="preklad-zdroj"> [{p.zdroj}]</span>}
                    {i < data.prekladyFr!.length - 1 && <span class="preklad-sep"> · </span>}
                  </span>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </section>
    )}

    {wipStatus && (
      <WipBanner status={wipStatus as 'todo' | 'in-progress' | 'review'} notes={entry.data.workflow?.notes} />
    )}

    {data.obrazek && (
      <figure class="slovnik-hero">
        <img src={cdnUrl(data.obrazek.src)} alt={data.obrazek.alt} loading="eager" decoding="async" />
        {data.obrazek.caption && <figcaption>{data.obrazek.caption}</figcaption>}
        <p class="slovnik-figure-credit"><em>{data.obrazek.credit}</em></p>
      </figure>
    )}

    <div class="prose-content">
      <Content components={CSH_CONTENT_COMPONENTS} />
    </div>

    {data.references && data.references.length > 0 && (
      <section class="references slovnik-references" aria-labelledby="references-heading">
        <h2 id="references-heading" class="references-title">Literatura a odkazy</h2>
        <ol>
          {data.references.map((r, idx) => {
            // Pokud má reference key, použij ji jako stabilní anchor;
            // jinak fallback na poziční index (legacy).
            const anchorId = `ref-${r.key ?? idx + 1}`;
            // bibKey: render ISO 690 přes citeproc-js (stejné jako kroky/[slug].astro)
            if (r.bibKey) {
              const cslItem = getRef(r.bibKey);
              if (!cslItem) {
                return (
                  <li id={anchorId}>
                    <code>{r.bibKey}</code>{' '}
                    <em>(nenalezeno v references.json — spusť pnpm refs:sync)</em>
                  </li>
                );
              }
              const formatted = formatCite(r.bibKey, r.pages ? { pages: r.pages } : undefined) ?? r.bibKey;
              return (
                <li id={anchorId}>
                  <span set:html={formatted} />
                  {r.citace && (
                    <blockquote class="slovnik-ref-citace">{r.citace}</blockquote>
                  )}
                  {r.note && <p class="slovnik-ref-note" set:html={tinyMarkdown(r.note).replace(/^<p>|<\/p>$/g, '')} />}
                </li>
              );
            }
            // Fallback — citace/title only (bez Zotero záznamu)
            if (r.title || r.citace) {
              return (
                <li id={anchorId}>
                  {r.title && <strong set:html={tinyMarkdown(r.title).replace(/^<p>|<\/p>$/g, '')} />}
                  {r.pages && <span class="slovnik-ref-pages">, s. {r.pages}</span>}
                  {r.citace && (
                    <blockquote class="slovnik-ref-citace">{r.citace}</blockquote>
                  )}
                  {r.note && <p class="slovnik-ref-note" set:html={tinyMarkdown(r.note).replace(/^<p>|<\/p>$/g, '')} />}
                </li>
              );
            }
            return null;
          })}
        </ol>
      </section>
    )}

    {pribuzneEntries.length > 0 && (
      <section class="slovnik-pribuzne" aria-labelledby="pribuzne-heading">
        <h2 id="pribuzne-heading">Související hesla</h2>
        <div class="pribuzne-grid">
          {pribuzneEntries.map((e) => (
            <a href={`/slovnik/${e.data.slug}`} class="pribuzne-card">
              <h3>{e.data.title}</h3>
              <p set:html={tinyMarkdown(e.data.definice).replace(/^<p>|<\/p>$/g, '')}></p>
            </a>
          ))}
        </div>
      </section>
    )}

    <CrossRefs refs={data.crossRefs} selfType="slovnik" selfSlug={data.slug} />

    <footer class="article-byline">
      <span class="byline-author">Český spolek horologický</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <span class="byline-date">Heslo z hodinářského slovníku — primární prameny v citacích</span>
    </footer>
  </article>

  {data.references && data.references.length > 0 && (
    <script is:inline define:vars={{ refCount: data.references.length }}>
      // Auto-link [N] tokens v body na #ref-N. Skip uvnitř <a>, <code>, <pre>.
      // Pattern: [N] nebo [N, M] nebo [N–M] (range), N <= refCount.
      (() => {
        const body = document.querySelector('.prose-content');
        if (!body) return;
        const skip = new Set(['A', 'CODE', 'PRE', 'SCRIPT', 'STYLE']);
        const walker = document.createTreeWalker(body, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            let p = node.parentElement;
            while (p && p !== body) {
              if (skip.has(p.tagName)) return NodeFilter.FILTER_REJECT;
              p = p.parentElement;
            }
            return /\[\d+(?:\s*[–—,-]\s*\d+)*\]/.test(node.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
          },
        });
        const nodes = [];
        for (let n = walker.nextNode(); n; n = walker.nextNode()) nodes.push(n);
        for (const node of nodes) {
          const frag = document.createDocumentFragment();
          let last = 0;
          const re = /\[(\d+(?:\s*[–—,-]\s*\d+)*)\]/g;
          let m;
          while ((m = re.exec(node.nodeValue)) !== null) {
            if (m.index > last) frag.appendChild(document.createTextNode(node.nodeValue.slice(last, m.index)));
            // First numeric in [N], [N,M], [N–M] = jump target
            const firstN = parseInt(m[1], 10);
            if (firstN >= 1 && firstN <= refCount) {
              const sup = document.createElement('sup');
              sup.className = 'ref-cite';
              const a = document.createElement('a');
              a.href = `#ref-${firstN}`;
              a.setAttribute('aria-label', `Reference ${m[1]}`);
              a.textContent = `[${m[1]}]`;
              sup.appendChild(a);
              frag.appendChild(sup);
            } else {
              frag.appendChild(document.createTextNode(m[0]));
            }
            last = m.index + m[0].length;
          }
          if (last < node.nodeValue.length) frag.appendChild(document.createTextNode(node.nodeValue.slice(last)));
          node.parentNode.replaceChild(frag, node);
        }
      })();
    </script>
  )}
</Base>

<style>
  .slovnik-detail {
    max-width: 72ch;
    margin: 0 auto;
  }

  .slovnik-detail-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .slovnik-detail-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    color: var(--color-brass-bright);
    letter-spacing: -0.01em;
    text-transform: lowercase;
  }
  .slovnik-detail-title::first-letter {
    text-transform: uppercase;
  }

  .slovnik-varianty {
    font-size: 0.9rem;
    color: var(--color-text-soft);
    margin: 0 0 1rem;
    font-style: italic;
    /* Při mnoha variantách (6+) na mobile zabránit přesahu kontejneru */
    overflow-wrap: anywhere;
  }
  .varianty-label {
    color: var(--color-copper);
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    margin-right: 0.5rem;
    font-style: normal;
  }
  .varianta {
    margin-right: 0.3rem;
    /* Nelámat termín + badge uprostřed; lámat jen mezi variantami */
    display: inline-block;
  }

  /* Status badges pro varianty (A.28) */
  .varianta-badge {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: lowercase;
    letter-spacing: 0.03em;
    padding: 0.05rem 0.4rem;
    margin-left: 0.35rem;
    border-radius: 2px;
    vertical-align: 0.05em;
    font-family: var(--font-sans, sans-serif);
    border: 1px solid;
  }
  .varianta-status-preferred {
    color: #4caf50;
    border-color: #4caf50;
    background: color-mix(in srgb, #4caf50 8%, transparent);
  }
  .varianta-status-admitted {
    color: #5b9dd9;
    border-color: #5b9dd9;
    background: color-mix(in srgb, #5b9dd9 8%, transparent);
  }
  .varianta-status-archaic {
    color: #d9a05b;
    border-color: #d9a05b;
    background: color-mix(in srgb, #d9a05b 8%, transparent);
  }
  .varianta-status-historical {
    color: var(--color-text-soft);
    border-color: color-mix(in srgb, var(--color-brass) 35%, transparent);
    background: color-mix(in srgb, var(--color-brass) 5%, transparent);
  }
  .varianta-status-erroneous {
    color: #d97070;
    border-color: #b04848;
    background: color-mix(in srgb, #b04848 8%, transparent);
  }
  .varianta-status-ocr-variant {
    color: var(--color-text-soft);
    border-color: color-mix(in srgb, var(--color-text-soft) 50%, transparent);
    background: transparent;
    font-style: italic;
  }

  .slovnik-definice-lead {
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
  }

  /* Atestace v pramenech (A.29) — pro hesla s terminologickou proměnou */
  .slovnik-atestace {
    margin: 1.75rem 0 0;
  }
  .slovnik-atestace h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-copper);
    margin: 0 0 0.85rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
  }
  .atestace-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .atestace-table th {
    text-align: left;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-brass-bright);
    padding: 0.4rem 0.6rem;
    border-bottom: 2px solid var(--color-brass);
  }
  .atestace-table td {
    padding: 0.55rem 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 12%, transparent);
    vertical-align: top;
  }
  .atestace-table .atest-rok { width: 80px; white-space: nowrap; }
  .atestace-table .atest-pramen { width: 130px; }
  .atestace-table .atest-forma { width: 140px; font-family: var(--font-serif); }
  .atest-citace {
    font-size: 0.88rem;
    color: var(--color-text-soft);
    margin: 0 0 0.3rem;
    padding-left: 0.6rem;
    border-left: 2px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    font-style: italic;
  }

  /* Polysémní hesla — sekce Významy s rozlišením kontextem (A.27) */
  .slovnik-vyznamy {
    margin: 1.75rem 0 0;
    padding: 0;
  }
  .slovnik-vyznamy h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-copper);
    margin: 0 0 0.85rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
  }
  .vyznamy-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: vyznam;
  }
  .vyznam-item {
    counter-increment: vyznam;
    margin: 0 0 1.25rem;
    padding: 0 0 0 2.5rem;
    position: relative;
  }
  .vyznam-item::before {
    content: counter(vyznam) ".";
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-brass);
    line-height: 1;
  }
  .vyznam-kontext {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-copper);
    margin: 0 0 0.3rem;
  }
  .vyznam-definice {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-text);
    margin: 0;
  }
  .vyznam-meta {
    font-size: 0.85rem;
    color: var(--color-text-soft);
    margin: 0.4rem 0 0;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .vyznam-kategorie {
    font-style: italic;
  }
  .vyznam-odkaz {
    color: var(--color-brass-bright);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 50%, transparent);
  }
  .vyznam-odkaz:hover {
