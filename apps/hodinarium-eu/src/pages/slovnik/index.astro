---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';
import { tinyMarkdown } from '../../utils/tinyMarkdown';

/**
 * /slovnik — hodinářský výkladový a překladový slovník.
 *
 * Hesla z primárních pramenů (Šumavský 1851, Špatný 1882, Sušický 1900,
 * Sladkovský 1947, Bureš 1965, Saunier 1887, Gros 1913). Cs heslo s
 * překlady do de/en/fr a doslovnými citacemi z pramenů.
 *
 * SSOT: ~/.claude/skills/horologicka-terminologie/reference/slovnik.md
 * Sync: pnpm slovnik:build (= node scripts/build-slovnik.mjs)
 */

const all = await getCollection('slovnik');

type Kategorie = 'mechanika' | 'bici' | 'astronomicke' | 'materialy' | 'hodinky' | 'profese' | 'jine';

const KATEGORIE_LABEL: Record<Kategorie, { title: string; lead: string }> = {
  mechanika: {
    title: 'Mechanika času',
    lead: 'Krok, kotva, kyvadlo, setrvačka, vlásek, soukolí, paleta — základní pojmy konstrukce hodin.',
  },
  bici: {
    title: 'Bicí mechanismy',
    lead: 'Bicí stroj, kladívko, cymbál, závěrkové kolo, početník, srdcovka — soukolí pro odbíjení hodin a čtvrtí.',
  },
  astronomicke: {
    title: 'Sluneční a astronomické hodiny',
    lead: 'Sluneční hodiny, gnómon, časová rovnice, kvadrant — astronomické základy měření času.',
  },
  materialy: {
    title: 'Materiály a vlastnosti',
    lead: 'Isochronismus, kompenzace teplotní, invar, rubínový kámen, Breguetova vlásková křivka — materiály a fyzikální principy.',
  },
  hodinky: {
    title: 'Hodinky kapesní a náramkové',
    lead: 'Kalibr, werk, korunka, sklíčko, pouzdro, signatura, opakovací hodinky, chronograf, automatic, GMT — terminologie kapesních a náramkových hodinek.',
  },
  profese: {
    title: 'Profese a hodinářské školy',
    lead: 'Hodinář, pouzdrář, regionální školy a tradice.',
  },
  jine: {
    title: 'Ostatní',
    lead: 'Hesla mimo hlavní kategorie.',
  },
};

const KAT_ORDER: Kategorie[] = ['mechanika', 'bici', 'astronomicke', 'materialy', 'hodinky', 'profese', 'jine'];

function groupByKategorie(list: typeof all) {
  const m = new Map<Kategorie, typeof all>();
  for (const k of KAT_ORDER) m.set(k, []);
  for (const e of list) {
    const kat = e.data.kategorie as Kategorie;
    m.get(kat)?.push(e);
  }
  for (const [k, v] of m) {
    v.sort((a, b) => a.data.title.localeCompare(b.data.title, 'cs'));
    if (v.length === 0) m.delete(k);
  }
  return m;
}

const grouped = groupByKategorie(all);
const total = all.length;
---
<Base
  title="Hodinářský slovník"
  description="Výkladový a překladový slovník hodinářských termínů z primárních pramenů (Šumavský 1851, Špatný 1882, Sušický 1900, Sladkovský 1947). Cs heslo s překlady de/en/fr a doslovnými citacemi."
>
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/vice', label: 'Více' },
    { label: 'Slovník' },
  ]} />

  <header class="max-w-3xl mb-10">
    <p class="eyebrow mb-4">Výkladový a překladový slovník</p>
    <h1 class="hero-title mb-5 hero-title-sm">
      Hodinářský slovník
    </h1>
    <p class="text-[var(--color-text)] leading-relaxed">
      Hesla česky s překlady do <strong>němčiny</strong>, <strong>angličtiny</strong>
      a <strong>francouzštiny</strong>. Každý fakt je opřený o doslovnou citaci
      z primárních pramenů — Šumavský 1851, Špatný 1882, Sušický 1900,
      Sladkovský 1947, Saunier 1887, Gros 1913, Dietzschold 1894, Táborský 1570.
    </p>
    <p class="slovnik-stats">
      <strong class="text-[var(--color-brass-bright)]" id="slovnik-count">{total}</strong>
      {' '}<span id="slovnik-count-label">hesel ve {grouped.size === 1 ? 'jedné' : grouped.size + ' tematických'} {grouped.size === 1 ? 'kategorii' : 'kategoriích'}</span>
    </p>
  </header>

  <div class="slovnik-filter">
    <label for="slovnik-search" class="slovnik-filter-label">Hledat heslo</label>
    <div class="slovnik-filter-input-wrap">
      <input
        type="search"
        id="slovnik-search"
        class="slovnik-filter-input"
        placeholder="trýb, escapement, kyvadlo, krok…"
        autocomplete="off"
        aria-describedby="slovnik-filter-hint"
        spellcheck="false"
      />
      <button type="button" id="slovnik-search-clear" class="slovnik-filter-clear" aria-label="Vymazat hledání" hidden>×</button>
    </div>
    <p id="slovnik-filter-hint" class="slovnik-filter-hint">
      Hledá v českém hesle, variantách i překladech (de/en/fr). Diakritika nemusí — „tryb" najde „trýb".
    </p>
  </div>

  {[...grouped.entries()].map(([kat, list]) => (
    <section class="slovnik-skupina" data-kategorie={kat}>
      <header class="slovnik-skupina-header">
        <h2 class="slovnik-skupina-label">{KATEGORIE_LABEL[kat].title}</h2>
        <p class="slovnik-skupina-lead">{KATEGORIE_LABEL[kat].lead}</p>
      </header>
      <div class="slovnik-grid">
        {list.map((e) => {
          const de = e.data.prekladyDe?.[0]?.term;
          const en = e.data.prekladyEn?.[0]?.term;
          const fr = e.data.prekladyFr?.[0]?.term;
          const definice = e.data.definice;
          // Searchable text: title + všechny překlady + varianty.
          // Lower-case + ASCII fold (diakritika nemusí) provádí JS na klientu.
          const searchBlob = [
            e.data.title,
            ...(e.data.varianty ?? []),
            ...(e.data.prekladyDe?.map((p) => p.term) ?? []),
            ...(e.data.prekladyEn?.map((p) => p.term) ?? []),
            ...(e.data.prekladyFr?.map((p) => p.term) ?? []),
          ].join(' ');
          return (
            <a href={`/slovnik/${e.data.slug}`} class="slovnik-card" data-search={searchBlob}>
              <h3 class="slovnik-name">{e.data.title}</h3>
              <p class="slovnik-translations">
                {de && <span class="lang-tag" title="němčina"><span class="lang-code">de</span> {de}</span>}
                {en && <span class="lang-tag" title="angličtina"><span class="lang-code">en</span> {en}</span>}
                {fr && <span class="lang-tag" title="francouzština"><span class="lang-code">fr</span> {fr}</span>}
              </p>
              <p class="slovnik-definice" set:html={tinyMarkdown(definice).replace(/^<p>|<\/p>$/g, '')}></p>
            </a>
          );
        })}
      </div>
      <p class="slovnik-empty" hidden>Žádné heslo neodpovídá filtru.</p>
    </section>
  ))}

  <p id="slovnik-no-results" class="slovnik-no-results" hidden>
    Žádné heslo neodpovídá hledání. Zkus jiné slovo nebo část slova (např. „kyv" místo „kyvadlo").
  </p>
</Base>

<script>
  // Diakritika-insenzitivní fold + lowercase pro fuzzy match.
  function fold(s: string): string {
    return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  const input = document.getElementById('slovnik-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('slovnik-search-clear') as HTMLButtonElement | null;
  const noResults = document.getElementById('slovnik-no-results') as HTMLElement | null;
  const count = document.getElementById('slovnik-count') as HTMLElement | null;
  const countLabel = document.getElementById('slovnik-count-label') as HTMLElement | null;
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.slovnik-skupina'));
  const allCards = Array.from(document.querySelectorAll<HTMLElement>('.slovnik-card'));
  const total = allCards.length;

  // Pre-fold each card's searchable text (jednou při loadu, ne při každém keystroke)
  const cardData = allCards.map((c) => ({
    el: c,
    text: fold(c.dataset.search ?? ''),
  }));

  function applyFilter() {
    if (!input) return;
    const raw = input.value.trim();
    const tokens = fold(raw).split(/\s+/).filter(Boolean);

    if (clearBtn) clearBtn.hidden = raw.length === 0;

    let visible = 0;
    for (const { el, text } of cardData) {
      const match = tokens.length === 0 || tokens.every((t) => text.includes(t));
      el.classList.toggle('slovnik-card-hidden', !match);
      if (match) visible++;
    }

    // Hide/show whole sections based on whether they have any visible card
    let visibleSections = 0;
    for (const sec of sections) {
      const visibleInSec = sec.querySelectorAll('.slovnik-card:not(.slovnik-card-hidden)').length;
      sec.hidden = visibleInSec === 0;
      if (visibleInSec > 0) visibleSections++;
    }

    if (noResults) noResults.hidden = visible > 0;

    // Update header count
    if (count && countLabel) {
      count.textContent = String(visible);
      if (tokens.length === 0) {
        countLabel.textContent = `hesel${visibleSections > 1 ? ` v ${visibleSections} kategoriích` : visibleSections === 1 ? ' v jedné kategorii' : ''}`;
      } else {
        countLabel.textContent = `${visible === 1 ? 'heslo' : visible >= 2 && visible <= 4 ? 'hesla' : 'hesel'} z ${total} odpovídá filtru`;
      }
    }
  }

  input?.addEventListener('input', applyFilter);
  clearBtn?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      input.focus();
      applyFilter();
    }
  });

  // ESC = clear (when input focused)
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && input.value !== '') {
      e.preventDefault();
      input.value = '';
      applyFilter();
    }
  });

  // Fokus z URL hashpattern `#hledat=foo` nebo query `?q=foo`
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q');
  if (initialQuery && input) {
    input.value = initialQuery;
    applyFilter();
  }
</script>

<style>
  .slovnik-stats {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* === Search filter === */
  .slovnik-filter {
    margin: 0 0 2.5rem;
    max-width: 40rem;
  }
  .slovnik-filter-label {
    display: block;
    font-family: var(--font-serif);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-copper);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }
  .slovnik-filter-input-wrap {
    position: relative;
  }
  .slovnik-filter-input {
    width: 100%;
    padding: 0.65rem 2.5rem 0.65rem 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 30%, transparent);
    border-radius: 2px;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .slovnik-filter-input::placeholder {
    color: color-mix(in srgb, var(--color-text-soft) 70%, transparent);
    font-style: italic;
  }
  .slovnik-filter-input:focus {
    outline: none;
    border-color: var(--color-brass-bright);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .slovnik-filter-clear {
    position: absolute;
    top: 50%;
    right: 0.45rem;
    transform: translateY(-50%);
    width: 1.75rem;
    height: 1.75rem;
    background: transparent;
    border: none;
    border-radius: 2px;
    color: var(--color-text-soft);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .slovnik-filter-clear:hover {
    background: color-mix(in srgb, var(--color-brass) 12%, transparent);
    color: var(--color-brass-bright);
  }
  .slovnik-filter-hint {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    color: var(--color-text-soft);
    line-height: 1.4;
  }

  .slovnik-card-hidden {
    display: none !important;
  }

  .slovnik-empty {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-soft);
    font-style: italic;
  }

  .slovnik-no-results {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .slovnik-skupina {
    margin-bottom: 3rem;
  }
  .slovnik-skupina-header {
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }
  .slovnik-skupina-label {
    font-family: var(--font-serif);
    font-size: 0.78rem !important;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-copper);
    font-weight: 500;
    margin: 0 0 0.4rem !important;
  }
  .slovnik-skupina-lead {
    font-size: 0.9rem;
    color: var(--color-text-soft);
    margin: 0;
    line-height: 1.5;
    max-width: 70ch;
  }

  .slovnik-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .slovnik-card {
    display: block;
    padding: 1.1rem 1.25rem 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 200ms ease, transform 200ms ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    border-left: 3px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .slovnik-card:hover {
    border-color: var(--color-brass);
    border-left-color: var(--color-brass-bright);
    transform: translateY(-2px);
  }

  .slovnik-name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.25rem !important;
    color: var(--color-brass-bright) !important;
    margin: 0 0 0.55rem !important;
    line-height: 1.2 !important;
    /* Lowercase heslo (e.g. "krok", "kotva") — capitalize first letter visually */
    text-transform: lowercase;
  }
  .slovnik-name::first-letter {
    text-transform: uppercase;
  }

  .slovnik-translations {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0 0 0.7rem;
    font-size: 0.78rem;
    line-height: 1.3;
  }
  .lang-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.05rem 0.35rem;
    background: color-mix(in srgb, var(--color-bg-deep) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    border-radius: 2px;
    color: var(--color-text-soft);
    font-feature-settings: "lnum";
    white-space: nowrap;
  }
  .lang-code {
    font-size: 0.65rem;
    color: var(--color-copper);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .slovnik-definice {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--color-text-soft);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .slovnik-grid { grid-template-columns: 1fr; }
  }
</style>
