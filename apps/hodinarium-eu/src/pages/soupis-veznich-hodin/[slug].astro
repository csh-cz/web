---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorNotesBlock from '../../components/EditorNotesBlock.astro';
import WipBanner from '../../components/WipBanner.astro';
import { getCollection, render } from 'astro:content';
import { hodinari } from '../../data/hodinari';
import { tinyMarkdown } from '../../utils/tinyMarkdown';
import { pramenTooltip, extractWikiTitle } from '../../utils/referenceTypes';
import { formatCite, getRef } from '../../utils/cite';
import { isPubliclyBuildable, showsWipBanner } from '../../utils/workflow-visibility';
import CrossRefs from '../../components/CrossRefs.astro';

/** Auto-detekce typu pramene z URL (když není explicitně uveden v frontmatteru).
 *  Bez URL → typicky bibliografická citace tištěného pramene → 'kniha' (📖). */
function detectPramenType(url: string | undefined, explicit?: string): string {
  if (explicit) return explicit;
  if (!url) return 'kniha';
  if (/wikipedia\.org|wikimedia\.org|wikidata\.org/i.test(url)) return 'wiki';
  if (/mapy\.cz|mapy\.com|google\.com\/maps|maps\.google|goo\.gl\/maps|openstreetmap\.org/i.test(url)) return 'mapa';
  if (/\.pdf(\?|$)/i.test(url)) return 'pdf';
  return 'odkaz';
}

export async function getStaticPaths() {
  const items = await getCollection('soupis-veznich-hodin');
  return items
    .filter((item) => isPubliclyBuildable(item.data.workflow))
    .map((item) => ({
      params: { slug: item.data.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const wipStatus = showsWipBanner(d.workflow) ? d.workflow!.status : null;

// slug → display name
const hodinarName = new Map<string, string>();
for (const h of hodinari) hodinarName.set(h.slug, h.jmeno);
const hodinarDisplay = d.hodinar ? (hodinarName.get(d.hodinar) || d.hodinar) : null;

/** Parsuje `restaurator` string na pole položek { slug?, jmeno }.
 *  Podporuje multi-restaurator oddělený `,`, `;`, ` + `, ` a `.
 *  Pro každý token: pokud existuje v hodinari registry jako slug,
 *  vytvoří link; jinak pokud existuje jako display name (přesný match),
 *  vytvoří link na slug; jinak ponechá jako plain text.
 *
 *  Stejný pattern jako displayHodinar v index.astro. */
const hodinarSlugByName = new Map<string, string>();
for (const h of hodinari) {
  hodinarSlugByName.set(h.jmeno, h.slug);
  for (const alias of h.aliasy || []) hodinarSlugByName.set(alias, h.slug);
}
type RestauratorPart = { slug?: string; jmeno: string };
function parseRestaurator(text?: string): RestauratorPart[] {
  if (!text) return [];
  return text
    .split(/\s*[,;+]\s*|\s+a\s+/)
    .map((t) => t.trim())
    .filter(Boolean)
    .map((token): RestauratorPart => {
      // 1) Token je slug — exists v registry
      if (hodinarName.has(token)) return { slug: token, jmeno: hodinarName.get(token)! };
      // 2) Token je display name — match přes hodinarSlugByName
      if (hodinarSlugByName.has(token)) {
        const slug = hodinarSlugByName.get(token)!;
        return { slug, jmeno: hodinarName.get(slug)! };
      }
      // 3) Plain text — žádný medailon
      return { jmeno: token };
    });
}
const restauratori = parseRestaurator(d.restaurator);

const stavLabel: Record<string, string> = {
  in_situ: 'in situ',
  preneseno: 'přeneseno',
  ztracene: 'ztracené',
  znicene: 'zničené',
  neznamy: 'neověřeno',
};
const stavTooltip: Record<string, string> = {
  in_situ: 'Stroj je stále na původním místě, kde byl instalován.',
  preneseno: 'Stroj byl přemístěn z původní lokality (typicky do muzejní expozice).',
  ztracene: 'Stroj se ztratil — jeho současný osud není znám.',
  znicene: 'Stroj byl prokazatelně zničen (rozebrán, sešrotován, požár, válka).',
  neznamy: 'Současný stav stroje není dohledán — vyžaduje terénní výzkum.',
};
const chodLabel: Record<string, string> = {
  v_chodu: 'v chodu',
  nefunkcni: 'nefunkční',
  restaurovano: 'restaurováno',
  pred_restaurovanim: 'před restaurováním',
  znicene: 'zničené',
  neznamy: 'neznámý',
};
const chodTooltip: Record<string, string> = {
  v_chodu: 'Stroj funguje a měří čas.',
  nefunkcni: 'Stroj nefunguje — vyžaduje opravu.',
  restaurovano: 'Stroj prošel restaurátorským zásahem.',
  pred_restaurovanim: 'Stroj čeká na restaurování.',
  znicene: 'Stroj nelze uvést do chodu (nedochovaný / zničený).',
  neznamy: 'Funkční stav stroje není doložen.',
};

const pageTitle = `${d.puvodniMisto.obec} ${d.rok} — ${hodinarDisplay || d.hodinarText || 'neznámý hodinář'}`;
---
<Base
  title={pageTitle}
  description={`Věžní hodiny ${d.rok} v lokalitě ${d.puvodniMisto.obec}${d.puvodniMisto.budova ? ` (${d.puvodniMisto.budova})` : ''} — záznam v Soupisu věžních hodin Hodinária.`}
  cmsEditUrl={`/admin/#/collections/soupis-veznich-hodin/entries/${item.id}`}
  citation={{
    /* Záznam o objektu (věžní hodiny) — Web Page, ne journalArticle.
       Datum = rok výroby objektu (~1868), ne datum publikace stránky. */
    itemType: 'webpage',
    title: pageTitle,
    author: hodinarDisplay || d.hodinarText || undefined,
    date: typeof d.rok === 'number' ? `${d.rok}-01-01` : undefined,
    journalTitle: 'Hodinárium — Soupis věžních hodin',
    keywords: [
      d.puvodniMisto.obec,
      ...(d.puvodniMisto.budova ? [d.puvodniMisto.budova] : []),
      ...(d.puvodniMisto.kraj ? [d.puvodniMisto.kraj] : []),
      ...(d.puvodniMisto.zeme && d.puvodniMisto.zeme !== 'CZ' ? [d.puvodniMisto.zeme] : []),
      ...(d.krok ? [`krok: ${d.krok.split(/[\s,;()]/)[0]}`] : []),
      ...(d.pohon ? [`pohon: ${d.pohon}`] : []),
      'věžní hodiny',
    ].filter(Boolean),
  }}
>
  <Breadcrumbs trail={[
    { href: "/", label: "Hodinárium" },
    { href: "/soupis-veznich-hodin/", label: "Soupis věžních hodin" },
    { label: pageTitle },
  ]} />

  <header class="detail-header">
    <p class="eyebrow mb-3">Věžní hodiny · {d.rok}</p>
    <h1>{d.puvodniMisto.obec}{d.puvodniMisto.budova ? ` — ${d.puvodniMisto.budova}` : ''}</h1>
    {d.hodinar && (
      <p class="meta">
        Hodinář: <a href={`/hodinari/${d.hodinar}`}>{hodinarDisplay}</a>
      </p>
    )}
    {!d.hodinar && d.hodinarText && (
      <p class="meta">Hodinář: {d.hodinarText}</p>
    )}
  </header>

  <section class="karta">
    <dl>
      {d.signatura && (<><dt>Signatura</dt><dd><code>{d.signatura}</code></dd></>)}
      {d.krok && (<><dt>Krok</dt><dd>{d.krok}</dd></>)}
      {d.pohon && (<><dt>Pohon</dt><dd>{d.pohon}</dd></>)}
      {d.pocetCifernik && (<><dt>Počet ciferníků</dt><dd>{d.pocetCifernik}</dd></>)}
      {d.rozmery && (<><dt>Rozměry</dt><dd>{d.rozmery}</dd></>)}
      {d.cenaDobova && (<><dt>Dobová cena</dt><dd>{d.cenaDobova}</dd></>)}
      <dt>Stav</dt>
      <dd><span class={`stav-badge stav-${d.stav}`} title={stavTooltip[d.stav]}>{stavLabel[d.stav]}</span></dd>
      {d.chod && (<><dt>Chod</dt><dd><span title={chodTooltip[d.chod]}>{chodLabel[d.chod]}</span></dd></>)}
      {d.prenos && (
        <>
          <dt>Přemístění</dt>
          <dd>
            do <strong>{d.prenos.do}</strong>
            {d.prenos.rok && <span> ({d.prenos.rok})</span>}
            {d.prenos.poznamka && <p class="poznamka">{d.prenos.poznamka}</p>}
          </dd>
        </>
      )}
      {restauratori.length > 0 && (
        <>
          <dt>{restauratori.length > 1 ? 'Restaurátoři' : 'Restaurátor'}</dt>
          <dd>
            {restauratori.map((r, i) => (
              <>
                {i > 0 && ', '}
                {r.slug ? (
                  <a href={`/hodinari/${r.slug}`}>{r.jmeno}</a>
                ) : (
                  <span>{r.jmeno}</span>
                )}
              </>
            ))}
            {d.rokRestaurovani && <span> ({d.rokRestaurovani})</span>}
          </dd>
        </>
      )}
      <dt>Lokace</dt>
      <dd>
        {d.puvodniMisto.budova && <>{d.puvodniMisto.budova}, </>}
        {d.puvodniMisto.obec}
        {d.puvodniMisto.cast && <span> – {d.puvodniMisto.cast}</span>}
        {d.puvodniMisto.okres && <span class="muted"> · {d.puvodniMisto.okres}</span>}
        {d.puvodniMisto.kraj && <span class="muted"> · {d.puvodniMisto.kraj}</span>}
        {d.souradnice && (
          <p class="souradnice">
            <a href={`https://www.openstreetmap.org/?mlat=${d.souradnice[0]}&mlon=${d.souradnice[1]}&zoom=17`} target="_blank" rel="noopener"
               title="Otevřít polohu v OpenStreetMap (nové okno)">
              {d.souradnice[0].toFixed(5)}, {d.souradnice[1].toFixed(5)}
            </a>
            {d.souradnicePribl && <span class="muted"> (přibližné)</span>}
          </p>
        )}
        {d.pamatkovyKatalog && (
          <p class="pk-badge">
            <a
              href={d.pamatkovyKatalog.slug
                ? `https://www.pamatkovykatalog.cz/${d.pamatkovyKatalog.slug}-${d.pamatkovyKatalog.id}`
                : `https://www.pamatkovykatalog.cz/?id=${d.pamatkovyKatalog.id}`}
              target="_blank"
              rel="noopener"
              title="Záznam v Památkovém katalogu NPÚ (nové okno)"
            >
              Kulturní památka — Památkový katalog NPÚ{d.pamatkovyKatalog.npuKatCislo && <span class="muted"> · KatCislo {d.pamatkovyKatalog.npuKatCislo}</span>}
            </a>
          </p>
        )}
      </dd>
    </dl>
  </section>

  {d.foto && d.foto.length > 0 && (
    <section class="foto-grid">
      {d.foto.map((f) => (
        <figure>
          <img src={f.src} alt={f.alt || ''} loading="lazy" />
          {(f.alt || f.credit) && (
            <figcaption>
              {f.alt}
              {f.credit && <small class="credit"> — {f.credit}</small>}
            </figcaption>
          )}
        </figure>
      ))}
    </section>
  )}

  {d.poznamka && (
    <section class="poznamka-block" set:html={tinyMarkdown(d.poznamka)}>
    </section>
  )}

  <EditorNotesBlock notes={d.editorNotes} sourceFile={`content/soupis-veznich-hodin/${item.id}.mdx`} />

  {wipStatus && (
    <WipBanner status={wipStatus as 'todo' | 'in-progress' | 'review'} notes={d.workflow?.notes} />
  )}

  <section class="prose-content">
    <Content />
  </section>

  {d.prameny && d.prameny.length > 0 && (
    <section class="prameny">
      <h2>Prameny</h2>
      <ul class="references-list">
        {d.prameny.map((p, i) => {
          const refId = `ref-${p.key ?? i + 1}`;
          // bibKey path: render přes citeproc + ISO 690 CSL
          const cslItem = p.bibKey ? getRef(p.bibKey) : null;
          const cslType = (cslItem?.type as string) || '';
          const inferredType =
            cslType === 'book' || cslType === 'chapter' ? 'kniha'
            : cslType === 'article-journal' || cslType === 'paper-conference' || cslType === 'article-newspaper' || cslType === 'article-magazine' ? 'clanek'
            : cslType === 'webpage' || cslType === 'post-weblog' || cslType === 'document' ? 'odkaz'
            : cslType === 'patent' ? 'patent'
            : cslType === 'manuscript' || cslType === 'archive' ? 'archiv'
            : cslType === 'report' ? 'zprava'
            : cslType === 'thesis' ? 'kniha'
            : null;
          const type = p.bibKey
            ? (p.type ?? inferredType ?? 'odkaz')
            : detectPramenType(p.url, p.type);

          // Wiki: jen title + skrytá URL + ⓦ ikona (přes CSS).
          if (type === 'wiki') {
            const wUrl = p.url || (cslItem?.URL as string) || (cslItem?.url as string);
            const wTitle = p.title
              || (cslItem?.title as string)
              || extractWikiTitle(wUrl)
              || p.bibKey
              || 'Wikipedie';
            return (
              <li id={refId} class="reference reference-wiki" title={pramenTooltip('wiki')}>
                {wUrl ? <a href={wUrl} target="_blank" rel="noopener">{wTitle}</a> : <span class="ref-title">{wTitle}</span>}
                {p.poznamka && <span class="ref-note"> — {p.poznamka}</span>}
              </li>
            );
          }

          const formatted = p.bibKey ? formatCite(p.bibKey, { pages: p.pages }) : null;

          if (formatted) {
            return (
              <li id={refId} class={`reference reference-${type}`} title={pramenTooltip(type)}>
                <span class="ref-cite" set:html={formatted} />
                {p.poznamka && <span class="ref-note"> — {p.poznamka}</span>}
              </li>
            );
          }

          // Legacy path (bez bibKey): prefer title, pak (zkrácená) citace, pak doménu URL.
          const linkText = p.title
            || (p.citace ? p.citace.replace(/\s+/g, ' ').trim() : null)
            || (p.url ? p.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/.*$/, '') : 'odkaz');
          // tinyMarkdown vrací <p>...</p>; pro inline použití strip <p> tagy.
          const linkHtml = tinyMarkdown(linkText).replace(/^<p>|<\/p>$/g, '').replace(/<\/p><p>/g, ' ');
          return (
            <li id={refId} class={`reference reference-${type}`} title={pramenTooltip(type)}>
              {p.autor && <span class="ref-author">{p.autor}:</span>}{' '}
              {p.url
                ? <a href={p.url} target="_blank" rel="noopener" set:html={linkHtml}></a>
                : <span class="ref-title" set:html={linkHtml}></span>}
              {p.rok !== undefined && <span class="ref-year"> ({p.rok})</span>}
              {/* citace zobrazujeme jen pokud není už použita jako text odkazu */}
              {p.citace && p.title && <p class="citace" set:html={tinyMarkdown(p.citace)}></p>}
            </li>
          );
        })}
      </ul>
    </section>
  )}

  {(d.relatedKarty?.length || d.relatedClanky?.length) && (
    <section class="related">
      <h2>Související</h2>
      <ul>
        {d.relatedKarty?.map((k) => <li>Karta exponátu: <a href={`/sbirka/karta/${k}/`}><code>{k}</code></a></li>)}
        {d.relatedClanky?.map((c) => <li>Článek: <a href={c}>{c}</a></li>)}
      </ul>
    </section>
  )}

  <CrossRefs refs={d.crossRefs} selfType="soupis" selfSlug={d.slug} />

  {/* zdrojDat (machine slug) se nezobrazuje — citace pramenů patří do <Prameny>.
      V patičce ponecháváme jen datum posledního ověření, pokud existuje. */}
  {d.posledniOvereni && (
    <p class="zdroj">
      <small>Poslední ověření {d.posledniOvereni}</small>
    </p>
  )}
</Base>

<style>
  .detail-header { margin-bottom: 2rem; max-width: 720px; }
  .detail-header h1 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: var(--color-brass-bright);
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }
  .meta { color: var(--color-text-soft); }
  .karta {
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-left: 3px solid var(--color-copper);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }
  .karta dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }
  .karta dt {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brass-bright);
  }
  .karta dd { margin: 0; }
  .karta code { background: rgba(0,0,0,0.2); padding: 0 0.3em; border-radius: 2px; }
  .stav-badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 2px;
    font-size: 0.85rem;
    border: 1px solid;
  }
  .stav-in_situ { color: #4caf50; border-color: #4caf50; }
  .stav-preneseno { color: #5b9dd9; border-color: #5b9dd9; }
  .stav-ztracene { color: #d9a05b; border-color: #d9a05b; }
  /* Audit C2 a11y: text #b04848 (3.28:1) → #d97070 (~5.4:1 AA pass).
     Border zůstává sytější — okraj nemá WCAG text-contrast požadavek. */
  .stav-znicene { color: #d97070; border-color: #b04848; }
  .stav-neznamy { color: #999; border-color: #999; }

  .souradnice { margin-top: 0.4rem; font-size: 0.9rem; }
  .pk-badge { margin-top: 0.3rem; font-size: 0.9rem; }
  .pk-badge a {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--color-text-soft);
    border-radius: 999px;
    color: var(--color-text);
    text-decoration: none;
  }
  .pk-badge a:hover { background: var(--color-bg-soft, rgba(0,0,0,0.04)); }
  .muted { color: var(--color-text-soft); opacity: 0.7; }
  .poznamka { font-size: 0.9rem; color: var(--color-text-soft); margin-top: 0.3rem; }

  .foto-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .foto-grid img { width: 100%; height: auto; display: block; }
  .foto-grid figcaption { font-size: 0.85rem; color: var(--color-text-soft); padding-top: 0.4rem; }
  .foto-grid .credit { font-size: 0.75rem; opacity: 0.75; }

  .poznamka-block {
    background: color-mix(in srgb, var(--color-bg-elevated) 50%, transparent);
    border-left: 3px solid color-mix(in srgb, var(--color-brass) 40%, transparent);
    padding: 0.85rem 1.25rem;
    margin-bottom: 1.5rem;
    font-style: italic;
    color: var(--color-text-soft);
  }

  .prose-content { margin-bottom: 2.5rem; }

  .prameny, .related {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 20%, transparent);
  }
  .prameny h2, .related h2 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-brass-bright);
  }
  .prameny ul:not(.references-list), .related ul { padding-left: 1.2rem; }
  .prameny li:not(.reference), .related li { margin-bottom: 0.5rem; }
  .citace { font-size: 0.85rem; color: var(--color-text-soft); margin: 0.3rem 0 0; }

  /* Sjednocený references-list styl (sdílený s Article.astro) */
  .prameny .references-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .prameny .references-list li {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-soft);
    padding-left: 1.4rem;
    position: relative;
  }
  .prameny .references-list li::before {
    content: '·';
    position: absolute;
    left: 0.4rem;
    color: var(--color-copper);
    font-weight: 700;
  }
  /* Font Awesome codepointy místo emoji glyphů (feedback_ikony_font_awesome
     migrace 2026-05-19). FA Free Solid = font-family + font-weight: 900;
     Brands = font-family + font-weight: 400. */
  .prameny .references-list li[class*="reference-"]::before {
    font-family: "Font Awesome 6 Free";
    font-weight: 900;
    font-style: normal;
    color: var(--color-copper);
  }
  .prameny .references-list li.reference-kniha::before  { content: '\f02d'; left: 0.1rem; }  /* fa-book */
  .prameny .references-list li.reference-pdf::before    { content: '\f019'; left: 0.2rem; color: var(--color-brass-bright); }  /* fa-download */
  .prameny .references-list li.reference-wiki::before   { content: '\f266'; left: 0.2rem; font-family: "Font Awesome 6 Brands"; font-weight: 400; }  /* fa-wikipedia-w */
  .prameny .references-list li.reference-clanek::before { content: '\f1ea'; left: 0.1rem; }  /* fa-newspaper */
  .prameny .references-list li.reference-archiv::before { content: '\f187'; left: 0.2rem; }  /* fa-box-archive */
  .prameny .references-list li.reference-patent::before { content: '\f013'; left: 0.2rem; }  /* fa-gear */
  .prameny .references-list li.reference-zprava::before { content: '\f304'; left: 0.2rem; }  /* fa-pen */
  .prameny .references-list li.reference-mapa::before {
    content: '';
    left: 0.2rem;
    top: 0.35em;
    width: 0.85em;
