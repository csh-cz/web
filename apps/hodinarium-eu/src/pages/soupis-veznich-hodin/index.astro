---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { hodinari } from '../../data/hodinari';

const hodiny = await getCollection('soupis-veznich-hodin');

// slug → display name lookup
const hodinarName = new Map<string, string>();
for (const h of hodinari) hodinarName.set(h.slug, h.jmeno);
function displayHodinar(slug?: string, fallback?: string): string {
  if (slug && hodinarName.has(slug)) return hodinarName.get(slug)!;
  if (slug) return slug;
  return fallback || '—';
}

// Sort: by year asc, then by obec
hodiny.sort((a, b) => {
  const ya = typeof a.data.rok === 'number' ? a.data.rok : parseInt(String(a.data.rok), 10) || 0;
  const yb = typeof b.data.rok === 'number' ? b.data.rok : parseInt(String(b.data.rok), 10) || 0;
  if (ya !== yb) return ya - yb;
  return a.data.puvodniMisto.obec.localeCompare(b.data.puvodniMisto.obec, 'cs');
});

const stavCount = { in_situ: 0, preneseno: 0, ztracene: 0, znicene: 0, neznamy: 0 };
for (const h of hodiny) stavCount[h.data.stav]++;

const stavLabel: Record<string, string> = {
  in_situ: 'in situ',
  preneseno: 'přeneseno',
  ztracene: 'ztracené',
  znicene: 'zničené',
  neznamy: 'neověřeno',
};
const stavTooltip: Record<string, string> = {
  in_situ: 'Stroj je stále na původním místě, kde byl instalován.',
  preneseno: 'Stroj byl přemístěn z původní lokality (typicky do muzejní expozice).',
  ztracene: 'Stroj se ztratil — jeho současný osud není znám.',
  znicene: 'Stroj byl prokazatelně zničen (rozebrán, sešrotován, požár, válka).',
  neznamy: 'Současný stav stroje není dohledán — vyžaduje terénní výzkum.',
};
const stavTone: Record<string, string> = {
  in_situ: 'tone-ok',
  preneseno: 'tone-info',
  ztracene: 'tone-warn',
  znicene: 'tone-bad',
  neznamy: 'tone-mute',
};

// Sběr unique hodnot pro dropdowny
const hodinariSet = new Map<string, string>();
const krajeSet = new Set<string>();
const stateSet = new Set<string>();
const krokSet = new Set<string>();
let yearMin = Infinity;
let yearMax = -Infinity;

for (const h of hodiny) {
  if (h.data.hodinar) hodinariSet.set(h.data.hodinar, displayHodinar(h.data.hodinar));
  else if (h.data.hodinarText) hodinariSet.set(`__text:${h.data.hodinarText}`, h.data.hodinarText);
  const z = h.data.puvodniMisto.zeme;
  const k = h.data.puvodniMisto.kraj;
  if (z) stateSet.add(z);
  if (z === 'CZ' && k) krajeSet.add(k);
  if (h.data.krok) {
    // Extract first word/keyword pro filtraci (Graham, Manhardt, Amant, kotvový, vřetenový, …)
    const krokKey = h.data.krok
      .replace(/[*]/g, '')
      .split(/[\s,;()]/)[0]
      .trim()
      .toLowerCase();
    if (krokKey.length >= 3) krokSet.add(krokKey);
  }
  const y = typeof h.data.rok === 'number' ? h.data.rok : parseInt(String(h.data.rok), 10);
  if (!isNaN(y) && y > 1000 && y < 2100) {
    if (y < yearMin) yearMin = y;
    if (y > yearMax) yearMax = y;
  }
}
const hodinariOpts = [...hodinariSet.entries()]
  .sort((a, b) => a[1].localeCompare(b[1], 'cs'));
const krajeOpts = [...krajeSet].sort((a, b) => a.localeCompare(b, 'cs'));
const stateOpts = [...stateSet].sort();
const krokOpts = [...krokSet].sort((a, b) => a.localeCompare(b, 'cs'));

// Helper: krok pro filter (extract keyword)
function krokKeyword(krok?: string): string {
  if (!krok) return '';
  return krok.replace(/[*]/g, '').split(/[\s,;()]/)[0].trim().toLowerCase();
}

// Helper: location string pro display + filter
function placeMeta(p: { obec: string; cast?: string; kraj?: string; zeme?: string }): { display: string; filter: string } {
  const parts = [p.obec];
  if (p.cast) parts.push(`(${p.cast})`);
  return {
    display: parts.join(' '),
    filter: [p.obec, p.cast, p.kraj, p.zeme].filter(Boolean).join(' ').toLowerCase(),
  };
}
---
<Base
  title="Soupis věžních hodin"
  description="Soupis dochovaných i ztracených věžních hodin v českých zemích — identifikovaných in situ i z pramenů. Strojovaná podle hodináře, lokace a stavu, doplněná o interaktivní mapu."
>
  <Breadcrumbs trail={[
    { href: "/", label: "Hodinárium" },
    { label: "Soupis věžních hodin" },
  ]} />

  <header class="soupis-header">
    <p class="eyebrow mb-4">Datafikovaný rejstřík</p>
    <h1>Soupis věžních hodin</h1>
    <p class="lede">
      Dochované i ztracené věžní hodiny v českých zemích — sestavené z dobových pramenů,
      hodinářských tabulek (Krečmer, Landesbergerové, Prokeš), evidence Hodinária, NPÚ
      pamatkového katalogu a OSM. Záznamy doplňujeme postupně.
    </p>
    <p class="lede">
      <a href="/soupis-veznich-hodin/mapa/" class="cta-link">→ zobrazit jako interaktivní mapu</a>
    </p>
  </header>

  <section class="stats" data-stats>
    <div class="stat-card">
      <div class="stat-num" data-stat-total>{hodiny.length}</div>
      <div class="stat-label">záznamů celkem</div>
    </div>
    {Object.entries(stavCount).filter(([_, n]) => n > 0).map(([k, n]) => (
      <div class={`stat-card ${stavTone[k]}`} data-stat-card={k}>
        <div class="stat-num" data-stat-count={k}>{n}</div>
        <div class="stat-label">{stavLabel[k]}</div>
      </div>
    ))}
  </section>

  {hodiny.length > 0 && (
    <section class="filters" aria-label="Filtry tabulky">
      <div class="filter-row">
        <label class="filter-cell">
          <span class="filter-label">Hodinář</span>
          <select id="f-hodinar">
            <option value="">— vše —</option>
            {hodinariOpts.map(([slug, name]) => (
              <option value={slug}>{name}</option>
            ))}
          </select>
        </label>

        <label class="filter-cell">
          <span class="filter-label">Stát</span>
          <select id="f-stat">
            <option value="">— vše —</option>
            {stateOpts.map((s) => (
              <option value={s}>{s}</option>
            ))}
          </select>
        </label>

        <label class="filter-cell">
          <span class="filter-label">Kraj (jen CZ)</span>
          <select id="f-kraj">
            <option value="">— vše —</option>
            {krajeOpts.map((k) => (
              <option value={k}>{k}</option>
            ))}
          </select>
        </label>

        <label class="filter-cell">
          <span class="filter-label">Krok</span>
          <select id="f-krok">
            <option value="">— vše —</option>
            {krokOpts.map((k) => (
              <option value={k}>{k}</option>
            ))}
          </select>
        </label>
      </div>

      <div class="filter-row">
        <label class="filter-cell filter-range">
          <span class="filter-label">Rok od</span>
          <input type="number" id="f-rok-od" placeholder={yearMin === Infinity ? '' : String(yearMin)} min={yearMin} max={yearMax} />
        </label>
        <label class="filter-cell filter-range">
          <span class="filter-label">Rok do</span>
          <input type="number" id="f-rok-do" placeholder={yearMax === -Infinity ? '' : String(yearMax)} min={yearMin} max={yearMax} />
        </label>

        <label class="filter-cell filter-search">
          <span class="filter-label">Místo (obec / budova)</span>
          <input type="search" id="f-misto" placeholder="hledej obec, část, budovu, kraj…" autocomplete="off" />
        </label>

        <fieldset class="filter-cell filter-stav">
          <legend class="filter-label">Stav</legend>
          {Object.keys(stavLabel).map((k) => (
            <label class="stav-checkbox">
              <input type="checkbox" name="f-stav" value={k} checked />
              <span class={`stav-badge stav-mini-${stavTone[k]}`}>{stavLabel[k]}</span>
            </label>
          ))}
        </fieldset>

        <button type="button" id="f-reset" class="filter-reset" disabled aria-label="Smazat všechny aktivní filtry">
          <i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i>
          Smazat filtry
          <span class="filter-reset-count" data-reset-count hidden></span>
        </button>
      </div>

      <p class="filter-summary">
        <span data-filter-count>{hodiny.length}</span> z {hodiny.length} záznamů
        <span data-filter-active class="filter-active hidden">· aktivní filtry</span>
      </p>
    </section>
  )}

  {hodiny.length === 0 && (
    <p class="empty-state">
      Soupis se právě sestavuje. Zatím nejsou k dispozici žádné záznamy.
    </p>
  )}

  {hodiny.length > 0 && (
    <table class="soupis-table" id="soupis-table">
      <thead>
        <tr>
          <th class="soupis-col-thumb col-thumb" aria-label="Náhled" />
          <th class="col-rok sortable" data-sort="rok" tabindex="0" role="columnheader" aria-sort="none">Rok</th>
          <th class="col-hodinar sortable" data-sort="hodinar" tabindex="0" role="columnheader" aria-sort="none">Hodinář</th>
          <th class="col-misto sortable" data-sort="misto" tabindex="0" role="columnheader" aria-sort="none">Místo</th>
          <th class="col-budova sortable" data-sort="budova" tabindex="0" role="columnheader" aria-sort="none">Budova</th>
          <th class="col-kraj sortable" data-sort="kraj" tabindex="0" role="columnheader" aria-sort="none">Kraj / Stát</th>
          <th class="col-stav sortable" data-sort="stav" tabindex="0" role="columnheader" aria-sort="none">Stav</th>
          <th class="col-krok sortable" data-sort="krok" tabindex="0" role="columnheader" aria-sort="none">Krok</th>
        </tr>
      </thead>
      <tbody>
        {hodiny.map((h) => {
          const place = placeMeta(h.data.puvodniMisto);
          const yr = typeof h.data.rok === 'number' ? h.data.rok : parseInt(String(h.data.rok), 10);
          const yrSafe = !isNaN(yr) && yr > 1000 ? yr : '';
          const krokKw = krokKeyword(h.data.krok);
          const hodinarKey = h.data.hodinar || (h.data.hodinarText ? `__text:${h.data.hodinarText}` : '');
          // Hero photo priority: stroj > budova > cifernik > historicke > first.
          // Stejná logika jako v hodinari/[slug].astro, drží se konzistence napříč
          // tabulkami soupisu věžních hodin.
          const fotos = h.data.foto ?? [];
          const heroPriority = ['stroj', 'budova', 'cifernik', 'historicke', 'detail'];
          let hero: { src: string; alt?: string } | null = null;
          for (const p of heroPriority) {
            const found = fotos.find((f) => f.typ === p);
            if (found) { hero = { src: found.src, alt: found.alt }; break; }
          }
          if (!hero && fotos.length > 0) hero = { src: fotos[0].src, alt: fotos[0].alt };
          return (
            <tr
              data-hodinar={hodinarKey}
              data-hodinar-name={h.data.hodinar ? displayHodinar(h.data.hodinar) : (h.data.hodinarText || '')}
              data-rok={yrSafe}
              data-misto={place.filter}
              data-obec={h.data.puvodniMisto.obec}
              data-budova={h.data.puvodniMisto.budova || ''}
              data-kraj={h.data.puvodniMisto.kraj || ''}
              data-stat={h.data.puvodniMisto.zeme || ''}
              data-krok={krokKw}
              data-krok-full={h.data.krok || ''}
              data-stav={h.data.stav}
            >
              <td class="soupis-col-thumb col-thumb">
                {hero && <a href={`/soupis-veznich-hodin/${h.data.slug}/`} class="soupis-thumb-link"><img src={hero.src} alt={hero.alt ?? ''} loading="lazy" decoding="async" /></a>}
              </td>
              <td class="col-rok"><strong>{h.data.rok}</strong></td>
              <td class="col-hodinar">
                {h.data.hodinar ? (
                  <a href={`/hodinari/${h.data.hodinar}`}>{displayHodinar(h.data.hodinar)}</a>
                ) : h.data.hodinarText ? (
                  <span class="muted">{h.data.hodinarText}</span>
                ) : (
                  <span class="muted">neznámý</span>
                )}
              </td>
              <td class="col-misto">
                <a href={`/soupis-veznich-hodin/${h.data.slug}/`}>
                  {h.data.puvodniMisto.obec}
                </a>
              </td>
              <td class="col-budova">{h.data.puvodniMisto.budova || <span class="muted">—</span>}</td>
              <td class="col-kraj cell-region">
                {h.data.puvodniMisto.zeme === 'CZ' && h.data.puvodniMisto.kraj ? (
                  <span class="region-kraj">{h.data.puvodniMisto.kraj}</span>
                ) : h.data.puvodniMisto.zeme && h.data.puvodniMisto.zeme !== 'CZ' ? (
                  <span class="region-stat">{h.data.puvodniMisto.zeme}</span>
                ) : (
                  <span class="muted">—</span>
                )}
              </td>
              <td class="col-stav"><span class={`stav-badge ${stavTone[h.data.stav]}`} title={stavTooltip[h.data.stav]}>{stavLabel[h.data.stav]}</span></td>
              <td class="col-krok"><span class="muted">{h.data.krok || '—'}</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )}

  <p id="filter-empty" class="empty-state hidden" role="status" aria-live="polite">
    Žádné záznamy neodpovídají vybraným filtrům. Zkus filtry uvolnit.
  </p>

  <script is:inline>
    (function () {
      const table = document.getElementById('soupis-table');
      if (!table) return;
      const rows = Array.from(table.querySelectorAll('tbody tr'));

      const $hod = document.getElementById('f-hodinar');
      const $stat = document.getElementById('f-stat');
      const $kraj = document.getElementById('f-kraj');
      const $krok = document.getElementById('f-krok');
      const $rOd = document.getElementById('f-rok-od');
      const $rDo = document.getElementById('f-rok-do');
      const $misto = document.getElementById('f-misto');
      const $stavCBs = Array.from(document.querySelectorAll('input[name="f-stav"]'));
      const $reset = document.getElementById('f-reset');
      const $count = document.querySelector('[data-filter-count]');
      const $active = document.querySelector('[data-filter-active]');
      const $empty = document.getElementById('filter-empty');
      const $statTotal = document.querySelector('[data-stat-total]');
      const stavCountEls = {};
      document.querySelectorAll('[data-stat-count]').forEach((el) => {
        stavCountEls[el.getAttribute('data-stat-count')] = el;
      });

      function applyFilters() {
        const hod = $hod.value;
        const stat = $stat.value;
        const kraj = $kraj.value;
        const krok = $krok.value;
        const rOd = parseInt($rOd.value, 10);
        const rDo = parseInt($rDo.value, 10);
        const misto = ($misto.value || '').trim().toLowerCase();
        const stavSet = new Set($stavCBs.filter((c) => c.checked).map((c) => c.value));

        let visible = 0;
        const stavLocal = { in_situ: 0, preneseno: 0, ztracene: 0, znicene: 0, neznamy: 0 };

        for (const tr of rows) {
          let show = true;
          if (hod && tr.dataset.hodinar !== hod) show = false;
          if (show && stat && tr.dataset.stat !== stat) show = false;
          if (show && kraj && tr.dataset.kraj !== kraj) show = false;
          if (show && krok && tr.dataset.krok !== krok) show = false;
          if (show && !isNaN(rOd)) {
            const r = parseInt(tr.dataset.rok, 10);
            if (isNaN(r) || r < rOd) show = false;
          }
          if (show && !isNaN(rDo)) {
            const r = parseInt(tr.dataset.rok, 10);
            if (isNaN(r) || r > rDo) show = false;
          }
          if (show && misto && !tr.dataset.misto.includes(misto)) show = false;
          if (show && !stavSet.has(tr.dataset.stav)) show = false;

          tr.style.display = show ? '' : 'none';
          if (show) {
            visible++;
            stavLocal[tr.dataset.stav] = (stavLocal[tr.dataset.stav] || 0) + 1;
          }
        }

        if ($count) $count.textContent = String(visible);
        if ($empty) $empty.classList.toggle('hidden', visible > 0);
        if (table) table.style.display = visible > 0 ? '' : 'none';
        if ($statTotal) $statTotal.textContent = String(visible);
        for (const [k, el] of Object.entries(stavCountEls)) {
          el.textContent = String(stavLocal[k] || 0);
        }

        // Count active filters (per UI control, not per filter rule)
        let activeCount = 0;
        if (hod) activeCount++;
        if (stat) activeCount++;
        if (kraj) activeCount++;
        if (krok) activeCount++;
        if (misto) activeCount++;
        if (!isNaN(rOd) || !isNaN(rDo)) activeCount++;
        if (stavSet.size !== 5) activeCount++;
        const anyActive = activeCount > 0;
        if ($active) $active.classList.toggle('hidden', !anyActive);
        if ($reset) {
          $reset.disabled = !anyActive;
          $reset.classList.toggle('is-active', anyActive);
          const $count = $reset.querySelector('[data-reset-count]');
          if ($count) {
            $count.textContent = anyActive ? String(activeCount) : '';
            $count.hidden = !anyActive;
          }
        }
      }

      function reset() {
        $hod.value = ''; $stat.value = ''; $kraj.value = ''; $krok.value = '';
        $rOd.value = ''; $rDo.value = ''; $misto.value = '';
        $stavCBs.forEach((c) => { c.checked = true; });
        sortState = { col: null, dir: null };
        renderSortIndicators();
        // Restore original DOM order
        const tbody = table.querySelector('tbody');
        for (const r of rows) tbody.appendChild(r);
        applyFilters();
        writeUrl();
      }

      [$hod, $stat, $kraj, $krok, $rOd, $rDo].forEach((el) => el.addEventListener('change', () => { applyFilters(); writeUrl(); }));
      $misto.addEventListener('input', () => { applyFilters(); writeUrl(); });
      $stavCBs.forEach((cb) => cb.addEventListener('change', () => { applyFilters(); writeUrl(); }));
      $reset.addEventListener('click', reset);

      // === URL ↔ filter state ===
      function readUrl() {
        const params = new URLSearchParams(window.location.search);
        if (params.has('hodinar')) $hod.value = params.get('hodinar') || '';
        if (params.has('stat')) $stat.value = params.get('stat') || '';
        if (params.has('kraj')) $kraj.value = params.get('kraj') || '';
        if (params.has('krok')) $krok.value = params.get('krok') || '';
        if (params.has('rokOd')) $rOd.value = params.get('rokOd') || '';
        if (params.has('rokDo')) $rDo.value = params.get('rokDo') || '';
        if (params.has('misto')) $misto.value = params.get('misto') || '';
        if (params.has('stav')) {
          const allowed = new Set(params.get('stav').split(','));
          $stavCBs.forEach((c) => { c.checked = allowed.has(c.value); });
        }
        if (params.has('sort')) {
          const [col, dir] = params.get('sort').split(':');
          if (col && (dir === 'asc' || dir === 'desc')) {
            sortState = { col, dir };
          }
        }
        const hasAny = params.toString().length > 0;
        if (hasAny) {
          applyFilters();
          if (sortState.col) applySort();
          renderSortIndicators();
        }
      }
      function writeUrl() {
        const p = new URLSearchParams();
        if ($hod.value) p.set('hodinar', $hod.value);
        if ($stat.value) p.set('stat', $stat.value);
        if ($kraj.value) p.set('kraj', $kraj.value);
        if ($krok.value) p.set('krok', $krok.value);
        if ($rOd.value) p.set('rokOd', $rOd.value);
        if ($rDo.value) p.set('rokDo', $rDo.value);
        if ($misto.value) p.set('misto', $misto.value);
        const stavOn = $stavCBs.filter((c) => c.checked).map((c) => c.value);
        if (stavOn.length !== $stavCBs.length) p.set('stav', stavOn.join(','));
        if (sortState.col && sortState.dir) p.set('sort', `${sortState.col}:${sortState.dir}`);
        const qs = p.toString();
        const url = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
        window.history.replaceState(null, '', url);
      }

      // === Sortable columns ===
      let sortState = { col: null, dir: null };
      const sortableHeaders = Array.from(table.querySelectorAll('th.sortable'));

      function compareValue(tr, col) {
        switch (col) {
          case 'rok':     { const v = parseInt(tr.dataset.rok, 10); return isNaN(v) ? Infinity : v; }
          case 'hodinar': return (tr.dataset.hodinarName || '').toLowerCase();
          case 'misto':   return (tr.dataset.obec || '').toLowerCase();
          case 'budova':  return (tr.dataset.budova || '').toLowerCase();
          case 'kraj':    return ((tr.dataset.kraj || tr.dataset.stat) || '').toLowerCase();
          case 'stav':    return tr.dataset.stav || '';
          case 'krok':    return (tr.dataset.krokFull || '').toLowerCase();
          default: return '';
        }
      }
      function applySort() {
        if (!sortState.col || !sortState.dir) return;
        const tbody = table.querySelector('tbody');
        const visible = rows.filter((r) => r.style.display !== 'none');
        const hidden = rows.filter((r) => r.style.display === 'none');
        const sorted = [...visible].sort((a, b) => {
          const va = compareValue(a, sortState.col);
          const vb = compareValue(b, sortState.col);
          let cmp;
          if (typeof va === 'number' && typeof vb === 'number') cmp = va - vb;
          else cmp = String(va).localeCompare(String(vb), 'cs');
          return sortState.dir === 'desc' ? -cmp : cmp;
        });
        for (const r of sorted) tbody.appendChild(r);
        for (const r of hidden) tbody.appendChild(r);
      }
      function renderSortIndicators() {
        for (const th of sortableHeaders) {
          const col = th.dataset.sort;
          if (sortState.col === col) {
            th.setAttribute('aria-sort', sortState.dir === 'asc' ? 'ascending' : 'descending');
            th.dataset.sortDir = sortState.dir;
          } else {
            th.setAttribute('aria-sort', 'none');
            delete th.dataset.sortDir;
          }
        }
      }
      function toggleSort(col) {
        if (sortState.col !== col) {
          sortState = { col, dir: 'asc' };
        } else if (sortState.dir === 'asc') {
          sortState = { col, dir: 'desc' };
        } else {
          sortState = { col: null, dir: null };
        }
        applySort();
        renderSortIndicators();
        writeUrl();
      }
      sortableHeaders.forEach((th) => {
        th.addEventListener('click', () => toggleSort(th.dataset.sort));
        th.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            toggleSort(th.dataset.sort);
          }
        });
      });

      readUrl();
    })();
  </script>
</Base>

