---
import "../styles/global.css";
import SearchModal from "../components/SearchModal.astro";
import TowerClockIcon from "../components/TowerClockIcon.astro";
import ReportIssueModal from "../components/ReportIssueModal.astro";
import { SISTER_SPOLEK, SISTER_SPOLEK_LABEL } from "../data/sites";
import { cdnUrl } from "../utils/cdnImage";

/** Highwire Press citation_* metadata pro Zotero connector + Google Scholar.
 *  Per-page layouty (Article, sbirka karta, hodinari, soupis) předávají
 *  toto pole; Base.astro vyrenderuje <meta name="citation_*"> v <head>.
 *  Když není předáno, použijí se default Hodinárium / ČSH metadata
 *  (vhodné pro listingy a statické stránky bez specifické struktury). */
export interface CitationMeta {
  /** Sémantický typ stránky pro Zotero connector / Highwire detection.
   *  - 'article' (default): odešle plnou sadu Highwire meta včetně
   *    `citation_journal_title`, `citation_volume`, `citation_issue` —
   *    Zotero to detekuje jako Journal Article.
   *  - 'webpage': pro stránky bez bibliografického ekvivalentu (sbírkové
   *    karty, medailony hodinářů, soupis věží …). Nepošle journal_title /
   *    volume / issue / isbn / doi tagy (které by Zotero force-mapovaly
   *    na journalArticle), takže fallback je correctly Web Page.
   *    Inv. č. místo `citation_volume` jde do `DC.identifier`.
   *  - 'document': stránka technické dokumentace / archiválií. Mezityp,
   *    chová se jako webpage ale přidává `DC.type=Document`. */
  itemType?: 'article' | 'webpage' | 'document';
  /** Title článku/karty. Default = page title. */
  title?: string;
  /** Autor — string nebo array. Pro nezávisle psané obsahy. Default ČSH. */
  author?: string | string[];
  /** Datum publikace ISO YYYY-MM-DD nebo full ISO timestamp. */
  date?: string;
  /** Jméno publikátora. Default "Český spolek horologický". */
  publisher?: string;
  /** Jméno serveru/časopisu. Default "Hodinárium". */
  journalTitle?: string;
  /** Volitelné ISBN (pro karty s katalogem ISBN). */
  isbn?: string;
  /** Volitelné DOI. */
  doi?: string;
  /** Stránky (např. "59-80"). */
  pages?: string;
  /** Volume / číslo ročníku. */
  volume?: string;
  /** Issue / číslo časopisu. */
  issue?: string;
  /** PDF URL — pokud máme alternativu jako PDF. Většinou nemáme. */
  pdfUrl?: string;
  /** Inventární číslo (sbírka karty) — Highwire nemá přesné field, použij `volume`. */
  inventarniCislo?: string;
  /** Custom keywords (klíčová slova). */
  keywords?: string[];
  /** Alternate representations stránky (citation exports, IIIF manifest, …).
   *  Vyrenderuje se jako `<link rel="alternate" type="..." title="..." href="...">`
   *  v <head>. Klienti (Zotero translator, citation managery) je mohou
   *  číst a nabídnout uživateli download alternativního formátu. */
  alternateLinks?: Array<{
    rel?: string;       // default: 'alternate'
    href: string;
    type?: string;      // MIME type
    title?: string;     // human-readable label
  }>;
}

interface Props {
  title: string;
  description?: string;
  ogSlug?: string;
  /** Override path (e.g. /img/foo.jpg) — kdy chceš místo template-based OG použít vlastní obrázek. */
  ogImageOverride?: string;
  /** Pokud je editor přihlášen do CF Access, JS hydrace odhalí floating
   *  "Upravit v CMS" tlačítko s odkazem na tuto cestu (např.
   *  `/admin/#/collections/clanky/entries/<slug>`). Anonymous návštěvníci
   *  tlačítko nikdy neuvidí — fetch /api/cms/auth/user vrátí authenticated:false. */
  cmsEditUrl?: string;
  /** Highwire citation meta pro Zotero connector + Google Scholar. */
  citation?: CitationMeta;
  /** True = vynutit noindex meta tag (např. draft article). Po DNS switch
   *  zůstane in-place pro tento konkrétní článek, i když DEV-state noindex
   *  zmizí pro celý web. */
  noindex?: boolean;
}
const { title, description, ogSlug, ogImageOverride, cmsEditUrl, citation, noindex } = Astro.props;

// Citation defaults — pokud per-page neposlala specific data, fall back na
// universal Hodinárium / ČSH metadata. Zotero connector pak uloží stránku
// s rozumným title + author + publisher.
const itemType = citation?.itemType ?? 'article';
const isWebpage = itemType === 'webpage' || itemType === 'document';
const citationData = {
  title: citation?.title ?? title,
  author: Array.isArray(citation?.author)
    ? citation!.author
    : citation?.author
      ? [citation.author]
      : ['Český spolek horologický'],
  date: citation?.date,
  publisher: citation?.publisher ?? 'Český spolek horologický',
  // Pro itemType='webpage' nepřidáváme journal_title — Zotero by jinak force-
  // mapoval na journalArticle (klasifikace dle Highwire scrape rules).
  journalTitle: isWebpage ? undefined : (citation?.journalTitle ?? 'Hodinárium'),
  // ISBN / DOI / volume / issue — taky journal/book specific. Pro webpage
  // nepřidáváme. Inv. č. (sbírka karta) místo toho jde do DC.identifier.
  isbn: isWebpage ? undefined : citation?.isbn,
  doi: isWebpage ? undefined : citation?.doi,
  pages: isWebpage ? undefined : citation?.pages,
  volume: isWebpage ? undefined : (citation?.volume ?? citation?.inventarniCislo),
  issue: isWebpage ? undefined : citation?.issue,
  pdfUrl: citation?.pdfUrl,
  keywords: citation?.keywords,
  // Webpage-specific: inv. č., archive, sub-collection.
  inventarniCislo: citation?.inventarniCislo,
};
const fullTitle = title === "Hodinárium" ? title : `${title} — Hodinárium`;
const desc = description ?? "Český spolek horologický — sbírka, expozice, projekty.";
// Cloudflare Web Analytics token — set in CF Pages env as PUBLIC_CF_ANALYTICS_TOKEN.
// Bez tokenu beacon tag se nevyrenderuje (no-op v dev/preview).
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;

// GitHub repo pro CMS commit pipeline. Override přes PUBLIC_GITHUB_REPO env
// var (např. když fork/staging používá jiný repo). Default `csh-cz/web`.
const githubRepo = (import.meta.env.PUBLIC_GITHUB_REPO as string | undefined) ?? 'csh-cz/web';
// Dočasně canonical na pages.dev — ostrá doména hodinarium.eu zatím neběží
// (po DNS switch změnit zpět na "https://hodinarium.eu" a aktualizovat astro.config).
const site = Astro.site ?? new URL("https://hodinarium-eu.pages.dev");
const canonical = new URL(Astro.url.pathname, site).toString();

// Mapa URL → OG slug. Když volající nepředá ogSlug, odvodíme z pathname.
// Pozn.: /clanky/* a legacy slugy jako /atlas, /decin jsou redirected
// v public/_redirects, sem se nedostanou — tahle větev je jen pro
// case kdy SSR projde na neznámou cestu.
//
// Pro kontent collections (sbirka/karta, hodinari, slovnik, kroky,
// kronika, soupis-veznich-hodin, projekty, sbirka, virtualni-muzeum,
// muzea, zajimavosti, konstrukce) detail page používá per-stránka OG
// pokud existuje (build-og-images.ts generuje per-collection od commitu
// cfe898f). Index page (např. /hodinari) používá kolekci-default.
const COLLECTIONS_WITH_PER_PAGE_OG = new Set([
  'sbirka', 'projekty', 'konstrukce', 'virtualni-muzeum', 'muzea', 'zajimavosti',
  'hodinari', 'soupis-veznich-hodin', 'slovnik', 'kroky', 'kronika',
]);

function ogSlugFromPath(path: string): string {
  const p = path.replace(/\/$/, '').replace(/^\//, '');
  if (p === '' || p === 'index') return 'home';
  if (p.startsWith('clanky/')) return p.slice('clanky/'.length);
  if (p === 'clanky') return 'clanky';
  // /sbirka/karta/<slug> — karta detail (per-karta OG)
  if (p.startsWith('sbirka/karta/')) return p.slice('sbirka/karta/'.length);
  const segments = p.split('/');
  // /<collection>/<slug> — detail page má per-page OG
  if (segments.length >= 2 && COLLECTIONS_WITH_PER_PAGE_OG.has(segments[0])) {
    return segments[segments.length - 1];
  }
  // Singleton routes (mapa, mapa-horologie, casova-osa, expozice, tagy,
  // pro-navstevniky, vice, podpora, licence, en) → první segment.
  return segments[0];
}
const slug = ogSlug ?? ogSlugFromPath(Astro.url.pathname);
const ogImage = ogImageOverride
  ? new URL(ogImageOverride, site).toString()
  : new URL(`/og/${slug}.png`, site).toString();

// hreflang alternate — /en je samostatná anglická stránka
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index';
const isEn = Astro.url.pathname === '/en' || Astro.url.pathname === '/en/';
const csUrl = new URL('/', site).toString();
const enUrl = new URL('/en', site).toString();

// Organization JSON-LD jen na home — odkazuje na spolek jako provozovatele
const orgJsonLd = isHome ? {
  '@context': 'https://schema.org',
  '@type': 'Museum',
  '@id': csUrl,
  name: 'Hodinárium',
  alternateName: 'Český spolek horologický — webová expozice',
  url: csUrl,
  logo: cdnUrl('/img/logo-csh.png'),
  description: 'Webová a fyzická expozice o hodinách Českého spolku horologického. ~218 článků, sbírka, atlas, mapa expozic.',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Český spolek horologický',
    url: 'https://horologie-cz.pages.dev/',
  },
  sameAs: [
    'https://horologie-cz.pages.dev/',
    'https://orloj.eu/',
  ],
  location: {
    '@type': 'Place',
    name: 'Zámek Děčín',
    address: { '@type': 'PostalAddress', addressLocality: 'Děčín', addressCountry: 'CZ' },
  },
} : null;
---
<!DOCTYPE html>
<html lang="cs" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14100c" />
    <meta name="description" content={desc} />
    {/* DEV STATE: dokud běžíme na pages.dev, blokujeme indexaci.
        Po DNS switch na hodinarium.eu odstranit oba následující meta tagy.
        Pro `noindex` prop (např. draft articles) emit noindex i po DNS switch — řádek níž. */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    {noindex && (
      <>
        {/* Per-page noindex (draft, gated content) — zůstává po DNS switch. */}
        <meta name="robots" content="noindex, nofollow" data-draft-noindex />
      </>
    )}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Hodinárium — Kronika" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Hodinárium — Články" href="/clanky/rss.xml" />
    {(isHome || isEn) && (
      <>
        <link rel="alternate" hreflang="cs" href={csUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={csUrl} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Hodinárium" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />

    <!-- Licence: Creative Commons Attribution 4.0 International -->
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
    <meta name="dcterms.rights" content="© Český spolek horologický z. s. — CC BY 4.0" />

    {/* Highwire Press citation_* meta — Zotero connector + Google Scholar.
        Pro itemType='article' (default) — pošleme citation_journal_title,
        citation_volume atd. → Zotero detekuje journalArticle.
        Pro itemType='webpage' / 'document' — vynecháme journal-specific
        tagy a místo toho použijeme Dublin Core (DC.*) → Zotero spadne
        do Web Page detekce, což je správně pro sbírkové karty a profily. */}
    <meta name="citation_title" content={citationData.title} />
    {citationData.author.map((a: string) => (
      <meta name="citation_author" content={a} />
    ))}
    {citationData.date && <meta name="citation_publication_date" content={citationData.date} />}
    {citationData.date && <meta name="citation_online_date" content={citationData.date} />}
    <meta name="citation_publisher" content={citationData.publisher} />
    {citationData.journalTitle && (
      <meta name="citation_journal_title" content={citationData.journalTitle} />
    )}
    <meta name="citation_language" content="cs" />
    <meta name="citation_public_url" content={canonical} />
    {citationData.isbn && <meta name="citation_isbn" content={citationData.isbn} />}
    {citationData.doi && <meta name="citation_doi" content={citationData.doi} />}
    {citationData.pages && <meta name="citation_firstpage" content={citationData.pages.split(/[-–—]/)[0].trim()} />}
    {citationData.pages && citationData.pages.includes('-') && (
      <meta name="citation_lastpage" content={citationData.pages.split(/[-–—]/)[1].trim()} />
    )}
    {citationData.volume && <meta name="citation_volume" content={citationData.volume} />}
    {citationData.issue && <meta name="citation_issue" content={citationData.issue} />}
    {citationData.pdfUrl && <meta name="citation_pdf_url" content={citationData.pdfUrl} />}
    {citationData.keywords && citationData.keywords.length > 0 && (
      <meta name="citation_keywords" content={citationData.keywords.join('; ')} />
    )}

    {/* Dublin Core meta — primárně pro itemType='webpage' / 'document'.
        Zotero EM (Embedded Metadata) translator čte DC.* jako fallback
        a klasifikuje jako Web Page (případně Document). */}
    {isWebpage && (
      <>
        <meta name="DC.title" content={citationData.title} />
        {citationData.author.map((a: string) => (
          <meta name="DC.creator" content={a} />
        ))}
        <meta name="DC.publisher" content={citationData.publisher} />
        <meta name="DC.language" content="cs" />
        {citationData.date && <meta name="DC.date" content={citationData.date} />}
        {citationData.inventarniCislo && (
          <meta name="DC.identifier" content={`inv. č. ${citationData.inventarniCislo}`} />
        )}
        <meta name="DC.identifier" content={canonical} />
        <meta name="DC.type" content={itemType === 'document' ? 'Document' : 'InteractiveResource'} />
        {citationData.keywords && citationData.keywords.length > 0 && citationData.keywords.map((kw: string) => (
          <meta name="DC.subject" content={kw} />
        ))}
      </>
    )}

    {/* Alternate representations — Zotero translator a custom skripty
        mohou nabídnout download RIS/BibTeX/CSL JSON přímo z <head>. */}
    {citation?.alternateLinks?.map((l) => (
      <link
        rel={l.rel ?? 'alternate'}
        href={l.href}
        type={l.type}
        title={l.title}
      />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" />
    {/* Font Awesome 6 Free — sjednocený icon set napříč celou aplikací.
        Cachovaný cdnjs (Cloudflare), takže preconnect + integrity check.
        Použití: <i class="fa-solid fa-bug" aria-hidden="true"></i>
        Ikon set: solid (free) + brands. Regular vyžaduje Pro license. */}
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    {/* KaTeX — matematické výrazy z `$inline$` / `$$display$$` markdownu
        (remark-math + rehype-katex). CSS musí být loaded aby fonty
        a layout fungovaly. Verze fixed na cdnjs build odpovídající
        katex v package.json. */}
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/KaTeX/0.16.9/katex.min.css"
      integrity="sha512-fHwaWebuwA7NSF5Qg/af4UeDx9XqUpYpOGgubo3yWu+b2IQR4UeQwbb42Ti7gVAjNtVoI/I9TEoYeu9omwcC6g=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <title>{fullTitle}</title>
    {orgJsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    )}
    {cfAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col antialiased" data-cms-edit-url={cmsEditUrl ?? null}>
    <a href="#hlavni-obsah" class="skip-link">Přeskočit na obsah</a>

    <header class="site-header sticky top-0 z-20" role="banner">
      <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-4" aria-label="Hlavní navigace">
        <a href="/" class="text-xl text-[var(--color-brass-bright)] flex-shrink-0 italic nav-link" aria-label="Hodinárium — domů">
          <TowerClockIcon class="brand-mark" />Hodinárium
        </a>

        <ul class="hidden md:flex gap-5 text-sm items-center" style="letter-spacing: 0.05em;">
          <li><a href="/pro-navstevniky" class="nav-link">Návštěva</a></li>
          <li><a href="/o-hodinariu" class="nav-link">O Hodináriu</a></li>
          <li><a href="/sbirka" class="nav-link">Sbírka</a></li>
          <li><a href="/projekty" class="nav-link">Projekty</a></li>
          <li><a href="/konstrukce" class="nav-link">Konstrukce</a></li>
          <li><a href="/hodinari" class="nav-link">Hodináři</a></li>
          <li><a href="/soupis-veznich-hodin" class="nav-link">Soupis věžních hodin</a></li>
          <li><a href="/slovnik" class="nav-link">Slovník</a></li>
          <li><a href="/mapa-horologie" class="nav-link">Mapa horologie</a></li>
          <li><a href="/vice" class="nav-link">Více</a></li>
          <li><a href={SISTER_SPOLEK} target="_blank" rel="noopener" class="nav-sister nav-link" aria-label={`Spolek na ${SISTER_SPOLEK_LABEL} (otevře se v novém okně)`}>Spolek</a></li>
          <li><a href="https://orloj.eu" target="_blank" rel="noopener" class="nav-sister nav-link" aria-label="Orloj.eu — encyklopedie Pražského orloje (otevře se v novém okně)">Orloj.eu</a></li>
          <li><a href="/en" class="nav-en nav-link" aria-label="English summary" hreflang="en" lang="en">EN</a></li>
          <li>
            <button data-search-trigger class="nav-search-btn" aria-label="Vyhledávat (Cmd+K)" title="Vyhledávat (⌘K)">
              <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            </button>
          </li>
          <li id="admin-redakce-slot" class="hidden">
            <!-- Admin: rychlý odkaz na redakční přehled (jen pro přihlášené editory) -->
            <a href="/redakce/" class="admin-mini-link"
               aria-label="Redakční přehled — co potřebuje review"
               title="Redakční přehled — co potřebuje review">
              <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
            </a>
          </li>
          <li id="admin-logout-slot" class="hidden">
            <!-- Odhlášení z CF Access. Endpoint /cdn-cgi/access/logout je
                 univerzální pro celou Cloudflare Access apps Team — po kliku
                 se zahodí session cookie a uživatel se vrátí jako anonymní.
                 Sveltia si pak při dalším pokusu o save uvědomí 401 a zobrazí
                 login screen znovu. -->
            <a href="/cdn-cgi/access/logout" class="admin-mini-link admin-logout-link"
               aria-label="Odhlásit z editor režimu (Cloudflare Access)"
               title="Odhlásit z editor režimu — zahodí Cloudflare Access session">
              <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
            </a>
          </li>
          <li id="admin-badge-slot">
            <!-- Admin badge — vždy viditelný.
                 Anon stav (data-state="anon"):
                   href směřuje na /api/cms/login (CF-Access protected) s query
                   parametrem `return_to` = aktuální URL, který JS doplní per-page.
                   Po úspěšném loginu Pages Function 302 zpět na původní stránku,
                   nikoli do /admin/ — editor zůstane na obsahové stránce a uvidí
                   "Upravit" FAB (pokud je page editovatelná).
                 Authed stav (data-state="authed"):
                   JS přepíná href na /admin/ (CMS dashboard) — explicitní open-CMS
                   akce pro správu kolekcí. -->
            <a href="/api/cms/login" id="admin-badge-link"
               class="admin-avatar"
               data-state="anon"
               aria-label="Přihlášení editora — vyžaduje oprávnění redaktora ČSH"
               title="Přihlášení editora obsahu — vyžaduje oprávnění redaktora ČSH (Cloudflare Access)">
              <span id="admin-badge-initial" aria-hidden="true">
                <!-- Anon stav: tužka (stejná jako na "Upravit" FAB).
                     Authed stav: JS přepíše obsah na první písmeno emailu. -->
                <i class="fa-solid fa-pen" aria-hidden="true"></i>
              </span>
            </a>
          </li>
        </ul>

        <details class="md:hidden relative" id="mobile-menu-details">
          <summary class="list-none cursor-pointer p-2 -m-2 select-none" aria-label="Otevřít menu">
            <i class="fa-solid fa-bars" style="font-size: 1.25rem; color: var(--color-brass-bright);" aria-hidden="true"></i>
          </summary>
          <ul class="mobile-menu absolute right-0 top-full mt-2 w-72 py-1">
            <!-- Hlavní (drží se synchronizované s desktop top nav) -->
            <li class="mobile-section-label">Hodinárium</li>
            <li><a href="/pro-navstevniky" class="nav-link">Návštěva</a></li>
