    <!--
      CMS admin hydration — fetch /api/cms/auth/user (= Pages Function endpoint).
      Pokud projde se 200 + authenticated:true, editor má platnou CF Access
      session → odhalíme avatar v navu + případně floating "Editovat" tlačítko
      pokud stránka má `data-cms-edit-url` atribut na <body>.

      Pages Function vrací 200 i pro neautentikované (s authenticated:false),
      ale fetch ze same-origin posílá CF Access cookie → pro editora vrátí
      authenticated:true s emailem.
    -->
    <script is:inline define:vars={{ githubRepo }}>
      // Namespace pro CMS-related JS helpery v Base.astro inline scriptu.
      // Scope: window.__csh — vyhneme se kolizím s globálními symboly
      // (resolveEditorNote, inferSourceFileFromUrl byly předtím v global scope).
      window.__csh = window.__csh || {};

      // ---- A11y M8: mobile hamburger aria-label toggle ----
      // <details> má implicitní aria-expanded, ale label `aria-label="Otevřít
      // menu"` zůstává statický. SR uživatel slyší state přes aria-expanded,
      // ale label je matoucí. Audit: docs/a11y-audit-hodinarium-2026-05-08.md M8.
      (function () {
        const details = document.getElementById('mobile-menu-details');
        if (!details) return;
        const summary = details.querySelector('summary');
        if (!summary) return;
        details.addEventListener('toggle', function () {
          summary.setAttribute('aria-label', details.open ? 'Zavřít menu' : 'Otevřít menu');
        });
      })();

      // ---- Helper: odvodit zdrojový MDX soubor z URL routy ----
      window.__csh.inferSourceFileFromUrl = function () {
        const path = window.location.pathname.replace(/\/$/, '');
        const slug = path.split('/').pop();
        if (!slug) return null;
        if (path.startsWith('/hodinari/')) return 'content/hodinari/' + slug + '.mdx';
        if (path.startsWith('/soupis-veznich-hodin/')) return 'content/soupis-veznich-hodin/' + slug + '.mdx';
        if (path.startsWith('/sbirka/karta/')) return 'content/hodinarium-eu/' + slug + '.md';
        if (path.startsWith('/kronika/')) return 'content/kronika/' + slug + '.mdx';
        return null;
      };

      // ---- Resolve editor-note: smaže aside blok ze zdroje přes /api/cms ----
      window.__csh.resolveEditorNote = async function (ev) {
        const button = ev.currentTarget;
        const aside = button.closest('aside.editor-note');
        if (!aside) return;
        let file = aside.dataset.sourceFile || window.__csh.inferSourceFileFromUrl();
        const noteKey = aside.dataset.noteKey;
        if (!file || !noteKey) { alert('Nelze určit zdrojový soubor pro tuto poznámku.'); return; }
        // Path allowlist — útočník s commit přístupem by jinak mohl přes
        // <aside data-source-file="../../.github/workflows/x.yml"> přimět
        // editora k smazání workflow. Povolíme jen content/<col>/<slug>.md(x).
        if (!/^content\/[a-zA-Z0-9_\-]+\/[a-zA-Z0-9_\-]+\.mdx?$/.test(file)) {
          alert('Source file mimo content/ allowlist: ' + file + ' — odmítnuto.');
          return;
        }
        // noteKey allowlist — jen tam, kam by hostile MDX autor potřeboval
        // dostat regex special chars k lookbehinds atd. Striktní whitelist.
        if (!/^[a-zA-Z0-9_-]+$/.test(noteKey)) {
          alert('noteKey nevalidní: ' + noteKey + ' — odmítnuto.');
          return;
        }
        if (!confirm('Smazat tuto editorskou poznámku ze souboru ' + file + '?\n\nBude commitnuto okamžitě, deploy ~1–2 min.')) return;

        button.disabled = true;
        const origText = button.textContent;
        button.innerHTML = '<i class="fa-solid fa-hourglass-half" aria-hidden="true"></i> Odesílám commit…';
        try {
          const repoApi = '/api/cms/api/v3/repos/' + githubRepo + '/contents/' + file;
          const r = await fetch(repoApi, { credentials: 'include' });
          if (!r.ok) throw new Error('Fetch ' + r.status);
          const data = await r.json();
          const bytes = Uint8Array.from(atob(data.content.replace(/\n/g, '')), (c) => c.charCodeAt(0));
          const text = new TextDecoder('utf-8').decode(bytes);

          // editorNotes žijí v YAML frontmatter (---...---). Line-based parser:
          //   1) Split na řádky
          //   2) Najdi "editorNotes:" header
          //   3) Sekce = lines až do prvního non-indented (jiný top-level klíč)
          //   4) Položky = řádky začínající "  - " + jejich indentované continuation
          //   5) Filtruj položku s daným noteKey, rebuild
          const fmMatch = text.match(/^---\n([\s\S]*?)\n---\n([\s\S]*)$/);
          if (!fmMatch) throw new Error('Žádný YAML frontmatter v souboru.');
          const lines = fmMatch[1].split('\n');
          const body = fmMatch[2];

          const enStart = lines.findIndex((l) => /^editorNotes:\s*$/.test(l));
          if (enStart < 0) throw new Error('Žádné editorNotes v frontmatter.');
          let enEnd = lines.length;
          for (let i = enStart + 1; i < lines.length; i++) {
            if (/^\S/.test(lines[i])) { enEnd = i; break; }
          }
          const section = lines.slice(enStart + 1, enEnd);
          const itemsArr = [];
          for (const ln of section) {
            if (/^  - /.test(ln)) itemsArr.push([ln]);
            else if (itemsArr.length > 0) itemsArr[itemsArr.length - 1].push(ln);
          }
          const escapedKey = noteKey.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&');
          const noteKeyRe = new RegExp("noteKey:\\s*['\"]?" + escapedKey + "['\"]?\\s*$");
          const kept = itemsArr.filter((it) => !it.some((ln) => noteKeyRe.test(ln)));
          if (kept.length === itemsArr.length) {
            throw new Error('noteKey "' + noteKey + '" nenalezen v editorNotes.');
          }
          let newLines;
          if (kept.length === 0) {
            newLines = [...lines.slice(0, enStart), ...lines.slice(enEnd)];
          } else {
            const newSection = kept.flat();
            newLines = [...lines.slice(0, enStart + 1), ...newSection, ...lines.slice(enEnd)];
          }
          const updated = '---\n' + newLines.join('\n') + '\n---\n' + body;
          if (updated === text) throw new Error('Frontmatter rebuild selhal — žádná změna.');
          const encBytes = new TextEncoder().encode(updated);
          let bin = ''; for (const b of encBytes) bin += String.fromCharCode(b);
          const put = await fetch(repoApi, {
            method: 'PUT', credentials: 'include',
            headers: {
              'Content-Type': 'application/json',
              // Defense in depth — Pages Function má Origin/Referer guard,
              // tenhle header je redundantní marker v telemetry.
              'X-CSH-Editor-Action': 'resolve-editor-note',
            },
            body: JSON.stringify({
              message: 'Resolve editor note (' + noteKey + ') in ' + file,
              content: btoa(bin), sha: data.sha,
            }),
          });
          if (!put.ok) throw new Error('Commit ' + put.status);
          aside.style.transition = 'opacity 250ms';
          aside.style.opacity = '0';
          setTimeout(() => aside.remove(), 280);
        } catch (err) {
          button.disabled = false;
          button.textContent = origText;
          alert('Resolve selhalo: ' + (err.message || err));
        }
      };

      // ---- Hlavní hydrace: anon avatar return_to + auth check + odhalení editor UI ----
      (async function () {
        // Anon avatar return_to (před případným klikem)
        try {
          const anonLink = document.getElementById('admin-badge-link');
          if (anonLink && anonLink.getAttribute('data-state') === 'anon') {
            const here = window.location.pathname + window.location.search + window.location.hash;
            anonLink.href = '/api/cms/login?return_to=' + encodeURIComponent(here);
          }
        } catch (e) { /* ignore */ }

        try {
          // redirect:'manual' — anonymně je endpoint za Cloudflare Access a
          // vrací 302 na cloudflareaccess.com; bez 'manual' by fetch ten
          // cross-origin redirect následoval a spadl na CORS (net::ERR_FAILED
          // v konzoli na KAŽDÉ stránce). S 'manual' se 302 vrátí jako
          // opaqueredirect (r.ok=false) → tiše skončíme, žádný console error.
          // Přihlášený editor dostane 200 JSON přímo (bez redirectu).
          const r = await fetch('/api/cms/auth/user', { credentials: 'include', redirect: 'manual' });
          if (!r.ok) return;
          const ct = r.headers.get('content-type') || '';
          if (!ct.includes('json')) return;
          const u = await r.json();
          if (!u.authenticated || !u.email) return;

          // Avatar — anon → authed
          const link = document.getElementById('admin-badge-link');
          const initial = document.getElementById('admin-badge-initial');
          if (link && initial) {
            const ch = (u.email[0] || '·').toUpperCase();
            initial.textContent = ch;
            link.setAttribute('data-state', 'authed');
            link.href = '/admin/';
            link.title = 'Přihlášen jako ' + u.email + ' — klikni pro otevření CMS administrace';
            link.setAttribute('aria-label', 'Otevřít CMS administraci (přihlášen jako ' + u.email + ')');
          }

          // Editor-mode flag — CSS odhalí .editor-note a [data-editor-only]
          document.body.setAttribute('data-editor-mode', 'true');

          // Připoj resolve handler na "✓ Vyřízeno" buttony
          document.querySelectorAll('[data-action="resolve-editor-note"]').forEach((btn) => {
            btn.addEventListener('click', window.__csh.resolveEditorNote);
          });

          // Redakční přehled link — vedle avataru, šipka ↻
          const redakceSlot = document.getElementById('admin-redakce-slot');
          if (redakceSlot) redakceSlot.classList.remove('hidden');

          // Odhlásit link
          const logoutSlot = document.getElementById('admin-logout-slot');
          if (logoutSlot) logoutSlot.classList.remove('hidden');

          // Floating edit button už je renderovaný server-side z ReportIssueModal
          // (předtím JS-injected — issue #36 fix). Tady jen `cms-return-url`
          // handler aby po editu v Sveltia editor mohl navigovat zpět.
          const editFab = document.getElementById('cms-edit-fab');
          if (editFab) {
            editFab.addEventListener('click', () => {
              try { sessionStorage.setItem('cms-return-url', window.location.href); } catch {}
            });
          }
        } catch (e) {
          // Tichá chyba — anonymous návštěvníci nemají session, je to OK.
        }
      })();
    </script>
  </body>
