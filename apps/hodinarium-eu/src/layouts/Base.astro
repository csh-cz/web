---
import "../styles/global.css";
import SearchModal from "../components/SearchModal.astro";
import { SISTER_SPOLEK, SISTER_SPOLEK_LABEL } from "../data/sites";

interface Props {
  title: string;
  description?: string;
  ogSlug?: string;
  /** Override path (e.g. /img/foo.jpg) — kdy chceš místo template-based OG použít vlastní obrázek. */
  ogImageOverride?: string;
  /** Pokud je editor přihlášen do CF Access, JS hydrace odhalí floating
   *  "Upravit v CMS" tlačítko s odkazem na tuto cestu (např.
   *  `/admin/#/collections/clanky/entries/<slug>`). Anonymous návštěvníci
   *  tlačítko nikdy neuvidí — fetch /api/cms/auth/user vrátí authenticated:false. */
  cmsEditUrl?: string;
}
const { title, description, ogSlug, ogImageOverride, cmsEditUrl } = Astro.props;
const fullTitle = title === "Hodinárium" ? title : `${title} — Hodinárium`;
const desc = description ?? "Český spolek horologický — sbírka, expozice, projekty.";
// Cloudflare Web Analytics token — set in CF Pages env as PUBLIC_CF_ANALYTICS_TOKEN.
// Bez tokenu beacon tag se nevyrenderuje (no-op v dev/preview).
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined;
// Dočasně canonical na pages.dev — ostrá doména hodinarium.eu zatím neběží
// (po DNS switch změnit zpět na "https://hodinarium.eu" a aktualizovat astro.config).
const site = Astro.site ?? new URL("https://hodinarium-eu.pages.dev");
const canonical = new URL(Astro.url.pathname, site).toString();

// Mapa URL → OG slug. Když volající nepředá ogSlug, odvodíme z pathname.
// Pozn.: /clanky/* a legacy slugy jako /atlas, /decin jsou redirected
// v public/_redirects, sem se nedostanou — tahle větev je jen pro
// case kdy SSR projde na neznámou cestu.
function ogSlugFromPath(path: string): string {
  const p = path.replace(/\/$/, '').replace(/^\//, '');
  if (p === '' || p === 'index') return 'home';
  if (p.startsWith('clanky/')) return p.slice('clanky/'.length);
  if (p === 'clanky') return 'clanky';
  // /sbirka, /projekty, /konstrukce, /muzea, /zajimavosti, /virtualni-muzeum,
  // /hodinari, /kronika, /tagy, /mapa, /mapa-horologie, /expozice, /kroky,
  // /casova-osa, /pro-navstevniky, /vice, /podpora, /licence, /en
  return p.split('/')[0];
}
const slug = ogSlug ?? ogSlugFromPath(Astro.url.pathname);
const ogImage = ogImageOverride
  ? new URL(ogImageOverride, site).toString()
  : new URL(`/og/${slug}.png`, site).toString();

// hreflang alternate — /en je samostatná anglická stránka
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index';
const isEn = Astro.url.pathname === '/en' || Astro.url.pathname === '/en/';
const csUrl = new URL('/', site).toString();
const enUrl = new URL('/en', site).toString();

// Organization JSON-LD jen na home — odkazuje na spolek jako provozovatele
const orgJsonLd = isHome ? {
  '@context': 'https://schema.org',
  '@type': 'Museum',
  '@id': csUrl,
  name: 'Hodinárium',
  alternateName: 'Český spolek horologický — webová expozice',
  url: csUrl,
  logo: new URL('/img/logo-csh.png', site).toString(),
  description: 'Webová a fyzická expozice o hodinách Českého spolku horologického. ~218 článků, sbírka, atlas, mapa expozic.',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Český spolek horologický',
    url: 'https://horologie-cz.pages.dev/',
  },
  sameAs: [
    'https://horologie-cz.pages.dev/',
    'https://orloj.eu/',
  ],
  location: {
    '@type': 'Place',
    name: 'Zámek Děčín',
    address: { '@type': 'PostalAddress', addressLocality: 'Děčín', addressCountry: 'CZ' },
  },
} : null;
---
<!DOCTYPE html>
<html lang="cs" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#14100c" />
    <meta name="description" content={desc} />
    <!-- DEV STATE: dokud běžíme na pages.dev, blokujeme indexaci. -->
    <!-- Po DNS switch na hodinarium.eu odstranit oba následující meta tagy. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="googlebot" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Hodinárium — Kronika" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Hodinárium — Články" href="/clanky/rss.xml" />
    {(isHome || isEn) && (
      <>
        <link rel="alternate" hreflang="cs" href={csUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={csUrl} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Hodinárium" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />

    <!-- Licence: Creative Commons Attribution 4.0 International -->
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />
    <meta name="dcterms.rights" content="© Český spolek horologický z. s. — CC BY 4.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" />
    <title>{fullTitle}</title>
    {orgJsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    )}
    {cfAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col antialiased" data-cms-edit-url={cmsEditUrl ?? null}>
    <a href="#hlavni-obsah" class="skip-link">Přeskočit na obsah</a>

    <header class="site-header sticky top-0 z-20" role="banner">
      <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-4" aria-label="Hlavní navigace">
        <a href="/" class="text-xl text-[var(--color-brass-bright)] flex-shrink-0 italic nav-link" aria-label="Hodinárium — domů">
          Hodinárium
        </a>

        <ul class="hidden md:flex gap-5 text-sm items-center" style="letter-spacing: 0.05em;">
          <li><a href="/pro-navstevniky" class="nav-link">Návštěva</a></li>
          <li><a href="/sbirka" class="nav-link">Sbírka</a></li>
          <li><a href="/projekty" class="nav-link">Projekty</a></li>
          <li><a href="/konstrukce" class="nav-link">Konstrukce</a></li>
          <li><a href="/hodinari" class="nav-link">Hodináři</a></li>
          <li><a href="/soupis-veznich-hodin" class="nav-link">Soupis věžních hodin</a></li>
          <li><a href="/mapa-horologie" class="nav-link">Mapa horologie</a></li>
          <li><a href="/vice" class="nav-link">Více</a></li>
          <li><a href={SISTER_SPOLEK} target="_blank" rel="noopener" class="nav-sister nav-link" aria-label={`Spolek na ${SISTER_SPOLEK_LABEL} (otevře se v novém okně)`}>Spolek&nbsp;↗</a></li>
          <li><a href="https://orloj.eu" target="_blank" rel="noopener" class="nav-sister nav-link" aria-label="Orloj.eu — encyklopedie Pražského orloje (otevře se v novém okně)">Orloj.eu&nbsp;↗</a></li>
          <li><a href="/en" class="nav-en nav-link" aria-label="English summary" hreflang="en" lang="en">EN</a></li>
          <li>
            <button data-search-trigger class="nav-search-btn" aria-label="Vyhledávat (Cmd+K)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" width="18" height="18">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5" stroke-linecap="round"/>
              </svg>
              <kbd class="hidden lg:inline">⌘K</kbd>
            </button>
          </li>
          <li id="admin-redakce-slot" class="hidden">
            <!-- Admin: rychlý odkaz na redakční přehled (jen pro přihlášené editory) -->
            <a href="/redakce/" class="admin-mini-link"
               aria-label="Redakční přehled — co potřebuje review"
               title="Redakční přehled — co potřebuje review">↻</a>
          </li>
          <li id="admin-badge-slot" class="hidden">
            <!-- Admin badge — JS níž ji odhalí, pokud je editor přihlášen do CF Access. -->
            <a href="/admin/" id="admin-badge-link"
               class="admin-avatar"
               aria-label="Otevřít CMS administraci"
               title="Otevřít CMS">
              <span id="admin-badge-initial" aria-hidden="true">·</span>
            </a>
          </li>
        </ul>

        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer p-2 -m-2 select-none" aria-label="Otevřít menu">
            <svg class="h-6 w-6 text-[var(--color-brass-bright)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <ul class="mobile-menu absolute right-0 top-full mt-2 w-72 py-1">
            <!-- Hlavní (drží se synchronizované s desktop top nav) -->
            <li class="mobile-section-label">Hodinárium</li>
            <li><a href="/pro-navstevniky" class="nav-link">Návštěva</a></li>
            <li><a href="/sbirka" class="nav-link">Sbírka</a></li>
            <li><a href="/projekty" class="nav-link">Projekty</a></li>
            <li><a href="/konstrukce" class="nav-link">Konstrukce</a></li>
            <li><a href="/hodinari" class="nav-link">Hodináři</a></li>
            <li><a href="/soupis-veznich-hodin" class="nav-link">Soupis věžních hodin</a></li>
            <li><a href="/mapa-horologie" class="nav-link">Mapa horologie</a></li>

            <!-- Mimo hlavní nav, ale dostupné z hamburgeru přímo (zkratky pro mobil) -->
            <li class="mobile-section-label">Více</li>
            <li><a href="/virtualni-muzeum" class="nav-link">Virtuální muzeum</a></li>
            <li><a href="/muzea" class="nav-link">Muzea</a></li>
            <li><a href="/zajimavosti" class="nav-link">Zajímavosti</a></li>
            <li><a href="/kronika" class="nav-link">Kronika</a></li>
            <li><a href="/casova-osa" class="nav-link">Časová osa</a></li>
            <li><a href="/expozice" class="nav-link">Expozice (seznam)</a></li>
            <li><a href="/kroky" class="nav-link">Hodinové kroky</a></li>
            <li><a href="/tagy" class="nav-link">Tagy</a></li>
            <li><a href="/podpora" class="nav-link">Podpora</a></li>

            <li class="mobile-section-label">Sesterské weby</li>
            <li><a href={SISTER_SPOLEK} target="_blank" rel="noopener" class="nav-link">Spolek&nbsp;↗</a></li>
            <li><a href="https://orloj.eu" target="_blank" rel="noopener" class="nav-link">Orloj.eu&nbsp;↗</a></li>
            <li><a href="/en" class="nav-link" hreflang="en" lang="en">English summary</a></li>
          </ul>
        </details>
      </nav>
    </header>

    <main id="hlavni-obsah" class="flex-1 max-w-6xl mx-auto px-6 py-10 md:py-16 w-full" role="main" tabindex="-1">
      <slot />
    </main>

    <SearchModal />

    <footer class="site-footer mt-20" role="contentinfo">
      <div class="max-w-6xl mx-auto px-6 py-10 text-sm text-[var(--color-text-muted)]">
        <div class="footer-grid">
          <div>
            <h3 class="footer-h">Muzeum</h3>
            <ul>
              <li><a href="/sbirka">Sbírka</a></li>
              <li><a href="/konstrukce">Konstrukce</a></li>
              <li><a href="/projekty">Projekty</a></li>
              <li><a href="/virtualni-muzeum">Virtuální muzeum</a></li>
              <li><a href="/muzea">Muzea</a></li>
              <li><a href="/zajimavosti">Zajímavosti</a></li>
              <li><a href="/kronika">Kronika</a></li>
              <li><a href="/hodinari">Hodináři</a></li>
              <li><a href="/tagy">Tagy</a></li>
              <li><a href="/mapa-horologie">Mapa horologie</a></li>
              <li><a href="/mapa">Mapa expozice</a></li>
              <li><a href="/expozice">Expozice (seznam)</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-h">Sesterské weby</h3>
            <ul>
              <li><a href={SISTER_SPOLEK} target="_blank" rel="noopener">Český spolek horologický ↗</a></li>
              <li><a href="https://orloj.eu" target="_blank" rel="noopener">Orloj.eu ↗</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-h">Externě</h3>
            <ul>
              <li><a href="https://www.facebook.com/Hodin%C3%A1rium-%C4%8Cesk%C3%BD-spolek-horologick%C3%BD-169939123371944" target="_blank" rel="noopener">Facebook ↗</a></li>
              <li><a href="https://www.youtube.com/@muzeum_veznich_hodin" target="_blank" rel="noopener">YouTube ↗</a></li>
              <li><a href="https://www.zamekdecin.cz/vystavy/vystava-decinske-hodinarium" target="_blank" rel="noopener">Zámek Děčín ↗</a></li>
            </ul>
          </div>
          <div>
            <h3 class="footer-h">Kontakt</h3>
            <ul class="footer-kontakt">
              <li><a href="mailto:info@orloj.eu">info@orloj.eu</a></li>
              <li><a href="tel:+420603502735">+420 603 502 735</a></li>
              <li>nábřeží Otakara Ostrčila 273/6, 392 01 Soběslav&nbsp;III</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>Český spolek horologický&nbsp;z.&nbsp;s. · IČO 26573008</span>
          <span class="footer-licence">
            Obsah pod licencí
            <a href="/licence" rel="license" class="cc-mini">
              <span class="cc-mini-icon">CC</span><span class="cc-mini-icon">BY</span>
              <span>CC&nbsp;BY&nbsp;4.0</span>
            </a>
          </span>
        </div>
      </div>
    </footer>

    <!--
      CMS admin hydration — fetch /api/cms/auth/user (= Pages Function endpoint).
      Pokud projde se 200 + authenticated:true, editor má platnou CF Access
      session → odhalíme avatar v navu + případně floating "Editovat" tlačítko
      pokud stránka má `data-cms-edit-url` atribut na <body>.

      Pages Function vrací 200 i pro neautentikované (s authenticated:false),
      ale fetch ze same-origin posílá CF Access cookie → pro editora vrátí
      authenticated:true s emailem.
    -->
    <script is:inline>
      (async function () {
        try {
          const r = await fetch('/api/cms/auth/user', { credentials: 'include' });
          if (!r.ok) return;
          const ct = r.headers.get('content-type') || '';
          if (!ct.includes('json')) return;
          const u = await r.json();
          if (!u.authenticated || !u.email) return;

          // Avatar v navu — initial z prvního písmene emailu, fallback "·".
          const slot = document.getElementById('admin-badge-slot');
          const link = document.getElementById('admin-badge-link');
          const initial = document.getElementById('admin-badge-initial');
          if (slot && link && initial) {
            const ch = (u.email[0] || '·').toUpperCase();
            initial.textContent = ch;
            link.title = 'Přihlášen jako ' + u.email + ' — kliknutím otevřeš CMS';
            link.setAttribute('aria-label', 'Otevřít CMS (přihlášen jako ' + u.email + ')');
            slot.classList.remove('hidden');
          }
          // Redakční přehled link — vedle avataru, šipka ↻ jako "co je k doplnění".
          const redakceSlot = document.getElementById('admin-redakce-slot');
          if (redakceSlot) redakceSlot.classList.remove('hidden');

          // Floating edit button — jen pokud stránka má edit URL (článek/karta/...).
          const editUrl = document.body.getAttribute('data-cms-edit-url');
          if (editUrl) {
            const btn = document.createElement('a');
            btn.href = editUrl;
            btn.className = 'cms-edit-fab';
            btn.setAttribute('aria-label', 'Upravit tuto stránku v CMS');
            btn.innerHTML =
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" width="18" height="18">' +
              '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>' +
              '</svg><span>Upravit</span>';
            // Před navigací do CMS uložíme aktuální URL, aby se editor po
            // Save (= přechod z entry na collection list) vrátil na detail.
            // /admin/ skript tu hodnotu přečte z sessionStorage.
            btn.addEventListener('click', () => {
              try { sessionStorage.setItem('cms-return-url', window.location.href); } catch {}
            });
            document.body.appendChild(btn);
          }
        } catch (e) {
          // Tichá chyba — anonymous návštěvníci nemají session, je to OK.
        }
      })();
    </script>
  </body>
</html>
