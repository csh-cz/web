---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Card from "../components/Card.astro";
import JsonLd from "../components/JsonLd.astro";
import KartaSbirky from "../components/KartaSbirky.astro";
import EditorNotesBlock from "../components/EditorNotesBlock.astro";
import { pramenTooltip, extractWikiTitle } from "../utils/referenceTypes";
import { formatCite, getRef } from "../utils/cite";
import catalog from "../data/catalog.json";
import { hodinariProClanek } from "../data/hodinari";
import { CMS_MDX_BLOCKLIST } from "../data/cms-mdx-blocklist";
import { krokyProClanek } from "../data/kroky";
import { clanekHref } from "../data/url-helpers";

import type { CatalogEntry } from '../data/catalog-types';

interface Reference {
  bibKey?: string;
  title?: string;
  url?: string;
  author?: string;
  year?: number | string;
  type?: 'kniha' | 'clanek' | 'pdf' | 'odkaz' | 'wiki' | 'mapa' | 'patent' | 'archiv' | 'zprava';
  pages?: string;
  note?: string;
}

interface KartaExtra { label: string; value: string; }
interface Karta {
  vyrobce?: string; ram?: string; krokJicihoStroje?: string;
  // biciStroje je v CMS multi-select widget → CMS vrací string[],
  // ale historické karty mají string ("čtvrťové + hodinové"). Schema toleruje obojí.
  biciStroje?: string | string[];
  rozmery?: string; kyvadlo?: string;
  ciselnik?: string; pohon?: string; pohonDetail?: string; signatura?: string;
  stav?: string;
  // pridanoDoSbirky: CMS number widget vrací int, historicky string.
  pridanoDoSbirky?: string | number;
  extra?: KartaExtra[];
}

interface Props {
  title: string;
  description?: string;
  originalUrl?: string;
  lastModified?: string;
  tldr?: string;
  category?: string;
  slug?: string;
  ogImageOverride?: string;
  author?: string;
  references?: Reference[];
  editorNotes?: Array<{ level: 'info' | 'warn' | 'todo'; title?: string; text: string; noteKey?: string }>;
  referenceStyle?: 'bullet' | 'numbered';
  karta?: Karta;
  /** Article je v draft mode — viditelný jen editorovi (CSS-gated tělem). */
  draft?: boolean;
}
const { title, description, lastModified, tldr, category, slug, ogImageOverride, author, references, referenceStyle = 'bullet', karta, editorNotes, draft } = Astro.props;

// CMS edit URL — Sveltia routy: /admin/#/collections/<col>/entries/<file_id>.
// Karty (podsekce: 'karta') jdou do collection 'karty', zbytek do 'clanky'.
// File ID = slug (bez .md extension). Pro karty je to 'inv-NNN-<slug>'.
//
// MDX články (15 souborů s `import` + JSX) Sveltia editor neumí — editor
// padá při Save. Pro ty FAB skryjeme úplně, dokud nezavedeme remark-directive
// shortcodes (viz cms-mdx-blocklist.ts).
const isMdxArticle = slug && !karta && CMS_MDX_BLOCKLIST.has(slug);
const cmsEditUrl = slug && !isMdxArticle
  ? `/admin/#/collections/${karta ? 'karty' : 'clanky'}/entries/${slug}`
  : undefined;

/**
 * Formát autora pro byline: "Petr Král" → "P. Král",
 * "Ing. Petr Král" → "P. Král" (titly se zahodí),
 * "P. Král" zůstává.
 */
function formatAuthor(name: string): string {
  const titleRe = /^(Ing\.|Dr\.|Mgr\.|MUDr\.|RNDr\.|JUDr\.|PaedDr\.|MgA\.|prof\.|doc\.|Prof\.|Doc\.)\s+/g;
  const stripped = name.replace(titleRe, '').trim();
  const parts = stripped.split(/\s+/);
  if (parts.length < 2) return stripped;
  const first = parts[0];
  const surname = parts.slice(1).join(' ');
  // Pokud je první už iniciál (jedno písmeno + tečka volitelně), normalizuj.
  if (/^[A-ZÁ-Ž]\.?$/u.test(first)) return `${first.replace(/\.$/, '')}. ${surname}`;
  return `${first.charAt(0)}. ${surname}`;
}
const authorFormatted = author ? formatAuthor(author) : null;

import { categoryLabel } from '../data/labels';

const all = catalog as CatalogEntry[];
const me = slug ? all.find((e) => e.slug === slug) : undefined;

/**
 * Perex / abstract — zobrazí se JEN pokud frontmatter explicit `tldr`.
 * Auto-extract z catalog.excerpt byl zrušen, protože duplikoval první
 * paragraf článku ("Stručně: …" v rámečku + tatáž věta pod hero).
 * Pokud autor chce perex, napíše svůj originální abstract do frontmatteru.
 */
const perexText = tldr;

// Related: 4 ze stejné kategorie, ne já, preferovat ty s thumbnailem
const related = me
  ? all
      .filter((e) => e.category === me.category && e.slug !== me.slug && e.thumbnail)
      .sort(() => Math.random() - 0.5)
      .slice(0, 4)
  : [];

const lastModifiedParsed = lastModified ? new Date(lastModified) : null;
const lastModifiedValid = lastModifiedParsed && !Number.isNaN(lastModifiedParsed.getTime());
const lastModifiedReadable = lastModifiedValid
  ? lastModifiedParsed!.toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
const lastModifiedISO = lastModifiedValid ? lastModifiedParsed!.toISOString() : null;

const hodinariZmineni = slug ? hodinariProClanek(slug) : [];
const krokyZmineni = slug ? krokyProClanek(slug) : [];

// Schema.org Article — pro [kategorie]/[slug] pages.
// Sbírkové karty (podsekce: 'karta') mají vlastní CreativeWork schema v page.
const site = Astro.site ?? new URL('https://hodinarium-eu.pages.dev');
const articleUrl = new URL(Astro.url.pathname, site).toString();
const articleImage = ogImageOverride
  ? new URL(ogImageOverride, site).toString()
  : me?.thumbnail
    ? new URL(me.thumbnail, site).toString()
    : new URL(`/og/${slug}.png`, site).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': articleUrl,
  headline: title,
  description: description ?? tldr ?? me?.excerpt?.slice(0, 200),
  url: articleUrl,
  image: articleImage,
  inLanguage: 'cs',
  ...(lastModifiedISO && { dateModified: lastModifiedISO }),
  ...(author && {
    author: { '@type': 'Person', name: author },
  }),
  publisher: {
    '@type': 'Organization',
    name: 'Český spolek horologický',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/img/logo-csh.png', site).toString(),
    },
  },
  ...(category && { articleSection: categoryLabel(category, 'long') ?? category }),
  isPartOf: {
    '@type': 'WebSite',
    name: 'Hodinárium',
    url: site.origin + '/',
  },
};
---
<Base
  title={title}
  description={description}
  ogImageOverride={ogImageOverride}
  cmsEditUrl={cmsEditUrl}
  noindex={draft}
  citation={{
    title,
    author: author || undefined,
    date: lastModifiedISO ?? undefined,
    journalTitle: category ? `Hodinárium — ${categoryLabel(category, 'long') ?? category}` : 'Hodinárium',
  }}
>
  <JsonLd data={articleJsonLd} />
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    ...(category ? [{ href: `/${category}`, label: categoryLabel(category, 'long') ?? category }] : []),
    { label: title },
  ]} />

  <article class="article-single" itemscope itemtype="https://schema.org/Article" data-draft={draft ? 'true' : undefined}>
    <meta itemprop="inLanguage" content="cs" />
    <meta itemprop="author" content="Český spolek horologický" />
    <meta itemprop="publisher" content="Český spolek horologický" />
    {lastModifiedISO && <meta itemprop="dateModified" content={lastModifiedISO} />}

    {draft && (
      <div class="draft-banner" role="status" aria-label="Rozpracovaný článek">
        <strong>📝 Rozpracovaný článek</strong>
        <span>Tento článek je viditelný jen v editor mode. Po finalizaci nastav <code>draft: false</code> ve frontmatteru.</span>
      </div>
    )}

    {draft && (
      <div class="draft-placeholder">
        <h1 class="article-title">{title}</h1>
        <p>Tento text je rozepsaný — ještě jsme ho nezveřejnili.</p>
        <p><a href="/">← Zpět na hlavní stránku</a></p>
      </div>
    )}

    <header class="article-header">
      {category && (
        <p class="eyebrow mb-3">{categoryLabel(category, 'long') ?? category}</p>
      )}
      <h1 class="article-title" itemprop="headline">{title}</h1>
      {perexText && (
        <p class="tldr" itemprop="description" aria-label="Stručné shrnutí">
          {perexText}
        </p>
      )}
    </header>

    <div class="prose-content drop-cap" itemprop="articleBody">
      {karta && <KartaSbirky karta={karta} />}
      <EditorNotesBlock notes={editorNotes} sourceFile={slug ? `content/hodinarium-eu/${slug}.md` : undefined} />
      <slot />
    </div>

    <div class="fleuron"></div>

    {hodinariZmineni.length > 0 && (
      <aside class="hodinari-box" aria-label="Hodináři zmínění v článku">
        <p class="eyebrow hodinari-box-label">Hodináři v tomto článku</p>
        <ul class="hodinari-box-list">
          {hodinariZmineni.map((h) => (
            <li>
              <a href={`/hodinari/${h.slug}`}>
                <strong>{h.jmeno}</strong>
                {h.obdobi && <span class="hodinari-box-meta">{h.obdobi}</span>}
                {h.mesto && (
                  <>
                    <span class="hodinari-box-sep" aria-hidden="true">·</span>
                    <span class="hodinari-box-meta">{h.mesto}</span>
                  </>
                )}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    {krokyZmineni.length > 0 && (
      <aside class="hodinari-box" aria-label="Hodinové kroky zmínění v článku">
        <p class="eyebrow hodinari-box-label">Hodinové kroky v tomto článku</p>
        <ul class="hodinari-box-list">
          {krokyZmineni.map((k) => (
            <li>
              <a href={`/kroky/${k.slug}`}>
                <strong>{k.jmeno}</strong>
                {k.rok && <span class="hodinari-box-meta">{k.rok}</span>}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    {references && references.length > 0 && (
      <section class="references" aria-labelledby="references-heading">
        <h2 id="references-heading" class="references-title">Literatura a odkazy</h2>
        <ul class="references-list" data-style={referenceStyle}>
          {references.map((r, i) => {
            // CSL lookup pro bibKey-driven references
            const cslItem = r.bibKey ? getRef(r.bibKey) : null;
            const cslType = (cslItem?.type as string) || '';
            const inferredType =
              cslType === 'book' || cslType === 'chapter' ? 'kniha'
              : cslType === 'article-journal' || cslType === 'paper-conference' || cslType === 'article-newspaper' || cslType === 'article-magazine' ? 'clanek'
              : cslType === 'webpage' || cslType === 'post-weblog' || cslType === 'document' ? 'odkaz'
              : cslType === 'patent' ? 'patent'
              : cslType === 'manuscript' || cslType === 'archive' ? 'archiv'
              : cslType === 'report' ? 'zprava'
              : cslType === 'thesis' ? 'kniha'
              : null;
            const refType = r.type ?? inferredType ?? 'odkaz';

            // Wiki refs render simple: jen title + URL (skryté), CSS doplní ⓦ.
            // Plný ISO 690 z citeproc by tu byl over-the-top — Wikipedia má
            // dynamický autorský model, citace nedává moc smysl.
            if (refType === 'wiki') {
              const wUrl = r.url || (cslItem?.URL as string) || (cslItem?.url as string);
              const wTitle = r.title
                || (cslItem?.title as string)
                || extractWikiTitle(wUrl)
                || r.bibKey;
              return (
                <li id={`ref-${i + 1}`} class="reference reference-wiki" title={pramenTooltip('wiki')}>
                  {wUrl ? <a href={wUrl} rel="noopener" target="_blank">{wTitle}</a> : <span class="ref-title">{wTitle}</span>}
                  {r.note && <span class="ref-note"> — {r.note}</span>}
                </li>
              );
            }

            // Ostatní typy: bibKey → citeproc, jinak legacy
            const formatted = r.bibKey ? formatCite(r.bibKey, { pages: r.pages }) : null;
            return (
              <li id={`ref-${i + 1}`} class={`reference reference-${refType}`} title={pramenTooltip(refType)}>
                {formatted ? (
                  <span class="ref-cite" set:html={formatted} />
                ) : (
                  <>
                    {r.author && <span class="ref-author">{r.author}:</span>}
                    {r.url
                      ? <a href={r.url} rel="noopener" target="_blank">{r.title}</a>
                      : <span class="ref-title">{r.title}</span>}
                    {r.year !== undefined && <span class="ref-year">({r.year})</span>}
                  </>
                )}
                {r.note && <span class="ref-note"> — {r.note}</span>}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <footer class="article-byline">
      {authorFormatted && (
        <>
          <span class="byline-author">{authorFormatted}</span>
          <span class="byline-sep" aria-hidden="true">·</span>
        </>
      )}
      <span class="byline-publisher">Český spolek horologický</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      {lastModifiedReadable
        ? <span class="byline-date">Aktualizováno <time datetime={lastModifiedISO ?? undefined}>{lastModifiedReadable}</time></span>
        : <span class="byline-date byline-date-unknown">Datum aktualizace neznámo</span>}
    </footer>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <header class="mb-6">
          <h2 id="related-heading" class="text-2xl h2-flush">Mohlo by vás zajímat</h2>
        </header>
        <div class="related-grid">
          {related.map((r) => (
            <Card
              href={clanekHref(r)}
              title={r.title}
              excerpt={r.excerpt}
              thumbnail={r.thumbnail}
              category={r.category}
              lastModified={r.lastModified}
              imageCount={r.imageCount}
            vyrobce={r.vyrobce}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  /* .breadcrumbs CSS žije v global.css — sjednoceno přes <Breadcrumbs> component */

  .article-single {
    max-width: 72ch;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }

  .article-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    color: var(--color-brass-bright);
    letter-spacing: -0.01em;
  }

  .hodinari-box {
    background: color-mix(in srgb, var(--color-bg-deep) 80%, var(--color-copper));
    border: 1px solid color-mix(in srgb, var(--color-copper) 30%, transparent);
    border-left: 3px solid var(--color-copper);
    border-radius: 2px;
    padding: 1rem 1.25rem;
    margin: 2rem 0 1rem;
  }
  .hodinari-box-label {
    margin: 0 0 0.6rem;
    /* Override .eyebrow color (--color-copper) — na hodinari-box BG mix
       (#2f1d14) měla copper kontrast 4.4:1, pod WCAG AA 4.5:1 (axe report
       2026-05-09). Brass je světlejší → ratio ~5:1, jasné. */
    color: var(--color-brass);
  }
  .hodinari-box-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .hodinari-box-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    background: var(--color-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    border-radius: 2px;
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--color-brass-bright);
    transition: border-color 150ms ease, background 150ms ease;
  }
  .hodinari-box-list a:hover {
    border-color: var(--color-brass);
    background: var(--color-bg);
  }
  .hodinari-box-list strong {
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .hodinari-box-meta {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-feature-settings: "lnum";
  }
  .hodinari-box-sep {
    color: var(--color-brass);
    opacity: 0.5;
  }

  .article-byline {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .byline-author {
    color: var(--color-brass-bright);
    font-weight: 500;
    font-feature-settings: "lnum";
  }
  .byline-publisher {
    color: var(--color-text-soft);
    font-style: italic;
  }
  .byline-sep {
    color: var(--color-brass);
    opacity: 0.5;
  }
  .byline-date time {
    font-feature-settings: "lnum";
  }

  /* Literatura a internetové odkazy pod článkem */
  .references {
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
  }
  .references-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-brass-bright);
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
    border: none;
    padding: 0;
  }
  .references-title::before { content: none; }
  .references-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .references-list li {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-soft);
    padding-left: 1.25rem;
    position: relative;
  }
  .references-list li::before {
    content: '·';
    position: absolute;
    left: 0.4rem;
    color: var(--color-copper);
    font-weight: 700;
  }
  .references-list li.reference-kniha::before { content: '📖'; left: 0; font-size: 0.85em; }
  .references-list li.reference-pdf::before { content: '⤓'; left: 0.3rem; color: var(--color-brass-bright); }
  .references-list li.reference-wiki::before { content: 'W'; left: 0.4rem; color: var(--color-copper); font-style: italic; font-family: var(--font-serif); }
  .references-list li.reference-clanek::before { content: '📰'; left: 0; font-size: 0.85em; }
  .references-list li.reference-mapa::before {
    content: '';
    left: 0.2rem;
    top: 0.25em;
    width: 0.85em;
    height: 0.85em;
    background-color: var(--color-copper);
    mask: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z'/%3E%3C/svg%3E") no-repeat center / contain;
    -webkit-mask: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z'/%3E%3C/svg%3E") no-repeat center / contain;
  }

  /* Numbered styl — [1], [2], … místo type-bullet ikonek.
     Aktivuje se přes data-style="numbered" na <ul> (vychází z frontmatter
     referenceStyle: numbered). CSS counter() inkrementuje per <li>. */
  .references-list[data-style="numbered"] {
    counter-reset: ref;
    padding-left: 2.5em;
  }
  .references-list[data-style="numbered"] li {
    padding-left: 0.4rem;
  }
  .references-list[data-style="numbered"] li::before {
    content: '[' counter(ref) ']';
    counter-increment: ref;
    width: 2.2em;
    left: -2.2em;
    top: 0;
    color: var(--color-copper);
    font-weight: 500;
    font-feature-settings: "lnum";
    text-align: right;
    padding-right: 0.4em;
    /* Reset všech mask trickách z bullet stylu */
    background: none !important;
    mask: none !important;
    -webkit-mask: none !important;
    height: auto;
    font-style: normal;
    font-family: inherit;
  }
  /* Při :target (kliknutí na ref-N) zvýraznit položku */
  .references-list li:target {
    background: color-mix(in srgb, var(--color-brass) 12%, transparent);
    border-radius: 2px;
    padding-top: 0.2rem;
    padding-bottom: 0.2rem;
    padding-right: 0.4rem;
    transition: background 200ms ease;
  }
  .references-list a {
    color: var(--color-brass-bright);
  }
  .ref-author {
    font-style: italic;
    color: var(--color-text);
    margin-right: 0.4em;
  }
  .ref-year {
    color: var(--color-text-muted);
    margin-left: 0.3em;
    font-feature-settings: "lnum";
  }
  .ref-note {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .related {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 20%, transparent);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }
</style>
