---
import Base from "./Base.astro";
import Card from "../components/Card.astro";
import catalog from "../data/catalog.json";

interface CatalogEntry {
  slug: string;
  title: string;
  category: string;
  thumbnail: string | null;
  excerpt: string;
  year: number | null;
  lastModified: string | null;
  imageCount: number;
  wordCount: number;
}

interface Props {
  title: string;
  description?: string;
  originalUrl?: string;
  lastModified?: string;
  tldr?: string;
  category?: string;
  slug?: string;
}
const { title, description, lastModified, tldr, category, slug } = Astro.props;

const categoryLabels: Record<string, string> = {
  decin: 'Hodinárium Děčín',
  'vezni-hodiny': 'Věžní hodiny',
  sbirka: 'Sbírka',
  projekty: 'Projekty',
  ostatni: 'Hodinárium',
};

const all = catalog as CatalogEntry[];
const me = slug ? all.find((e) => e.slug === slug) : undefined;

// Related: 4 ze stejné kategorie, ne já, preferovat ty s thumbnailem
const related = me
  ? all
      .filter((e) => e.category === me.category && e.slug !== me.slug && e.thumbnail)
      .sort(() => Math.random() - 0.5)
      .slice(0, 4)
  : [];

const lastModifiedReadable = lastModified
  ? new Date(lastModified).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---
<Base title={title} description={description}>
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Drobečková navigace">
    <a href="/">Hodinárium</a>
    <span aria-hidden="true">›</span>
    {category && (
      <>
        <a href={`/atlas#${category}`}>{categoryLabels[category]}</a>
        <span aria-hidden="true">›</span>
      </>
    )}
    <span class="current" aria-current="page">{title}</span>
  </nav>

  <article class="article-single">
    <header class="article-header">
      {category && (
        <p class="eyebrow mb-3">{categoryLabels[category] ?? category}</p>
      )}
      <h1 class="article-title">{title}</h1>
      {tldr && (
        <aside class="tldr" aria-label="Stručné shrnutí">
          <span class="tldr-label">Stručně:</span>{tldr}
        </aside>
      )}
    </header>

    <div class="prose-content drop-cap">
      <slot />
    </div>

    <div class="fleuron"></div>

    <footer class="article-byline">
      <span class="byline-author">Český spolek horologický</span>
      {lastModifiedReadable && (
        <>
          <span class="byline-sep" aria-hidden="true">·</span>
          <span class="byline-date">Aktualizováno <time datetime={lastModified}>{lastModifiedReadable}</time></span>
        </>
      )}
    </footer>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <header class="mb-6">
          <p class="eyebrow mb-2">Mohlo by vás zajímat</p>
          <h2 id="related-heading" class="text-2xl" style="margin-top: 0;">Související exponáty</h2>
        </header>
        <div class="related-grid">
          {related.map((r) => (
            <Card
              href={`/clanky/${r.slug}`}
              title={r.title}
              excerpt={r.excerpt}
              thumbnail={r.thumbnail}
              category={r.category}
              lastModified={r.lastModified}
              imageCount={r.imageCount}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .breadcrumbs {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .breadcrumbs a {
    color: var(--color-text-soft);
    border-bottom: none;
  }
  .breadcrumbs a:hover {
    color: var(--color-brass-bright);
  }
  .breadcrumbs .current {
    color: var(--color-text-soft);
    font-style: italic;
  }
  .breadcrumbs span[aria-hidden] {
    color: var(--color-brass);
    opacity: 0.5;
  }

  .article-single {
    max-width: 72ch;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }

  .article-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.1;
    margin: 0 0 1rem;
    color: var(--color-brass-bright);
    letter-spacing: -0.01em;
  }

  .article-byline {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .byline-author {
    color: var(--color-text-soft);
    font-style: italic;
  }
  .byline-sep {
    color: var(--color-brass);
    opacity: 0.5;
  }
  .byline-date time {
    font-feature-settings: "lnum";
  }

  .related {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 20%, transparent);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }
</style>
