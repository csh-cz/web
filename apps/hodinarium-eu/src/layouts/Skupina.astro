---
// Souhrnná stránka skupiny (vitrína) — generovaná data-driven ze soupisu.
// Panely mají vlastní kurátorské články; tato šablona slouží vitrínám.
import Base from './Base.astro';
import Breadcrumbs from '@csh/ui/components/Breadcrumbs.astro';
import SkupinaClenove from '../components/SkupinaClenove.astro';
import { skupinaTypLabel, mistnostLabel, type Skupina } from '../data/skupiny';

interface Props { skupina: Skupina; }
const { skupina } = Astro.props;

const typLabel = skupinaTypLabel(skupina.typ);
const mistLabel = mistnostLabel(skupina.mistnost);
const pocet = skupina.clenove.length;
---
<Base
  title={skupina.nazev}
  description={`${typLabel} v expozici Hodinária (${mistLabel}) — ${pocet} ${pocet === 1 ? 'exponát' : pocet < 5 ? 'exponáty' : 'exponátů'}.`}
>
  <Breadcrumbs trail={[
    { href: '/', label: 'Hodinárium' },
    { href: '/sbirka', label: 'Sbírka' },
    { href: '/sbirka/katalog', label: 'Katalog', soft: true },
    { label: skupina.nazev },
  ]} />

  <article class="skupina-detail">
    <header class="skupina-detail-header">
      <p class="eyebrow mb-3">{typLabel} · {mistLabel}</p>
      <h1 class="skupina-detail-title">{skupina.nazev}</h1>
      <p class="skupina-detail-lede">
        Organizační jednotka expozice — {pocet} {pocet === 1 ? 'exponát' : pocet < 5 ? 'exponáty' : 'exponátů'}.
        Každý má vlastní evidenční kartu.
      </p>
    </header>

    <SkupinaClenove kod={skupina.kod} title="Exponáty v této skupině" />

    <footer class="skupina-byline">
      <span class="byline-publisher">Český spolek horologický</span>
      <span class="byline-sep" aria-hidden="true">·</span>
      <a href="/sbirka/katalog" class="byline-back">← Zpět do katalogu</a>
    </footer>
  </article>
</Base>

<style>
  .skupina-detail { max-width: 72ch; margin: 0 auto; }
  .skupina-detail-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
  }
  .skupina-detail-title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 0.75rem;
    color: var(--color-brass-bright);
  }
  .skupina-detail-lede {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .skupina-byline {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-brass) 18%, transparent);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
  }
  .byline-publisher { color: var(--color-text-soft); font-style: italic; }
  .byline-sep { color: var(--color-brass); opacity: 0.5; }
  .byline-back { color: var(--color-brass); border-bottom: 1px dotted color-mix(in srgb, var(--color-brass) 40%, transparent); text-decoration: none; }
  .byline-back:hover { color: var(--color-brass-bright); }
</style>
