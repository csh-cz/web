---
/**
 * @csh/ui — Breadcrumbs drobečková navigace + JSON-LD BreadcrumbList.
 *
 * Sjednoceno mezi hodinarium-eu a horologie-cz (FU5 fáze 4, 2026-05-19).
 * CSS žije v site-specific global.css (`.breadcrumbs`).
 *
 * Crumb props:
 *   - label   : zobrazený text (povinný)
 *   - href    : když je nastavený, vykreslí <a>; bez něj <span class="current">
 *   - soft    : separátor PŘED touto položkou je „·" místo „›" (sub-view)
 *   - dim     : ztlumený intermediate label — bez href, bez current —
 *               vypadne i z JSON-LD BreadcrumbList
 *
 * Použití:
 *   <Breadcrumbs trail={[
 *     { href: '/', label: 'Hodinárium' },
 *     { href: '/sbirka', label: 'Sbírka' },
 *     { href: '/sbirka/katalog', label: 'Katalog', soft: true },
 *     { label: 'Soustrojí Prokeš 1868' },  // current
 *   ]} />
 *
 * JSON-LD URL base: `Astro.site` (z astro.config.mjs). Pokud chybí,
 * BreadcrumbList se vyrenderuje jen s `name` (bez `item` URL) — Google
 * to akceptuje.
 */

interface Crumb {
  label: string;
  href?: string;
  soft?: boolean;
  dim?: boolean;
}

interface Props {
  trail: Crumb[];
  /** Vynechat JSON-LD BreadcrumbList (homepage / kosmetické breadcrumbs). */
  noJsonLd?: boolean;
}

const { trail, noJsonLd = false } = Astro.props;

// JSON-LD BreadcrumbList — Google rich snippets.
// Filtrujeme dim crumbs (nejsou to skutečné úrovně), ostatní vč. soft zachováváme.
const site = Astro.site;
const ldItems = trail
  .filter((c) => !c.dim)
  .map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    // Když site není nakonfigurovaná (žádný site: v astro.config), vynechej
    // absolute item URL — relative URL by Google odmítl. `name` stačí pro
    // partial markup.
    ...(c.href && site && { item: new URL(c.href, site).toString() }),
  }));

const jsonLd =
  !noJsonLd && ldItems.length >= 2
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: ldItems,
      }
    : null;
---
{jsonLd && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
<nav class="breadcrumbs" aria-label="Drobečková navigace">
  {trail.map((crumb, i) => (
    <>
      {i > 0 && <span aria-hidden="true">{crumb.soft ? '·' : '›'}</span>}
      {crumb.href ? (
        <a href={crumb.href}>{crumb.label}</a>
      ) : crumb.dim ? (
        <span class="bc-dim">{crumb.label}</span>
      ) : (
        <span class="current" aria-current="page">{crumb.label}</span>
      )}
    </>
  ))}
</nav>
