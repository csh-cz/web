---
/**
 * @csh/ui — sdílený Schema.org JSON-LD komponent.
 *
 * Injectne `<script type="application/ld+json">` s předaným payloadem.
 * Pole `data` může být jeden objekt nebo pole objektů (více schémat).
 *
 * `is:inline` — kritické! Astro by jinak mohl bundlerovat JSON content
 * nebo přidat module preamble; SEO validátory potřebují raw inline script.
 *
 * Validace: https://search.google.com/test/rich-results
 */
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---
{items.map((item) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
))}
